    <skos:prefLabel xml:lang="en">PLANKTON</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: &quot;Plankton refers to any community of floating or weakly swimming
organism, mostly microscopic, living in freshwater and saltwater habitats.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="Starr, C. and R. Taggart. 1998. Biology: the unity and diversity of life. Wadsworth Publishing Company. Belmont, California." xml:lang="en"/>
    <skos:narrower rdf:resource="28dc7895-3365-4bab-9946-3b247f4137b0"/>
    <skos:definition xml:lang="en">&apos;Plankton refers to any community of floating or weakly swimmingorganism, mostly microscopic, living in freshwater and saltwater habitats.</skos:definition>
    <dcterms:modified>2017-03-15 11:29:06.0</dcterms:modified>
