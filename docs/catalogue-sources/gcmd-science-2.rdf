  </skos:Concept>
  <skos:Concept rdf:about="f9f0f92b-7901-4dda-8d64-be4e845ce29b">
    <skos:broader rdf:resource="b6fd22ab-dca7-4dfa-8812-913453b5695b"/>
    <skos:prefLabel xml:lang="en">DELTAS</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Garrison, T.  1993.  Oceanography, An Invitation to Marine Science.  Wadsworth Publishing Co.  p. 518." xml:lang="en"/>
    <skos:definition xml:lang="en">The deposit of sediments found at the mouth of a river.</skos:definition>
