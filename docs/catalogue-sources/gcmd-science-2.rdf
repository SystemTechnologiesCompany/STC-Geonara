    <skos:broader rdf:resource="9e5ec924-2fd3-4cbb-a7eb-ffde114d0cb9"/>
    <skos:prefLabel xml:lang="en">DINITROGEN PENTOXIDE</skos:prefLabel>
    <gcmd:reference gcmd:text="American Meteorological Society. 2000. Glossary of Meteorology, Second Edition. Boston, MA: American Meteorological Society." xml:lang="en"/>
    <skos:definition xml:lang="en">Dinitrogen pentoxide (N2O5) is formed from the reaction of the nitrate radicalwith nitrogen dioxide. Higher in the atmosphere N2O5 is an effective reservoirfor active nitrogen.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d6db51cf-d2d0-4203-94c8-c884579e0cb0">
    <skos:broader rdf:resource="9b5474eb-2dc8-4a8e-90b4-872f9fda80d9"/>
    <skos:prefLabel xml:lang="en">MILLIPEDES</skos:prefLabel>
    <gcmd:reference gcmd:text="Burn, David M.  Animal World.  1980.  Octopus Books Ltd.  London." xml:lang="en"/>
    <skos:definition xml:lang="en">Millipedes are in the Class Chilopoda, in the Phylum Arthropoda, andare elongate arthropods with body divided into head and trunk, the latterbearing never many more than 200 pairs of legs.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
