  </skos:Concept>
  <skos:Concept rdf:about="be027470-35ab-4ebb-a213-5f557cca71c8">
    <skos:broader rdf:resource="08fd82a1-4370-46a2-82ea-94c0f91498a7"/>
    <skos:prefLabel xml:lang="en">PRESSURE THICKNESS</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Weather and Climate, American Meteorological Society, 1996." xml:lang="en"/>
    <skos:definition xml:lang="en">In synoptic meteorology, the vertical depth, measured in geometricor geopotential units, of a layer in the atmosphere bounded by twodifferent constant-pressure surfaces.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c0656cbc-5d94-4945-bbfd-1c8eabb059b2">
    <skos:broader rdf:resource="08fd82a1-4370-46a2-82ea-94c0f91498a7"/>
    <skos:prefLabel xml:lang="en">OSCILLATIONS</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Weather and Climate, American Meteorological Society, 1996." xml:lang="en"/>
    <skos:definition xml:lang="en">The process of regularly varying pressure above and below a mean value,a periodic process.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
