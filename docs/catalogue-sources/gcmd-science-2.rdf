  <skos:Concept rdf:about="8ce4bad9-f050-4b0c-845e-5e7569b6a2d2">
    <skos:broader rdf:resource="abc6f016-d1f0-4725-b847-639de054d13f"/>
    <skos:prefLabel xml:lang="en">FLATWORMS/FLUKES/TAPEWORMS</skos:prefLabel>
    <gcmd:reference gcmd:text="Burn, David M. Animal World.  1980.  Octopus Books Ltd. London." xml:lang="en"/>
    <skos:definition xml:lang="en">Flatworms have a dorsoventrally flattened, simple triploblastic body lackinga coelom, anus and blood vascular system.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
