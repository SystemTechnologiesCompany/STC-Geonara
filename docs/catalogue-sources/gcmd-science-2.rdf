  <skos:Concept rdf:about="e8f25820-dd06-4d8d-9548-dcc30a871982">
    <skos:broader rdf:resource="1bf8f27a-d6ff-4cb6-acb7-7e5cce11e029"/>
    <skos:prefLabel xml:lang="en">WADERS/GULLS/AUKS AND ALLIES</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: Phylum Chordata. Class Aves. Order Charadriiformes are very diverse group of birds. Waders feed mostly in the mud. Gulls are generally larger and feed on small fish. Auks nest on sea cliffs.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="encyclopedia of life" xml:lang="en"/>
    <skos:definition xml:lang="en">Phylum Chordata. Class Aves. Order Charadriiformes are very diverse group of birds. Waders feed mostly in the mud. Gulls are generally larger and feed on small fish. Auks nest on sea cliffs.</skos:definition>
    <dcterms:modified>2017-03-15 13:38:53.0</dcterms:modified>
