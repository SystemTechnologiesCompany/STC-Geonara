    <gcmd:reference gcmd:text="https://nsidc.org/learn/cryosphere-glossary" xml:lang="en"/>
    <skos:definition xml:lang="en">Ice that is anchored to the shore or ocean bottom, typically over shallow ocean shelves at continental margins. Fast ice does not move with the winds or currents. Also known as landfast ice.</skos:definition>
