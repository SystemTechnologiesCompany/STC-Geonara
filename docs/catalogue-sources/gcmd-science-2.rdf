    <skos:prefLabel xml:lang="en">PRIMARY PRODUCTION</skos:prefLabel>
    <gcmd:reference gcmd:text="Krebs, Charles K. Ecology - 4th ed. 1994.  HarperCollins College Publishers, New York, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">Primary production is production by green plants.</skos:definition>
