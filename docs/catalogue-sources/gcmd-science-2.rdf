  <skos:Concept rdf:about="c59b0666-e20f-4134-847b-89719ed5621a">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">CROWN</skos:prefLabel>
    <gcmd:reference gcmd:text="Kimmins, J.P. 1997. Forest Ecology.  Prentice Hall.  Upper Saddle River, New Jersey." xml:lang="en"/>
    <skos:definition xml:lang="en">The crown is the horizontal layer of the vegetation where most of thebranches and foliage are found.</skos:definition>
