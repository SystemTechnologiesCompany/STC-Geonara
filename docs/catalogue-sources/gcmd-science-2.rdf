  <skos:Concept rdf:about="9d99408d-0d8b-4642-a2cb-edee8319fe1d">
    <skos:broader rdf:resource="d73e969a-4b66-4713-8d63-fa3cbb1e25e3"/>
    <skos:prefLabel xml:lang="en">ISOTOPES</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of ice age terms &apos;http://academic.emporia.edu/aberjame/ice/gloss.htm&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">Isotopes are a form of an element with a certain number of neutrons, for
example carbon exists in three isotopes: C12, C13, and C14. Some isotopes are
naturally unstable and spontaneously decay at a fixed rate; other isotopes are
stable.</skos:definition>
