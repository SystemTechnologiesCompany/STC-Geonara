    <skos:broader rdf:resource="abc6f016-d1f0-4725-b847-639de054d13f"/>
    <skos:prefLabel xml:lang="en">ARTHROPODS</skos:prefLabel>
    <gcmd:reference gcmd:text="Burn, David M. Animal World.  1980.  Octopus Books Ltd.  London." xml:lang="en"/>
    <skos:narrower rdf:resource="38e40180-1a2a-40a9-a030-04775dabbabb"/>
    <skos:narrower rdf:resource="f2044dcf-40da-4fcc-97ab-914343d885a5"/>
    <skos:narrower rdf:resource="9b5474eb-2dc8-4a8e-90b4-872f9fda80d9"/>
    <skos:narrower rdf:resource="b32ca9df-f981-4696-bf97-c190175e47b7"/>
    <skos:definition xml:lang="en">The phylum Arthropods possesses an exoskeleton, the arrangement ofhardened plates and tubular sections found in the outer covering orcuticle of the body.</skos:definition>
