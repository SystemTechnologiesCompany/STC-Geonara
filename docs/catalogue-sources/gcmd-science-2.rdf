  <skos:Concept rdf:about="cd9f44da-b3b4-4f9c-a21f-89b59a29b235">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">INDIGENOUS/NATIVE SPECIES</skos:prefLabel>
    <gcmd:reference gcmd:text="Allaby, M. 1998. A Dictionary of Ecology. Oxford University Press.  Oxford, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">Indigenous Species or native species is a term applied to a species thatoccurs naturally in an area, and therefore, one that has not beenintroduced by humans accidentally or intentionally.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="abc96dce-cbae-43a4-b7c2-2ff02276b030">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">SCAVENGING</skos:prefLabel>
    <gcmd:reference gcmd:text="Hickman, C. and L. Roberts. 1995. Animal Diversity. William C. Brown Publishers. Dubuque, Iowa." xml:lang="en"/>
    <skos:definition xml:lang="en">Scavenging is the manner of feeding where the animal feeds on dead animaland plant matter.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c5ae3a71-d144-4b91-9cf0-e3cb27ce718f">
