    <skos:prefLabel xml:lang="en">AGRICULTURAL CHEMICALS</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Herren, R.V., and R.L. Donahue.  1991.  The Agriculture Dictionary, Delmar Publishers INC.  Albany, New york.  553pp." xml:lang="en"/>
    <skos:narrower rdf:resource="18a8197e-3a3f-408c-9c51-e9fe89dd6b45"/>
    <skos:narrower rdf:resource="59a203f9-f818-42a6-8d00-4301385cafc3"/>
    <skos:definition xml:lang="en">A term used to designate chemical materials used in Agriculture suchas herbicides, insecticides, fungicides, and fertilizers. Does NOT includefood or feed additives, or animal hormones.</skos:definition>
