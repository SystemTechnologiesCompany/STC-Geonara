  <skos:Concept rdf:about="b1ce822a-139b-4e11-8bbe-453f19501c36">
    <skos:broader rdf:resource="376a1d5c-2496-4381-981f-bc047af92044"/>
    <skos:prefLabel xml:lang="en">ROCK GLACIERS</skos:prefLabel>
    <gcmd:reference gcmd:text="From the National Snow and Ice Data Center (NSIDC). &apos;http://nsidc.org&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">A mass of rock fragments and finer material, on a slope, that
contains either interstitial ice or an ice core and shows evidence of past or
present movement.</skos:definition>
