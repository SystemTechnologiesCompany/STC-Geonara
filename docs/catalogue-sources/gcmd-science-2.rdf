  <skos:Concept rdf:about="ff889b84-e12f-40ab-815b-61d5aecf2b63">
    <skos:broader rdf:resource="431eca76-9d34-4f86-b1d3-a0b40221e905"/>
    <skos:prefLabel xml:lang="en">WEB COORDINATE TRANSFORMATION SERVICE</skos:prefLabel>
    <gcmd:reference gcmd:text="Open Geospatial Consortium (OGC)" xml:lang="en"/>
    <skos:definition xml:lang="en">Transforms the coordinates of feature or coverage data from one coordinatereference system (CRS) to another, including “transformations”, “conversions”, rectification, and orthorectification.</skos:definition>
