  <skos:Concept rdf:about="90f97e5b-f883-4a34-a3bc-7dea8d96eb7d">
    <skos:broader rdf:resource="457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
    <skos:prefLabel xml:lang="en">BIOLUMINESCENCE</skos:prefLabel>
    <gcmd:reference gcmd:text="Lerman, M. 1986. Marine Biology: Environment, Diversity and Ecology. The Benjamin/Cummings Publishing Co. p. 511." xml:lang="en"/>
    <skos:definition xml:lang="en">The production of visible light by organisms.</skos:definition>
