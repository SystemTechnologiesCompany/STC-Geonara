    <gcmd:reference gcmd:text="Adapted from: Webster&apos;s College Dictionary. 1991. Random House." xml:lang="en"/>
    <skos:definition xml:lang="en">Any non-radioactive form of a chemical element, having the same atomic weight as that element (i.e. same number of protons), but a different number of neutrons.</skos:definition>
