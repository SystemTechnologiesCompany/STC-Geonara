related concept uuid: a6c3e78f-f408-4b72-941a-f40e3d83dd60
relationship type: null
relationship value: null
generated by: null</skos:changeNote>
    <gcmd:reference gcmd:text="Canadian Centre for Remote Sensing, Remote Sensing Glossary.See: &apos;http://www.ccrs.nrcan.gc.ca/ccrs/eduref/ref/glosndxe.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">The small-scale variation in the relief of the terrain surface (in thiscase the surface of the ice). Remote sensing instruments, such as radarand microwave sensors, have been able to detect the degree of roughness ofsea, lake, and river ice.</skos:definition>
    <dcterms:modified>2024-10-02 15:53:26.0</dcterms:modified>
