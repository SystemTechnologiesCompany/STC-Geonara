  <skos:Concept rdf:about="b6b51058-1111-4498-a9ac-e1515270fb27">
    <skos:broader rdf:resource="c16bda61-353b-4668-af2f-bbb98785b6fa"/>
    <skos:prefLabel xml:lang="en">SEAFLOOR TOPOGRAPHY</skos:prefLabel>
    <gcmd:reference gcmd:text="Alyn C. Duxbury, Alison B. Duxbury, and Keith A. Sverdrup. An Introduction to  the World&apos;s Oceans. 6th edition. McGraw-Hill Higher Education, 2000." xml:lang="en"/>
    <skos:definition xml:lang="en">General elevation pattern of the land surface or the ocean bottom.  Also referto as bathymetry, the study and mapping of sea floor elevations and thevariations of water depth; the topography of the sea floor.</skos:definition>
