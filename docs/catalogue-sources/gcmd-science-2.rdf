  <skos:Concept rdf:about="9b6ca807-7719-48aa-864d-ebb45a519ff8">
    <skos:broader rdf:resource="d46a5046-e1c6-4a09-a2f1-db6a21eda611"/>
    <skos:prefLabel xml:lang="en">METHYL BROMIDE</skos:prefLabel>
    <gcmd:reference gcmd:text="[New York Times Aug. 16, 2003] [Baird, Colin. Environmental Chemistry. (1999) W.H.   Freeman,  New York.]" xml:lang="en"/>
    <skos:definition xml:lang="en">CH3Br, this halocarbon is released, to a degree, naturally from the oceans, but is more commonly released from its anthropogenic use as a soil fumigant or pesticide. Methyl bromide is persistent enough to reach the stratosphere where it photochemically decomposes to yield atomic bromine (radical) and proceeds to destroy stratospheric ozone in the same manner as the atomic chlorine radical. On an atom-for-atom basis, stratospheric bromine is more efficient at destroying ozone than is chlorine because the HBr reservoir species is more photochemically active than HCl; however, there is much less of hydrogen bromide in the stratosphere. Recent data suggest that since 1998 atmospheric concentrations have dropped 13% due the CH3Br use limitations mandated by the Montreal Protocol</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a4f0e0d2-4bcb-4675-b874-e6e0f3a8c462">
    <skos:broader rdf:resource="a04804d5-1064-48fd-a7a7-8da8e10399e1"/>
    <skos:prefLabel xml:lang="en">WAVE TYPES</skos:prefLabel>
    <skos:definition xml:lang="en">Names of kinds of waves.  Specific types may be included asDetailed Variables, e.g. capillary waves, Rossby waves, etc.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
