  <skos:Concept rdf:about="8cbdfa00-852c-452d-8013-86145ad318c8">
    <skos:broader rdf:resource="3a942e8a-d2f2-42bf-9e83-b7b3793b100e"/>
    <skos:prefLabel xml:lang="en">MAGNETIC FIELDS/MAGNETIC CURRENTS</skos:prefLabel>
    <gcmd:reference gcmd:text="http://www-istp.gsfc.nasa.gov/Education/gloss.html" xml:lang="en"/>
    <skos:definition xml:lang="en">An Electromagnetic field (EM field) is the region of space near electriccurrents, magnets, broadcasting antennas etc., regions in which electric andmagnetic forces may act, for example on charged particles.</skos:definition>
