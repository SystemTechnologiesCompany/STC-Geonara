generated by: null</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">In geology, a proglacial lake is a lake formed either by the damming action of a moraine or ice dam during the retreat of a melting glacier, or by meltwater trapped against an ice sheet due to isostatic depression of the crust around the ice.</skos:definition>
    <dcterms:modified>2024-10-30 15:47:03.0</dcterms:modified>
