    <skos:changeNote>Date=2013-03-11 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Hydrogen gas is colorless, odorless, tasteless, flammable, and nontoxic. Hydrogen gas exists as a gas at ambient temperatures and atmospheric pressures. Hydrogen gas is the lightest gas known with a density approximately 0.07 that of air. The concentration of hydrogen gas in the atmosphere volume is 5.0 x 10-5%. Hydrogen is principally shipped and used in gaseous form for refineries, petrochemical companies for hydrotreating, catalytic reforming and hydrocracking. Hydrogen is also used in heat treating, metal production, welding, lasers, plastics, food production, and semiconductors.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="Spectra Gases Inc." xml:lang="en"/>
    <skos:narrower rdf:resource="833b6958-fc93-473c-aadb-bb65da7578e5"/>
    <skos:definition xml:lang="en">Hydrogen gas is colorless, odorless, tasteless, flammable, and nontoxic. Hydrogen gas exists as a gas at ambient temperatures and atmospheric pressures. Hydrogen gas is the lightest gas known with a density approximately 0.07 that of air. The concentration of hydrogen gas in the atmosphere volume is 5.0 x 10-5%. Hydrogen is principally shipped and used in gaseous form for refineries, petrochemical companies for hydrotreating, catalytic reforming and hydrocracking. Hydrogen is also used in heat treating, metal production, welding, lasers, plastics, food production, and semiconductors.</skos:definition>
    <dcterms:modified>2013-03-11 12:34:20.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="bf19f1d1-ae18-4ff2-95f6-dc0ed812c568">
    <skos:broader rdf:resource="8603db51-3484-4439-8b3b-a06f48e8c686"/>
    <skos:prefLabel xml:lang="en">GLACIER TOPOGRAPHY/ICE SHEET TOPOGRAPHY</skos:prefLabel>
    <gcmd:reference gcmd:text="From the Rice University Glacier Glossary &apos;http://www.glacier.rice.edu/misc/glossary.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">Surface relief of the land. Topography usually is measured in meters above sea
level. The topography can be very different from one location to another.
Topography can be flat, or mountainous, or hilly.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
