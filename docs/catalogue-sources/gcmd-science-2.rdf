User Note=Insert Concept
System Note=add narrower relation
New Value=PRECIPITATION [ea213be5-fe37-4179-9a9b-030c2bf42cf5,1011362] - SOLID PRECIPITATION [c40d3dbc-5d7e-434d-996e-120ba44a5d44,1011363]</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society, https://glossary.ametsoc.org/wiki/Precipitation" xml:lang="en"/>
    <skos:narrower rdf:resource="c40d3dbc-5d7e-434d-996e-120ba44a5d44"/>
    <skos:narrower rdf:resource="4ca02520-1345-475c-9a54-b562a042c4e1"/>
    <skos:definition xml:lang="en">All hydrometeors formed in the atmosphere, including liquid, solid, or a combination of the two (e.g., resulting from incomplete melting or freezing or from accretion), that are large enough to fall as a result of gravity.</skos:definition>
    <dcterms:modified>2022-08-05 14:20:00.0</dcterms:modified>
