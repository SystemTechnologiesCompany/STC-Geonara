New Value=DYNAMIC TOPOGRAPHY [940550d2-1d9f-4c28-b9ba-857c2dc8ef95,778236] - SEA ICE TOPOGRAPHY [15547b03-1b99-4c60-92eb-216a2908f504,778232]</skos:changeNote>
    <gcmd:reference gcmd:text="Stewart, R.H. (September 2008). Introduction To Physical Oceanography" xml:lang="en"/>
    <skos:narrower rdf:resource="7e1fc68e-5a7e-4a59-8ae6-3fa15bdae12d"/>
    <skos:narrower rdf:resource="cf89619d-c67d-43f0-a217-c8684ce7c984"/>
    <skos:definition xml:lang="en">Ocean surface topography or sea surface topography, also called ocean dynamic topography, are highs and lows on the ocean surface, similar to the hills and valleys of Earth&apos;s land surface depicted on a topographic map.</skos:definition>
    <dcterms:modified>2021-10-22 15:14:55.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="949f8a84-185a-42a0-89dc-48534b46f309">
    <skos:broader rdf:resource="663a2ea2-e2bf-4209-ae9b-334c8222b106"/>
    <skos:prefLabel xml:lang="en">AMOEBAS</skos:prefLabel>
    <gcmd:reference gcmd:text="Otto, James H. and Albert Towle.  Modern Biology.  1977. Holt, Rinehart and Winston, Publishers.  New York, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">The genus amoebae includes several protozoan species.  Although, throughthe microscope it appears as a shapeless mass of cytoplasm surrounded by athin membrane.  Amoebae perform all of life&apos;s functions.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a9b6a001-42b2-48db-b132-62e69f03b8cb">
    <skos:broader rdf:resource="63bc0693-52eb-4ebd-a39e-e77e96409072"/>
    <skos:prefLabel xml:lang="en">BOWEN RATIO</skos:prefLabel>
    <gcmd:reference gcmd:text="The Texas A&amp;M Glossary of Oceanography and the Related Geosciences with References. &apos;http://www-ocean.tamu.edu/~baum/paleo/paleogloss/paleogloss.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">The ratio of the amount of sensible to that of latent heat lost by a surface
to the atmosphere by the processes of conduction and turbulence. See J. M.
Lewis. The story behind the Bowen ratio.  Bull. Am. Meteor. Soc.,
76:-2443, 1995.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d1426df9-7653-442b-8e38-fa28757ec748">
    <skos:broader rdf:resource="63bc0693-52eb-4ebd-a39e-e77e96409072"/>
    <skos:prefLabel xml:lang="en">REFLECTANCE</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Oceanography and the Related Geosciences with References, Texas A&amp;M, &apos;http://www-ocean.tamu.edu/~baum/paleo/paleogloss/paleogloss.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">In radiation transfer, reflectance is the fraction of incoming radiation
that is reflected from a medium. The sum of this, the transmittance, and
the absorptance must equal unity.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d8e2bcae-7781-41b6-8d2d-7c82ae61be47">
    <skos:broader rdf:resource="68eed887-8008-4352-b420-949457ab59ab"/>
    <dcterms:created>2019-08-26</dcterms:created>
    <skos:prefLabel xml:lang="en">GLACIER TERMINUS</skos:prefLabel>
    <skos:changeNote>Date=2019-08-26 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=GLACIER TERMINUS [d8e2bcae-7781-41b6-8d2d-7c82ae61be47,369047] - GLACIERS [68eed887-8008-4352-b420-949457ab59ab,84413]</skos:changeNote>
    <gcmd:reference gcmd:text="https://nsidc.org/cryosphere/glaciers/gallery/terminus.html" xml:lang="en"/>
    <skos:definition xml:lang="en">The terminus is the end of a glacier, usually the lowest end, and is also often called a glacier toe or snout.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d16cd32f-978d-4ab5-9711-f8189a748399">
    <skos:broader rdf:resource="638a22af-4e97-450e-a278-b81338443230"/>
    <dcterms:created>2016-03-31</dcterms:created>
    <skos:prefLabel xml:lang="en">INFILTRATION RATE</skos:prefLabel>
    <skos:changeNote>Date=2016-03-31 User Id=gee-cee Entity=PrefLabel Operation=UPDATE Field=text 
System Note=update PrefLabel
