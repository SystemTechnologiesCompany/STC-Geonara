    <skos:prefLabel xml:lang="en">SEA CLIFFS</skos:prefLabel>
    <skos:changeNote>Date=2024-10-31 User Id=tstevens Entity=WeightedRelation Operation=INSERT 
System Note=insert WeightedRelation
New Value=id: null
related concept uuid: 01400b09-68a3-4e3e-b076-1687e30bed56
