    <skos:broader rdf:resource="2e83362e-d8f8-4bca-83fd-bae360ebe94b"/>
    <skos:prefLabel xml:lang="en">SOLAR FLARES</skos:prefLabel>
    <gcmd:reference gcmd:text="the Cambridge Encyclopedia of the Sun, The Cambridge University Press, Cambridge, CB2, 2RU, UK, 2001. (Excerpted)" xml:lang="en"/>
    <skos:definition xml:lang="en">A sudden and violent release of matter and energy within a solar activityregion in the form of electromagnetic radiation, energetic particles, shockwaves, lasting a few minutes to hours.	Solar flares accelerate chargedparticles into interplanetary space.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
