relationship value: null
generated by: null</skos:changeNote>
    <skos:changeNote>Date=2013-08-20 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=text 
System Note=update Definition
Old Value=Sea arches form by wave erosion of coastal headlands. Sea arches are very temporary landforms, in both geologic and human terms.
New Value=A significant vertical, or near vertical, rock exposure. Cliffs are formed as erosion landforms due to the processes of erosion and weathering that produce them. Cliffs are common on coasts, in mountainous areas, escarpments and along rivers.</skos:changeNote>
    <skos:changeNote>Date=2013-08-20 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
Old Value=Geology.com
New Value=PhysicalGeography.net</skos:changeNote>
    <skos:changeNote>Date=2013-08-20 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Sea arches form by wave erosion of coastal headlands. Sea arches are very temporary landforms, in both geologic and human terms.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-08-06 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SEA CLIFFS [a82477e6-b563-4135-90e8-c6977c7381be,105541] - COASTAL LANDFORMS [0cff6e4b-e42a-4565-89ff-350adf41ed69,105283]</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">A significant vertical, or near vertical, rock exposure. Cliffs are formed as erosion landforms due to the processes of erosion and weathering that produce them. Cliffs are common on coasts, in mountainous areas, escarpments and along rivers.</skos:definition>
    <dcterms:modified>2024-10-31 10:32:58.0</dcterms:modified>
