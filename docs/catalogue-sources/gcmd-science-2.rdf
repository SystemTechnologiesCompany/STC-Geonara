New Value=SPECTRAL IRRADIANCE [b7a45c57-b652-469a-a3f2-8d38555bf478,367649] - ATMOSPHERIC RADIATION [4ad0c52d-6449-48ff-8678-adc6b2cebcb7,83505]</skos:changeNote>
    <gcmd:reference gcmd:text="http://glossary.ametsoc.org/wiki/Spectral_irradiance" xml:lang="en"/>
    <skos:definition xml:lang="en">Units are typically W m-2 μm-1 or W m-2(cm-1)-1.</skos:definition>
