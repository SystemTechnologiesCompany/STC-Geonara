  <skos:Concept rdf:about="f12c3e63-07ba-45dd-848f-55e96b497d27">
    <skos:broader rdf:resource="d4313915-2d24-424c-a171-30ee9a6f4bb5"/>
    <skos:prefLabel xml:lang="en">WATER CONTROL STRUCTURES</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from WATER CONTROL STRUCTURES [f12c3e63-07ba-45dd-848f-55e96b497d27] to INFRASTRUCTURE [d4313915-2d24-424c-a171-30ee9a6f4bb5]</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added narrower relation from WATER CONTROL STRUCTURES [f12c3e63-07ba-45dd-848f-55e96b497d27] to LEVEES [2e372203-e14e-46cc-9db0-3b6613f61405]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nrcs.usda.gov/sites/default/files/2022-10/Structure_for_Water_Control_587_CPS_Oct_2017.pdf" xml:lang="en"/>
    <skos:narrower rdf:resource="2e372203-e14e-46cc-9db0-3b6613f61405"/>
    <skos:definition xml:lang="en">A structure in a water management system that conveys water, controls the direction or rate of flow, maintains a desired water surface elevation, or measures water.</skos:definition>
    <dcterms:modified>2025-08-12T16:41:51.372Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="dbb6d354-1ffe-4228-8ee4-69b2577a21f7">
    <skos:broader rdf:resource="d83b4271-048c-4763-9d5c-b5ec1b1788f4"/>
    <skos:prefLabel xml:lang="en">TRAILS</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from TRAILS [dbb6d354-1ffe-4228-8ee4-69b2577a21f7] to RURAL AREAS [d83b4271-048c-4763-9d5c-b5ec1b1788f4]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nps.gov/subjects/trails/types-of-trails.htm" xml:lang="en"/>
    <skos:definition xml:lang="en">Foot trails, bikeways, boardwalks, nature trails, multi-use trails, and other designated pathways.</skos:definition>
    <dcterms:modified>2025-08-12T16:55:15.012Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="fe40d33a-a792-4e06-8b4a-70bd0210b5a0">
    <skos:broader rdf:resource="55b1e1e3-f6c1-439d-864c-f32a9ca8852c"/>
    <skos:prefLabel xml:lang="en">SURFACE MOMENTUM FLUX</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from SURFACE MOMENTUM FLUX [fe40d33a-a792-4e06-8b4a-70bd0210b5a0] to ATMOSPHERE/SURFACE INTERACTIONS [55b1e1e3-f6c1-439d-864c-f32a9ca8852c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://oceanobservatories.org/data-product/mommflx/#:~:text=Momentum%20Flux%20(Wind%20Stress)%20refers,wind%20blows%20across%20the%20surface." xml:lang="en"/>
    <skos:definition xml:lang="en">Transfer of momentum across the interfaces between the atmosphere and the ocean or land.</skos:definition>
    <dcterms:modified>2025-08-12T17:12:27.658Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="edb02736-af90-41bd-b4c3-f0f1599078a5">
    <skos:broader rdf:resource="885735f3-121e-4ca0-ac8b-f37dbc972f03"/>
    <skos:prefLabel xml:lang="en">TERRESTRIAL HYDROSPHERE CHANGE</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from TERRESTRIAL HYDROSPHERE CHANGE [edb02736-af90-41bd-b4c3-f0f1599078a5] to TERRESTRIAL HYDROSPHERE [885735f3-121e-4ca0-ac8b-f37dbc972f03]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.earthdata.nasa.gov/topics/terrestrial-hydrosphere#:~:text=The%20terrestrial%20hydrosphere%20includes%20water,along%20with%20total%20water%20storage." xml:lang="en"/>
    <skos:definition xml:lang="en">Changes to the terrestrial hydrosphere, including water on the land surface and underground in the form of lakes, rivers, and groundwater along with total water storage. </skos:definition>
    <dcterms:modified>2025-08-12T17:21:52.156Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="ed710f29-031f-45b3-8fa7-aeb17e8ce564">
    <skos:broader rdf:resource="06180441-d4bb-4fed-b36a-9b3cb2cac0fe"/>
    <skos:prefLabel xml:lang="en">TROPICAL CYCLONE CENTER</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from TROPICAL CYCLONE CENTER [ed710f29-031f-45b3-8fa7-aeb17e8ce564] to TROPICAL CYCLONES [06180441-d4bb-4fed-b36a-9b3cb2cac0fe]</skos:changeNote>
    <gcmd:reference gcmd:text="https://geo.libretexts.org/Bookshelves/Meteorology_and_Climate_Science/Practical_Meteorology_(Stull)/16%3A_Tropical_Cyclones/16.00%3A_Section_1-#:~:text=Tropical%20cyclones%20are%20made%20of,the%20greatest%20radar%20reflectivity%20(Fig." xml:lang="en"/>
    <skos:definition xml:lang="en">A relatively calm, generally clear area of sinking air and light winds at the center of a cyclone, also referred to as the &quot;eye&quot;.</skos:definition>
    <dcterms:modified>2025-08-12T18:05:41.653Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="ee84a17d-221f-4798-93f9-7cecc8400662">
    <skos:broader rdf:resource="61c3b720-abc8-4430-866c-f1da35d2cd0b"/>
    <skos:prefLabel xml:lang="en">ABSORBING AEROSOL OPTICAL DEPTH/THICKNESS</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from ABSORBING AEROSOL OPTICAL DEPTH/THICKNESS [ee84a17d-221f-4798-93f9-7cecc8400662] to AEROSOL OPTICAL DEPTH/THICKNESS [61c3b720-abc8-4430-866c-f1da35d2cd0b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nature.com/articles/s43247-022-00576-6" xml:lang="en"/>
    <skos:definition xml:lang="en">The integrated extinction of shortwave energy by aerosols through the atmospheric column attributable to absorbing aerosols, and a component of the more commonly used total aerosol optical depth.</skos:definition>
    <dcterms:modified>2025-08-12T18:33:45.510Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c31e6af1-d4fd-408c-9fca-bd0697a45891">
    <skos:broader rdf:resource="25be3b9a-9d4c-4b5b-8d24-b1f519913d90"/>
    <skos:prefLabel xml:lang="en">CROP EMERGENCE</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from CROP EMERGENCE [c31e6af1-d4fd-408c-9fca-bd0697a45891] to AGRICULTURAL PLANT SCIENCE [25be3b9a-9d4c-4b5b-8d24-b1f519913d90]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.fao.org/agrovoc/concepts-of-the-month/seedling-emergence#:~:text=Emergence%20represents%20the%20point%20in,and%20when%20photosynthetic%20autotrophism%20begins." xml:lang="en"/>
    <skos:definition xml:lang="en">The period during which a seedling is weaned from dependence upon nonrenewable seed reserves originally produced by its parent, and when photosynthetic autotrophism begins. Emergence occurs when the cotyledon(s) of the seedling penetrates the soil surface (i.e. sprouting).</skos:definition>
    <dcterms:modified>2025-08-12T18:40:41.729Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="bf0f8e3a-d227-43d9-af73-ff36aeb079ba">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">VEGETATION DENSITY</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from VEGETATION DENSITY [bf0f8e3a-d227-43d9-af73-ff36aeb079ba] to VEGETATION [c7b5c02c-724d-4a19-b824-98180f3900c9]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.fs.usda.gov/rm/pubs_series/rmrs/gtr/rmrs_gtr164/rmrs_gtr164_10_density.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">The number of individuals of a specific plant species or of all total species per unit area using the area of the sampling unit, quadrat, or belt transect.</skos:definition>
    <dcterms:modified>2025-08-12T19:01:39.326Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a088868e-8c40-4cea-bcd2-01e777b0563b">
    <skos:broader rdf:resource="acc824e7-8eea-4e7d-aa3d-757cda7e6ec9"/>
    <skos:prefLabel xml:lang="en">STRATOSPHERIC WATER VAPOR</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from STRATOSPHERIC WATER VAPOR [a088868e-8c40-4cea-bcd2-01e777b0563b] to WATER VAPOR PROFILES [acc824e7-8eea-4e7d-aa3d-757cda7e6ec9]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nasa.gov/centers-and-facilities/langley/studying-earths-stratospheric-water-vapor/" xml:lang="en"/>
    <skos:definition xml:lang="en">Concentrations and transport of water vapor in Earth’s stratosphere.</skos:definition>
    <dcterms:modified>2025-08-13T13:48:33.897Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d8205171-15fc-4e2c-af05-2d384cb82e1e">
    <skos:broader rdf:resource="62019831-aaba-4d63-a5cd-73138ccfa5d0"/>
    <skos:prefLabel xml:lang="en">IN-CLOUD VERTICAL VELOCITIES</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from IN-CLOUD VERTICAL VELOCITIES [d8205171-15fc-4e2c-af05-2d384cb82e1e] to CLOUD DYNAMICS [62019831-aaba-4d63-a5cd-73138ccfa5d0]</skos:changeNote>
    <gcmd:reference gcmd:text="https://forecast.weather.gov/glossary.php?word=vertical%20velocity" xml:lang="en"/>
    <skos:definition xml:lang="en">The component of air motion (wind) in the vertical within clouds that is strongly connected to cloud dynamics and microphysics.</skos:definition>
    <dcterms:modified>2025-08-13T14:14:13.140Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a994de61-f16c-4b57-9dd0-b4862067203f">
    <skos:broader rdf:resource="d4313915-2d24-424c-a171-30ee9a6f4bb5"/>
    <skos:prefLabel xml:lang="en">OIL RIGS</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from OIL RIGS [a994de61-f16c-4b57-9dd0-b4862067203f] to INFRASTRUCTURE [d4313915-2d24-424c-a171-30ee9a6f4bb5]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.merriam-webster.com/dictionary/oil%20rig" xml:lang="en"/>
    <skos:definition xml:lang="en">A structure above an oil well on land or in the sea that has special equipment attached to it for drilling and removing oil from the ground.</skos:definition>
    <dcterms:modified>2025-08-13T14:38:07.751Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c4a74ff8-0eb9-426d-b6bd-97cc951addd0">
    <skos:broader rdf:resource="3f4cfc81-7745-43d9-b313-f68cdf72359b"/>
    <skos:prefLabel xml:lang="en">LIQUID POLLUTANTS</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from LIQUID POLLUTANTS [c4a74ff8-0eb9-426d-b6bd-97cc951addd0] to ENVIRONMENTAL IMPACTS [3f4cfc81-7745-43d9-b313-f68cdf72359b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nrdc.org/stories/water-pollution-everything-you-need-know#causes" xml:lang="en"/>
    <skos:definition xml:lang="en">Pollutants impacting bodies of water, such as oil spill footprints, sewage, agricultural run off, and algal blooms. </skos:definition>
    <dcterms:modified>2025-08-13T14:53:18.350Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="940cfe3b-e5b2-47f0-8e86-e3a5bd231a3f">
    <skos:broader rdf:resource="1ee8a323-f0ba-4a21-b597-50890c527c8e"/>
    <skos:prefLabel xml:lang="en">ALGAL BLOOMS</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from ALGAL BLOOMS [940cfe3b-e5b2-47f0-8e86-e3a5bd231a3f] to WATER QUALITY [1ee8a323-f0ba-4a21-b597-50890c527c8e]</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added narrower relation from ALGAL BLOOMS [940cfe3b-e5b2-47f0-8e86-e3a5bd231a3f] to HARMFUL ALGAL BLOOM (HABs) [ba506291-2799-4877-a886-8e906704a060]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.niehs.nih.gov/health/topics/agents/algal-blooms" xml:lang="en"/>
    <skos:narrower rdf:resource="ba506291-2799-4877-a886-8e906704a060"/>
    <skos:definition xml:lang="en">Excessive algal growth across a body of water which may be visible to the naked eye and can be green, blue-green, red, or brown, depending on the type of algae. </skos:definition>
    <dcterms:modified>2025-08-13T16:11:10.705Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e210bb78-19b6-453c-8dcb-81e389601329">
    <skos:broader rdf:resource="25be3b9a-9d4c-4b5b-8d24-b1f519913d90"/>
    <skos:prefLabel xml:lang="en">CROP TYPE</skos:prefLabel>
    <skos:changeNote>Date=2025-08-14 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-14 User Id=system System Note=Added broader relation from CROP TYPE [e210bb78-19b6-453c-8dcb-81e389601329] to AGRICULTURAL PLANT SCIENCE [25be3b9a-9d4c-4b5b-8d24-b1f519913d90]</skos:changeNote>
    <gcmd:reference gcmd:text="https://education.nationalgeographic.org/resource/crop/" xml:lang="en"/>
    <skos:definition xml:lang="en">A plant or plant product grown and harvested, often falling into one or more categories including food crops, feed crops, fiber crops, oil crops, ornamental crops, and industrial crops. </skos:definition>
    <dcterms:modified>2025-08-14T12:34:07.002Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="90edcb0a-78cc-4622-8182-4c6fe9646df4">
    <skos:broader rdf:resource="ec0e2762-f57a-4fdc-b395-c8d7d5590d18"/>
    <skos:prefLabel xml:lang="en">LAND DEFORMATION</skos:prefLabel>
    <skos:changeNote>Date=2025-08-15 User Id=tstevens User Note=added new keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-15 User Id=system System Note=Added broader relation from LAND DEFORMATION [90edcb0a-78cc-4622-8182-4c6fe9646df4] to NATURAL HAZARDS [ec0e2762-f57a-4fdc-b395-c8d7d5590d18]</skos:changeNote>
    <gcmd:reference gcmd:text="https://library.fiveable.me/key-terms/natural-human-disasters/ground-deformation   https://www.usgs.gov/observatories/hvo/science/deformation-monitoring-tracks-moving-magma-and-faults" xml:lang="en"/>
    <skos:definition xml:lang="en">Ground deformation refers to the changes in the shape or position of the Earth&apos;s surface caused by various geological processes, including volcanic activity.</skos:definition>
    <dcterms:modified>2025-08-15T13:28:28.067Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a0aed25f-b6db-4da3-8b98-a073bab6eb8d">
    <skos:broader rdf:resource="885735f3-121e-4ca0-ac8b-f37dbc972f03"/>
    <skos:prefLabel xml:lang="en">SURFACE RADIATIVE PROPERTIES</skos:prefLabel>
    <skos:changeNote>Date=2025-08-15 User Id=tstevens User Note=added new keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-15 User Id=system System Note=Added broader relation from SURFACE RADIATIVE PROPERTIES [a0aed25f-b6db-4da3-8b98-a073bab6eb8d] to TERRESTRIAL HYDROSPHERE [885735f3-121e-4ca0-ac8b-f37dbc972f03]</skos:changeNote>
    <skos:changeNote>Date=2025-08-15 User Id=system System Note=Added narrower relation from SURFACE RADIATIVE PROPERTIES [a0aed25f-b6db-4da3-8b98-a073bab6eb8d] to REFLECTANCE [b6fbd995-7e4d-4e15-98bd-5c4093723983]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.earthdata.nasa.gov/topics/land-surface/surface-radiative-properties" xml:lang="en"/>
    <skos:narrower rdf:resource="b6fbd995-7e4d-4e15-98bd-5c4093723983"/>
    <skos:definition xml:lang="en">Any measurement involving the scattering, absorption, or reflection of electromagnetic radiation at the land surface.</skos:definition>
    <dcterms:modified>2025-08-15T13:35:01.705Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b6fbd995-7e4d-4e15-98bd-5c4093723983">
    <skos:broader rdf:resource="a0aed25f-b6db-4da3-8b98-a073bab6eb8d"/>
    <skos:prefLabel xml:lang="en">REFLECTANCE</skos:prefLabel>
    <skos:changeNote>Date=2025-08-15 User Id=tstevens User Note=added new keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-15 User Id=system System Note=Added broader relation from REFLECTANCE [b6fbd995-7e4d-4e15-98bd-5c4093723983] to SURFACE RADIATIVE PROPERTIES [a0aed25f-b6db-4da3-8b98-a073bab6eb8d]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.earthdata.nasa.gov/topics/land-surface/reflectance" xml:lang="en"/>
    <skos:definition xml:lang="en">Reflectance is the amount of light reflected back into space. Reflectance data are useful when comparing multiple images for the same region to detect and characterize changes to Earth’s surface and atmosphere. </skos:definition>
    <dcterms:modified>2025-08-15T13:35:53.739Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="8fd7f9f6-9b95-4ba4-9df1-7b876b779a86">
    <skos:broader rdf:resource="32d72476-ba7b-43fa-b054-84804278aa84"/>
    <skos:prefLabel xml:lang="en">BENDING ANGLE</skos:prefLabel>
    <skos:changeNote>Date=2025-08-28 User Id=system System Note=Added broader relation from BENDING ANGLE [8fd7f9f6-9b95-4ba4-9df1-7b876b779a86] to RADIO OCCULTATION PROFILES [32d72476-ba7b-43fa-b054-84804278aa84]</skos:changeNote>
    <gcmd:reference gcmd:text="https://agupubs.onlinelibrary.wiley.com/doi/epdf/10.1029/2001JD900050 https://agupubs.onlinelibrary.wiley.com/doi/epdf/10.1029/97JD01569 https://user.eumetsat.int/s3/eup-strapi-media/C3_S_D311b_T2_1_2_D2_2_3_4_5_Radio_Occultation_Level_1b_Bending_Angle_Profiles_FCDR_Product_User_Guide_v1_1_380f7fb7d6.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">Bending angle quantifies the angle through which a geometric optical ray is bent as it transects the Earth’s atmosphere in limb sounding geometry. It is an intermediate quantity in the processing of GNSS radio occultation measurements. It has the dimension of an angle (radians, degrees, etc.), and its associated independent coordinate is the impact parameter with respect to a local center of curvature of the Earth’s mean sea-level ellipsoid.</skos:definition>
    <dcterms:modified>2025-08-28T19:44:21.850Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f4ec49af-b1c5-431c-968c-56890da96020">
    <skos:broader rdf:resource="32d72476-ba7b-43fa-b054-84804278aa84"/>
    <skos:prefLabel xml:lang="en">REFRACTIVITY</skos:prefLabel>
    <skos:changeNote>Date=2025-08-28 User Id=system System Note=Added broader relation from REFRACTIVITY [f4ec49af-b1c5-431c-968c-56890da96020] to RADIO OCCULTATION PROFILES [32d72476-ba7b-43fa-b054-84804278aa84]</skos:changeNote>
    <gcmd:reference gcmd:text="https://journals.ametsoc.org/view/journals/atot/23/12/jtech1996_1.xml" xml:lang="en"/>
    <skos:definition xml:lang="en">Refractivity 𝑁 is the index of refraction 𝑛 less unity in parts per million, or 𝑁 = (𝑛 − 1) × 10^6. In GNSS radio occultation, it is retrieved using the Abel transform as applied to profiles of bending angle vs. impact parameter. Its dimension is unitless but typically designated as “N-units”, and its associated independent coordinate is altitude above the mean sea-level geoid.</skos:definition>
    <dcterms:modified>2025-08-28T19:44:55.021Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c599ae55-3ca3-4c68-9ef0-2b3739bda726">
    <skos:broader rdf:resource="aa35a52f-e3d9-41bd-abd2-ec7e1a8101d1"/>
    <skos:prefLabel xml:lang="en">SNOW/ICE MASS</skos:prefLabel>
    <skos:changeNote>Date=2025-10-09 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-10-09 User Id=system System Note=Added broader relation from SNOW/ICE MASS [c599ae55-3ca3-4c68-9ef0-2b3739bda726] to SNOW/ICE [aa35a52f-e3d9-41bd-abd2-ec7e1a8101d1]</skos:changeNote>
    <gcmd:reference gcmd:text="https://science.nasa.gov/universe/glossary/" xml:lang="en"/>
    <skos:definition xml:lang="en">Total mass of a representative physical sample of snow or ice.</skos:definition>
    <dcterms:modified>2025-10-09T15:34:10.286Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e83e3455-9b6e-4ece-943e-1ce9e570a1ec">
    <skos:broader rdf:resource="2e5a401b-1507-4f57-82b8-36557c13b154"/>
    <skos:prefLabel xml:lang="en">AEROSOL OPTICAL CENTROID HEIGHT</skos:prefLabel>
    <skos:changeNote>Date=2025-10-21 User Id=tstevens User Note=added new science keywords</skos:changeNote>
    <skos:changeNote>Date=2025-10-21 User Id=system System Note=Added broader relation from AEROSOL OPTICAL CENTROID HEIGHT [e83e3455-9b6e-4ece-943e-1ce9e570a1ec] to AEROSOLS [2e5a401b-1507-4f57-82b8-36557c13b154]</skos:changeNote>
    <gcmd:reference gcmd:text="Kim, H., X. Chen, J. Wang, Z. Lu, M. Zhou, G. R. Carmichael, S. S. Park, and J. Kim (2025), Aerosol layer height (ALH) retrievals from oxygen absorption bands: intercomparison and validation among different satellite platforms, GEMS, EPIC, and TROPOMI, Atmos. Meas. Tech., 18(2), 327-349, https://doi.org/10.5194/amt-18-327-2025.   Chen, X., Wang, J., Xu, X., Zhou, M., Zhang, H., Castro Garcia, L., et al. (2021). First retrieval of absorbing aerosol height over dark target using TROPOMI oxygen B band: Algorithm development and application for surface particulate matter estimates. Remote Sensing of Environment, 265, 112674. https://doi.org/10.1016/j.rse.2021.112674" xml:lang="en"/>
    <skos:definition xml:lang="en">The aerosol optical centroid height (AOCH) is retrieved from passive remote sensing in optical variable, and here is defined as the extinction-weighted average height assuming  that the shape of aerosol extinction profile follows a quasi-Gaussian distribution. AOCH has been validated with its counterpart derived from lidar data. Retrieving this height is important for understanding atmospheric processes, air quality, and climate.</skos:definition>
    <dcterms:modified>2025-10-21T13:06:07.491Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d863e94c-5368-4c6b-937d-20d22d685239">
    <skos:broader rdf:resource="b7812c71-4b9e-4016-b4ba-dfcdb7e62365"/>
    <skos:prefLabel xml:lang="en">CHLOROPHYLL-CAROTENOID INDEX (CCI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from CHLOROPHYLL-CAROTENOID INDEX [d863e94c-5368-4c6b-937d-20d22d685239] to VEGETATION INDEX [b7812c71-4b9e-4016-b4ba-dfcdb7e62365]</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=add new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/science/article/pii/S0034425719304262 https://nph.onlinelibrary.wiley.com/doi/10.1111/nph.16479" xml:lang="en"/>
    <skos:definition xml:lang="en">The Chlorophyll-Carotenoid Index (CCI) is a remote sensing vegetation index that uses specific light wavelengths (near 531 nm) to measure the ratio of chlorophyll to carotenoid pigments, acting as a sensitive indicator of plant photosynthetic health and photosynthetic efficiency.</skos:definition>
    <dcterms:modified>2026-01-08T13:24:56.208Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="be0e2026-5429-4f72-a0dd-bdfed087e85f">
    <skos:broader rdf:resource="e63844c1-015c-4776-b01c-e3e7d5dd3d0c"/>
    <skos:prefLabel xml:lang="en">CHLOROPHYLL INDEX RED EDGE (CIRE)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from CHLOROPHYLL INDEX RED EDGE [be0e2026-5429-4f72-a0dd-bdfed087e85f] to VEGETATION INDEX [e63844c1-015c-4776-b01c-e3e7d5dd3d0c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://pro.arcgis.com/en/pro-app/latest/arcpy/spatial-analyst/cire.htm https://agriculture.africageoportal.com/content/7bfa9b2e530641c09e4e3ea3c9c0b872/about" xml:lang="en"/>
    <skos:definition xml:lang="en">The Chlorophyll Index - Red-Edge (CIre) method is a vegetation index for estimating the chlorophyll content in leaves using the ratio of reflectivity in the NIR and red-edge bands.</skos:definition>
    <dcterms:modified>2026-01-08T13:48:13.978Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e8a2e742-b0e4-407e-9510-7719dc3bde30">
    <skos:broader rdf:resource="e63844c1-015c-4776-b01c-e3e7d5dd3d0c"/>
    <skos:prefLabel xml:lang="en">CAROTENOID CONTENT INDEX (CAR)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from CAROTENOID CONTENT INDEX [e8a2e742-b0e4-407e-9510-7719dc3bde30] to VEGETATION INDEX [e63844c1-015c-4776-b01c-e3e7d5dd3d0c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.arcgis.com/home/item.html?id=20811a82245246178d95321bdebe76f0" xml:lang="en"/>
    <skos:definition xml:lang="en">Carotenoid Content Index describes the canopy content of carotenoids in terrestrial vegetation.</skos:definition>
    <dcterms:modified>2026-01-08T13:49:11.963Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b9b9d005-e90a-4455-a337-556325316a35">
    <skos:broader rdf:resource="e63844c1-015c-4776-b01c-e3e7d5dd3d0c"/>
    <skos:prefLabel xml:lang="en">CHLOROPHYLL-CAROTENOID INDEX (CCI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from CHLOROPHYLL-CAROTENOID INDEX [b9b9d005-e90a-4455-a337-556325316a35] to VEGETATION INDEX [e63844c1-015c-4776-b01c-e3e7d5dd3d0c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/science/article/pii/S0034425719304262 https://nph.onlinelibrary.wiley.com/doi/10.1111/nph.16479" xml:lang="en"/>
    <skos:definition xml:lang="en">The Chlorophyll-Carotenoid Index (CCI) is a remote sensing vegetation index that uses specific light wavelengths (near 531 nm) to measure the ratio of chlorophyll to carotenoid pigments, acting as a sensitive indicator of plant photosynthetic health and photosynthetic efficiency.</skos:definition>
    <dcterms:modified>2026-01-08T13:49:31.392Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f4002584-484c-42b5-85dc-c8c86406f00a">
    <skos:broader rdf:resource="e63844c1-015c-4776-b01c-e3e7d5dd3d0c"/>
    <skos:prefLabel xml:lang="en">NORMALIZED DIFFERENCE INFRARED INDEX (NDII)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from NORMALIZED DIFFERENCE INFRARED INDEX [f4002584-484c-42b5-85dc-c8c86406f00a] to VEGETATION INDEX [e63844c1-015c-4776-b01c-e3e7d5dd3d0c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://hess.copernicus.org/articles/27/2149/2023/ https://www.sciencedirect.com/science/article/pii/S0034425707004798" xml:lang="en"/>
    <skos:definition xml:lang="en">The normalized difference infrared index (NDII) is an index that detects canopy water content.</skos:definition>
    <dcterms:modified>2026-01-08T13:50:13.695Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e2dcb23a-e358-472c-90b3-18b8d5475923">
    <skos:broader rdf:resource="25be3b9a-9d4c-4b5b-8d24-b1f519913d90"/>
    <skos:prefLabel xml:lang="en">COVER CROPS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from COVER CROPS [e2dcb23a-e358-472c-90b3-18b8d5475923] to AGRICULTURAL PLANT SCIENCE [25be3b9a-9d4c-4b5b-8d24-b1f519913d90]</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.rma.usda.gov/about-crop-insurance/highlighted-initiatives-plans/cover-crops" xml:lang="en"/>
    <skos:definition xml:lang="en">A cover crop is a crop generally recognized by agricultural experts as agronomically sound for the area for erosion control or other purposes related to conservation or soil improvement.</skos:definition>
    <dcterms:modified>2026-02-18T12:44:44.437Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="8b8d4116-3ce6-499d-ba34-3ecf52ea499a">
    <skos:broader rdf:resource="25be3b9a-9d4c-4b5b-8d24-b1f519913d90"/>
    <skos:prefLabel xml:lang="en">HARVESTED AREA</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from HARVESTED AREA [8b8d4116-3ce6-499d-ba34-3ecf52ea499a] to AGRICULTURAL PLANT SCIENCE [25be3b9a-9d4c-4b5b-8d24-b1f519913d90]</skos:changeNote>
    <gcmd:reference gcmd:text="https://knowledge4policy.ec.europa.eu/glossary-item/harvested-area_en" xml:lang="en"/>
    <skos:definition xml:lang="en">The part of the cropped area that is harvested.  Area harvested excludes the area from which, although sown or planted, there was no harvest due to damage, failure, etc.</skos:definition>
    <dcterms:modified>2026-02-18T12:50:38.103Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a2900ef4-8b62-4bca-8814-59ea38b2b0a4">
    <skos:broader rdf:resource="199e3af8-4cf3-48ba-8b28-b9b54756b3db"/>
    <skos:prefLabel xml:lang="en">TILLAGE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from TILLAGE [a2900ef4-8b62-4bca-8814-59ea38b2b0a4] to SOILS [199e3af8-4cf3-48ba-8b28-b9b54756b3db]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.ers.usda.gov/topics/farm-practices-management/crop-livestock-practices/soil-tillage-and-crop-rotation" xml:lang="en"/>
    <skos:definition xml:lang="en">Turning the soil to control for weeds and pests and to prepare for seeding.</skos:definition>
    <dcterms:modified>2026-02-18T12:54:22.015Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e3472035-3f48-4350-adbd-f57e79b29349">
    <skos:broader rdf:resource="7c892333-f4c4-4f81-b825-d6a86e107e9f"/>
    <skos:prefLabel xml:lang="en">METHANE CONCENTRATION</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from METHANE CONCENTRATION [e3472035-3f48-4350-adbd-f57e79b29349] to METHANE [7c892333-f4c4-4f81-b825-d6a86e107e9f]</skos:changeNote>
    <gcmd:reference gcmd:text="https://gml.noaa.gov/ccgg/trends_ch4/" xml:lang="en"/>
    <skos:definition xml:lang="en">Atmospheric methane abundance, defined as the number of molecules of methane divided by the total number of molecules in the sample.</skos:definition>
    <dcterms:modified>2026-02-18T13:04:15.254Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="9052eb78-103a-47ab-84a4-90c0c6b1da2a">
    <skos:broader rdf:resource="7c892333-f4c4-4f81-b825-d6a86e107e9f"/>
    <skos:prefLabel xml:lang="en">METHANE EMISSION RATE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from METHANE EMISSION RATE [9052eb78-103a-47ab-84a4-90c0c6b1da2a] to METHANE [7c892333-f4c4-4f81-b825-d6a86e107e9f]</skos:changeNote>
    <gcmd:reference gcmd:text="https://energy.sustainability-directory.com/term/methane-flux-measurement/#:~:text=Meaning%20%E2%86%92%20Quantifies%20methane%20exchange%20between%20surfaces%20and%20the%20atmosphere.%20%E2%86%92%20Term." xml:lang="en"/>
    <skos:definition xml:lang="en">The bidirectional exchange rate of methane (CH4) across defined interfaces (e.g., soil-atmosphere, water-atmosphere, vegetation-atmosphere) within Earth’s systems. </skos:definition>
    <dcterms:modified>2026-02-18T13:05:24.135Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="900f9c46-3b70-4b4e-8131-503b186e2595">
    <skos:broader rdf:resource="7c892333-f4c4-4f81-b825-d6a86e107e9f"/>
    <skos:prefLabel xml:lang="en">METHANE FLUX</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from METHANE FLUX [900f9c46-3b70-4b4e-8131-503b186e2595] to METHANE [7c892333-f4c4-4f81-b825-d6a86e107e9f]</skos:changeNote>
    <gcmd:reference gcmd:text="https://energy.sustainability-directory.com/term/methane-flux-measurement/#:~:text=Meaning%20%E2%86%92%20Quantifies%20methane%20exchange%20between%20surfaces%20and%20the%20atmosphere.%20%E2%86%92%20Term." xml:lang="en"/>
    <skos:definition xml:lang="en">Fluctuations in the bidirectional exchange rate of methane (CH4) across defined interfaces (e.g., soil-atmosphere, water-atmosphere, vegetation-atmosphere) within Earth’s systems.</skos:definition>
    <dcterms:modified>2026-02-18T13:06:16.712Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="bf1b3390-3afb-45aa-acae-c6e2bed39d38">
    <skos:broader rdf:resource="6a745a5e-829c-43f5-8d5a-6fb549e7b81b"/>
    <skos:prefLabel xml:lang="en">AMMONIA EMISSION FLUX</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from AMMONIA EMISSION FLUX [bf1b3390-3afb-45aa-acae-c6e2bed39d38] to AMMONIA [6a745a5e-829c-43f5-8d5a-6fb549e7b81b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://nph.onlinelibrary.wiley.com/doi/10.1046/j.1469-8137.1998.00180.x" xml:lang="en"/>
    <skos:definition xml:lang="en">Rate of release of ammonia (NH3) into the atmosphere in space and time, and changes in import/export balances.  Major global sources are excreta from domestic animals, fertilizers, oceans, biomass burning, and crops. </skos:definition>
    <dcterms:modified>2026-02-18T13:08:32.065Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a6a07f58-0fd5-4dcf-b90c-0ca7a5889db6">
    <skos:broader rdf:resource="42eb8baf-edbd-4791-8114-ca898ce5890f"/>
    <skos:prefLabel xml:lang="en">CANOPY BASE HEIGHT</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CANOPY BASE HEIGHT [a6a07f58-0fd5-4dcf-b90c-0ca7a5889db6] to VEGETATION HEIGHT [42eb8baf-edbd-4791-8114-ca898ce5890f]</skos:changeNote>
    <gcmd:reference gcmd:text="http://www.nwcg.gov/publications/pms437/fuels/canopy-fuel-characteristics#:~:text=The%20forest%20Canopy%20Base%20Height,fire%20vertically%20into%20the%20canopy" xml:lang="en"/>
    <skos:definition xml:lang="en">The forest Canopy Base Height (CBH) describes the average height from the ground to a forest stand&apos;s canopy bottom. </skos:definition>
    <dcterms:modified>2026-02-18T13:21:44.373Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c2b9ab46-05ec-4cbf-82ef-86d6e7857f68">
    <skos:broader rdf:resource="0408bac9-c247-4b00-80de-f4665b813658"/>
    <skos:prefLabel xml:lang="en">PLANT HEALTH</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from PLANT HEALTH [c2b9ab46-05ec-4cbf-82ef-86d6e7857f68] to PLANT CHARACTERISTICS [0408bac9-c247-4b00-80de-f4665b813658]</skos:changeNote>
    <gcmd:reference gcmd:text="https://cordis.europa.eu/article/id/413320-plant-health-protecting-plants-to-safeguard-our-future#:~:text=Plant%20health%20is%20an%20overarching,economic%2C%20ecological%20and%20social%20level" xml:lang="en"/>
    <skos:definition xml:lang="en">Plant health is an overarching term for emerging risks including pests, diseases and weeds, integrated pest management and innovation in plant protection.</skos:definition>
    <dcterms:modified>2026-02-18T13:37:04.042Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="fbe6a5d3-428f-436d-8690-898ec8ed25c4">
    <skos:broader rdf:resource="bf703f22-9775-460d-86bd-149aaef1acde"/>
    <skos:prefLabel xml:lang="en">RUINS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from RUINS [fbe6a5d3-428f-436d-8690-898ec8ed25c4] to ARCHAEOLOGICAL AREAS [bf703f22-9775-460d-86bd-149aaef1acde]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/referencework/9780080430768/international-encyclopedia-of-the-social-and-behavioral-sciences" xml:lang="en"/>
    <skos:definition xml:lang="en">Any place that has been a scene of past human activity where human beings have established themselves, even momentarily.</skos:definition>
    <dcterms:modified>2026-02-18T13:56:07.731Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f228ed52-e052-46dd-8821-48cfb3c35425">
    <skos:broader rdf:resource="d4313915-2d24-424c-a171-30ee9a6f4bb5"/>
    <skos:prefLabel xml:lang="en">INDUSTRIAL AREAS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from INDUSTRIAL AREAS [f228ed52-e052-46dd-8821-48cfb3c35425] to INFRASTRUCTURE [d4313915-2d24-424c-a171-30ee9a6f4bb5]</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keywords</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.epa.gov/rmp/identification-industrial-buildings-commercial-buildings-and-recreational-areas" xml:lang="en"/>
    <skos:definition xml:lang="en">Area used for industrial activities, including manufacturing and production of goods.</skos:definition>
    <dcterms:modified>2026-02-18T13:58:11.328Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f336f12d-0fb2-4475-99c7-5210c74b3a55">
    <skos:broader rdf:resource="d4313915-2d24-424c-a171-30ee9a6f4bb5"/>
    <skos:prefLabel xml:lang="en">LANDFILLS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from LANDFILLS [f336f12d-0fb2-4475-99c7-5210c74b3a55] to INFRASTRUCTURE [d4313915-2d24-424c-a171-30ee9a6f4bb5]</skos:changeNote>
    <gcmd:reference gcmd:text="https://des.sc.gov/programs/bureau-land-waste-management/landfills  https://doi.org/10.1016/j.chemosphere.2022.136627" xml:lang="en"/>
    <skos:definition xml:lang="en">A large outdoor site specifically designed for the disposal of solid waste. </skos:definition>
    <dcterms:modified>2026-02-18T13:59:22.333Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="911e1d74-802f-4ad0-adca-fd54c490959d">
    <skos:broader rdf:resource="ce4b2c6e-3d69-4cf1-8416-c36e5f9b1b2c"/>
    <skos:prefLabel xml:lang="en">PARTICLE SIZE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from PARTICLE SIZE [911e1d74-802f-4ad0-adca-fd54c490959d] to MARINE SEDIMENTS [ce4b2c6e-3d69-4cf1-8416-c36e5f9b1b2c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.1016/j.csr.2021.104548" xml:lang="en"/>
    <skos:definition xml:lang="en">The diameter or overall dimension of individual sediment grains that make up the seafloor, such as sand, silt, or clay. </skos:definition>
    <dcterms:modified>2026-02-18T14:40:26.430Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b501a674-638e-41d5-a2e5-b630cb5a62c4">
    <skos:broader rdf:resource="b2bdeb71-81b5-43e6-a8b1-b09c215c8d1a"/>
    <skos:prefLabel xml:lang="en">DETRITUS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from DETRITUS [b501a674-638e-41d5-a2e5-b630cb5a62c4] to ORGANIC MATTER [b2bdeb71-81b5-43e6-a8b1-b09c215c8d1a]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.researchgate.net/publication/261661126_Detritus_in_the_pelagic_ocean" xml:lang="en"/>
    <skos:definition xml:lang="en">Nonliving particulate matter, a heterogeneous class of marine particles including &quot;&quot;dead&quot;&quot; phytoplankton, fecal pellets, molts, dead organisms, aggregates, and terrigenous material.</skos:definition>
    <dcterms:modified>2026-02-18T14:42:49.907Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d6ff6bad-cc6c-4185-ba9f-61220b58fb5c">
    <skos:broader rdf:resource="9d86cd70-062a-4c39-b3f3-226abebc07f7"/>
    <skos:prefLabel xml:lang="en">INLAND BATHYMETRY</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from INLAND BATHYMETRY [d6ff6bad-cc6c-4185-ba9f-61220b58fb5c] to SURFACE WATER PROCESSES/MEASUREMENTS [9d86cd70-062a-4c39-b3f3-226abebc07f7]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.usgs.gov/3d-elevation-program/inland-bathymetry  https://doi.org/10.1016/j.jhydrol.2022.128789 " xml:lang="en"/>
    <skos:definition xml:lang="en">The measurement and mapping of underwater terrain of inland water bodies such as lakes, rivers, reservoirs, and streams. Typically conducted through bathymetric surveys that record water-depth and bed topography beneath the water surface.</skos:definition>
    <dcterms:modified>2026-02-18T15:18:02.579Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="ab804ba3-7551-4ca2-83a0-6af042c870e9">
    <skos:broader rdf:resource="8c02f5d1-ce86-4bf5-84d5-b3496cdba6ad"/>
    <skos:prefLabel xml:lang="en">HARMFUL ALGAL BLOOM (HABs)</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from HARMFUL ALGAL BLOOM (HABs) [ab804ba3-7551-4ca2-83a0-6af042c870e9] to WATER QUALITY/WATER CHEMISTRY [8c02f5d1-ce86-4bf5-84d5-b3496cdba6ad]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.noaa.gov/what-is-harmful-algal-bloom https://www.cdc.gov/harmful-algal-blooms/about/index.html" xml:lang="en"/>
    <skos:definition xml:lang="en">The rapid growth of algae or cyanobacteria in the water that can harm people, animals, and the environment through toxic effects. </skos:definition>
    <dcterms:modified>2026-02-18T15:21:51.595Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="92ae093d-cd20-46c2-ba0a-7a4e90e05757">
    <skos:broader rdf:resource="25be3b9a-9d4c-4b5b-8d24-b1f519913d90"/>
    <skos:prefLabel xml:lang="en">CROP WATER PRODUCTIVITY</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CROP WATER PRODUCTIVITY [92ae093d-cd20-46c2-ba0a-7a4e90e05757] to AGRICULTURAL PLANT SCIENCE [25be3b9a-9d4c-4b5b-8d24-b1f519913d90]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.mdpi.com/2072-4292/15/19/4894" xml:lang="en"/>
    <skos:definition xml:lang="en">The ratio of crop output per unit of water input.</skos:definition>
    <dcterms:modified>2026-02-18T17:31:07.686Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b54f0b2f-139c-4e8a-85cf-762dbe5bff16">
    <skos:broader rdf:resource="06d230f1-08f8-48cc-9bbd-5f2358a84d13"/>
    <skos:prefLabel xml:lang="en">AROMATICS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from AROMATICS [b54f0b2f-139c-4e8a-85cf-762dbe5bff16] to NON-METHANE HYDROCARBONS/VOLATILE ORGANIC COMPOUNDS [06d230f1-08f8-48cc-9bbd-5f2358a84d13]</skos:changeNote>
    <gcmd:reference gcmd:text="https://books.google.com/books?hl=en&amp;lr=&amp;id=i-Xk7OTU6AIC https://www.chem.fsu.edu/chemlab/chm1046course/aromatics.html" xml:lang="en"/>
    <skos:definition xml:lang="en">Unsaturated cyclic molecules that possess additional stability as the result of the arrangement of π-electrones associated with the unsaturation of the ring system. Aromatics consist exclusively of carbon and hydrogen, and the main aromatics are benzene, toluene, and the xylenes.</skos:definition>
    <dcterms:modified>2026-02-18T17:34:53.035Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a34924f3-459b-45d4-a5d0-218cf93a379d">
    <skos:broader rdf:resource="06d230f1-08f8-48cc-9bbd-5f2358a84d13"/>
    <skos:prefLabel xml:lang="en">TOLUENE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from TOLUENE [a34924f3-459b-45d4-a5d0-218cf93a379d] to NON-METHANE HYDROCARBONS/VOLATILE ORGANIC COMPOUNDS [06d230f1-08f8-48cc-9bbd-5f2358a84d13]</skos:changeNote>
    <gcmd:reference gcmd:text="https://wwwn.cdc.gov/TSP/substances/ToxSubstance.aspx?toxid=29" xml:lang="en"/>
    <skos:definition xml:lang="en">A clear, colorless liquid with a distinctive smell. Toluluene occurs naturally in crude oil and in the tolu tree, but can also be produced in the process of making gasoline from crude oil and coke from coal.</skos:definition>
    <dcterms:modified>2026-02-18T17:37:42.367Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b98834a1-72a4-47df-968c-1f6a6efc53f4">
    <skos:broader rdf:resource="f42c849c-7113-4c69-a01e-52ebc5e7b44d"/>
    <skos:prefLabel xml:lang="en">MICROSITE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from MICROSITE [b98834a1-72a4-47df-968c-1f6a6efc53f4] to COMMUNITY STRUCTURE [f42c849c-7113-4c69-a01e-52ebc5e7b44d]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.3390/f10100864" xml:lang="en"/>
    <skos:definition xml:lang="en">Local features on the scale of centimeters to meters having the potential to alter the environment for seedling regeneration.</skos:definition>
    <dcterms:modified>2026-02-18T17:49:18.813Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="9860c05d-a35f-4c98-934c-eecdaa503bc3">
    <skos:broader rdf:resource="abbba948-9b77-4e19-a855-49a7fbc17696"/>
    <skos:prefLabel xml:lang="en">CANOPY CARBON FLUX</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CANOPY CARBON FLUX [9860c05d-a35f-4c98-934c-eecdaa503bc3] to CANOPY CHARACTERISTICS [abbba948-9b77-4e19-a855-49a7fbc17696]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.earthdata.nasa.gov/topics/climate-indicators/carbon-flux" xml:lang="en"/>
    <skos:definition xml:lang="en">The direction and rate at which carbon is exchanged between the plant canopy and other carbon pools such as the ocean, atmosphere, and other living things.</skos:definition>
    <dcterms:modified>2026-02-18T18:46:21.500Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e5eb6054-968d-4c43-a673-63cbef262d22">
    <skos:broader rdf:resource="abbba948-9b77-4e19-a855-49a7fbc17696"/>
    <skos:prefLabel xml:lang="en">CANOPY DENSITY</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CANOPY DENSITY [e5eb6054-968d-4c43-a673-63cbef262d22] to CANOPY CHARACTERISTICS [abbba948-9b77-4e19-a855-49a7fbc17696]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.isprs.org/proceedings/xxxvii/congress/8_pdf/11_wg-viii-11/21.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">The proportion of the forest floor covered by the vertical projection of the tree crowns, ranging from 0% (no cover) to 100% (complete overlap). Canopy density is a key forest health indicator used for biomass measurement and forest management.</skos:definition>
    <dcterms:modified>2026-02-18T18:47:21.095Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a55476d9-0a33-435d-8c25-be3ed57b8f10">
    <skos:broader rdf:resource="abbba948-9b77-4e19-a855-49a7fbc17696"/>
    <skos:prefLabel xml:lang="en">CANOPY STRUCTURE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CANOPY STRUCTURE [a55476d9-0a33-435d-8c25-be3ed57b8f10] to CANOPY CHARACTERISTICS [abbba948-9b77-4e19-a855-49a7fbc17696]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.3390/rs9100994" xml:lang="en"/>
    <skos:definition xml:lang="en">The spatial distribution and orientation of vegetation components within a canopy.</skos:definition>
    <dcterms:modified>2026-02-18T18:58:55.327Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="9c90d402-6cc2-416d-815d-abfc2ef02a97">
    <skos:broader rdf:resource="abbba948-9b77-4e19-a855-49a7fbc17696"/>
    <skos:prefLabel xml:lang="en">CANOPY WATER FLUX</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CANOPY WATER FLUX [9c90d402-6cc2-416d-815d-abfc2ef02a97] to CANOPY CHARACTERISTICS [abbba948-9b77-4e19-a855-49a7fbc17696]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.1016/j.agrformet.2014.12.007" xml:lang="en"/>
    <skos:definition xml:lang="en">The transfer of water across the canopy-soil interface, including precipitation intercepted by tree crowns and evaporated back to the atmosphere (i.e., interception loss), transferred to the ground by falling through canopy gaps or by leaf drop-off (throughfall), or by stemflow.</skos:definition>
    <dcterms:modified>2026-02-18T19:00:20.626Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b77fab47-ee9d-451e-8499-f2c5b325d6bb">
    <skos:broader rdf:resource="37a6c8e2-f2ac-48a4-a4fa-d80f700f68db"/>
    <skos:prefLabel xml:lang="en">RAILROADS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from RAILROADS [b77fab47-ee9d-451e-8499-f2c5b325d6bb] to TRANSPORTATION [37a6c8e2-f2ac-48a4-a4fa-d80f700f68db]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.merriam-webster.com/dictionary/railroad https://www.britannica.com/technology/railroad" xml:lang="en"/>
    <skos:definition xml:lang="en">A road designed for flange-wheeled vehicles and that typically consists of parallel steel rails fixed to ties and laid on a roadbed.</skos:definition>
    <dcterms:modified>2026-02-18T19:23:57.727Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="9a471aa1-09d9-44e4-a0e4-f8ffdeccb056">
    <skos:broader rdf:resource="d4313915-2d24-424c-a171-30ee9a6f4bb5"/>
    <skos:prefLabel xml:lang="en">UTILITY CORRIDORS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from UTILITY CORRIDORS [9a471aa1-09d9-44e4-a0e4-f8ffdeccb056] to INFRASTRUCTURE [d4313915-2d24-424c-a171-30ee9a6f4bb5]</skos:changeNote>
    <gcmd:reference gcmd:text="https://mccmeetingspublic.blob.core.usgovcloudapi.net/sanjuancut-meet-da5045ec817d4d398a882411022bd6e2/ITEM-Attachment-001-2beb66123eb14146830bae2b7015dd7f.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">Linear tracts of land set aside for the placement of above and below-ground infrastructure that transports and conveys raw materials, processed materials, and energy.</skos:definition>
    <dcterms:modified>2026-02-18T19:25:30.858Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b361211f-8114-4ecb-a261-53011f803e9e">
    <skos:broader rdf:resource="9673dc0b-89c0-4f0c-b378-f1c8cb267c8f"/>
    <skos:prefLabel xml:lang="en">CRATER</skos:prefLabel>
    <skos:changeNote>Date=2026-02-19 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-19 User Id=system System Note=Added broader relation from CRATER [b361211f-8114-4ecb-a261-53011f803e9e] to TECTONIC LANDFORMS [9673dc0b-89c0-4f0c-b378-f1c8cb267c8f]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.oxfordreference.com/display/10.1093/oi/authority.20110803095646112" xml:lang="en"/>
    <skos:definition xml:lang="en">A circular depression around the vent of a volcano. Craters occur where lava overflows and hardens or where the walls collapse as the magma sinks down the vent after an eruption.</skos:definition>
    <dcterms:modified>2026-02-19T13:50:29.461Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f10b89fe-e462-4989-ab48-a8c43903a51f">
    <skos:broader rdf:resource="ff13560a-161c-4ac9-b79c-4910936cf465"/>
    <skos:prefLabel xml:lang="en">MACROPLASTIC CONCENTRATION</skos:prefLabel>
    <skos:changeNote>Date=2026-02-19 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-19 User Id=system System Note=Added broader relation from MACROPLASTIC CONCENTRATION [f10b89fe-e462-4989-ab48-a8c43903a51f] to SEA SURFACE CONTAMINANTS [ff13560a-161c-4ac9-b79c-4910936cf465]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.researchgate.net/publication/342855785_Macroplastic_Storage_and_Remobilization_in_Rivers#pf8" xml:lang="en"/>
    <skos:definition xml:lang="en">Refers to the concentration of macroplastics (&gt;5 mm) in the ocean.</skos:definition>
    <dcterms:modified>2026-02-19T13:55:03.002Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="99365d2a-0db3-4073-b8eb-6df6f0e4feb1">
    <skos:broader rdf:resource="0db0e1c8-6ba3-40c4-97c2-d78c9812692b"/>
    <skos:prefLabel xml:lang="en">BALLISTIC PROJECTILES</skos:prefLabel>
    <skos:changeNote>Date=2026-02-19 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-19 User Id=system System Note=Added broader relation from BALLISTIC PROJECTILES [99365d2a-0db3-4073-b8eb-6df6f0e4feb1] to ERUPTION DYNAMICS [0db0e1c8-6ba3-40c4-97c2-d78c9812692b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://volcano.si.edu/gallery/ImageCollection.cfm?gallery=HazProcBallistics#:~:text=Ballistic%20projectiles%20are%20fragments%20of,phreatic%20(steam)%20explosive%20eruptions" xml:lang="en"/>
    <skos:definition xml:lang="en">Ballistic projectiles are fragments of solid (blocks) or fluid (bombs) material ejected during the range of magmatic or phreatic (steam) explosive eruptions.</skos:definition>
    <dcterms:modified>2026-02-19T13:56:54.968Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c8ebd7b8-03bd-4562-976a-b0bd9673fc0a">
    <skos:broader rdf:resource="0db0e1c8-6ba3-40c4-97c2-d78c9812692b"/>
    <skos:prefLabel xml:lang="en">LAHARS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-19 User Id=system System Note=Added broader relation from LAHARS [c8ebd7b8-03bd-4562-976a-b0bd9673fc0a] to ERUPTION DYNAMICS [0db0e1c8-6ba3-40c4-97c2-d78c9812692b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.usgs.gov/observatories/cvo/science/lahars-most-threatening-volcanic-hazard-cascades#overview" xml:lang="en"/>
    <skos:definition xml:lang="en">Lahars, along with debris flows and debris avalanches, are masses of rock, mud and water that travel rapidly downslope and downstream under the action of gravity. </skos:definition>
    <dcterms:modified>2026-02-19T14:11:16.702Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="90521614-8b92-4053-9fa7-959ccc4315e0">
    <skos:broader rdf:resource="0db0e1c8-6ba3-40c4-97c2-d78c9812692b"/>
    <skos:prefLabel xml:lang="en">VOLCANIC CLOUDS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-19 User Id=system System Note=Added broader relation from VOLCANIC CLOUDS [90521614-8b92-4053-9fa7-959ccc4315e0] to ERUPTION DYNAMICS [0db0e1c8-6ba3-40c4-97c2-d78c9812692b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://eos.org/editors-vox/inside-volcanic-clouds-where-tephra-goes-and-why-it-matters" xml:lang="en"/>
    <skos:definition xml:lang="en">During explosive eruptions, tephra particles are injected into the atmosphere; smaller particles, mainly ash (less than 2 mm in diameter), remain suspended, forming volcanic clouds. </skos:definition>
    <dcterms:modified>2026-02-19T14:17:57.214Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="8cea15de-b376-433f-9306-95e3169a0141">
    <skos:broader rdf:resource="83150c54-5da8-4ee8-9579-19b95a8dc10c"/>
    <skos:prefLabel xml:lang="en">MULTISPECTRAL IMAGERY</skos:prefLabel>
    <skos:changeNote>Date=2026-02-19 User Id=system System Note=Added broader relation from MULTISPECTRAL IMAGERY [8cea15de-b376-433f-9306-95e3169a0141] to SPECTRAL/ENGINEERING [83150c54-5da8-4ee8-9579-19b95a8dc10c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/topics/earth-and-planetary-sciences/multispectral-image https://innoter.com/en/articles/multispectral-imaging/" xml:lang="en"/>
    <skos:definition xml:lang="en">Imagery composed of multiple layers of the same scene, where each layer is acquired at a particular wavelength band in the electromagnetic spectrum, showing how the objects in the scene interact with that portion of the spectrum.</skos:definition>
    <dcterms:modified>2026-02-19T14:23:01.521Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a05e2b76-0d60-44f2-8fda-9ced8e21d60b">
    <skos:broader rdf:resource="4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
    <skos:prefLabel xml:lang="en">ELECTROMAGNETIC SPECTRUM (EMS)</skos:prefLabel>
    <skos:changeNote>Date=2026-04-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-04-07 User Id=system System Note=Added broader relation from ELECTROMAGNETIC SPECTRUM (EMS) [a05e2b76-0d60-44f2-8fda-9ced8e21d60b] to ATMOSPHERIC RADIATION [4ad0c52d-6449-48ff-8678-adc6b2cebcb7]</skos:changeNote>
    <gcmd:reference gcmd:text="https://science.nasa.gov/ems/" xml:lang="en"/>
    <skos:definition xml:lang="en">Entire range of electromagnetic radiation ranging from gamma rays, less than 0.03 nanometers, to radio waves, greater than or equal to 30 centimeters.</skos:definition>
    <dcterms:modified>2026-04-07T13:49:25.587Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d6992c16-224b-4107-9f05-35d1257e40fb">
    <skos:broader rdf:resource="2e5a401b-1507-4f57-82b8-36557c13b154"/>
    <skos:prefLabel xml:lang="en">MIE SCATTERING</skos:prefLabel>
    <skos:changeNote>Date=2026-04-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-04-07 User Id=system System Note=Added broader relation from MIE SCATTERING [d6992c16-224b-4107-9f05-35d1257e40fb] to AEROSOLS [2e5a401b-1507-4f57-82b8-36557c13b154]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/topics/engineering/mie-scattering-theory" xml:lang="en"/>
    <skos:definition xml:lang="en">Atmospheric scattering caused by large particles such as dust, pollen, smoke, and water droplets; more prevalent in the lower atmosphere, from 0 to 5 km.</skos:definition>
    <dcterms:modified>2026-04-07T14:06:13.410Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="cc8c80ae-0c01-4185-9255-b8dc77d18279">
    <skos:broader rdf:resource="ec9e0b6a-1315-4569-93bc-0f1190bb8c08"/>
    <skos:prefLabel xml:lang="en">RAYLEIGH SCATTERING</skos:prefLabel>
    <skos:changeNote>Date=2026-04-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-04-07 User Id=system System Note=Added broader relation from RAYLEIGH SCATTERING [cc8c80ae-0c01-4185-9255-b8dc77d18279] to SCATTERING [ec9e0b6a-1315-4569-93bc-0f1190bb8c08]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.britannica.com/science/Rayleigh-scattering" xml:lang="en"/>
    <skos:definition xml:lang="en">A dominant form of light scattering in the upper atmosphere, which produces the blue color of the sky. It is caused by atmospheric particulates that have very small diameters relative to the wavelength of the light, such as dust particles or atmospheric gases like nitrogen and oxygen.</skos:definition>
    <dcterms:modified>2026-04-07T14:20:06.523Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d0dff81f-80a5-40c0-b422-15df9cd03ccf">
    <skos:broader rdf:resource="f795b88f-1aba-4548-97f6-7b587e8ba451"/>
    <skos:prefLabel xml:lang="en">AEROSOL BACKSCATTERING RATIO</skos:prefLabel>
    <skos:changeNote>Date=2026-04-21 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-04-21 User Id=system System Note=Added broader relation from AEROSOL BACKSCATTERING RATIO [d0dff81f-80a5-40c0-b422-15df9cd03ccf] to AEROSOL BACKSCATTER [f795b88f-1aba-4548-97f6-7b587e8ba451]</skos:changeNote>
    <gcmd:reference gcmd:text="https://airbornescience.nasa.gov/category/meas/Aerosol_Backscattering" xml:lang="en"/>
    <skos:definition xml:lang="en">A measure of the scattering in the backward direction ( i.e. towards the incident direction, at an scattering angle of 180 deg., sometimes also meant for scattering at an angle larger than 90 deg. ) for the light encountering the atmospheric aerosol particles.</skos:definition>
    <dcterms:modified>2026-04-21T12:56:52.515Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="ab8f3b94-c988-4b3e-ada5-e30b7bba51fa">
    <skos:broader rdf:resource="e1f20631-b5b9-438c-b5c2-b1fa0fce100a"/>
    <skos:prefLabel xml:lang="en">DYNAMICAL DOWNSCALING MODELS</skos:prefLabel>
    <skos:changeNote>Date=2026-08-05 User Id=tstevens User Note=added new service keywords</skos:changeNote>
    <skos:changeNote>Date=2026-08-05 User Id=system System Note=Added broader relation from DYNAMICAL DOWNSCALING MODELS [ab8f3b94-c988-4b3e-ada5-e30b7bba51fa] to MODELS [e1f20631-b5b9-438c-b5c2-b1fa0fce100a]</skos:changeNote>
    <gcmd:reference gcmd:text="IPCC, 2021: Annex VII: Glossary " xml:lang="en"/>
    <skos:definition xml:lang="en">Models and methods that increase the spatial resolution of global climate model output over a region by using a higher-resolution, physically-based limited-area model / RCM driven by the global model&apos;s boundary conditions. Dynamical downscaling produces physically consistent fine-scale fields by explicitly simulating regional processes.</skos:definition>
    <dcterms:modified>2026-08-05T18:22:34.453Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b17c679a-232e-44ee-bf8c-74bc2e932012">
    <skos:broader rdf:resource="31ab3c10-1f10-4372-82d4-4c0c4be5999f"/>
    <skos:prefLabel xml:lang="en">BIAS ADJUSTMENT</skos:prefLabel>
    <skos:changeNote>Date=2026-09-01 User Id=tstevens User Note=added new service keyword</skos:changeNote>
    <skos:changeNote>Date=2026-09-01 User Id=system System Note=Added broader relation from BIAS ADJUSTMENT [b17c679a-232e-44ee-bf8c-74bc2e932012] to TRANSFORMATION/CONVERSION [31ab3c10-1f10-4372-82d4-4c0c4be5999f]</skos:changeNote>
    <gcmd:reference gcmd:text="IPCC, 2021: Annex VII: Glossary" xml:lang="en"/>
    <skos:definition xml:lang="en">The statistical adjustment of climate model output so that its distribution matches that of a reference observational dataset over a common period, in order to remove systematic model errors (biases).</skos:definition>
    <dcterms:modified>2026-09-01T16:00:52.159Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <gcmd:altLabel gcmd:text="Bias Correction" xml:lang="en" gcmd:category="alternate"/>
  </skos:Concept>
  <skos:Concept rdf:about="a0a32058-ccbf-4efa-865e-88df81a75041">
    <skos:broader rdf:resource="31ab3c10-1f10-4372-82d4-4c0c4be5999f"/>
    <skos:prefLabel xml:lang="en">DERIVED QUANTITIES</skos:prefLabel>
    <skos:changeNote>Date=2026-09-01 User Id=tstevens User Note=added new service keyword</skos:changeNote>
    <skos:changeNote>Date=2026-09-01 User Id=system System Note=Added broader relation from DERIVED QUANTITIES [a0a32058-ccbf-4efa-865e-88df81a75041] to TRANSFORMATION/CONVERSION [31ab3c10-1f10-4372-82d4-4c0c4be5999f]</skos:changeNote>
    <gcmd:reference gcmd:text="IPCC, 2021: Annex VII: Glossary" xml:lang="en"/>
    <skos:definition xml:lang="en">Quantities computed from one or more measured or modeled variables to produce new geophysical information, such as indices or diagnostics, that is not directly present in the source data.</skos:definition>
    <dcterms:modified>2026-09-01T16:05:42.192Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="93ae54c2-c2b2-4d14-b288-493c674a7b54">
    <skos:broader rdf:resource="0cfcbaa7-727b-4199-8cca-93824b427e9b"/>
    <skos:prefLabel xml:lang="en">CLOUD DROPLET EFFECTIVE VARIANCE</skos:prefLabel>
    <skos:changeNote>Date=2026-09-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-09-18 User Id=system System Note=Added broader relation from CLOUD DROPLET EFFECTIVE VARIANCE [93ae54c2-c2b2-4d14-b288-493c674a7b54] to CLOUD MICROPHYSICS [0cfcbaa7-727b-4199-8cca-93824b427e9b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://amt.copernicus.org/articles/16/645/2023/" xml:lang="en"/>
    <skos:definition xml:lang="en">The cloud droplet size distribution is often described by a gamma distribution defined by the effective radius and the effective variance. The effective radius is directly related to the cloud&apos;s optical thickness, which influences the radiative properties of a cloud. The effective variance affects, among other things, the evolution of precipitation. Both parameters can be retrieved from measurements of the cloudbow. The cloudbow (or rainbow) is an optical phenomenon that forms due to the single scattering of radiation by liquid cloud droplets at the cloud edge. The polarized radiance of the cloudbow crucially depends on the cloud droplet size distribution. The effective radius and the effective variance can be retrieved by fitting model simulations (stored in a lookup table) to polarized cloudbow observations.

This study uses measurements from the wide-field polarization-sensitive camera of the spectrometer of the Munich Aerosol Cloud Scanner (specMACS) aboard the German “High Altitude and LOng range research aircraft” (HALO). Along with precise cloud geometry data derived by a stereographic method, a geolocalization of the observed clouds is possible. Observations of the same cloud from consecutive images are combined into one radiance measurement from multiple angles. Two case studies of trade-wind cumulus clouds measured during the EUREC4A (ElUcidating the RolE of Cloud-Circulation Coupling in ClimAte) field campaign are presented, and the cloudbow technique is demonstrated. The results are combined into maps of the effective radius and the effective variance with a 100 m × 100 m spatial resolution and large coverage (across-track swath width of 8 km). The first case study shows a stratiform cloud deck with distinct patches of large effective radii up to 40 µm and a median effective variance of 0.11. specMACS measures at a very high angular resolution (binned to 0.3∘) which is necessary when large droplets are present. The second case study consists of small cumulus clouds (diameters of approximately 2 km). The retrieved effective radius is 7.0 µm, and the effective variance is 0.08 (both median values). This study demonstrates that specMACS is able to determine the droplet size distribution of liquid water clouds even for small cumulus clouds, which are a problem for traditional droplet size retrievals based on total reflectances.</skos:definition>
    <dcterms:modified>2026-09-18T16:14:50.307Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="ef1647a2-0b05-49a1-b49a-923a4ea3c287">
    <skos:broader rdf:resource="83150c54-5da8-4ee8-9579-19b95a8dc10c"/>
    <skos:prefLabel xml:lang="en">POLARIMETRY</skos:prefLabel>
    <skos:changeNote>Date=2026-09-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-09-18 User Id=system System Note=Added broader relation from POLARIMETRY [ef1647a2-0b05-49a1-b49a-923a4ea3c287] to SPECTRAL/ENGINEERING [83150c54-5da8-4ee8-9579-19b95a8dc10c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://science.nasa.gov/mission/nisar/polarimetry/" xml:lang="en"/>
    <skos:definition xml:lang="en">Polarization refers to the direction of travel of an electromagnetic wave vector’s tip: vertical (up and down), horizontal (left to right), or circular (rotating in a constant plane left or right). The direction of polarization is defined by the orientation of the wave’s electric field, which is always 90°, or perpendicular, to its magnetic field.</skos:definition>
    <dcterms:modified>2026-09-18T16:23:50.646Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="aeda1c37-8b01-42b8-8c6b-1806d0d95708">
    <skos:broader rdf:resource="cb5cc628-a1b5-459e-934f-881153a937b8"/>
    <skos:prefLabel xml:lang="en">BI-DIRECTIONAL SURFACE REFLECTANCE</skos:prefLabel>
    <skos:changeNote>Date=2026-09-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-09-18 User Id=system System Note=Added broader relation from BI-DIRECTIONAL SURFACE REFLECTANCE [aeda1c37-8b01-42b8-8c6b-1806d0d95708] to SURFACE RADIATIVE PROPERTIES [cb5cc628-a1b5-459e-934f-881153a937b8]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.tarmacview.com/glossary/bidirectional-reflectance/" xml:lang="en"/>
    <skos:definition xml:lang="en">Bidirectional reflectance is a foundational concept in optics and photometry, describing how a surface reflects light in different directions depending on both how it is illuminated and from which direction it is observed. Unlike simple reflectance or albedo, which average over all directions, bidirectional reflectance rigorously accounts for the geometry of both the source and the observer. This concept is crucial in fields as diverse as remote sensing, material science, and computer graphics. The key mathematical tool for describing this angular dependence is the Bidirectional Reflectance Distribution Function (BRDF), which provides an exact relationship between the incident and reflected radiance as a function of their respective angles and wavelength.

By capturing the effects of surface microstructure, material properties, and geometry, BRDF forms the backbone for analyzing and simulating the appearance of real-world materials. In remote sensing, accurate knowledge of bidirectional reflectance is critical for radiometric calibration and for extracting reliable information about our environment from satellite imagery. In computer graphics, BRDFs enable photorealistic rendering by simulating how light interacts with virtual materials under any lighting condition. In material science and optics, BRDF measurements support the design and evaluation of advanced coatings, paints, and optical surfaces.

Understanding bidirectional reflectance is therefore essential for any application that relies on the appearance, characterization, or radiometric measurement of surfaces.</skos:definition>
    <dcterms:modified>2026-09-18T16:33:23.054Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
</rdf:RDF>
