    <gcmd:reference gcmd:text="CCRS Remote Sensing Glossary &apos;http://www.ccrs.nrcan.gc.ca/ccrs/eduref/ref/glosndxe.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">A reproduction of an object by imaging the microwave radiation coming from
the object or reflected by the object.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="dbf0db20-7d18-4a67-9227-ea479fcf7c7d">
    <skos:broader rdf:resource="68eed887-8008-4352-b420-949457ab59ab"/>
