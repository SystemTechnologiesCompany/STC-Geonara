    <skos:prefLabel xml:lang="en">WATER STORAGE</skos:prefLabel>
    <skos:changeNote>Date=2020-05-07 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=WATER STORAGE [bdfa3404-c00d-45fe-a3c1-31389a831ffc,560029] - WATER MANAGEMENT [14555831-70ae-4650-8983-956d65595575,85065]</skos:changeNote>
    <skos:changeNote>Date=2020-05-08 User Id=tstevens Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=WATER STORAGE [bdfa3404-c00d-45fe-a3c1-31389a831ffc,560029] - ICE STUPA [73a50bfa-6a0a-4a36-ace4-2c424db05ab8,560069]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/sdfe/pdf/download/eid/3-s2.0-B9780123859549000216/first-page-pdf" xml:lang="en"/>
    <skos:narrower rdf:resource="73a50bfa-6a0a-4a36-ace4-2c424db05ab8"/>
    <skos:definition xml:lang="en">Monitoring water storage and its variations is impor-tant to understanding local hydrological processesand the global water cycle, which sustains all life onEarth. The development of satellite remote-sensingtechniques has benefited the retrieval of terrestrialwater storage and its variations, which has emerged asa new discipline. Focusing on terrestrial water storage,this  chapter  describes  three  major  retrievalapproaches: the water-balance-based approach, thesurface-parameter-based approach, and the GravityRecovery and Climate Experiment (GRACE)-basedapproach. Accurate estimates of terrestrial waterstorage and its variations are still being developed.</skos:definition>
    <dcterms:modified>2020-05-08 08:39:19.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
