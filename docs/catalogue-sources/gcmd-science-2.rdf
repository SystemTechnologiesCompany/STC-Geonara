    <gcmd:reference gcmd:text="Houghton, J. 1997. Global Warming: The Complete Briefing, 2nd. ed. Cambridge University Press, Cambridge, UK. Maunder, W.J. 1994. Dictionary of Global Climate Change, 2nd ed. Chapman and Hall, NY." xml:lang="en"/>
    <skos:narrower rdf:resource="03ddc432-906d-4469-bb00-179c828dbea4"/>
    <skos:narrower rdf:resource="194d8a3c-9cdd-45f3-8b4c-ce7830d9df46"/>
    <skos:narrower rdf:resource="a65cfcfa-1028-4cc8-a4d5-9e78f487a612"/>
    <skos:definition xml:lang="en">One of the major greenhouse gases. Atmospheric carbon dioxide is caused mainly by the burning of fossil fuels and deforestation. The chemical formula for carbon dioxide is CO2. Long-term measurements of CO2 in the atmosphere are conducted at Manua Loa, Hawaii and several international monitoring stations around the world.</skos:definition>
    <dcterms:modified>2021-02-26 08:41:33.0</dcterms:modified>
