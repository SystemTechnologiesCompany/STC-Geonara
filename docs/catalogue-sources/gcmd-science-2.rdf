  <skos:Concept rdf:about="f2f37978-d942-43d2-9c51-79e9f5bdfe24">
    <skos:broader rdf:resource="b8018326-a186-4847-961d-8bd0727bbd5e"/>
    <skos:prefLabel xml:lang="en">AGRICULTURAL EQUIPMENT</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Herren, R.V., and R.L. Donahue.  1991.  The Agriculture Dictionary, Delmar Publishers INC.  Albany, New york.  553pp." xml:lang="en"/>
    <skos:definition xml:lang="en">Any tool, including vehicles, used in agriculture which aids a person tomake work and effort more productive and effective.</skos:definition>
