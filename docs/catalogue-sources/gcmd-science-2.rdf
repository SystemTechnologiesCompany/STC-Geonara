    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added narrower relation from SURFACE WATER PROCESSES/MEASUREMENTS [9d86cd70-062a-4c39-b3f3-226abebc07f7] to WATER SURFACE HEIGHT [41795836-95f8-465f-9d26-9588059d0724]</skos:changeNote>
    <gcmd:reference gcmd:text="https://en.wikipedia.org/wiki/Surface-water_hydrology" xml:lang="en"/>
