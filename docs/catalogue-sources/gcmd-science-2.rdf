  <skos:Concept rdf:about="8f6adff6-672d-4066-8c85-25418a7d0e00">
    <skos:broader rdf:resource="bdc0bd86-a3a3-48fa-b1fb-4ca5d13d4dde"/>
    <dcterms:created>2013-08-05</dcterms:created>
    <skos:prefLabel xml:lang="en">SWAMP</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=UPDATE Field=text 
User Note=Definition updated
System Note=update Definition
Old Value=An area of land that is always soaked with water; low, wet land that supports grass and trees.
New Value=An area of land that is always soaked with water; low, wet land that supports grass and trees. Swamps are wet areas that are normally covered by water all year and subject to drying out during the summer.  The parameter Swamp may be colloquially interchanged with the parameter Marshes.</skos:changeNote>
    <skos:changeNote>Date=2013-08-05 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SWAMP [8f6adff6-672d-4066-8c85-25418a7d0e00,105341] - FLUVIAL LANDFORMS [bdc0bd86-a3a3-48fa-b1fb-4ca5d13d4dde,105281]</skos:changeNote>
    <skos:changeNote>Date=2013-08-15 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: An area of land that is always soaked with water; low, wet land that supports grass and trees.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">An area of land that is always soaked with water; low, wet land that supports grass and trees. Swamps are wet areas that are normally covered by water all year and subject to drying out during the summer.  The parameter Swamp may be colloquially interchanged with the parameter Marshes.</skos:definition>
    <dcterms:modified>2017-03-15 11:53:28.0</dcterms:modified>
