  <skos:Concept rdf:about="bcb43cdf-294e-463c-a114-a55bd54f0b48">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">GRAZING DYNAMICS/PLANT HERBIVORY</skos:prefLabel>
    <gcmd:reference gcmd:text="Krebs, Charles K. Ecology - 4th ed. 1994.  HarperCollins College Publishers, New York, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">Herbivory is an ecological interaction between two species where onespecies eats part or all of a plant species.</skos:definition>
