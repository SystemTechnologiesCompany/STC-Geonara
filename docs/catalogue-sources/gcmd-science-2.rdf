  <skos:Concept rdf:about="c6b2279c-804f-42bf-aa8a-0c81f9ecf6cd">
    <skos:broader rdf:resource="19ab681c-bdd7-4793-bbdb-1ec498575314"/>
    <skos:prefLabel xml:lang="en">HYPOCHLOROUS MONOXIDE</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=sritz Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: &quot;
Hypochlorous acid is also a minor component of the gas-phase inorganic chlorine budget in the stratosphere. It is formed there largely from reaction of hydroperoxyl radicals (HO2) with chlorine monoxide (ClO) radicals, and from the hydrolysis of chlorine nitrate on stratospheric aerosols. It is subject to quite rapid photolysis in the sunlit atmosphere.&quot;
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society, 2017." xml:lang="en"/>
    <skos:definition xml:lang="en">&apos;Hypochlorous acid is also a minor component of the gas-phase inorganic chlorine budget in the stratosphere. It is formed there largely from reaction of hydroperoxyl radicals (HO2) with chlorine monoxide (ClO) radicals, and from the hydrolysis of chlorine nitrate on stratospheric aerosols. It is subject to quite rapid photolysis in the sunlit atmosphere.&apos;</skos:definition>
    <dcterms:modified>2017-03-15 17:21:47.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
