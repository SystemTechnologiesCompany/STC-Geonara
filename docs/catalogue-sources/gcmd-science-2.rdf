  <skos:Concept rdf:about="ddbd1be1-2a1b-4aea-a085-6a63208a75c0">
    <skos:broader rdf:resource="dba19648-3f52-48ba-b00b-8527d44c4d74"/>
    <skos:prefLabel xml:lang="en">NITROUS OXIDE</skos:prefLabel>
    <gcmd:reference gcmd:text="Ice Cores and Climate Change: http://www.emporia.edu/earthsci/student/sedlacek3/icecore.htm and Fluckinger, J., D¿llenbach, A., Blunier, T., Stauffer, B., Stocker, T.F., Raynaud, D., and Barnola, J.-M. 1999. Variations in Atmospheric N2O Concentration During Abrupt Climate Changes. Science 285: 227-230." xml:lang="en"/>
    <skos:definition xml:lang="en">Nitrous oxide (N2O) is a greenhouse gas produced from ocean upwelling and soilsin tropical and temperate regions. Ice core studies have shown that nitrousoxide increases with temperature in the Northern Hemisphere.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
