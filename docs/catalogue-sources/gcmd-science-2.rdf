  <skos:Concept rdf:about="e49f0aae-c2ef-4fd2-aaf4-ddfad074bb75">
    <skos:broader rdf:resource="e1f20631-b5b9-438c-b5c2-b1fa0fce100a"/>
    <skos:prefLabel xml:lang="en">REGULATORY MODELS</skos:prefLabel>
    <gcmd:reference gcmd:text="US EPA" xml:lang="en"/>
    <skos:definition xml:lang="en">Models that provide predictions and analysis of environmental factors such asair quality and water quality; also included are dispersion modeling. Thesemodels are generally associated with the U.S. EPA to support policy andregulatory decisions.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e5f94c93-e8af-4919-827f-9059dab9cf27">
    <skos:broader rdf:resource="e1f20631-b5b9-438c-b5c2-b1fa0fce100a"/>
    <skos:prefLabel xml:lang="en">DIGITAL ELEVATION/DIGITAL TERRAIN MODELS</skos:prefLabel>
    <gcmd:reference gcmd:text="Dictionary of GIS Terminology" xml:lang="en"/>
    <skos:definition xml:lang="en">Models that represent continuous elevation values over a topographic surface bya regular array of z-values, referenced to a common datum. Digital ElevationModels (DEM) and Digital Terrain Models (DTM) are used to predict thetopography and terrain over a given land surface.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="dfed775e-934a-4606-b673-e55fd74fded8">
    <skos:broader rdf:resource="fe4392b0-13a9-43ff-bacc-f44a65aed4fa"/>
    <dcterms:created>2022-07-25</dcterms:created>
    <skos:prefLabel xml:lang="en">UNSUPERVISED</skos:prefLabel>
    <skos:changeNote>Date=2022-07-27 User Id=tstevens Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
New Value=Encyclopedia of Machine Learning and Data Science: https://doi.org/10.1007/978-1-4899-7502-7</skos:changeNote>
