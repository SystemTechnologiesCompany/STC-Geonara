    <gcmd:reference gcmd:text="https://www.earthdata.nasa.gov/data/space-geodesy-techniques" xml:lang="en"/>
    <skos:narrower rdf:resource="06382d35-5885-4d34-a586-8b44868250a8"/>
    <skos:narrower rdf:resource="22f57987-7a8d-46d8-9b3d-37761755f8b2"/>
    <skos:narrower rdf:resource="846a5d37-085b-4ae0-9d4d-23b88b6fc304"/>
    <skos:narrower rdf:resource="93b2fed5-883f-4d82-9d62-19654d0765ea"/>
    <skos:narrower rdf:resource="de965e45-2275-44d6-9193-9387881b538c"/>
    <skos:definition xml:lang="en">Geodesy is the science of the Earth’s shape, gravity, and rotation, including their evolution in time. Several techniques are used to observe the geodetic properties of the Earth, including Global Navigation Satellite Systems (GNSS), Satellite Laser Ranging (SLR), Very Long Baseline Interferometry (VLBI), and the Doppler Orbitography and Radio-Positioning by Integrated Satellite (DORIS) system. These space-geodetic observations also provide the basis for the reference frame that is needed in order to assign coordinates to points and objects and thereby determine how those points and objects move over time.</skos:definition>
