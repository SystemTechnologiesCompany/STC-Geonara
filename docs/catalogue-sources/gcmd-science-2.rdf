    <skos:prefLabel xml:lang="en">SULFUR OXIDES</skos:prefLabel>
    <gcmd:reference gcmd:text="Porteous, A. 1996. Dictionary of Environmental Science and Technology, 2nd ed. John Wiley and Sons, NY." xml:lang="en"/>
    <skos:definition xml:lang="en">Sulfur oxides (SOx) can occur naturally from such sources as volcanoes,sulfur springs and decaying organic matter, or from anthropogenic sourcessuch as fossil fuel combustion, brickworks, and spontaneous combustion incoal mine spoil heaps. Sulfur oxides in the atmosphere are usually removedby acid rain.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="bffac466-83aa-4060-a378-6d2d6e49f2a1">
