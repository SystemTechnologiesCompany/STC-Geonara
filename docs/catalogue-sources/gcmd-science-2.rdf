  <skos:Concept rdf:about="b54e01eb-02d9-413a-baf1-40a6e59d9eae">
    <skos:broader rdf:resource="486f2c33-2401-4292-9d74-8756ee95211f"/>
    <skos:prefLabel xml:lang="en">PALEOSOLS</skos:prefLabel>
    <gcmd:reference gcmd:text="Jackson, J.A., ed. 1997. Glossary of Geology, 4th edition. American Geological Institute" xml:lang="en"/>
    <skos:definition xml:lang="en">Paleosols are soils that formed in a landscape of the past with distinctivemorphological features resulting from a soil-forming environment that no longerexists at the site.</skos:definition>
