  <skos:Concept rdf:about="b3063d3a-af53-44f9-a532-4cea2880c198">
    <skos:broader rdf:resource="199e3af8-4cf3-48ba-8b28-b9b54756b3db"/>
    <skos:prefLabel xml:lang="en">MICROFLORA</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from Allaby, Michael. 1998. A Dictionary of Plant Sciences, New York: Oxford University Press." xml:lang="en"/>
    <skos:definition xml:lang="en">Microflora (or simply microbiota) refers to the smallest soil organisms,including fungi and algae.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c9f1a861-2173-4124-962c-759f71b6f131">
