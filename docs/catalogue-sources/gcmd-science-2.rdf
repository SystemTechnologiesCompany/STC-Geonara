    <skos:prefLabel xml:lang="en">MEDIAL MORAINE</skos:prefLabel>
    <skos:changeNote>Date=2013-04-01 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A ridge of moraine that runs down the center of a valley floor. It is formed when two glaciers meet and the debris on the edges of the adjacent valley sides join and are carried on top of the enlarged glacier.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-03-05 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=MEDIAL MORAINE [9d6c8fac-a5cd-4fbc-8283-1bc256c12a43,82761] - MORAINES [4f590d94-110c-4762-9171-aba6d24af6a0,82759]</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">A ridge of moraine that runs down the center of a valley floor. It is formed when two glaciers meet and the debris on the edges of the adjacent valley sides join and are carried on top of the enlarged glacier.</skos:definition>
    <dcterms:modified>2013-04-01 10:31:17.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
