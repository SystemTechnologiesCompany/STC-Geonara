  </skos:Concept>
  <skos:Concept rdf:about="b59e188c-49b8-41b3-94c4-0bc1dbb554fe">
    <skos:broader rdf:resource="346cade5-801a-4afc-9652-48d02905bc4f"/>
    <skos:prefLabel xml:lang="en">CONVERGENCE/DIVERGENCE</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Weather and Climate, American Meteorological Society, 1996." xml:lang="en"/>
    <skos:definition xml:lang="en">Convergence - A net inflow of winds into a region.   Divergence- Anet outflow of wind from a region.</skos:definition>
