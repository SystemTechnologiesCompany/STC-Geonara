  <skos:Concept rdf:about="ad7abcce-b88e-46c7-be44-496d60c88f25">
    <skos:broader rdf:resource="8fb66b46-b998-4412-a541-d2acabdf484b"/>
    <skos:prefLabel xml:lang="en">PLANT SUCCESSION</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J. and Richard T. Wright.  Environmental Science.  1998. Prentice Hall." xml:lang="en"/>
    <skos:definition xml:lang="en">The phenomenon of orderly transition from one biotic community to anotherand is also known as ecological or natural succession.  Natural successionoccurs because the physical environment may be gradually modified by thegrowth of the biotic community itself, such that the area becomes morefavorable to another group of species and less favorable to the presentoccupants.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
