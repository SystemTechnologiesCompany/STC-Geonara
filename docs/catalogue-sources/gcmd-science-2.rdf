System Note=insert Definition
New Value=id: null
text: The removal of rock in solution by acidic rainwater. In particular, limestone is weathered by rainwater containing dissolved CO2.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-02-18 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=CHEMICAL SOLUTION [bb891ee1-6c7b-4ec0-b2fa-6fb67a2df2a3,82633] - COASTAL PROCESSES [672d6958-4bbc-4b33-adc8-927e4348908b,82553]</skos:changeNote>
    <gcmd:reference gcmd:text="Geological Society" xml:lang="en"/>
    <skos:definition xml:lang="en">The removal of rock in solution by acidic rainwater. In particular, limestone is weathered by rainwater containing dissolved CO2.</skos:definition>
