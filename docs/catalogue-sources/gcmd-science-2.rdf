    <skos:changeNote>Date=2012-07-03 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A measurement of the number of people in an area. It is an average number. Population density is calculated by dividing the number of people by area.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="Internet Geography" xml:lang="en"/>
    <skos:definition xml:lang="en">A measurement of the number of people in an area. It is an average number. Population density is calculated by dividing the number of people by area.</skos:definition>
