    <skos:prefLabel xml:lang="en">PENGUINS</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: Phylum Chordata. Class Aves. Order Sphenisciformes. Penguins are flightless aquatic birds, with countershaded bodies and evolved wings into flippers.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="marinebio.org" xml:lang="en"/>
    <skos:definition xml:lang="en">Phylum Chordata. Class Aves. Order Sphenisciformes. Penguins are flightless aquatic birds, with countershaded bodies and evolved wings into flippers.</skos:definition>
    <dcterms:modified>2017-03-15 09:23:47.0</dcterms:modified>
