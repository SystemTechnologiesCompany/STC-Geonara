  <skos:Concept rdf:about="ddeb06af-5c36-428d-801e-e9f9a60ce429">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">EXOTIC SPECIES</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J.and Richard T. Wright. 1998. Environmental Science-the Way the World Works. Prentice-Hall, Inc. Upper Saddle River, New Jersey." xml:lang="en"/>
    <skos:definition xml:lang="en">Exotic species are those that are introduced to a geographical area wherethey are not native.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e008a809-42eb-4694-aac2-db7b6027ee77">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">SYMBIOSIS</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J.and Richard T. Wright. Environmental Science-the Way the World Works. 1998. Prentice-Hall, Inc. Upper Saddle River, New Jersey." xml:lang="en"/>
    <skos:definition xml:lang="en">Symbiosis is the intimate living together or association of two kindsof organisms.</skos:definition>
