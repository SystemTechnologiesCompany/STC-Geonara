    <skos:prefLabel xml:lang="en">VECTOR-BORN DISEASES</skos:prefLabel>
    <skos:changeNote>Date=2019-04-03 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=VECTOR-BORN DISEASES [9d92320e-b9b9-4ae8-8394-252eeda7ceb1,368619] - DISEASES/EPIDEMICS [7d59f070-ccac-4a90-815b-edfca521779b,84157]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from the ​Climate and Health Assessment Glossary" xml:lang="en"/>
    <skos:definition xml:lang="en">Illnesses and diseases spread through vectors. ​Vector-borne diseases include, for example, Malaria, Dengue Fever, West Nile virus, and Lyme disease.</skos:definition>
