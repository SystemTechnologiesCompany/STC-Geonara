  <skos:Concept rdf:about="8c615709-df55-4b09-a5a9-1fabb133fe1a">
    <skos:broader rdf:resource="486f2c33-2401-4292-9d74-8756ee95211f"/>
    <skos:prefLabel xml:lang="en">GLACIATION</skos:prefLabel>
    <gcmd:reference gcmd:text="From: http://en.wikipedia.org/wiki/Glaciation" xml:lang="en"/>
    <skos:definition xml:lang="en">A glaciation (a created composite term meaning Glacial Period, referring to thePeriod or Era of, as well as the process of High Glacial Activity), oftencalled an ice age, is a geological phenomenon in which massive ice sheets formin the Arctic and Antarctic and advance toward the equator. Conversely, theterm interglacial or Interglacial Period, such as the current era, is used todenote the absence of large-scale glaciation on a global scale ¿ i.e., anon-Ice Age. Interglacials are, in general, shorter than glacial epochs.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f2115645-e006-414a-bfb6-083d4874a665">
    <skos:broader rdf:resource="46c929ad-8729-4484-8dc5-0a58a4e696a6"/>
    <skos:prefLabel xml:lang="en">UNIVERSAL DESCRIPTION, DISCOVERY AND INTEGRATION (UDDI) SERVICE</skos:prefLabel>
    <gcmd:reference gcmd:text="Open Geospatial Consortium (OGC)" xml:lang="en"/>
    <skos:definition xml:lang="en">Allows a client to find a web-based service.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
