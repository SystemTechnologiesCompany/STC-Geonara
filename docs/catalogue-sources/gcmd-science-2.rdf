  <skos:Concept rdf:about="9015e65f-bbae-4855-a4b6-1bfa601752bd">
    <skos:broader rdf:resource="233a4d81-44f8-4b0e-8ad3-695f641729f8"/>
    <skos:prefLabel xml:lang="en">BIOGEOCHEMICAL CYCLES</skos:prefLabel>
    <gcmd:reference gcmd:text="Allaby, Michael. 1998. A Dictionary of Ecology.  Oxford University Press. Oxford, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">A Biogeochemical cycle is the movement of chemical elements from organismto physical environment to organism in more or less circularpathways.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="ee8dfdf6-0153-4067-ab3b-51794b01ee86">
    <skos:broader rdf:resource="24b052b6-5996-496d-9e91-1fdbda5897da"/>
