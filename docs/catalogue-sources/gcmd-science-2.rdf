    <skos:prefLabel xml:lang="en">DISSOLVED NITROGEN</skos:prefLabel>
    <skos:changeNote>Date=2018-03-06 User Id=tstevens Entity=Definition Operation=UPDATE Field=text 
System Note=update Definition
Old Value=Refers to nitrogen that has been dissolved in water.
New Value=Nitrogen is essential to life on Earth. It is a component of all proteins, and it can be found in all living systems. Nitrogen compounds are present in organic materials, foods, fertilizers, explosives and poisons. Nitrogen is crucial to life, but in excess it can also be harmful to the environment.</skos:changeNote>
    <skos:changeNote>Date=2018-03-06 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=DISSOLVED NITROGEN [dc748b93-e7d6-419d-a9f0-f370556d6f8e,310647] - GASES [7b98fcc5-4465-45c8-a647-557432276844,310625]</skos:changeNote>
    <skos:changeNote>Date=2018-03-06 User Id=tstevens Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
New Value=LiveScience</skos:changeNote>
    <skos:changeNote>Date=2018-03-06 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Refers to nitrogen that has been dissolved in water.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="LiveScience" xml:lang="en"/>
    <skos:definition xml:lang="en">Nitrogen is essential to life on Earth. It is a component of all proteins, and it can be found in all living systems. Nitrogen compounds are present in organic materials, foods, fertilizers, explosives and poisons. Nitrogen is crucial to life, but in excess it can also be harmful to the environment.</skos:definition>
    <dcterms:modified>2018-03-06 15:40:13.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="8c05bcf2-d13b-44fd-b1a2-5ec797b2f851">
    <skos:broader rdf:resource="7da95c01-4b39-437e-a8d4-fd572e43f693"/>
    <skos:prefLabel xml:lang="en">SWAMPS</skos:prefLabel>
    <gcmd:reference gcmd:text="Allaby, M. 1978.  A Dictionary of Ecology.  Oxford University Press.  Oxford, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">Swamps are wet areas that are normally covered by water all year and subjectto drying out during the summer.  The parameter Swamp may becolloquially interchanged with the parameter Marshes.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e2d18940-adf6-4bdd-ab4f-fe86e68278f4">
    <skos:broader rdf:resource="81655dc5-83d3-4daf-81c8-dc1522e9906e"/>
    <skos:prefLabel xml:lang="en">BROWN ALGAE</skos:prefLabel>
    <skos:definition xml:lang="en">Phylum Ochrophyta. Class Phaeophyceae, brown algae, are distinguished by chloroplasts with four membranes, fucoxanthin pigment and are heterokonts that develop into forms with differentiated tissues.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="8de8b909-8fcb-4ed7-9df3-37f9dd54054f">
    <skos:broader rdf:resource="7f71a0a0-3da7-42b9-b134-c0a824dff971"/>
    <skos:prefLabel xml:lang="en">PRESCRIBED BURNS</skos:prefLabel>
    <gcmd:reference gcmd:text="&apos;http://school.discovery.com/lessonplans/programs/forestfires&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">The act of intentionally setting fire to an area in order to prevent more
damaging fires. &lt;br&gt;
A Prescribed Burn Advisory may report on a prescribe burn.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b8a877b7-d867-4305-9053-3777e5dd330a">
    <skos:broader rdf:resource="7d59f070-ccac-4a90-815b-edfca521779b"/>
