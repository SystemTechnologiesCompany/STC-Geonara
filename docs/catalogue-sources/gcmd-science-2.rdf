    <gcmd:reference gcmd:text="From &lt;a href=http://disc.gsfc.nasa.gov/geomorphology/GEO_7/GEO_CHAPTER_7.HTML&gt; http://disc.gsfc.nasa.gov/geomorphology/GEO_7/GEO_CHAPTER_7.HTML&lt;/a&gt; Geomorphology from Space, Chapter 7 by Robert W. Blair, Jr." xml:lang="en"/>
    <skos:narrower rdf:resource="40d9bf88-e7e2-4137-81fc-4721d67ce520"/>
    <skos:narrower rdf:resource="631c5fb8-5e44-48f8-b937-a5f393d0832d"/>
    <skos:narrower rdf:resource="7f298307-73f6-4f10-96a2-db381f357cb6"/>
    <skos:narrower rdf:resource="a20151df-e7cf-43e0-9745-ffc965f97ef7"/>
    <skos:narrower rdf:resource="c319a44c-b21a-491f-9cf0-65868507576c"/>
    <skos:definition xml:lang="en">Karstification is the geologic process of differential chemical and mechanicalerosion by water on soluble bodies of rock, such as limestone, dolomite,gypsum, or salt, at or near the Earth4s surface. Karstification is exhibitedbest on thick, fractured, and pure limestones in a humid environment in whichthe subsurface and surface are being modified simultaneously. The resultingkarst morphology usually characterized by dolines (sinkholes), hums (towers),caves, and a complex subsurface.</skos:definition>
    <dcterms:modified>2024-10-04 14:21:03.0</dcterms:modified>
