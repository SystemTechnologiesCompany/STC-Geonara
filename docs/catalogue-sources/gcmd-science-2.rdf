  <skos:Concept rdf:about="d622004f-e155-4af3-87c5-61b3a4b87692">
    <skos:broader rdf:resource="cda9b483-8711-42b8-82f9-e7d22ce9c62c"/>
    <skos:prefLabel xml:lang="en">VIEWING GEOMETRY</skos:prefLabel>
    <gcmd:reference gcmd:text="&apos;http://www.star.ait.ac.th/star/rsnotes/CP5/CP5-3.htm&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">The effects of roll, pitch, and yaw, as well as jitter on  the image
geometry. &lt;I&gt;Roll&lt;/I&gt; will cause the image to take on a wavy appearance,
&lt;I&gt;pitch&lt;/I&gt; will cause grid cells to contract or expand in the flight
direction, and &lt;I&gt;yaw&lt;/I&gt; will create a skewed image.	 &lt;I&gt;Jitter&lt;/I&gt;
consists of random and	unsystematic vibaration which cannot be
measured.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
