  <skos:Concept rdf:about="fe6b37b9-f95a-491e-a58e-22aa66be9a9d">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">REFORESTATION</skos:prefLabel>
    <gcmd:reference gcmd:text="Chiras, Daniel D. 1998. Environmental Science. A Systems Approach to Sustainable Development. Wadsworth Publishing Company. Belmont, California." xml:lang="en"/>
    <skos:definition xml:lang="en">Reforestation is the replanting of trees in forests where the trees havebeen cut down.  Reforestation sometimes is undertaken in an effort toreduce atmospheric carbon dioxide levels by restoring forests, which arecarbon sinks.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c5b13fa4-0069-40ce-85cb-bfbab34c2058">
    <skos:broader rdf:resource="e1f20631-b5b9-438c-b5c2-b1fa0fce100a"/>
    <skos:prefLabel xml:lang="en">COUPLED CLIMATE MODELS</skos:prefLabel>
    <gcmd:reference gcmd:text="http://www.metoffice.gov.uk/research/hadleycentre/models/modeltypes.html#AOGCM" xml:lang="en"/>
    <skos:definition xml:lang="en">Coupled atmosphere-ocean general circulation models (AOGCMs) are the mostcomplex models in use, consisting of an Atmosphere general circulation model(AGCM) coupled to an Ocean general circulation models (OGCM). With the additionof other components (such as a sea ice model or a model for evapotranspirationover land), the AOGCM becomes the basis for a full climate model. 
Some recent models include the biosphere, carbon cycle and atmosphericchemistry as well. AOGCMs can be used for the prediction and rate of change offuture climate. They are also used to study the variability and physicalprocesses of the coupled climate system. Global climate models typically have aresolution of a few hundred kilometres. Climate projections from the HadleyCentre make use of the HadCM2 AOGCM, developed in 1994, and its successorHadCM3 AOGCM, developed in 1998. Greenhouse-gas experiments with AOGCMs haveusually been driven by specifying atmospheric concentrations of the gases, butif a carbon cycle model is included, the AOGCM can predict changes in carbondioxide concentration, given the emissions of carbon dioxide into theatmosphere. Similarly, an AOGCM coupled to an atmospheric chemistry model isable to predict the changes in concentration of other atmospheric constituentsin response to climate change and to the changing emissions of various gases.Further information is available on: some aspects of ocean simulation in HadCM3(thermohaline circulation, ventilation, vertical mixing), decadal variabilityin the ocean of HadCM3.
Recently a global coupled climate model with an eddy-permitting oceanresolution has been developed at the Hadley Centre, in order to betterrepresent important oceanic processes.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d57dff3d-5f2f-425c-80bb-2a6fcb42d3fa">
    <skos:broader rdf:resource="f36d71c6-f2ad-49c4-809f-09b4f0688412"/>
    <skos:prefLabel xml:lang="en">RECLAMATION/REVEGETATION/RESTORATION</skos:prefLabel>
    <skos:changeNote>Date=2013-08-15 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=text 
System Note=update Definition
Old Value=RESTORATION: The processes by which an area is treated in  an attempt
to restore original conditions.  RECLAIMATION: The process of reconverting
land to other  forms of productive uses.  REVEGETATION: Reestablishment
of vegetation which may take  place naturally or be induced by humans
through seeding or transplanting.
New Value=Restoration: The processes by which an area is treated in  an attempt to restore original conditions.  

Reclamation: The process of reconverting land to other forms of productive uses.  

Revegetation: Reestablishment of vegetation which may take  place naturally or be induced by humans through seeding or transplanting.</skos:changeNote>
    <skos:changeNote>Date=2013-08-15 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
Old Value=The Nature and Properties of Soils, Prentice Hall, 1996.  &lt;BR&gt; Herren, R.V.,
and R.L. Donahue.  1991.  The Agricultural Dictionary, Delmar Publishers, INC.
Albany, New York.  553pp.
New Value=The Nature and Properties of Soils, Prentice Hall, 1996.  &lt;BR&gt; Herren, R.V., and R.L. Donahue.  1991.  The Agricultural Dictionary, Delmar Publishers, INC. Albany, New York.  553pp.</skos:changeNote>
    <skos:changeNote>Date=2017-03-10 User Id=tstevens Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
Old Value=The Nature and Properties of Soils, Prentice Hall, 1996.  &lt;BR&gt; Herren, R.V., and R.L. Donahue.  1991.  The Agricultural Dictionary, Delmar Publishers, INC. Albany, New York.  553pp.
New Value=The Nature and Properties of Soils, Prentice Hall, 1996. Herren, R.V., and R.L. Donahue.  1991.  The Agricultural Dictionary, Delmar Publishers, INC. Albany, New York.  553pp.</skos:changeNote>
    <gcmd:reference gcmd:text="The Nature and Properties of Soils, Prentice Hall, 1996. Herren, R.V., and R.L. Donahue.  1991.  The Agricultural Dictionary, Delmar Publishers, INC. Albany, New York.  553pp." xml:lang="en"/>
    <skos:definition xml:lang="en">Restoration: The processes by which an area is treated in  an attempt to restore original conditions.  Reclamation: The process of reconverting land to other forms of productive uses.  Revegetation: Reestablishment of vegetation which may take  place naturally or be induced by humans through seeding or transplanting.</skos:definition>
    <dcterms:modified>2017-03-10 09:00:17.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="df597f06-8575-4726-acac-65b2bd432d59">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">DOMINANT SPECIES</skos:prefLabel>
    <gcmd:reference gcmd:text="Krebs, C. 1994. Ecology. HarperCollins. New York, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">Dominant Species are recognized by their numerical abundance or biomass andare usually defined separately for each trophic level.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="de0ace5c-fa2b-47ca-93db-79d8df7ab6f2">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">VEGETATION SPECIES</skos:prefLabel>
    <skos:changeNote>Date=2021-09-08 User Id=tstevens Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
New Value=USGS</skos:changeNote>
    <gcmd:reference gcmd:text="USGS" xml:lang="en"/>
    <skos:definition xml:lang="en">Vegetation Species are the enumeration of different species in an area.</skos:definition>
    <dcterms:modified>2021-09-08 13:44:22.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f97f5caf-206e-4310-8c9d-c4c1a09d3c62">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <dcterms:created>2020-11-05</dcterms:created>
    <skos:prefLabel xml:lang="en">VEGETATION OPTICAL DEPTH</skos:prefLabel>
    <skos:changeNote>Date=2020-11-05 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=VEGETATION OPTICAL DEPTH [f97f5caf-206e-4310-8c9d-c4c1a09d3c62,560749] - VEGETATION [c7b5c02c-724d-4a19-b824-98180f3900c9,83709]</skos:changeNote>
    <gcmd:reference gcmd:text="https://ieeexplore.ieee.org/document/1420287" xml:lang="en"/>
    <skos:definition xml:lang="en">Optical depth is a measure of how opaque a medium is to radiation passing through it. The optical depth is directly related to the vegetation water content, and is also a function of the incidence angle and the radiometric frequency.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f717330e-3656-4910-beed-d54cc9a19c2b">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">EXOTIC VEGETATION</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J.and Richard T. Wright. 1998. Environmental Science-the Way the World Works. Prentice-Hall, Inc. Upper Saddle River, New Jersey." xml:lang="en"/>
    <skos:definition xml:lang="en">Exotic vegetation are species of vegetation that are introduced toa geographical area where they are not native.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
