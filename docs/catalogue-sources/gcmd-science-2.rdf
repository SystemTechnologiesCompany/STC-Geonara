    <skos:prefLabel xml:lang="en">KARST LANDSCAPE</skos:prefLabel>
    <gcmd:reference gcmd:text="From the Houghton Mifflin Student Resource Center GeologyLink. &apos;http://college.hmco.com/geology/resources/geologylink/glossary.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">An ecosystem within a landscape defined as Karst topography characterized by
caves, sinkholes, disappraring streams and underground drainage. Karst forms
when groundwater dissolves pockets of limestone, dolomite, or gypsum in rock.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
