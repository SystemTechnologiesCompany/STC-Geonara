    <gcmd:reference gcmd:text="nationalgeographic.org" xml:lang="en"/>
    <skos:narrower rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:narrower rdf:resource="8eb84f36-f355-458b-889f-b37cfa120654"/>
    <skos:narrower rdf:resource="6bef0291-a9ca-4832-bbb4-80459dc1493f"/>
    <skos:narrower rdf:resource="f1a25060-330c-4f84-9633-ed59ae8c64bf"/>
    <skos:definition xml:lang="en">The biosphere is made up of the parts of Earth where life exists. The biosphere extends from the deepest root systems of trees, to the dark environment of ocean trenches, to lush rain forests and high mountaintops.</skos:definition>
    <dcterms:modified>2024-10-28 16:25:27.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d1c2bba5-799d-412b-80e0-fa04058416e3">
    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">NITROUS OXIDE</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Libes. S. 1992. Introduction to Marine Biogeochemistry. John Wiley and Sons. p. 434." xml:lang="en"/>
    <skos:definition xml:lang="en">A colorless gas, made up of two atoms of univalent nitrogen and one atomof oxygen, N2O. In the ocean, it is formed as a minor product ofbacterial nitrification and denitrification.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="d3055f47-258e-4556-a885-54cd1fff4680">
    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">ORGANIC CARBON</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Webster&apos;s College Dictionary. 1991. Random House." xml:lang="en"/>
    <skos:definition xml:lang="en">Carbon species that are hydrocarbons or hydrocarbon derivatives. Variablessuch as particulate organic carbon (POC) are included as detailedvariables under organic carbon.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="8b99d6c3-1751-43e6-81d1-92a7618cadb3">
