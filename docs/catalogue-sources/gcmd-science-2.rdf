    <skos:prefLabel xml:lang="en">CARBON SEQUESTRATION</skos:prefLabel>
    <skos:changeNote>Date=2019-09-11 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=CARBON SEQUESTRATION [e58872a8-6104-4ff8-bbca-4b00ba4b38e8,369159] - ECOSYSTEM FUNCTIONS [233a4d81-44f8-4b0e-8ad3-695f641729f8,83923]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from Climate-Policy-Watcher.org (https://www.climate-policy-watcher.org/greenhouse-gases-2/types-of-carbon-sequestration.html)" xml:lang="en"/>
    <skos:definition xml:lang="en">Carbon sequestration is the process through which CO2 from the atmosphere is absorbed by various carbon sinks. Types of sinks include agricultural sinks, forests, geologic formations, oceanic sinks,as well as roots and within the soil.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <gcmd:altLabel gcmd:text="Carbon uptake" xml:lang="en"/>
