    <skos:prefLabel xml:lang="en">LICHENS</skos:prefLabel>
    <gcmd:reference gcmd:text="Allaby, Michael.  1994.  The Concise Oxford Dictionary of Ecology.  Oxford University Press.  Oxford, United Kingdom." xml:lang="en"/>
