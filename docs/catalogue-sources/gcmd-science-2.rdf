User Note=Insert Concept
System Note=add broader relation
New Value=SPECIFIC SURFACE AREA [a72b96ad-3755-4205-b353-66592c7bff54,310797] - SNOW MICROSTRUCTURE [4dc6b614-36ad-4e3b-ac6f-af6e0aa6378b,310793]</skos:changeNote>
    <gcmd:reference gcmd:text="NSIDC DAAC" xml:lang="en"/>
    <skos:definition xml:lang="en">Ice surface area per unit mass of snow.</skos:definition>
