    <skos:definition xml:lang="en">Particulate matter suspended in the water column, greater than0.45 micrometers, as distinguished from dissolved solids which are lessthan 0.45 micrometers.  Synonymous with Particulates.</skos:definition>
    <dcterms:modified>2024-10-04 11:02:02.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
