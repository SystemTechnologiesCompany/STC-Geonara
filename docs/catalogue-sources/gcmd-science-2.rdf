    <gcmd:reference gcmd:text="USGS" xml:lang="en"/>
    <skos:definition xml:lang="en">Pertaining to the measurement of waves generated through the relaxation of stress within the Earth&apos;s crust; either through an earthquake, or as an externally generated shock-wave.</skos:definition>
    <dcterms:modified>2017-03-10 11:15:23.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="8d69bce7-efce-4efb-9870-6a6d3a2684fd">
    <skos:broader rdf:resource="63bc0693-52eb-4ebd-a39e-e77e96409072"/>
    <skos:prefLabel xml:lang="en">SHORTWAVE RADIATION</skos:prefLabel>
    <gcmd:reference gcmd:text="Huschke, R.E. 1959. Glossary of Meteorology. American Meteorological Association, Boston, MA. See also: Pickard, G.L. and W.J. Emery. 1990. Descriptive Physical Oceanography: An Introduction. Pergamon Press, NY" xml:lang="en"/>
    <skos:definition xml:lang="en">Shortwave radiation is electromagnetic radiation in the visibleand near-visible portions of the spectrum (0.4 to 1.0 microns). Shortwaveradiation is the small fraction of the sun&apos;s total radiated energyreaching the atmosphere. Shortwave radiation reaching the surface of theocean is direct radiation or indirect radiation scattered from theatmosphere.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="9becd489-f8fb-4dbb-b920-6c8399100515">
    <skos:broader rdf:resource="663a2ea2-e2bf-4209-ae9b-334c8222b106"/>
    <skos:prefLabel xml:lang="en">RADIOLARIANS</skos:prefLabel>
    <gcmd:reference gcmd:text="Gould, J. and W.Keaton. 1996. Biological Science. W.W. Norton and Company. New York, New York. and Starr, C. and Taggart.  1998.  Biology: the unity and diversity of life.  Wadsworth Publishing Company.  Belmont, California." xml:lang="en"/>
    <skos:definition xml:lang="en">Radiolarians belong to the class Actinopoda, meaning &apos;ray feet&apos; which refersto the numerous slender, reinforced pseudopods that radiate from the body.Like foramniferans, the radiolarians are well represented in the fossilrecord, for they have ornate, silica-hardened parts that resistdegradation. Radiolarian shells contribute to the formation of siliceousrocks such as chert.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b3657e71-acd1-4be4-9c70-a54e074a40a4">
    <skos:broader rdf:resource="672d6958-4bbc-4b33-adc8-927e4348908b"/>
