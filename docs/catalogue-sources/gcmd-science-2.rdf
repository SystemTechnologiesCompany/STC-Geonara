    <gcmd:reference gcmd:text="Adapted from: Webster&apos;s College Dictionary. 1991. Random House." xml:lang="en"/>
    <skos:definition xml:lang="en">Particulate matter suspended in the water column, greater than 0.45 micrometers, as distinguished from dissolved solids which are less than 0.45 micrometers.</skos:definition>
