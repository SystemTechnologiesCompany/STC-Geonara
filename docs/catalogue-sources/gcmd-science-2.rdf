    <skos:prefLabel xml:lang="en">SOLAR RADIATION</skos:prefLabel>
    <gcmd:reference gcmd:text="WMO. 1966. International Meteorological Vocabulary. WMO/OMM/BMO, No. 182. TP. 91., Switzerland. Huschke, R.E., ed. 1959. Glossary of Meteorology, American Meteorological Society, Boston, MA." xml:lang="en"/>
    <skos:definition xml:lang="en">Solar radiation is the total electromagnetic radiation emitted by the Sun.Also could include insolation, direct solar radiation, diffuse radiation,solar irradiance, and shortwave radiation.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="9d6c8fac-a5cd-4fbc-8283-1bc256c12a43">
    <skos:broader rdf:resource="4f590d94-110c-4762-9171-aba6d24af6a0"/>
