    <skos:prefLabel xml:lang="en">FEED COMPOSITION</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Herren, R.V., and R.L. Donahue.  1991.  The Agriculture Dictionary, Delmar Publishers INC.  Albany, New york.  553pp." xml:lang="en"/>
