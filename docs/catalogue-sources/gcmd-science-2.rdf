  <skos:Concept rdf:about="dbc7fed3-ad30-4e57-868e-bae478713a71">
    <skos:broader rdf:resource="01021105-60ed-479a-a35b-faa73e286264"/>
    <dcterms:created>2013-02-12</dcterms:created>
    <skos:prefLabel xml:lang="en">ALTOCUMULUS LENTICULARIS</skos:prefLabel>
    <skos:changeNote>Date=2013-04-15 User Id=mpmorahan Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=ALTOCUMULUS LENTICULARIS [dbc7fed3-ad30-4e57-868e-bae478713a71,87473] - LENTICULAR CLOUDS [d5e72d73-22f6-4f4c-b937-b71d84960a1e,105089]</skos:changeNote>
    <skos:changeNote>Date=2013-03-20 User Id=mpmorahan Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: &quot;(Or lenticular cloud.) A cloud species the elements of which have the form of more or less isolated, generally smooth lenses or almonds; the outlines are sharp and sometimes show irisation.

These clouds appear most often in formations of orographic origin, the result of lee waves, in which cases they remain nearly stationary with respect to the terrain (standing cloud), but they also occur in regions without marked orography. This species is found mainly in the genera cirrocumulus, altocumulus, and (rarely) stratocumulus. Altocumulus lenticularis differs from cirrocumulus lenticularis in that, when smooth and without elements, it has shadowed parts while the latter is very white throughout. When undulated or subdivided, the altocumulus species differs from stratocumulus lenticularis in that its elements subtend an angle of less than 5° when viewed at an angle of more than 30° above the horizon.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-02-12 User Id=mpmorahan Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=ALTOCUMULUS LENTICULARIS [dbc7fed3-ad30-4e57-868e-bae478713a71,82165] - ALTOCUMULUS [01021105-60ed-479a-a35b-faa73e286264,82159]</skos:changeNote>
    <gcmd:reference gcmd:text="American Meteorological Society (http://glossary.ametsoc.org/wiki/Main_Page)" xml:lang="en"/>
    <skos:narrower rdf:resource="d5e72d73-22f6-4f4c-b937-b71d84960a1e"/>
    <skos:definition xml:lang="en">&apos;(Or lenticular cloud.) A cloud species the elements of which have the form of more or less isolated, generally smooth lenses or almonds; the outlines are sharp and sometimes show irisation.These clouds appear most often in formations of orographic origin, the result of lee waves, in which cases they remain nearly stationary with respect to the terrain (standing cloud), but they also occur in regions without marked orography. This species is found mainly in the genera cirrocumulus, altocumulus, and (rarely) stratocumulus. Altocumulus lenticularis differs from cirrocumulus lenticularis in that, when smooth and without elements, it has shadowed parts while the latter is very white throughout. When undulated or subdivided, the altocumulus species differs from stratocumulus lenticularis in that its elements subtend an angle of less than 5° when viewed at an angle of more than 30° above the horizon.</skos:definition>
    <dcterms:modified>2013-04-15 15:09:03.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a413f88b-859c-4035-a45b-2faa9934156b">
    <skos:broader rdf:resource="162e2243-3266-4999-b352-d8a1a9dc82ac"/>
