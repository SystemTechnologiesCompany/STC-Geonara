    <skos:prefLabel xml:lang="en">ATMOSPHERIC STABILITY</skos:prefLabel>
    <skos:changeNote>Date=2013-10-11 User Id=saritz Entity=Definition Operation=UPDATE Field=reference 
User Note=Updated definition.
System Note=update Definition
Old Value=Glossary of Weather and Climate, American Meteorological Society, 1996.
New Value=Glossary of Weather and Climate, American Meteorological Society, 1996.</skos:changeNote>
    <skos:changeNote>Date=2013-10-11 User Id=saritz Entity=Definition Operation=UPDATE Field=text 
User Note=Updated definition.
System Note=update Definition
Old Value=The property of the atmosphere, usually assumed in hydrostatic equilibrium
with respect to vertical displacements of air parcels.
New Value=The characteristic of a system if sufficiently small disturbances have only small effects, either decreasing in amplitude or oscillating periodically; it is asymptotically stable if the effect of small disturbances vanishes for long time periods.</skos:changeNote>
    <skos:changeNote>Date=2013-10-11 User Id=saritz Entity=Definition Operation=UPDATE Field=text 
User Note=Updated definition.
System Note=update Definition
Old Value=The property of the atmosphere, usually assumed in hydrostatic equilibrium
with respect to vertical displacements of air parcels.
New Value=The property of the atmosphere, usually assumed in hydrostatic equilibrium
with respect to vertical displacements of air parcels.</skos:changeNote>
    <skos:changeNote>Date=2013-10-11 User Id=saritz Entity=Definition Operation=UPDATE Field=reference 
User Note=Updated definition.
System Note=update Definition
Old Value=Glossary of Weather and Climate, American Meteorological Society, 1996.
New Value=Glossary of Meteorology, American Meteorological Society, 2012.</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society, 2012." xml:lang="en"/>
    <skos:definition xml:lang="en">The characteristic of a system if sufficiently small disturbances have only small effects, either decreasing in amplitude or oscillating periodically; it is asymptotically stable if the effect of small disturbances vanishes for long time periods.</skos:definition>
    <dcterms:modified>2013-10-11 17:10:52.0</dcterms:modified>
