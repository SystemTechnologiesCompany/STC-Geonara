    <skos:definition xml:lang="en">Photosynthetically Active Radiation is the light in the whole wavelength band from 400 nm (deep violet) to 700 nm (dark red) used by plants in photosynthesis.</skos:definition>
    <dcterms:modified>2016-06-15 08:46:28.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f5cd9ac7-6b10-44dd-8b1d-660a7a681518">
