    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society" xml:lang="en"/>
    <skos:definition xml:lang="en">A downburst that covers an area less than 4 km along a side with peak winds that last 2–5 minutes.</skos:definition>
