  <skos:Concept rdf:about="9613f08d-da11-4ed0-989e-c0c830870044">
    <skos:broader rdf:resource="d3b7c3c0-e644-4f01-94da-dfebe854c0d1"/>
    <skos:prefLabel xml:lang="en">RADAR CROSS-SECTION</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Radar Terminology &apos;http://www.geog.nottingham.ac.uk/~dee/rs/agrg/radar/radgloe3.html&apos;" xml:lang="en"/>
