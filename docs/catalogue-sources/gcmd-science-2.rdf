    <skos:prefLabel xml:lang="en">WAVE REFRACTION</skos:prefLabel>
    <skos:changeNote>Date=2013-03-29 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The change in direction of a wave due to a change in its medium. It is essentially a surface phenomenon.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-02-18 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=WAVE REFRACTION [b43d2d47-c86e-41b6-81bd-be803db536da,82665] - COASTAL PROCESSES [672d6958-4bbc-4b33-adc8-927e4348908b,82553]</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">The change in direction of a wave due to a change in its medium. It is essentially a surface phenomenon.</skos:definition>
    <dcterms:modified>2013-03-29 14:06:21.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
