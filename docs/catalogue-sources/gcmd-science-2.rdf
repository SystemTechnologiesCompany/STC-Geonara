    <skos:prefLabel xml:lang="en">VARVE DEPOSITS</skos:prefLabel>
    <skos:changeNote>Date=2012-06-26 User Id=gee-cee Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=VARVE DEPOSITS [9db3b1cb-0d3d-4486-bf56-1e96b8691b01,40071] - OCEAN/LAKE RECORDS [5237fae3-c98e-4d4a-9013-d7c824b3862b,40027]</skos:changeNote>
    <skos:changeNote>Date=2012-07-24 User Id=mpmorahan Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A sedimentary bed or lamina or sequence of laminae (thin layers) deposited in a body of silt or still water within a year&apos;s time. Usually refers to glacial varves resulting from seasonally deposited meltwater streams in a glacial lake or other body of still water. Counting the varves have been used to measure glacial deposits.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2012-07-24 User Id=mpmorahan Entity=NarrowerRelation Operation=DELETE 
User Note=undo move
System Note=delete narrower relation
Old Value=VARVE DEPOSITS [9db3b1cb-0d3d-4486-bf56-1e96b8691b01,40071] - PALEOCLIMATE FORCING [dc3f297b-8471-4101-b70e-dc5765762061,40177]</skos:changeNote>
    <skos:changeNote>Date=2012-07-24 User Id=mpmorahan Entity=NarrowerRelation Operation=INSERT 
User Note=Move Concepts
System Note=add narrower relation
New Value=VARVE DEPOSITS [9db3b1cb-0d3d-4486-bf56-1e96b8691b01,40071] - PALEOCLIMATE FORCING [dc3f297b-8471-4101-b70e-dc5765762061,40177]</skos:changeNote>
    <gcmd:reference gcmd:text="Jackson, J.A. 1997. Glossary of Geology, 4th edition. American Geological Institute." xml:lang="en"/>
    <skos:definition xml:lang="en">A sedimentary bed or lamina or sequence of laminae (thin layers) deposited in a body of silt or still water within a year&apos;s time. Usually refers to glacial varves resulting from seasonally deposited meltwater streams in a glacial lake or other body of still water. Counting the varves have been used to measure glacial deposits.</skos:definition>
    <dcterms:modified>2012-07-24 17:02:47.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a219dbe6-c095-4002-9fbe-012b31da839c">
    <skos:broader rdf:resource="5273c8c2-d30b-4666-b2d5-0388ce2741d0"/>
    <dcterms:created>2019-09-11</dcterms:created>
    <skos:prefLabel xml:lang="en">OCEAN ACIDIFICATION</skos:prefLabel>
    <skos:changeNote>Date=2019-09-11 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=OCEAN ACIDIFICATION [a219dbe6-c095-4002-9fbe-012b31da839c,369155] - ATMOSPHERIC/OCEAN INDICATORS [5273c8c2-d30b-4666-b2d5-0388ce2741d0,86809]</skos:changeNote>
    <gcmd:reference gcmd:text="USGCRP Glossary (https://www.globalchange.gov/climate-change/glossary)" xml:lang="en"/>
    <skos:definition xml:lang="en">The process by which ocean waters have become more acidic due to the absorption of human-produced carbon dioxide, which interacts with ocean water to form carbonic acid and lower the ocean’s pH. Acidity reduces the capacity of key plankton species and shelled animals to form and maintain shells.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <gcmd:altLabel gcmd:text="OA" xml:lang="en"/>
  </skos:Concept>
  <skos:Concept rdf:about="ab1952ae-de34-4299-ad10-9c9b2baf87f5">
    <skos:broader rdf:resource="abc6f016-d1f0-4725-b847-639de054d13f"/>
    <skos:prefLabel xml:lang="en">SEGMENTED WORMS (ANNELIDS)</skos:prefLabel>
    <gcmd:reference gcmd:text="Starr, C. and R.Taggart. 1998. Biology: the unity and diversity of life. Wadsworth Publishing Company. Belmont, California." xml:lang="en"/>
    <skos:narrower rdf:resource="517e2978-223e-42a2-b889-9c60f7099859"/>
    <skos:narrower rdf:resource="ea2c5c8f-6b57-4fcc-8c01-53343c706cef"/>
    <skos:narrower rdf:resource="b845369b-bf6b-47a6-b56a-a11438604a39"/>
    <skos:definition xml:lang="en">Segmented Worms are worms that have a repeating series of body units thatmay or may not be similar to one another.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="ad8499b4-28cb-46ed-b0fe-867ed90fce05">
    <skos:broader rdf:resource="50b8fe04-9149-4b7f-a8b2-b33b1e3aa192"/>
    <skos:prefLabel xml:lang="en">RIVER ICE</skos:prefLabel>
    <gcmd:reference gcmd:text="Goudie, Andrew. 1997. The Encyclopedic Dictionary of Physical Geography. Blackwell Publishing, Malden, Massachusetts." xml:lang="en"/>
    <skos:definition xml:lang="en">Pertaining to the extent, thickness, longevity, etc. of ice formations
that occur on river systems.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
