New Value=INFILTRATION RATE</skos:changeNote>
    <skos:changeNote>Date=2016-03-31 User Id=gee-cee Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The rate at which rain/snow/water seeps into the subsurface soil and rock.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2016-03-31 User Id=gee-cee Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=INFILTRATION RATES [d16cd32f-978d-4ab5-9711-f8189a748399,158795] - INFILTRATION [638a22af-4e97-450e-a278-b81338443230,85535]</skos:changeNote>
    <gcmd:reference gcmd:text="http://ga.water.usgs.gov/edu/watercycleinfiltration.html" xml:lang="en"/>
    <skos:definition xml:lang="en">The rate at which rain/snow/water seeps into the subsurface soil and rock.</skos:definition>
    <dcterms:modified>2016-03-31 10:19:03.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="9902dc89-61fb-4a1e-becf-c8138122d2c4">
    <skos:broader rdf:resource="63846997-4a3f-41e1-9241-6d5053360d7a"/>
    <dcterms:created>2013-03-05</dcterms:created>
    <skos:prefLabel xml:lang="en">CACO3</skos:prefLabel>
    <skos:changeNote>Date=2013-03-05 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=CACO3 [9902dc89-61fb-4a1e-becf-c8138122d2c4,82887] - KARST PROCESSES [63846997-4a3f-41e1-9241-6d5053360d7a,82869]</skos:changeNote>
    <gcmd:reference gcmd:text="Handbook of Inorganic Chemical Compounds" xml:lang="en"/>
    <skos:definition xml:lang="en">A chemical compound that is a common substance found in rocks in all parts of the world, and is the main component of shells of marine organisms, snails, coal balls, pearls, and eggshells. Calcium carbonate is the active ingredient in agricultural lime, and is created when Ca ions in hard water react with carbonate ions creating limescale.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
