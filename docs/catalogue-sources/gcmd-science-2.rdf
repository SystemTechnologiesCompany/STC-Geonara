    <skos:changeNote>Date=2016-05-12 User Id=gee-cee Entity=AltLabel Operation=INSERT 
System Note=insert AltLabel
New Value=id: null
text: AGRICULTURAL COMMODITIES
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from: Herren, R.V., and R.L. Donahue.  1991.  The Agriculture Dictionary, Delmar Publishers INC.  Albany, New york.  553pp." xml:lang="en"/>
    <skos:narrower rdf:resource="1e2557c5-d232-48e4-8276-369a22ae6aae"/>
    <skos:narrower rdf:resource="a368da76-b191-4859-bd55-8643f4fab812"/>
    <skos:narrower rdf:resource="d3ce1677-f3a8-452e-91c8-0ff80e6a3f09"/>
    <skos:definition xml:lang="en">Measurments related to any transportable animal resource productwith commercial value; all animal resource products which are articles ofcommerce.  Does NOT include Apicultural/Sericultural products (seeApiculture or Sericulture).</skos:definition>
