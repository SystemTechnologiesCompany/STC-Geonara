    <skos:changeNote>Date=2012-07-16 User Id=mpmorahan Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The process by which soil, rock or sand is gradually worn away by water or wind action.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from: Garrison, T. 1993. Oceanography, An Invitation to Marine Science. Wadsworth Publishing Co. p. 519." xml:lang="en"/>
    <skos:definition xml:lang="en">The process by which soil, rock or sand is gradually worn away by water or wind action.</skos:definition>
