  </skos:Concept>
  <skos:Concept rdf:about="cad91f82-7e2a-43b7-b272-2dc77e2791f4">
    <skos:broader rdf:resource="57383ac5-614c-4b84-9202-e137b000422b"/>
    <skos:prefLabel xml:lang="en">SOLAR ENERGETIC PARTICLE FLUX</skos:prefLabel>
    <gcmd:reference gcmd:text="http://www-istp.gsfc.nasa.gov/Education/gloss.html" xml:lang="en"/>
    <skos:narrower rdf:resource="0168947c-5f28-46d8-b643-cb31af02a6de"/>
    <skos:narrower rdf:resource="2217b742-b21a-4230-ba34-1af30132135d"/>
    <skos:narrower rdf:resource="5223ebeb-a22d-4bb9-b2b2-ed949a10ac29"/>
    <skos:narrower rdf:resource="67773da0-f5f1-4047-871a-1fb5a5c1621a"/>
    <skos:narrower rdf:resource="8686285f-9949-4a22-ad80-a1bf4d43e122"/>
    <skos:narrower rdf:resource="8f801f54-9ca9-4ba6-be35-fd87968f24e7"/>
    <skos:narrower rdf:resource="a2443978-118d-4f7c-843d-dcd0059fe949"/>
    <skos:narrower rdf:resource="d9ce8e7e-44ff-4555-a910-86b87daca0c2"/>
    <skos:definition xml:lang="en">Solar energetic particles are high energy particles occasionally emitted fromactive areas on the Sun, associated with solar flares and coronal massejections. The Earth¿s magnetic field keeps them out of regions close to Earth(except for the polar caps) but they can pose a hazard to space travelers farfrom Earth. Solar energetic particles are somtimes referred to as solar cosmicrays.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
