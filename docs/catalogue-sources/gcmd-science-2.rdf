  <skos:Concept rdf:about="9c40d795-abe1-42d4-b5ff-727d4843b3a4">
    <skos:broader rdf:resource="236cec51-c9e5-4584-90c4-0dac11c603cb"/>
    <dcterms:created>2024-02-21</dcterms:created>
    <skos:prefLabel xml:lang="en">ENVIRONMENTAL RNA (eRNA)</skos:prefLabel>
    <skos:changeNote>Date=2024-02-21 User Id=tstevens Entity=PrefLabel Operation=UPDATE Field=text 
System Note=update PrefLabel
Old Value=ENVIRONMENTAL RNA _eRNA_
New Value=ENVIRONMENTAL RNA (eRNA)</skos:changeNote>
    <skos:changeNote>Date=2024-02-22 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Refers to RNAs released by organisms into their surrounding environment. The term is used here to refer strictly to RNA extracted from the environment (in cellular, vesicular, or free form) in the absence of progenitor organisms. Current eRNA applications exploit its rapid degradation to quantify temporally recent or metabolically active communities.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2024-02-21 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=ENVIRONMENTAL RNA _eRNA_ [9c40d795-abe1-42d4-b5ff-727d4843b3a4,1588452] - RNA [236cec51-c9e5-4584-90c4-0dac11c603cb,1588450]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.cell.com/trends/ecology-evolution/abstract/S0169-5347(19)30155-7 https://www.sciencedirect.com/science/article/pii/S0169534721000689#bb0010" xml:lang="en"/>
    <skos:definition xml:lang="en">Refers to RNAs released by organisms into their surrounding environment. The term is used here to refer strictly to RNA extracted from the environment (in cellular, vesicular, or free form) in the absence of progenitor organisms. Current eRNA applications exploit its rapid degradation to quantify temporally recent or metabolically active communities.</skos:definition>
    <dcterms:modified>2024-02-22 09:18:15.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="9f8a6a52-df35-487d-9a74-74b76943e0c0">
    <skos:broader rdf:resource="dc2088f9-ffb7-41c3-b0a1-856ecfec89de"/>
    <skos:prefLabel xml:lang="en">EXHIBIT MATERIALS</skos:prefLabel>
    <gcmd:reference gcmd:text="NASA GCMD" xml:lang="en"/>
    <skos:narrower rdf:resource="24b7bc59-3f10-4a0b-b9c1-92ae10feb007"/>
    <skos:narrower rdf:resource="fb3b3728-a6ff-465d-8a33-2619a3276cdf"/>
    <skos:definition xml:lang="en">Exhibit Materials are defined as Education/Outreach Services that provide a sensory (visual, auditory, tactile, etc.) presentation of items or concepts related to the Earth Sciences and/or Global Environmental Change. These materials are designed such that one unit is able to disseminate its information to a large number of viewers at any one time.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e5a8c6ed-5b59-40fe-a83b-18b39fb7c31b">
    <skos:broader rdf:resource="22ec2f9b-1f1a-469b-bc09-851d58637ff4"/>
    <skos:prefLabel xml:lang="en">FOREST FIRE SCIENCE</skos:prefLabel>
    <gcmd:reference gcmd:text="Franzese, M.L., T.J. Thompson, and J. McNutt.  1978.  Glossary of forestry related terms.      Potlatch Corporation Internal Report.  Lewiston, ID:Potlatch Corporation.  59p." xml:lang="en"/>
    <skos:definition xml:lang="en">The branch of Forestry that studies the effects, benefits,
prevention, movement, and ecology of Fire in forests.  May include any
Forest Fire related items.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="e1dbe955-7285-4df2-a854-07693fce44ec">
    <skos:broader rdf:resource="aa35a52f-e3d9-41bd-abd2-ec7e1a8101d1"/>
    <skos:prefLabel xml:lang="en">AVALANCHE</skos:prefLabel>
    <skos:changeNote>Date=2024-10-01 User Id=tstevens Entity=WeightedRelation Operation=INSERT 
System Note=insert WeightedRelation
New Value=id: null
related concept uuid: 2565d1be-7468-4969-9367-e21719c006a1
relationship type: null
relationship value: null
generated by: null</skos:changeNote>
    <skos:definition xml:lang="en">Pertaining to the measuerment of a large mass of snow, ice, soil, rock,falling rapidly from heights far above a lowland area.</skos:definition>
    <dcterms:modified>2024-10-01 15:57:17.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <skos:related rdf:resource="2565d1be-7468-4969-9367-e21719c006a1"/>
  </skos:Concept>
  <skos:Concept rdf:about="e02b0b50-a0f2-4c47-841b-9689fdb99121">
    <skos:broader rdf:resource="251c87cd-03b3-464f-8390-8ede2fec28fc"/>
    <skos:prefLabel xml:lang="en">POTENTIAL TEMPERATURE</skos:prefLabel>
    <skos:definition xml:lang="en">Measurement of water temperature taking water&apos;s compressibility intoaccount, provided no heat exchange of the water sample with itssurroundings.	 This is important because water temperature ishigher under the higher pressure conditions of the deep ocean compared tothe temperature of that same water at the lower pressure conditions of theocean surface.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
