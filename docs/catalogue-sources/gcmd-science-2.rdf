    <skos:prefLabel xml:lang="en">SUB-DEBRIS MELT ENHANCEMENT</skos:prefLabel>
    <skos:changeNote>Date=2020-12-22 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SUB-DEBRIS MELT ENHANCEMENT [b6c9cc25-b989-4915-a5c6-43dff744b056,560806] - GLACIERS [68eed887-8008-4352-b420-949457ab59ab,84413]</skos:changeNote>
    <gcmd:reference gcmd:text="http://dx.doi.org/10.1080/00288306.2012.736391" xml:lang="en"/>
    <skos:definition xml:lang="en">Glacier melt rates are influenced by the presence of supraglacial debris. Supraglacial debris can either enhance or reduce ablation relative to bare ice.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
