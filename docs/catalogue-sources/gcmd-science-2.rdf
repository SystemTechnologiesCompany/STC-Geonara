    <skos:prefLabel xml:lang="en">RODENTS</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: Phylum Chordata. Class Mammalia. Order Rodentia. Rodents have small robust bodies, short limbs and long tails and are characterized by their dentition of a single pair of continuously growing incisors in each of the upper and lower jaws.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="animaldiversity.org" xml:lang="en"/>
    <skos:definition xml:lang="en">Phylum Chordata. Class Mammalia. Order Rodentia. Rodents have small robust bodies, short limbs and long tails and are characterized by their dentition of a single pair of continuously growing incisors in each of the upper and lower jaws.</skos:definition>
    <dcterms:modified>2017-03-15 09:42:18.0</dcterms:modified>
