    <gcmd:reference gcmd:text="U.S. Department of Energy" xml:lang="en"/>
    <skos:definition xml:lang="en">Refers to the production and use of solar energy for human consumption. Solar energy is energy from the sun that is converted into thermal or electrical energy.</skos:definition>
