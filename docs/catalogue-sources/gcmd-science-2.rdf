  <skos:Concept rdf:about="fd8d9257-795c-4406-b205-cf20059d8e77">
    <skos:broader rdf:resource="0a81d67a-102b-4611-a38c-dbfdd7ba4e7d"/>
    <skos:prefLabel xml:lang="en">GAMMA RAY FLUX</skos:prefLabel>
    <gcmd:reference gcmd:text="CCRS Remote Sensing Glossary &apos;http://www.ccrs.nrcan.gc.ca/ccrs/eduref/ref/glosndxe.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">The portion of the electromagnetic spectrum from approximately 10^-7 to
10^-5 micrometers.  Most often, gamma ray sensors are used to detect
composition (from wavelengths of rays emitted by nuclei) or to measure
soil moisture.</skos:definition>
