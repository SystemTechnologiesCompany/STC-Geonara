    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">A type of distinctive, flat-topped, steep-sided volcano formed when lava  erupts through a thick glacier or ice sheet. They are somewhat rare worldwide, being confined to regions which were formerly covered by continental ice sheets and also had active volcanism during the same time period.</skos:definition>
    <dcterms:modified>2013-04-02 08:29:58.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
