  <skos:Concept rdf:about="aa1bc71c-daeb-401e-9e29-ebde975482cf">
    <skos:broader rdf:resource="a031952d-9f00-4ba5-9966-5f87ab9dfdd4"/>
    <skos:prefLabel xml:lang="en">THERMOHALINE CIRCULATION</skos:prefLabel>
    <gcmd:reference gcmd:text="Oceanography: Perspectives on a Fluid Earth, Steve Neshyba, John Wiley &amp; Sons, 1987." xml:lang="en"/>
    <skos:definition xml:lang="en">Circulation driven by the unequal heating of earth by the sun, togetherwith surface patterns of evaporation and precipitation.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c2920f06-fd42-47da-9989-3104f8fb7282">
