  <skos:Concept rdf:about="9a583e74-34e9-4eb5-af7a-03418d702af6">
    <skos:broader rdf:resource="7406a787-6ab6-429f-bc09-9a86d393e114"/>
    <skos:prefLabel xml:lang="en">WATER QUALITY</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from Jackson, Julia A. (1997) &lt;i&gt;Glossary of Geology, 4th Edition&lt;/i&gt;. Alexandria, VA: American Geological Institute, 769 p.&lt;p&gt; See &apos;http://water.usgs.gov/nawqa/&apos; as an example." xml:lang="en"/>
    <skos:definition xml:lang="en">The fitness of water for use (by plants or animals), being affected by
physical, chemical and biological factors.&lt;p&gt;
A Water Quality Advisory may include information on the types of contaminants
that may decrease the water quality in a particular area.&lt;br&gt;</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
