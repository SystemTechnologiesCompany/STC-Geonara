User Note=Insert Concept
System Note=add narrower relation
New Value=TROPOSPHERIC/MID-LEVEL CLOUDS (OBSERVED/ANALYZED) [a413f88b-859c-4035-a45b-2faa9934156b,82125] - ALTOCUMULUS [01021105-60ed-479a-a35b-faa73e286264,82159]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.noaa.gov/jetstream/clouds/ten-basic-clouds" xml:lang="en"/>
    <skos:narrower rdf:resource="01021105-60ed-479a-a35b-faa73e286264"/>
    <skos:narrower rdf:resource="f58d0203-0070-422c-ab52-6ca8ffbb6362"/>
    <skos:definition xml:lang="en">Mid-level clouds that form in the middle of the troposphere, the lowest part of the Earth&apos;s atmosphere. The clouds are made up of water droplets, ice crystals, or a combination of both, depending on the temperature and altitude.</skos:definition>
    <dcterms:modified>2024-10-09 09:38:35.0</dcterms:modified>
