    <gcmd:reference gcmd:text="Remote Sensing and Image Interpretation, John Wiley &amp;amp; Sons, 1994." xml:lang="en"/>
    <skos:definition xml:lang="en">Those properties which define the position of a satellite by determiningthe relationship between its axes and a reference datum  (such as theearth horizon, the sun, or stars).</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
