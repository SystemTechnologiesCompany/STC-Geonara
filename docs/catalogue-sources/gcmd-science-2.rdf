  <skos:Concept rdf:about="f930dcf2-ddb4-4242-9079-9c8d5ceeaa35">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">ENDANGERED SPECIES</skos:prefLabel>
    <gcmd:reference gcmd:text="Meffe, Gary K. and C. Ronald Carroll.  Principles of Conservation Biology.-2nd ed.  1997.  Sinauer Associates, Inc.  Sunderland, Massachusetts." xml:lang="en"/>
    <skos:definition xml:lang="en">An endangered species is a species in imminent danger of extinctionthroughout all or a significant portion of its range.</skos:definition>
