  <skos:Concept rdf:about="e3bef663-6116-4f15-995c-38c7cdc9652c">
    <skos:broader rdf:resource="91697b7d-8f2b-4954-850e-61d5f61c867d"/>
    <skos:prefLabel xml:lang="en">TIDES</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Garrison, T., 1993, Oceanography, An Invitation to Marine Science, Wadsworth Publishing Co., p. 528.    Neshyba, S., 1987, Oceanography, Perspectives on a Fluid Earth, John Wiley and Sons, Inc., p. 490." xml:lang="en"/>
    <skos:narrower rdf:resource="062be713-9c35-458e-86e2-26cea9415f5d"/>
    <skos:narrower rdf:resource="54ab2e0e-8e36-48e8-b020-ea9a5b453373"/>
    <skos:narrower rdf:resource="9afcf69c-f56f-45a9-afd9-6f929850326b"/>
    <skos:narrower rdf:resource="a5a6266a-9457-4acf-b140-fcdc8bc00a00"/>
    <skos:narrower rdf:resource="f4f40ec7-e698-4e11-b406-a0fa7f4b530c"/>
    <skos:definition xml:lang="en">Pertaining to the study of the periodic rise and fall of the seasurface, generated by long-wavelength waves which are caused by theinteraction of gravitational force and inertia.  Variables includecharacteristics of tides and other aspects important to their study.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c5ff6f39-0c35-488a-96f2-f3498c678e45">
    <skos:broader rdf:resource="83150c54-5da8-4ee8-9579-19b95a8dc10c"/>
    <skos:prefLabel xml:lang="en">VISIBLE WAVELENGTHS</skos:prefLabel>
    <gcmd:reference gcmd:text="Canada CCRS Remote Sensing Glossary" xml:lang="en"/>
    <skos:narrower rdf:resource="03f0c0a3-04a7-4ef8-8ec0-3c2266510815"/>
    <skos:narrower rdf:resource="7971f416-cf75-47f4-9108-6184baab58e5"/>
    <skos:narrower rdf:resource="a3792ab1-61af-48be-acf2-116c291a3765"/>
    <skos:narrower rdf:resource="b590bfda-a053-4439-8f86-a2811e67ce46"/>
    <skos:definition xml:lang="en">The band of the electromagnetic spectrum which can be  perceived by the
naked eye. This band ranges from about .75  μm to .4 μm, being bordered by
the infrared and ultraviolet bands.</skos:definition>
