    <skos:prefLabel xml:lang="en">WATER-LEAVING RADIANCE</skos:prefLabel>
    <skos:definition xml:lang="en">Radiation from the sun, reflected off particles in the water, and exitingthe ocean surface back into the atmosphere. The upwelling radiance at theocean surface.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
