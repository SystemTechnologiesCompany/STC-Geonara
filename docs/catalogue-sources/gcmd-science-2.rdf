  </skos:Concept>
  <skos:Concept rdf:about="ec839718-ba64-4bc5-8458-fae7390e11c4">
    <skos:broader rdf:resource="4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
    <dcterms:created>2018-06-06</dcterms:created>
    <skos:prefLabel xml:lang="en">ACTINIC FLUX</skos:prefLabel>
    <skos:changeNote>Date=2018-06-06 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=ACTINIC FLUX [ec839718-ba64-4bc5-8458-fae7390e11c4,367653] - ATMOSPHERIC RADIATION [4ad0c52d-6449-48ff-8678-adc6b2cebcb7,83505]</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Meteorology, 2018, http://glossary.ametsoc.org/wiki/Actinic_flux" xml:lang="en"/>
    <skos:definition xml:lang="en">The spherically integrated radiation flux in the earth&apos;s atmosphere that originates from the sun, including the direct beam and any scattered components.This radiation is responsible for initiating the chemistry of the atmosphere. Compare radiance, irradiance.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a72b96ad-3755-4205-b353-66592c7bff54">
    <skos:broader rdf:resource="4dc6b614-36ad-4e3b-ac6f-af6e0aa6378b"/>
