    <skos:prefLabel xml:lang="en">LESSON PLANS</skos:prefLabel>
    <gcmd:reference gcmd:text="NASA GCMD" xml:lang="en"/>
    <skos:definition xml:lang="en">Lesson Plans are defined as Education / Outreach Services that comprise a set of courses, sections, or teaching modules related to a topic or topics within the Earth Sciences and/or Global Environmental Change.</skos:definition>
