    <skos:prefLabel xml:lang="en">SURFACE PRESSURE</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Weather and Climate, American Meteorological Society, 1996." xml:lang="en"/>
    <skos:definition xml:lang="en">In meteorology, the atmospheric pressure at a given location on theearth&apos;s surface.</skos:definition>
