    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">An isolated, comparatively small reef outcrop, usually within a lagoon or embayment, often circular and surrounded by sand or seagrass. Patch reefs are common.</skos:definition>
