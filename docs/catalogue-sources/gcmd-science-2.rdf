    <skos:prefLabel xml:lang="en">PARTICLE COMPOSITION</skos:prefLabel>
    <gcmd:reference gcmd:text="Jursa, A.S., ed. 1985. Handbook of Geophysics and the Space Enviornment, Air Force Geophysics Laboratory, USAF. (Available from NTIS, Springfield, VA)." xml:lang="en"/>
    <skos:definition xml:lang="en">Particle composition refers to the elemental composition of solar particles,such as protons, electrons, atoms, etc.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c39210ba-7659-424b-a2f0-5777a1519115">
    <skos:broader rdf:resource="a82d885e-34cd-496a-b34d-17a23ad04126"/>
    <skos:prefLabel xml:lang="en">PARTICLE DISTRIBUTION FUNCTIONS</skos:prefLabel>
    <gcmd:reference gcmd:text="From: FREQUENTLY USED TERMS IN CONVENTIONAL FUSION RESEARCH AND PLASMA PHYSICS Edited by Robert F. Heeter, rfheeter@pppl.gov" xml:lang="en"/>
    <skos:definition xml:lang="en">A characterization of the density of particles located at a given point inphase space (a combination
of either velocity or position coordinates) at a given time. The velocity-spacedistribution function gives the number of particles with a particular velocity;the position-space distribution function is synonymous with the particledensity in position-space.  Different combinations of position and spatialcoordinates are useful in different problems.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
