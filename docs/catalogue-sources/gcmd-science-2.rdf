  <skos:Concept rdf:about="d8494f01-bcec-4232-ad78-fbd92c242e62">
    <skos:broader rdf:resource="d8dcfd36-f71c-499f-84f5-43da9fee26c5"/>
    <skos:prefLabel xml:lang="en">HYDROPEROXY</skos:prefLabel>
    <gcmd:reference gcmd:text="American Meteorological Society. 2000. Glossary of Meteorology, Second Edition. Boston, MA: American Meteorological Society." xml:lang="en"/>
    <skos:definition xml:lang="en">Consists of oxygenated compounds that are organic derivitives of hydrogenperoxide. These compounds are formed in the oxidation of hydrocarbons inrelatively clean air, where oxides of nitrogen are not abundant.</skos:definition>
