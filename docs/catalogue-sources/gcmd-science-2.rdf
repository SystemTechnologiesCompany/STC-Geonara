  <skos:Concept rdf:about="eca0080c-b001-4b6a-b978-f76415e28421">
    <skos:broader rdf:resource="1532e590-a62d-46e3-8d03-2351bc48166a"/>
    <skos:prefLabel xml:lang="en">LIQUID WATER EQUIVALENT</skos:prefLabel>
    <skos:changeNote>Date=2014-04-14 User Id=128.183.164.42 Entity=Definition Operation=UPDATE Field=reference 
User Note=updated definition
System Note=update Definition
New Value=National Weather Service Glossary, NOAA, 2009</skos:changeNote>
    <skos:changeNote>Date=2014-04-14 User Id=128.183.164.42 Entity=Definition Operation=UPDATE Field=text 
User Note=updated definition
System Note=update Definition
Old Value=The amount of water that is produced when frozen  precipitation is
collected and melted into liquid form.
New Value=The liquid content of solid precipitation that has accumulated on the ground (snow depth). The accumulation may consist of snow, ice formed by freezing precipitation, freezing liquid precipitation, or ice formed by the refreezing of melted snow.</skos:changeNote>
    <gcmd:reference gcmd:text="National Weather Service Glossary, NOAA, 2009" xml:lang="en"/>
    <skos:definition xml:lang="en">The liquid content of solid precipitation that has accumulated on the ground (snow depth). The accumulation may consist of snow, ice formed by freezing precipitation, freezing liquid precipitation, or ice formed by the refreezing of melted snow.</skos:definition>
    <dcterms:modified>2014-04-14 16:22:54.0</dcterms:modified>
