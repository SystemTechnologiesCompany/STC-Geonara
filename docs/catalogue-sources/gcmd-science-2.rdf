  <skos:Concept rdf:about="e0d7fb1f-5233-4664-8e83-3c65ca344f41">
    <skos:broader rdf:resource="02d92216-70c6-437c-8c15-2b76f2132921"/>
    <skos:prefLabel xml:lang="en">DATA COMPRESSION</skos:prefLabel>
    <gcmd:reference gcmd:text="NASA GCMD" xml:lang="en"/>
    <skos:definition xml:lang="en">Compression services are defined as Data Handling Services that reduce the proportions (file size, physical size, volume or mass) of Earth science data. Data can be reduced by mechanical means (e.g., dehydration) or by 
 computer algorithms (e.g., .zip). EXAMPLES: Dehydration or Deflation (mechanical). ZIP, TAR, JAR, GZIP (computer).</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
