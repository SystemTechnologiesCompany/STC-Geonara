  <skos:Concept rdf:about="d4f4b5d3-27b2-4b7d-bb69-733b67ac687a">
    <skos:broader rdf:resource="ce4b2c6e-3d69-4cf1-8416-c36e5f9b1b2c"/>
    <skos:prefLabel xml:lang="en">GEOTECHNICAL PROPERTIES</skos:prefLabel>
    <skos:definition xml:lang="en">A distinguishing trait, quality, or property of any deposit of insolublematerial, primarily rock and soil particles, transported from land areasto the ocean by wind, ice, and rivers, as well as the remains of marineorganisms, products of  submarine volcanism, chemicalprecipitates from seawater, and materials from outer space (e.g.,meteorites) that accumulate on the seafloor.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="cddc37fd-8540-4c78-b567-add74e6b789b">
    <skos:broader rdf:resource="ce4b2c6e-3d69-4cf1-8416-c36e5f9b1b2c"/>
    <skos:prefLabel xml:lang="en">SEDIMENTARY TEXTURES</skos:prefLabel>
    <skos:definition xml:lang="en">The characterization of sediment by the size of individual particles; theclassification of sediment by particle-size classes.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
