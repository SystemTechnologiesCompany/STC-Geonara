    <skos:prefLabel xml:lang="en">ATMOSPHERIC FEEDBACKS</skos:prefLabel>
    <skos:changeNote>Date=2019-06-03 User Id=mmorahan Entity=PrefLabel Operation=UPDATE Field=text 
User Note=Rename Concept
System Note=update PrefLabel
Old Value=Atmospheric Feedbacks
New Value=ATMOSPHERIC FEEDBACKS</skos:changeNote>
    <skos:changeNote>Date=2019-05-30 User Id=mmorahan Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=Atmospheric Feedbacks [fc77777e-614f-41f1-9b97-d5324fa99105,368855] - Climate Feedbacks [de62c07e-96c6-44fb-a3a1-cd2902305691,368851]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from the IPCC TAR (https://www.ipcc.ch/site/assets/uploads/2018/03/TAR-07.pdf) and the USGCRP Glossary (https://www.globalchange.gov/climate-change/glossary)." xml:lang="en"/>
    <skos:definition xml:lang="en">Processes within the atmosphere through which the climate system iscontrolled, changed, or modulated. Atmospheric feedbacks involve aperturbation in a climate quantity that causes a change in a secondquantity, and the change in the second quantity ultimately leads to anadditional change in the first. Examples include water vapor and cloudfeedbacks.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="daab3b2a-1fe7-4ad9-8340-1a7cfa54a2ac">
    <skos:broader rdf:resource="dba19648-3f52-48ba-b00b-8527d44c4d74"/>
    <skos:prefLabel xml:lang="en">METHANE</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of climate change http://calspace.ucsd.edu/virtualmuseum/Glossary_Climate/gloss_m-r.shtml  See also: http://www.ncdc.noaa.gov/paleo/icecore/antarctica/vostok/vostok_methane.html" xml:lang="en"/>
    <skos:definition xml:lang="en">Methane (CH4) is a greenhouse gas and is seen in polar ice cores. From the icecore record, it is known that methane rose rapidly whenever climate changedfrom glacial to interglacial conditions (during &apos;deglaciation&apos;). Warming ofwater bathing the seafloor could have led to large-scale release of methanefrom the melting of methane ice.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
