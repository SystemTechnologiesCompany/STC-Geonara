  <skos:Concept rdf:about="d8b34f6e-0713-45ae-b0c7-23329b0b8f0b">
    <skos:broader rdf:resource="625da982-3648-43fc-a640-1b230509944e"/>
    <dcterms:created>2020-09-29</dcterms:created>
    <skos:prefLabel xml:lang="en">COMMON MIDPOINT GATHER</skos:prefLabel>
    <skos:changeNote>Date=2020-09-29 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=COMMON MIDPOINT GATHER [d8b34f6e-0713-45ae-b0c7-23329b0b8f0b,560729] - RADAR BACKSCATTER [625da982-3648-43fc-a640-1b230509944e,86025]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.18122/td/1418/boisestate  https://doi.org/10.1002/2016JF003942" xml:lang="en"/>
    <skos:definition xml:lang="en">A common midpoint (CMP) gather is constructed when multichannel surveys image the same subsurface target through multiple pathways, using a range of source‐receiver offsets. The CMP gather is a collection of all recorded offsets co-located about a single reflection point in the snow or firn.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f9385327-31fe-49a6-b3d6-073d6897ff4a">
    <skos:broader rdf:resource="85d46af8-f6ce-490d-a971-0f03b301c1e4"/>
    <dcterms:created>2013-03-07</dcterms:created>
    <skos:prefLabel xml:lang="en">REFLECTION</skos:prefLabel>
    <skos:changeNote>Date=2017-03-10 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A method of exploration geophysics that uses the principles of seismology to estimate of the properties of the Earth&apos;s subsurface from reflected seismic waves. This measurement is also known as seismic reflection.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-03-07 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=REFLECTION [f9385327-31fe-49a6-b3d6-073d6897ff4a,83137] - METALS PHYSICAL/OPTICAL PROPERTIES [85d46af8-f6ce-490d-a971-0f03b301c1e4,83117]</skos:changeNote>
    <gcmd:reference gcmd:text="Sheriff, R. E., Geldart, L. P., (1995), 2nd Edition. Exploration Seismology. Cambridge University Press" xml:lang="en"/>
    <skos:definition xml:lang="en">A method of exploration geophysics that uses the principles of seismology to estimate of the properties of the Earth&apos;s subsurface from reflected seismic waves. This measurement is also known as seismic reflection.</skos:definition>
    <dcterms:modified>2017-03-10 07:51:14.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
