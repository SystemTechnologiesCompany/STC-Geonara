    <skos:narrower rdf:resource="0b4081fa-5233-4484-bc82-706976defa0e"/>
    <skos:narrower rdf:resource="abc6f016-d1f0-4725-b847-639de054d13f"/>
    <skos:narrower rdf:resource="14802b53-b702-438f-8c8a-f51506807ce6"/>
    <skos:narrower rdf:resource="7437925f-7e10-4c96-af36-f3532ec24276"/>
    <skos:narrower rdf:resource="6a2a2417-1a9c-4767-bffd-6b99f9747bab"/>
    <skos:narrower rdf:resource="85510ccc-5dc9-44ff-871e-775e856714f8"/>
    <skos:definition xml:lang="en">Biological classification is the process by which scientists group living organisms. Organisms are classified based on how similar they are. Historically, similarity was determined by examining the physical characteristics of an organism but modern classification uses a variety of techniques including genetic analysis.Organisms are classified according to a system of seven ranks:KingdomPhylumClassOrderFamilyGenusSpecies</skos:definition>
    <dcterms:modified>2017-03-15 12:10:00.0</dcterms:modified>
