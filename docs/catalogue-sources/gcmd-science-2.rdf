  <skos:Concept rdf:about="fa68e752-f3a7-4361-a000-47c908545e49">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">SURVIVAL RATES</skos:prefLabel>
    <gcmd:reference gcmd:text="Krebs, C. 1994. Ecology. HarperCollins. New York, New York and Hickman, C. and L. Roberts.  1995. Animal Diversity.  William C. Brown Publishers.  Dubuque, IA." xml:lang="en"/>
    <skos:definition xml:lang="en">Survival is the converse of mortality for an organism.	Survival is a resultof a combination of factors that contribute toward successfulreproductive advantage and the ability to resist being killed or eaten byanother species.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="fd06e0a2-f689-4b33-8a85-f38bf4966808">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">SPECIES LIFE HISTORY</skos:prefLabel>
    <gcmd:reference gcmd:text="Meffe, Gary K. and C. Ronald Carroll.  Principles of Conservation Biology.2nd ed.  1997. Sinauer Associates, Inc. Sunderland, Massachusetts." xml:lang="en"/>
    <skos:definition xml:lang="en">Life History of a population are long-term attributes, such as age atfirst breeding, which are more likely to change in response to long-termchanges in an organism&apos;s environment.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
