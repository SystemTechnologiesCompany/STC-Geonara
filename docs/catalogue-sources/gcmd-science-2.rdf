    <gcmd:reference gcmd:text="Glossary of Weather and Climate, American Meteorological Society, 1996." xml:lang="en"/>
    <skos:definition xml:lang="en">A visible aggregate of minute water droplets suspended in the atmosphereclose to the ground; a cloud in contact with the earth&apos;s surface.</skos:definition>
