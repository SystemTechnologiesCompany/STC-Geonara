  <skos:Concept rdf:about="cf3d1728-7606-4561-a0dd-116b4dbec21f">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">EVOLUTIONARY ADAPTATION</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J. and Richard T. Wright. 1998. Environmental Science: the Way the World Works.-6th ed. Prentice Hall, Inc. Upper Saddle River, New Jersey." xml:lang="en"/>
    <skos:definition xml:lang="en">Adaptation is an ecological or evolutionary change in structure orfunction that produces better adjustment of an organism to its environmentand hence enhances its ability to survive and reproduce.</skos:definition>
