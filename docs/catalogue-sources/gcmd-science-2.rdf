relationship type: null
relationship value: null
generated by: null</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from: A Dictionary of Ecology, Michael Allaby, ed., Oxford University Press, 1998." xml:lang="en"/>
    <skos:definition xml:lang="en">The artificial augmentation of the amount of water available to crops/plants, either by spraying water directly on to the plants or making it available to their root systems through a series of surface channels or ditches.</skos:definition>
