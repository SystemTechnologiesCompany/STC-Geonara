  <skos:Concept rdf:about="f082ad51-4ce4-4ffe-be50-6753c4f997ae">
    <skos:broader rdf:resource="41adc080-c182-4753-9666-435f8b1c913f"/>
    <skos:prefLabel xml:lang="en">GLOBAL POSITIONING SYSTEMS</skos:prefLabel>
    <gcmd:reference gcmd:text="NOAA" xml:lang="en"/>
    <skos:definition xml:lang="en">A surveying method that uses a set of 24 satellites in geostationary position high above the Earth. Specially designed GPS receivers, when positioned at a point on Earth, can measure the distance from that point to three or more orbiting satellites. The coordinates of the point are determined through the geometric calculations of triangulation. GPS provides accurate geodetic data for any point on the Earth.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="b2318fb3-788c-4f36-a1d1-36670d2da747">
    <skos:broader rdf:resource="42c6d91b-afef-4638-95c5-0d130828b2e7"/>
    <dcterms:created>2018-03-07</dcterms:created>
    <skos:prefLabel xml:lang="en">SELENIUM</skos:prefLabel>
    <skos:changeNote>Date=2018-03-07 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A chemical element, a nonmetal, that rarely occurs in its elemental state or as pure ore compounds in the Earth&apos;s crust. Selenium is found in metal sulfide ores, where it partially replaces the sulfur.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2018-03-07 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SELENIUM [b2318fb3-788c-4f36-a1d1-36670d2da747,310665] - CONTAMINANTS [42c6d91b-afef-4638-95c5-0d130828b2e7,84623]</skos:changeNote>
    <gcmd:reference gcmd:text="Chemistry of the Elements (2nd ed.)" xml:lang="en"/>
    <skos:definition xml:lang="en">A chemical element, a nonmetal, that rarely occurs in its elemental state or as pure ore compounds in the Earth&apos;s crust. Selenium is found in metal sulfide ores, where it partially replaces the sulfur.</skos:definition>
    <dcterms:modified>2018-03-07 09:35:46.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
