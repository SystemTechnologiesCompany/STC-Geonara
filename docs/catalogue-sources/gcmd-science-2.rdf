    <gcmd:reference gcmd:text="Fluorescent Mineral Society" xml:lang="en"/>
    <skos:definition xml:lang="en">The emission of “cold light” from minerals. There are several varieties of luminescence, each named according to the source of energy, or the trigger for the luminescence.</skos:definition>
