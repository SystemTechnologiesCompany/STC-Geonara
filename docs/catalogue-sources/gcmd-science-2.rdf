    <skos:prefLabel xml:lang="en">SHOALS</skos:prefLabel>
    <skos:changeNote>Date=2013-08-06 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SHOALS [cae5bafd-10a7-4bcf-af1a-3e187ee5e955,105543] - COASTAL LANDFORMS [0cff6e4b-e42a-4565-89ff-350adf41ed69,105283]</skos:changeNote>
    <skos:changeNote>Date=2013-08-20 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A somewhat linear landform  within or extending into a body of water, typically composed of sand, silt or small pebbles. A spit or sandspit is a type of shoal.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">A somewhat linear landform  within or extending into a body of water, typically composed of sand, silt or small pebbles. A spit or sandspit is a type of shoal.</skos:definition>
    <dcterms:modified>2013-08-20 09:23:13.0</dcterms:modified>
