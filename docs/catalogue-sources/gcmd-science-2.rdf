    <gcmd:reference gcmd:text="NASA/JPL Polar Oceanography Glossary http://oceans-www.jpl.nasa.gov/polar/Glossary/terms.html" xml:lang="en"/>
    <skos:definition xml:lang="en">How salty the water is. Brine has a very high salinity. Fresh water has a salinity of zero.</skos:definition>
    <dcterms:modified>2012-07-10 15:41:51.0</dcterms:modified>
