    <gcmd:reference gcmd:text="Black, J.A. 1986.  Oceans and Coasts, An Introduction to Oceanography. William C. Brown Publishers.  p. 278. Garrison, T.  1993.  Oceanography, An Invitation to Marine Science. Wadsworth Publishing Co.  p. 519." xml:lang="en"/>
