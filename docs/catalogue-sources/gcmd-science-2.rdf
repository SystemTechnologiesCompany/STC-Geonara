    <skos:prefLabel xml:lang="en">DICARBON MONOXIDE</skos:prefLabel>
    <skos:changeNote>Date=2020-10-16 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=DICARBON MONOXIDE [94863274-c0fc-4386-9bac-5b6f5d1b9d06,560739] - CARBON AND HYDROCARBON COMPOUNDS [19ab681c-bdd7-4793-bbdb-1ec498575314,83945]</skos:changeNote>
    <gcmd:reference gcmd:text="Frenking, Gernot; Tonner, Ralf &apos;Divalent carbon(0) compounds&apos; Pure and Applied Chemistry 2009, vol. 81, pp. 597-614. doi:10.1351/PAC-CON-08-11-03" xml:lang="en"/>
    <skos:definition xml:lang="en">Dicarbon monoxide (C2O) is a molecule that contains two carbon atoms and one oxygen atom. It is a linear molecule that, because of its simplicity, is of interest in a variety of areas. It is, however, so extremely reactive that it is not encountered in everyday life. It is classified as a cumulene and an oxocarbon.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="c8186508-c5dd-4282-86d2-b217643a87d8">
    <skos:broader rdf:resource="1bf8f27a-d6ff-4cb6-acb7-7e5cce11e029"/>
    <skos:prefLabel xml:lang="en">PERCHING BIRDS</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: Phylum Chordata. Class Aves. Order Passeriformes are true perching birds with four toes, three directed forward and one backward, and sharp curved claws.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="new world encyclopedia" xml:lang="en"/>
    <skos:definition xml:lang="en">Phylum Chordata. Class Aves. Order Passeriformes are true perching birds with four toes, three directed forward and one backward, and sharp curved claws.</skos:definition>
