  <skos:Concept rdf:about="b62123dd-1bf5-4222-a646-05d71d729c75">
    <skos:broader rdf:resource="2575cfaf-1a09-48b6-acb9-fda23b6f4719"/>
    <dcterms:created>2013-08-06</dcterms:created>
    <skos:prefLabel xml:lang="en">RIBBED/ROGAN MORAINE</skos:prefLabel>
    <skos:changeNote>Date=2013-08-26 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Type of basal moraines that forms a series of ribs perpendicular to the ice flow in an ice sheet. The depressions between the ribs are sometimes filled with water making the Rogen moraines look like tigerstripes on aerial photographs.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-08-06 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=RIBBED/ROGAN MORAINE [b62123dd-1bf5-4222-a646-05d71d729c75,105651] - MORAINES [2575cfaf-1a09-48b6-acb9-fda23b6f4719,105627]</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">Type of basal moraines that forms a series of ribs perpendicular to the ice flow in an ice sheet. The depressions between the ribs are sometimes filled with water making the Rogen moraines look like tigerstripes on aerial photographs.</skos:definition>
    <dcterms:modified>2013-08-26 08:47:14.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
