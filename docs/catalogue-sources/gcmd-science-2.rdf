    <skos:prefLabel xml:lang="en">CONDENSATION</skos:prefLabel>
    <skos:changeNote>Date=2017-04-21 User Id=sritz Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
Old Value=Glossary of Meteorology, American Meteorological Society, 1998.
New Value=Glossary of Meteorology, American Meteorological Society</skos:changeNote>
    <skos:changeNote>Date=2017-04-21 User Id=sritz Entity=Definition Operation=UPDATE Field=text 
System Note=update Definition
Old Value=The physical process by which a vapor becomes a liquid or solid.
New Value=In meteorological usage, this term is applied only to the transformation from vapor to liquid; any process in which a solid forms directly from its vapor is termed deposition, and the reverse process sublimation.</skos:changeNote>
    <skos:changeNote>Date=2017-04-20 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Move Concepts
System Note=add broader relation
New Value=CONDENSATION [d7fbbafe-fc73-4b63-9837-3d53d2370d9d,84643] - WATER VAPOR PROCESSES [3c4fe00c-6fb1-403e-a053-3a0174a6dfe6,278813]</skos:changeNote>
    <skos:changeNote>Date=2017-04-20 User Id=sritz Entity=BroaderRelation Operation=DELETE 
User Note=Move Concepts
System Note=delete broader relation
Old Value=CONDENSATION [d7fbbafe-fc73-4b63-9837-3d53d2370d9d,84643] - ATMOSPHERIC WATER VAPOR [286d2ae0-9d86-4ef0-a2b4-014843a98532,83915]</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society" xml:lang="en"/>
    <skos:definition xml:lang="en">In meteorological usage, this term is applied only to the transformation from vapor to liquid; any process in which a solid forms directly from its vapor is termed deposition, and the reverse process sublimation.</skos:definition>
