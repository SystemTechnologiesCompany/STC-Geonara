    <skos:prefLabel xml:lang="en">CFC-11</skos:prefLabel>
    <skos:changeNote>Date=2022-03-03 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=CFC-11 [94472216-6cd7-434b-beec-17067fb69b2e,836060] - CHLOROFLUOROCARBONS [e78ae4ce-807a-4417-ad6e-a458c6da6638,833781]</skos:changeNote>
    <gcmd:reference gcmd:text="https://en.wikipedia.org/wiki/Trichlorofluoromethane" xml:lang="en"/>
    <skos:definition xml:lang="en">Trichlorofluoromethane, also called freon-11, CFC-11, or R-11, is a chlorofluorocarbon (CFC). It is a colorless, faintly ethereal, and sweetish-smelling liquid that boils around room temperature.[5] CFC-11 is a Class 1 ozone-depleting substance which damages Earth&apos;s protective stratospheric ozone layer.[6]Contents.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
