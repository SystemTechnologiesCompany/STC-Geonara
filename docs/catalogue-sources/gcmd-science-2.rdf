  <skos:Concept rdf:about="a60ae1b6-abfc-4905-8c09-772da7bb1a10">
    <skos:broader rdf:resource="457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
    <skos:prefLabel xml:lang="en">FLUORESCENCE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added narrower relation from FLUORESCENCE [a60ae1b6-abfc-4905-8c09-772da7bb1a10] to MACROALGAE FLUORESCENCE [092956f8-767b-4c43-94d3-72d5f8dba898]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from: Webster&apos;s College Dictionary. 1991. Random House." xml:lang="en"/>
    <skos:narrower rdf:resource="092956f8-767b-4c43-94d3-72d5f8dba898"/>
    <skos:definition xml:lang="en">The emission of radiation, especially of visible light, by a substanceduring exposure to external radiation, as light or x-rays. Since thechlorophyll molecule fluoresces, the measurement of fluorescence can beused to calculate chlorophyll concentration in the ocean.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
