  <skos:Concept rdf:about="af67dee1-7c50-4e73-8db8-b1f421df67fb">
    <skos:broader rdf:resource="1bf8f27a-d6ff-4cb6-acb7-7e5cce11e029"/>
    <skos:prefLabel xml:lang="en">HERONS/EGRETS AND ALLIES</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: Phylum Chordata. Class Aves. Order Pelecaniformes. Family Ardeidae are long-legged freshwater and coastal birds. Though not egrets are not biologically distinct from herons, they tend to be mainly white with decorative plumes. Herons has the same build has egrets but tend to be larger with thick daggerlike bills.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="allaboutbirds.org" xml:lang="en"/>
    <skos:definition xml:lang="en">Phylum Chordata. Class Aves. Order Pelecaniformes. Family Ardeidae are long-legged freshwater and coastal birds. Though not egrets are not biologically distinct from herons, they tend to be mainly white with decorative plumes. Herons has the same build has egrets but tend to be larger with thick daggerlike bills.</skos:definition>
    <dcterms:modified>2017-03-15 09:17:13.0</dcterms:modified>
