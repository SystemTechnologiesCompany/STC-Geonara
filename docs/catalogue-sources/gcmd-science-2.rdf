  <skos:Concept rdf:about="b4a924bb-0d42-4169-bad7-3856f69f0c4a">
    <skos:broader rdf:resource="0517ae1f-7617-4f3b-80cb-649178032825"/>
    <skos:prefLabel xml:lang="en">ACOUSTIC SCATTERING</skos:prefLabel>
    <skos:definition xml:lang="en">The process by which some sound is dispersed to travel in directions otherthan that which from it was incident by particles suspended in the mediumthrough which it is travelling.</skos:definition>
