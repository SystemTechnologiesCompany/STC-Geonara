  <skos:Concept rdf:about="a4ed794f-d7b6-4e53-b565-3b86fe584ba3">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">MIGRATORY RATES/ROUTES</skos:prefLabel>
    <gcmd:reference gcmd:text="Feldhamer, G., L.Drickamer, S.Vessey, J.Merritt.  1999.  Mammalogy: Adaptation, Diversity, Ecology.  McGraw Hill-Hill Companies, Inc." xml:lang="en"/>
    <skos:definition xml:lang="en">Migration is a persistent movement across different habitats in responseto seasonal changes in resource availability and quality. Migratory ratesand routes are observed for many migrating species.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="f173021d-afc4-4a8f-8432-30c0cf832e3b">
    <skos:broader rdf:resource="58f39353-7e1c-4884-9501-376cd0377fbf"/>
    <skos:prefLabel xml:lang="en">POST-BREEDING PERIODS</skos:prefLabel>
    <gcmd:reference gcmd:text="U.S. Geological Survey, Biological Resources Division, Western Ecological Resource Center" xml:lang="en"/>
    <skos:definition xml:lang="en">Post-Breeding is the time after nesting.</skos:definition>
