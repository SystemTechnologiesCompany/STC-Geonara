  <skos:Concept rdf:about="b9957bbc-3c12-481d-86a0-0f6cf2bb8219">
    <skos:broader rdf:resource="c1f9f5fa-245c-4055-81cf-5230c076c0ce"/>
    <skos:prefLabel xml:lang="en">FEED CONTAMINATION AND TOXICOLOGY</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Herren, R.V., and R.L. Donahue.  1991.  The Agriculture Dictionary, Delmar Publishers INC.  Albany, New york.  553pp." xml:lang="en"/>
    <skos:definition xml:lang="en">Any measure related to the contamination and toxicology of feedby microorganisms, pathogens, viruses, weeds, etc...</skos:definition>
