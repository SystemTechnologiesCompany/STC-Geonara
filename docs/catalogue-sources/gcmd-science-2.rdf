    <gcmd:reference gcmd:text="Adapted from: Herren, R.V., and R.L. Donahue.  1991.  The Agriculture Dictionary, Delmar Publishers INC.  Albany, New york.  553pp." xml:lang="en"/>
    <skos:narrower rdf:resource="9244fe19-b86f-4a8d-82bf-c52f804a77e3"/>
    <skos:narrower rdf:resource="b9957bbc-3c12-481d-86a0-0f6cf2bb8219"/>
    <skos:narrower rdf:resource="fec2eb53-bc69-4d35-849c-c2bedf5dc6cf"/>
    <skos:narrower rdf:resource="cf9ef34d-ed39-4c8d-bf00-ca1b0bb11363"/>
    <skos:definition xml:lang="en">Any measure related to harvested forage, such as hay, fodder, silage, grain,or other processed feed for livestock.</skos:definition>
