  <skos:Concept rdf:about="b283a59c-0e9a-469c-baf4-591b64cd4671">
    <skos:broader rdf:resource="4f938731-d686-4d89-b72b-ff60474bb1f0"/>
    <dcterms:created>2020-05-21</dcterms:created>
    <skos:prefLabel xml:lang="en">VALIDATION</skos:prefLabel>
    <skos:changeNote>Date=2020-05-21 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=VALIDATION [b283a59c-0e9a-469c-baf4-591b64cd4671,560193] - CALIBRATION/VALIDATION [4f938731-d686-4d89-b72b-ff60474bb1f0,86319]</skos:changeNote>
    <gcmd:reference gcmd:text="https://ec.europa.eu/eurostat/cros/system/files/methodology_for_data_validation_v1.0_rev-2016-06_final.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">The process of ensuring data have undergone data cleansing to ensure they have data quality, that is, that they are both correct and useful. It uses routines, often called &apos;validation rules&apos;, &apos;validation constraints&apos;, or &apos;check routines&apos;, that check for correctness, meaningfulness, and security of data that are input to the system. The rules may be implemented through the automated facilities of a data dictionary, or by the inclusion of explicit application program validation logic of the computer and its application.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a8f5c969-34e9-4284-afb5-ff2113f5f881">
    <skos:broader rdf:resource="4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
    <skos:prefLabel xml:lang="en">SHORTWAVE RADIATION</skos:prefLabel>
    <skos:changeNote>Date=2021-05-12 User Id=sritz Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=SHORTWAVE RADIATION [a8f5c969-34e9-4284-afb5-ff2113f5f881,604550] - DOWNWELLING SHORTWAVE RADIATION [74de6492-617b-4046-8a4e-1336c3238a7e,606938]</skos:changeNote>
    <gcmd:reference gcmd:text="WMO. 1966. International Meteorological Vocabulary. WMO/OMM/BMO, No. 182. TP. 91., Switzerland. Huschke, R.E., ed. 1959. Glossary of Meteorology, American Meteorological Society, Boston, MA." xml:lang="en"/>
    <skos:narrower rdf:resource="74de6492-617b-4046-8a4e-1336c3238a7e"/>
    <skos:definition xml:lang="en">Shortwave radiation is radiation at wavelengths shorter than 4microns. Sometimes called the solar radiation. Usually radiation in thevisible and near-infrared wavelengths.</skos:definition>
    <dcterms:modified>2021-05-12 15:56:33.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="ec9e0b6a-1315-4569-93bc-0f1190bb8c08">
    <skos:broader rdf:resource="4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
    <skos:prefLabel xml:lang="en">SCATTERING</skos:prefLabel>
    <skos:changeNote>Date=2026-04-07 User Id=system System Note=Added narrower relation from SCATTERING [ec9e0b6a-1315-4569-93bc-0f1190bb8c08] to RAYLEIGH SCATTERING [cc8c80ae-0c01-4185-9255-b8dc77d18279]</skos:changeNote>
    <gcmd:reference gcmd:text="CEOS Glossary of Remote Sensing Terms, &apos;http://ceos.cnes.fr:8100/cdrom-00b2/ceos1/science/glossary/gloss.htm&apos;  . See also Huschke, R.E., ed. 1959. Glossary of Meteorology, American Meteorological Society, Boston, MA" xml:lang="en"/>
    <skos:narrower rdf:resource="cc8c80ae-0c01-4185-9255-b8dc77d18279"/>
    <skos:definition xml:lang="en">The process in which a wave or beam of particles is diffused or deflected
by collisions with particles of the medium which it traverses. Along
with absorption, scattering is a major cause of the attenuation of
radiation by the atmosphere.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="a87d6473-3a03-4bc6-aa21-6157fae96b8e">
    <skos:broader rdf:resource="4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
    <dcterms:created>2016-08-29</dcterms:created>
    <skos:prefLabel xml:lang="en">POLARIZED REFLECTANCE</skos:prefLabel>
    <skos:changeNote>Date=2016-08-29 User Id=mpmorahan Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=POLARIZED REFLECTANCE [a87d6473-3a03-4bc6-aa21-6157fae96b8e,277829] - ATMOSPHERIC RADIATION [4ad0c52d-6449-48ff-8678-adc6b2cebcb7,83505]</skos:changeNote>
    <gcmd:reference gcmd:text="The American Heritage® Science Dictionary" xml:lang="en"/>
    <skos:definition xml:lang="en">To cause the electrical and magnetic fields associated with electromagnetic waves, especially light, to vibrate in a particular direction or path. The transverse electric and magnetic waves always vibrate at right angles to each other, but in ordinary unpolarized light sources, the direction of polarization of each wave is randomly distributed. Light can be polarized by reflection, and by passing through certain materials.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
