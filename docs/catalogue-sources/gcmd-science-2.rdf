  <skos:Concept rdf:about="e501d002-d11e-4569-8c0d-e40ae5b45f65">
    <skos:broader rdf:resource="457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
    <skos:prefLabel xml:lang="en">ABSORPTION</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Oceanography and the Related Geosciences with References &apos;http://stommel.tamu.edu/~baum/paleo/paleogloss/paleogloss.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">A process by which incident radiation is taken into a body and
retained without reflection or transmission. It increases either the
internal or the kinetic energy of the molecules or atoms composing the
absorbing medium.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
