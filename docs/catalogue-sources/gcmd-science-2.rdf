    <skos:prefLabel xml:lang="en">FORMIC ACID</skos:prefLabel>
    <skos:changeNote>Date=2020-10-16 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=FORMIC ACID [eb1bfadc-8aa6-477b-af6a-6c320aa21351,560741] - CARBON AND HYDROCARBON COMPOUNDS [19ab681c-bdd7-4793-bbdb-1ec498575314,83945]</skos:changeNote>
    <gcmd:reference gcmd:text="National Library of Medicine, https://pubchem.ncbi.nlm.nih.gov/compound/Formic-acid" xml:lang="en"/>
    <skos:definition xml:lang="en">Formic acid, also known as formate or methanoic acid, belongs to the class of organic compounds known as carboxylic acids. Carboxylic acids are compounds containing a carboxylic acid group with the formula -C(=O)OH. Formic acid exists as a liquid, soluble (in water), and a weakly acidic compound (based on its pKa).</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
