    <skos:prefLabel xml:lang="en">CARBON TETRAFLUORIDE</skos:prefLabel>
    <skos:changeNote>Date=2022-03-03 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=CARBON TETRAFLUORIDE [cf96b289-d316-4abc-8540-b8849e2f6140,836056] - HALOCARBONS AND HALOGENS [d46a5046-e1c6-4a09-a2f1-db6a21eda611,832624]</skos:changeNote>
    <gcmd:reference gcmd:text="National Library of Medicine, https://pubchem.ncbi.nlm.nih.gov/compound/Carbon-tetrafluoride" xml:lang="en"/>
    <skos:definition xml:lang="en">Tetrafluoromethane is a colorless nonflammable gas. It is shipped as a liquid under pressure. It may be narcotic at high concentrations. Under prolonged exposure to fire or heat the containers may rupture violently and rocket. It is used as a refrigerant.</skos:definition>
