  <skos:Concept rdf:about="b4e28ec2-c2a0-4eb4-9544-8eb227903d47">
    <skos:broader rdf:resource="1bf8f27a-d6ff-4cb6-acb7-7e5cce11e029"/>
    <skos:prefLabel xml:lang="en">ALBATROSSES/PETRELS AND ALLIES</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: Phylum Chordata. Class Aves. Order Procellariformes. Albatross family are colonial birds among the largest flying seabirds with a strong sharp-edged bill, the upper mandible ending in a large hook characterized by tubes along the sides of the bill that measure airspeed in flight. Petrel family are exclusively pelagic, colonial birds that refer to all Procellariforme families except Albatross family.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="JSTOR &apos;On the Classification of Albatrosses, Petrels, and Diving Petrels&apos; Leverett Mills Loomis The Auk Vol. 40, No. 4 (Oct., 1923), pp. 596-602 Published by: American Ornithological Society DOI: 10.2307/4074439 Stable URL: http://www.jstor.org/stable/4074439" xml:lang="en"/>
    <skos:definition xml:lang="en">Phylum Chordata. Class Aves. Order Procellariformes. Albatross family are colonial birds among the largest flying seabirds with a strong sharp-edged bill, the upper mandible ending in a large hook characterized by tubes along the sides of the bill that measure airspeed in flight. Petrel family are exclusively pelagic, colonial birds that refer to all Procellariforme families except Albatross family.</skos:definition>
    <dcterms:modified>2017-03-15 08:41:44.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
