    <gcmd:reference gcmd:text="American Meteorological Society Glossary of Meteorology" xml:lang="en"/>
    <skos:definition xml:lang="en">A layer of soil or bedrock at a variable depth beneath the surface of the earth in which the temperature has been below freezing continuously from a few to several thousands of years.</skos:definition>
