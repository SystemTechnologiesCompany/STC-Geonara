  <skos:Concept rdf:about="2c31fc22-747a-476f-b76d-fec61220b5b1">
    <skos:broader rdf:resource="b41894fa-2e3e-475b-b8f0-b6ffdd2d6e9c"/>
    <skos:prefLabel xml:lang="en">APICULTURE</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Herren, R.V., and R.L. Donahue.  1991.  The Agriculture Dictionary, Delmar Publishers INC.  Albany, New york.  553pp." xml:lang="en"/>
    <skos:definition xml:lang="en">Any measure related to the science and art of studying and using honey beesfor human benefit.     Includes management systems, products, diseases ofbees, and others.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
