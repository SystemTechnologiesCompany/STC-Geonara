New Value=WATERBORNE DISEASES [68447296-6019-453b-9684-3cd3ff1530c9,368959] - DISEASES/EPIDEMICS [7d59f070-ccac-4a90-815b-edfca521779b,84157]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from the National Institute of Environmental Health Sciences (https://www.niehs.nih.gov/research/programs/geh/climatechange/health_impacts/waterborne_diseases/index.cfm) and the World Health Organization (https://www.who.int/sustainable-development/housing/health-risks/waterborne-disease/en/)" xml:lang="en"/>
    <skos:definition xml:lang="en">Diseases caused by consuming water that contains harmfulmicroorganisms, biotoxins, or toxic contaminants. Examples includecholera, schistosomiasis, and other gastrointestinal problems.Waterborne diseases are often the result of unsafe sanitation practicesor a breakdown in infrastructure that can be a result of or exacerbatedby various natural hazards, such as flood or drought.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <gcmd:altLabel gcmd:text="WATERBORNE ILLNESSES" xml:lang="en"/>
    <gcmd:altLabel gcmd:text="WATERBORNE INFECTIONS" xml:lang="en"/>
  </skos:Concept>
