  <skos:Concept rdf:about="4a07f23e-e3f7-4cda-880f-c8cdc6b33e37">
    <skos:broader rdf:resource="431eca76-9d34-4f86-b1d3-a0b40221e905"/>
    <skos:prefLabel xml:lang="en">WEB 3D SERVICE</skos:prefLabel>
    <gcmd:reference gcmd:text="Open Geospatial Consortium (OGC)" xml:lang="en"/>
    <skos:definition xml:lang="en">Dynamically produces client-specified perspective views from geographic feature data, returning perspectives of feature data in a graphical format.</skos:definition>
