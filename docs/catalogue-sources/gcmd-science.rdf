  </skos:Concept>
  <skos:Concept rdf:about="6e2f1371-05b1-41db-a6d9-bccd7cc2b3da">
    <skos:broader rdf:resource="d73e969a-4b66-4713-8d63-fa3cbb1e25e3"/>
    <skos:prefLabel xml:lang="en">SEA ICE ELEVATION</skos:prefLabel>
    <gcmd:reference gcmd:text="See &apos;http://icesat4.gsfc.nasa.gov/&apos; for more information on sea ice elevation measurements from IceSat." xml:lang="en"/>
    <skos:definition xml:lang="en">Pertains to the measurement of the surface height of the sea ice. In
particular, sea ice elevation is measured by the radar altimeter on board the
NASA IceSat satellite.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
