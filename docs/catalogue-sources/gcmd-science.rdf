    <skos:definition xml:lang="en">Pertaining to the composition, texture, formation, location, extent, etc. ofrocks formed through sedimentary processes.</skos:definition>
    <dcterms:modified>2013-03-07 08:47:49.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="226d05da-dd0b-4314-919a-0b259ce724b5">
