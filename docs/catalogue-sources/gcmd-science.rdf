    <skos:prefLabel xml:lang="en">SEDIMENT THICKNESS</skos:prefLabel>
    <skos:changeNote>Date=2023-11-15 User Id=sritz Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Definition: The sediment thickness at any location on the continental margin is the vertical distance from the sea floor to the top of the basement at the base of the sediments, regardless of the slope of the sea floor or the slope of the top basement surface.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2023-11-15 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SEDIMENT THICKNESS [6956aa5f-a54a-4335-a48c-8be363d267ac,1484200] - MARINE SEDIMENTS [ce4b2c6e-3d69-4cf1-8416-c36e5f9b1b2c,1481262]</skos:changeNote>
    <gcmd:reference gcmd:text="Reference: CLCS/11, paragraph 8.1.4. - http://www.continentalshelf.org/" xml:lang="en"/>
    <skos:definition xml:lang="en">Definition: The sediment thickness at any location on the continental margin is the vertical distance from the sea floor to the top of the basement at the base of the sediments, regardless of the slope of the sea floor or the slope of the top basement surface.</skos:definition>
