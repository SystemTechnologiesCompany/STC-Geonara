  <skos:Concept rdf:about="4fb63f34-f934-4a20-9d6e-ee57424f2391">
    <skos:broader rdf:resource="e731c2a1-e4b0-42e9-bed9-bd911c9b496c"/>
    <skos:prefLabel xml:lang="en">GREEN ALGAE</skos:prefLabel>
    <skos:definition xml:lang="en">Green algae are distinguished by chlorophyll a and b proportions, accessory pigments beta-carotene, and xanthophylls in stacked thylakoids. Cell walls are typically cellulose and they store carbohydrates as starch</skos:definition>
