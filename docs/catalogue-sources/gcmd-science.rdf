  <skos:Concept rdf:about="536a5a5a-28bb-473a-aa95-6d2dd1e5098d">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">IMPORTANCE VALUE</skos:prefLabel>
    <gcmd:reference gcmd:text="Krebs, C. 1994. Ecology. HarperCollins. New York, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">The importance value is the sum of relative density, relative dominance,and relative frequency for a species in the community. The larger theimportance value, the more dominant a species is in the particularcommunity.</skos:definition>
