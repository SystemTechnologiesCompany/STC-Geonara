    <gcmd:reference gcmd:text="Dictionary of Geological Terms, American Geological Institute, 1984." xml:lang="en"/>
    <skos:definition xml:lang="en">The wearing away of soil and rock by weathering, mass wasting, and the action of streams, glaciers, waves, wind, and underground water.</skos:definition>
