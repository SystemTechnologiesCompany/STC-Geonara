  </skos:Concept>
  <skos:Concept rdf:about="2590519a-c2bb-448a-b2f3-d10aaa7e057c">
    <skos:broader rdf:resource="25d73bcf-c8d4-4c0e-ac98-8f3e98677e73"/>
    <skos:prefLabel xml:lang="en">COOLING DEGREE DAYS</skos:prefLabel>
    <skos:changeNote>Date=2013-09-04 User Id=epneff Entity=BroaderRelation Operation=INSERT 
User Note=Move Concepts
System Note=add broader relation
New Value=DEGREE DAYS [2590519a-c2bb-448a-b2f3-d10aaa7e057c,86701] - ATMOSPHERIC TEMPERATURE INDICES [25d73bcf-c8d4-4c0e-ac98-8f3e98677e73,105815]</skos:changeNote>
    <skos:changeNote>Date=2013-10-11 User Id=saritz Entity=Definition Operation=UPDATE Field=text 
User Note=Updated definition.
System Note=update Definition
Old Value=Generally, a measure of the departure of the mean daily temperature from
a given standard: one degree day for each degree (C or F) of departure
above (or below) the standard during one day.
New Value=A form of degree-day used to estimate the energy requirements for air conditioning or refrigeration; one cooling degree-day is given for each Fahrenheit degree that the daily mean temperature departs above the base of 24°C (75°F).</skos:changeNote>
    <skos:changeNote>Date=2013-10-11 User Id=saritz Entity=Definition Operation=UPDATE Field=reference 
User Note=Updated definition.
System Note=update Definition
Old Value=Glossary of Meteorology, American Meteorological Society, 1998.
New Value=Glossary of Meteorology, American Meteorological Society, 2013.</skos:changeNote>
    <skos:changeNote>Date=2013-09-04 User Id=epneff Entity=BroaderRelation Operation=DELETE 
User Note=Move Concepts
System Note=delete broader relation
Old Value=DEGREE DAYS [2590519a-c2bb-448a-b2f3-d10aaa7e057c,86701] - ATMOSPHERIC TEMPERATURE [35e1f93b-99b3-4430-b477-0ecafa80d67a,83865]</skos:changeNote>
    <skos:changeNote>Date=2013-09-04 User Id=epneff Entity=PrefLabel Operation=UPDATE Field=text 
User Note=Rename Concept
System Note=update PrefLabel
Old Value=DEGREE DAYS
New Value=COOLING DEGREE DAYS</skos:changeNote>
    <skos:changeNote>Date=2013-10-11 User Id=saritz Entity=Definition Operation=UPDATE Field=reference 
User Note=added new definition
System Note=update Definition
Old Value=Glossary of Meteorology, American Meteorological Society, 2013.
New Value=Glossary of Meteorology, American Meteorological Society, 2013, http://glossary.ametsoc.org/wiki/Cooling_degree-day</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society, 2013, http://glossary.ametsoc.org/wiki/Cooling_degree-day" xml:lang="en"/>
    <skos:definition xml:lang="en">A form of degree-day used to estimate the energy requirements for air conditioning or refrigeration; one cooling degree-day is given for each Fahrenheit degree that the daily mean temperature departs above the base of 24°C (75°F).</skos:definition>
    <dcterms:modified>2013-10-11 18:00:37.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="2a664e2d-4e50-463a-af9f-b14b86eb42a7">
    <skos:broader rdf:resource="d73e969a-4b66-4713-8d63-fa3cbb1e25e3"/>
    <skos:prefLabel xml:lang="en">ICE TEMPERATURE</skos:prefLabel>
    <gcmd:reference gcmd:text="Hall, D.K. and J. Martinec. 1985. Remote Sensing of Ice and Snow, Chapman and Hall, London." xml:lang="en"/>
    <skos:definition xml:lang="en">Measurements of the temperature of the sea ice and surrounding seasurface temperature. These measurements are usually obtained from remotesensing satellites.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
