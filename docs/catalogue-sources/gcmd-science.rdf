  <skos:Concept rdf:about="78a4dbe2-2d6b-4562-988c-022c3a83f4c1">
    <skos:broader rdf:resource="bb04ee83-bf49-4f96-898d-20bb6e92bc93"/>
    <skos:prefLabel xml:lang="en">PLATE TECTONICS</skos:prefLabel>
    <gcmd:reference gcmd:text="Jackson, J.A.(1997) Glossary of Geology. 4th ed. Alexandria, VA:American  Geological Institute.769 p." xml:lang="en"/>
    <skos:definition xml:lang="en">A theory of global tectonics in which the lithosphere is 
divided into a number of plates whose pattern of horizontal movement is 
that of torsionally rigid bodies that interact with one another at their 
boundaries, causing seismic and tectonic activity along these boundaries.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="7836e8bd-176d-4e2f-9ac1-7f9d9a152b4e">
    <skos:broader rdf:resource="cbdf4f94-efc6-4965-a329-5df989a9a211"/>
    <skos:prefLabel xml:lang="en">SOFT CORALS</skos:prefLabel>
    <gcmd:reference gcmd:text="marine species.org" xml:lang="en"/>
    <skos:definition xml:lang="en">Phylum Cnidaria. Class Anthozoa. Subclass Octocorallia.  Common name of water-based organisms formed by colonial polyps with 8 fold symmetry, clacking a distinct stony skeleton distinguished by minute, spiny skeletal sclerites used in identification</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="791b7271-3a30-46ee-98e0-bc8239389950">
    <skos:broader rdf:resource="d7b62912-5970-46b1-be45-6a603c9a6979"/>
    <dcterms:created>2013-03-05</dcterms:created>
    <skos:prefLabel xml:lang="en">SEDIMENT TRANSPORT</skos:prefLabel>
    <skos:changeNote>Date=2013-04-01 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The movement of solid particles (sediment), typically due to a combination of the force of gravity acting on the sediment, and/or the movement of the fluid in which the sediment is entrained. An understanding of sediment transport is typically used in natural systems, where the particles are clastic rocks (sand, gravel, boulders, etc.), mud, or clay; the fluid is air, water, or ice; and the force of gravity acts to move the particles due to the sloping surface on which they are resting.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-03-05 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SEDIMENT TRANSPORT [791b7271-3a30-46ee-98e0-bc8239389950,82813] - GLACIAL PROCESSES [d7b62912-5970-46b1-be45-6a603c9a6979,82723]</skos:changeNote>
    <skos:changeNote>Date=2013-04-03 User Id=tbs1979 Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=SEDIMENT TRANSPORT [791b7271-3a30-46ee-98e0-bc8239389950,82813] - LOESS [4092d909-9eec-454f-9204-ce10e8d2f479,83245]</skos:changeNote>
    <skos:changeNote>Date=2017-03-10 User Id=tstevens Entity=NarrowerRelation Operation=DELETE 
User Note=Remove Concepts
System Note=delete narrower relation
Old Value=SEDIMENT TRANSPORT [791b7271-3a30-46ee-98e0-bc8239389950,88033] - LOESS [4092d909-9eec-454f-9204-ce10e8d2f479,88399]</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">The movement of solid particles (sediment), typically due to a combination of the force of gravity acting on the sediment, and/or the movement of the fluid in which the sediment is entrained. An understanding of sediment transport is typically used in natural systems, where the particles are clastic rocks (sand, gravel, boulders, etc.), mud, or clay; the fluid is air, water, or ice; and the force of gravity acts to move the particles due to the sloping surface on which they are resting.</skos:definition>
    <dcterms:modified>2017-03-10 07:59:01.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
