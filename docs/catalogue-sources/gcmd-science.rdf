    <skos:narrower rdf:resource="786c08f1-f3ed-4edd-8ec9-a69313906426"/>
    <skos:definition xml:lang="en">The tendency for particles in suspension to settle out of the fluid in which they are entrained, and come to rest against a barrier.</skos:definition>
    <dcterms:modified>2013-08-20 10:00:44.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
