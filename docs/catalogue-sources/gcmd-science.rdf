  <skos:Concept rdf:about="5e7a091a-894f-423f-a431-ab52cf205311">
    <skos:broader rdf:resource="71e9bc66-6f8c-41ec-8b22-2fe390223639"/>
    <skos:prefLabel xml:lang="en">ISOSTATIC REBOUND</skos:prefLabel>
    <skos:changeNote>Date=2013-03-07 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Move Concepts
System Note=add broader relation
New Value=ISOSTATIC REBOUND [5e7a091a-894f-423f-a431-ab52cf205311,64393] - PLATE TECTONICS [71e9bc66-6f8c-41ec-8b22-2fe390223639,64395]</skos:changeNote>
    <skos:changeNote>Date=2013-03-08 User Id=tbs1979 Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=ISOSTATIC REBOUND [5e7a091a-894f-423f-a431-ab52cf205311,64393] - REBOUND RATE [f0b2ab0f-46eb-426b-924b-471e4d1b7598,83175]</skos:changeNote>
    <skos:changeNote>Date=2013-04-02 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=text 
System Note=update Definition
Old Value=Pertaining to the measurement, mapping, or processes involved in isostatic
rebound, due to glacial removal, mountain building, the removal of water
weight, or similar effects.
New Value=Occurs when a load is imposed on or removed from the lithosphere. The surface tends to rise or sink as the lithosphere rises or sinks in the asthenosphere. Loads may consist of large lakes, oceans, (on continental shelves during eustatic sea level), ice, sediment, thrust sheets, and volcanoes. The rising or sinking of the lithosphere will continue until isostatic equilibrium is reached.</skos:changeNote>
    <skos:changeNote>Date=2013-04-02 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
New Value=Department of Geological Sciences, University of Michigan</skos:changeNote>
    <skos:changeNote>Date=2013-03-07 User Id=tbs1979 Entity=BroaderRelation Operation=DELETE 
User Note=Move Concepts
System Note=delete broader relation
Old Value=ISOSTATIC REBOUND [5e7a091a-894f-423f-a431-ab52cf205311,64393] - TECTONICS [1e17c8d3-81d0-473c-8f24-d2a4ea52b6b9,63225]</skos:changeNote>
    <skos:changeNote>Date=2013-03-08 User Id=tbs1979 Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=ISOSTATIC REBOUND [5e7a091a-894f-423f-a431-ab52cf205311,64393] - REBOUND DIRECTION [c185f7f5-0c62-489f-b365-9424e054de58,83177]</skos:changeNote>
    <gcmd:reference gcmd:text="Department of Geological Sciences, University of Michigan" xml:lang="en"/>
    <skos:narrower rdf:resource="c185f7f5-0c62-489f-b365-9424e054de58"/>
    <skos:narrower rdf:resource="f0b2ab0f-46eb-426b-924b-471e4d1b7598"/>
    <skos:definition xml:lang="en">Occurs when a load is imposed on or removed from the lithosphere. The surface tends to rise or sink as the lithosphere rises or sinks in the asthenosphere. Loads may consist of large lakes, oceans, (on continental shelves during eustatic sea level), ice, sediment, thrust sheets, and volcanoes. The rising or sinking of the lithosphere will continue until isostatic equilibrium is reached.</skos:definition>
    <dcterms:modified>2013-04-02 09:24:29.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="5e693789-87a8-4f94-9b5d-a50cecf55e24">
    <skos:broader rdf:resource="868b87a1-d8c2-49b3-8bbd-9cbbed115271"/>
    <dcterms:created>2012-06-27</dcterms:created>
    <skos:prefLabel xml:lang="en">WILDFIRE SUPPRESSION</skos:prefLabel>
    <skos:changeNote>Date=2012-06-27 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=WILDFIRE SUPPRESSION [5e693789-87a8-4f94-9b5d-a50cecf55e24,40213] - WILDFIRES  [868b87a1-d8c2-49b3-8bbd-9cbbed115271,22743]</skos:changeNote>
    <skos:changeNote>Date=2012-07-02 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Refers to the firefighting tactics used to suppress wildfires. Firefighting efforts in wildland areas requires different techniques, equipment, and training from the more familiar structure fire fighting found in populated areas. Working in conjunction with specially designed firefighting aircraft, these wildfire-trained crews suppress flames, construct firelines, and extinguish flames and areas of heat to protect resources and natural wilderness. Wildfire suppression also addresses the issues of the wildland-urban interface, where populated areas border with wildland areas.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="Wikipedia" xml:lang="en"/>
    <skos:definition xml:lang="en">Refers to the firefighting tactics used to suppress wildfires. Firefighting efforts in wildland areas requires different techniques, equipment, and training from the more familiar structure fire fighting found in populated areas. Working in conjunction with specially designed firefighting aircraft, these wildfire-trained crews suppress flames, construct firelines, and extinguish flames and areas of heat to protect resources and natural wilderness. Wildfire suppression also addresses the issues of the wildland-urban interface, where populated areas border with wildland areas.</skos:definition>
    <dcterms:modified>2012-07-02 08:27:26.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
