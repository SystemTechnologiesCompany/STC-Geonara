  <skos:Concept rdf:about="0b4081fa-5233-4484-bc82-706976defa0e">
    <skos:broader rdf:resource="fbec5145-79e6-4ed0-a804-6228aa6daba5"/>
    <skos:prefLabel xml:lang="en">PLANTS</skos:prefLabel>
    <gcmd:reference gcmd:text="Allaby, Michael. 1998. A Dictionary of Plant Sciences, New York: Oxford University Press." xml:lang="en"/>
    <skos:narrower rdf:resource="566e22da-d72e-4663-89d2-ced5aea948ea"/>
    <skos:narrower rdf:resource="934bd870-ffa8-41d8-8da9-214b73707168"/>
    <skos:narrower rdf:resource="e731c2a1-e4b0-42e9-bed9-bd911c9b496c"/>
