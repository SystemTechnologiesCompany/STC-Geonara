  <skos:Concept rdf:about="3a942e8a-d2f2-42bf-9e83-b7b3793b100e">
    <skos:broader rdf:resource="57383ac5-614c-4b84-9202-e137b000422b"/>
    <skos:prefLabel xml:lang="en">IONOSPHERE/MAGNETOSPHERE DYNAMICS</skos:prefLabel>
    <gcmd:reference gcmd:text="NOAA/NGDC gloassary of solar-terresrial terms: http://www.ngdc.noaa.gov/stp/GLOSSARY/glossary.html" xml:lang="en"/>
    <skos:narrower rdf:resource="990016e0-f247-4c36-8a17-f50e792a964a"/>
    <skos:narrower rdf:resource="5f8a9188-d588-4782-a34b-07fa68380c41"/>
    <skos:narrower rdf:resource="e453077b-b6f3-44f0-9f3d-4408bf9a69e5"/>
    <skos:narrower rdf:resource="8cbdfa00-852c-452d-8013-86145ad318c8"/>
    <skos:narrower rdf:resource="5d290bd8-049b-4002-86c8-8acba563d0e1"/>
    <skos:narrower rdf:resource="ba75172a-6965-40cf-bf3f-6c0af2f97dad"/>
    <skos:narrower rdf:resource="882d9a10-713c-4b58-8c7b-d9af086115a3"/>
    <skos:narrower rdf:resource="9abe9fdb-59f3-4bd6-b24f-b9b7e46eae7c"/>
    <skos:narrower rdf:resource="792cf9f0-6d24-4de8-902c-b74e42c74fd3"/>
    <skos:definition xml:lang="en">Refers to dynamic processess of the Earth&apos;s ionosphere and solar magnetosphere
triggered by solar events. The magnetosphere is the magnetic cavity surroundingthe earth, carved out of the passing solar wind by virtue of the geomagnetic
field, which prevents, or at least impedes, the direct entry of the solar wind
plasma into the cavity. The ionosphere is the region of the earth&apos;s upper
atmosphere containing a small percentage of free electrons and ions produced byphotoionization of the constituents of the atmosphere by solar ultraviolet
radiation at very short wavelengths (l.t.1000 angstroms).  The ionosphere
significantly influences radiowave propagation of frequencies less than about
30 MHz.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="3c6d5e60-c312-4589-9918-b0f44b2ae8cd">
    <skos:broader rdf:resource="cc9e67fc-eafa-43cc-879f-0cb56b25bc39"/>
    <dcterms:created>2020-05-21</dcterms:created>
