  <skos:Concept rdf:about="4b5c0805-13ec-4d32-81ae-430265d15f49">
    <skos:broader rdf:resource="431eca76-9d34-4f86-b1d3-a0b40221e905"/>
    <skos:prefLabel xml:lang="en">CHANGE DETECTION SERVICES</skos:prefLabel>
    <gcmd:reference gcmd:text="Open Geospatial Consortium (OGC)" xml:lang="en"/>
    <skos:definition xml:lang="en">Services to find differences between two data sets that represent the samegeographical area at different times.</skos:definition>
