  <skos:Concept rdf:about="4eab7956-e59e-4615-8d5c-39a16faa1f27">
    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">ALKALINITY</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: &apos;http://www.soc.soton.ac.uk/SUDO/organic/204timetable.html/co2defs.doc&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">The alkalinity of seawater is the combined negative charges due to
hydrogen carbonate and carbonate ions expressed in molal concentrations.
Alkalinity is based on seawater being electrically neutral and is
determined by titration (and therefore given the subscript t).</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
