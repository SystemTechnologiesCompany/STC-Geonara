  <skos:Concept rdf:about="0cf44d92-1959-41af-9890-b916008efbae">
    <skos:broader rdf:resource="431eca76-9d34-4f86-b1d3-a0b40221e905"/>
    <skos:prefLabel xml:lang="en">WEB IMAGE CLASSIFICATION SERVICE</skos:prefLabel>
    <gcmd:reference gcmd:text="Open Geospatial Consortium (OGC)" xml:lang="en"/>
    <skos:definition xml:lang="en">Performs classification of digital images, using a client-selected supervised orunsupervised image classification method.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="0d32a340-ee64-4795-9254-09dcaf55bf4c">
    <skos:broader rdf:resource="2e83362e-d8f8-4bca-83fd-bae360ebe94b"/>
    <skos:prefLabel xml:lang="en">SOLAR ACTIVE REGIONS</skos:prefLabel>
    <gcmd:reference gcmd:text="the Cambridge Encyclopedia of the Sun, The Cambridge University Press, Cambridge, CB2, 2RU, UK, 2001." xml:lang="en"/>
    <skos:definition xml:lang="en">A region of the solar atmosphere from the photosphere to the corona thatdevelops when strong magnetic fields emerge from inside the sun. The magnetizedrealm in and around the sunspots is called an active region. Radiation fromactive regions is enhanced when compared to neighboring areas in thechromosphere a corona over the whole electromagnetic spectrum. They may lastfrom a few hours to a few months. They are the sites of intense explosions,called solar flares.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="26558c08-beca-4ef0-9ea3-b000504ece60">
    <skos:broader rdf:resource="a246a8cf-e3f9-4045-af9f-dc97f6fe019a"/>
    <skos:prefLabel xml:lang="en">SEDIMENTS</skos:prefLabel>
    <skos:changeNote>Date=2017-03-10 User Id=tstevens Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
Old Value=Lutgens, Frederick K., Edward J. Tarbuck.  Essentials of Geology, 5th Edition.
Prentice-Hall, Inc.:  Englewood Cliffs, NJ, 1995.
New Value=Lutgens, Frederick K., Edward J. Tarbuck.  Essentials of Geology, 5th Edition. Prentice-Hall, Inc.:  Englewood Cliffs, NJ, 1995.</skos:changeNote>
    <skos:changeNote>Date=2017-03-10 User Id=tstevens Entity=Definition Operation=UPDATE Field=text 
System Note=update Definition
Old Value=Unconsolidated particles created by the weathering and erosion of rock,
by chemical precipitation from solution in water, or from the secretions
of organisms, and transported by water, wind, or glaciers.
New Value=Unconsolidated particles created by the weathering and erosion of rock, by chemical precipitation from solution in water, or from the secretions of organisms, and transported by water, wind, or glaciers.</skos:changeNote>
    <gcmd:reference gcmd:text="Lutgens, Frederick K., Edward J. Tarbuck.  Essentials of Geology, 5th Edition. Prentice-Hall, Inc.:  Englewood Cliffs, NJ, 1995." xml:lang="en"/>
    <skos:definition xml:lang="en">Unconsolidated particles created by the weathering and erosion of rock, by chemical precipitation from solution in water, or from the secretions of organisms, and transported by water, wind, or glaciers.</skos:definition>
