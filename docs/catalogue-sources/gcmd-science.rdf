  <skos:Concept rdf:about="1ecb1e7c-50fc-4951-b610-5140475d87ed">
    <skos:broader rdf:resource="d46a5046-e1c6-4a09-a2f1-db6a21eda611"/>
    <skos:prefLabel xml:lang="en">CARBON TETRACHLORIDE</skos:prefLabel>
    <gcmd:reference gcmd:text="Environmental Science and Technology; v28; 1243-1247; 1994.] [Journal of the Air and Waste Management Association; v41; 1579-1584; 1991." xml:lang="en"/>
    <skos:definition xml:lang="en">CCl4, a compound consisting of a carbon and 4 chlorines that is active in ozone depletion when the compound is broken down and releases chlorine atoms (radicals). Chlorine reacts with the ozone creating diatomic oxygen and chlorine monoxide which cycles back to chlorine radicals.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="1eb6eeff-77f8-40b6-8e4a-2e4438f00b10">
    <skos:broader rdf:resource="b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
    <dcterms:created>2012-06-26</dcterms:created>
    <skos:prefLabel xml:lang="en">TIDAL ENERGY PRODUCTION/USE</skos:prefLabel>
    <skos:changeNote>Date=2012-06-29 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Refers to the production and use of tidal energy for human consumption. Tidal energy is the energy involved in tidal movements of water which is available to be harnessed if those movements can be used to turn turbines.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2012-06-26 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=TIDAL ENERGY PRODUCTION/USE [1eb6eeff-77f8-40b6-8e4a-2e4438f00b10,40121] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]</skos:changeNote>
    <gcmd:reference gcmd:text="U.S. Department of Energy" xml:lang="en"/>
    <skos:definition xml:lang="en">Refers to the production and use of tidal energy for human consumption. Tidal energy is the energy involved in tidal movements of water which is available to be harnessed if those movements can be used to turn turbines.</skos:definition>
    <dcterms:modified>2012-06-29 13:55:45.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
