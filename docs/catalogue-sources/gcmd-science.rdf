  </skos:Concept>
  <skos:Concept rdf:about="873e35f5-908b-4418-861e-eab5d13a19a4">
    <skos:broader rdf:resource="14555831-70ae-4650-8983-956d65595575"/>
    <dcterms:created>2019-04-03</dcterms:created>
    <skos:prefLabel xml:lang="en">STORMWATER MANAGEMENT</skos:prefLabel>
    <skos:changeNote>Date=2019-04-03 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=STORMWATER MANAGEMENT [873e35f5-908b-4418-861e-eab5d13a19a4,368611] - WATER MANAGEMENT [14555831-70ae-4650-8983-956d65595575,85065]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from a University of Nebraska-Lincoln Extension, Institute of Agriculture and Natural Resources ​Stormwater Management publication." xml:lang="en"/>
    <skos:definition xml:lang="en">Stormwater management is the control and use of stormwater runoff. The goals of stormwater management include reducing flooding to protect people and property, reducing demand on public stormwater drainage systems,  and supporting healthy streams and rivers. These can be achieved by planning for runoff, maintaining stormwater systems, and regulating the collection, storage, and movement of stormwater.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <gcmd:altLabel gcmd:text="Low Impact Development" xml:lang="en"/>
    <gcmd:altLabel gcmd:text="Sustainable Drainage Systems" xml:lang="en"/>
    <gcmd:altLabel gcmd:text="Water Sensitive Urban Design" xml:lang="en"/>
  </skos:Concept>
