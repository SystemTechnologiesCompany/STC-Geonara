  <skos:Concept rdf:about="881eea51-e32c-4174-a73f-d56c94122c2e">
    <skos:broader rdf:resource="63bc0693-52eb-4ebd-a39e-e77e96409072"/>
    <skos:prefLabel xml:lang="en">EVAPORATION</skos:prefLabel>
    <gcmd:reference gcmd:text="Huschke, R.E. 1959. Glossary of Meteorology. American Meteorological Association, Boston, MA. See also: Pickard, G.L. and W.J. Emery. 1990. Descriptive Physical Oceanography: An Introduction. Pergamon Press, NY" xml:lang="en"/>
    <skos:definition xml:lang="en">The physical process by which a liquid is transformed to the gaseousstate. Evaporation also implies a loss of heat from the ocean surface andis an important term in determining the heat budget of the ocean.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
