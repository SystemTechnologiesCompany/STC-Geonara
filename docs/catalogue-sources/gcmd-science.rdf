  <skos:Concept rdf:about="548a3f85-bf22-473b-b641-45c32d9c6a0c">
    <skos:broader rdf:resource="2e5a401b-1507-4f57-82b8-36557c13b154"/>
    <skos:prefLabel xml:lang="en">PARTICULATE MATTER</skos:prefLabel>
    <skos:changeNote>Date=2023-02-16 User Id=tstevens Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=PARTICULATE MATTER [548a3f85-bf22-473b-b641-45c32d9c6a0c,1214272] - PARTICULATE MATTER _PM 10_ [1ffc2101-e4bc-4010-9a4c-b86c858d850f,1217447]</skos:changeNote>
    <skos:changeNote>Date=2023-02-16 User Id=tstevens Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=PARTICULATE MATTER [548a3f85-bf22-473b-b641-45c32d9c6a0c,1214272] - PARTICULATE MATTER _PM 2.5_ [6ab81a2f-5e7e-4249-87d2-875c6a4a2a80,1217441]</skos:changeNote>
    <skos:changeNote>Date=2023-02-16 User Id=tstevens Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=PARTICULATE MATTER [548a3f85-bf22-473b-b641-45c32d9c6a0c,1214272] - PARTICULATE MATTER _PM 1.0_ [6a340e0c-1f2e-435d-acf2-427ebc0d5e4c,1217444]</skos:changeNote>
    <gcmd:reference gcmd:text="United States Environmental Protection Agency (EPA), 2009. http://www.epa.gov/particles/" xml:lang="en"/>
    <skos:narrower rdf:resource="1ffc2101-e4bc-4010-9a4c-b86c858d850f"/>
    <skos:narrower rdf:resource="6a340e0c-1f2e-435d-acf2-427ebc0d5e4c"/>
    <skos:narrower rdf:resource="6ab81a2f-5e7e-4249-87d2-875c6a4a2a80"/>
    <skos:definition xml:lang="en">&apos;Particulate matter,&apos; also known as particle pollution or PM, is a complex mixture of extremely small particles and liquid droplets. Particle pollution is made up of a number of components, including acids (such as nitrates and sulfates), organic chemicals, metals, and soil or dust particles.The size of particles is directly linked to their potential for causing health problems. EPA is concerned about particles that are 10 micrometers in diameter or smaller because those are the particles that generally pass through the throat and nose and enter the lungs. Once inhaled, these particles can affect the heart and lungs and cause serious health effects. EPA groups particle pollution into two categories: &lt;BR&gt;- &apos;Inhalable coarse particles,&apos; such as those found near roadways and dusty industries, are larger than 2.5 micrometers and smaller than 10 micrometers in diameter.&lt;BR&gt;- &apos;Fine particles,&apos; such as those found in smoke and haze, are 2.5 micrometers in diameter and smaller. These particles can be directly emitted from sources such as forest fires, or they can form when gases emitted from power plants, industries and automobiles react in the air.</skos:definition>
    <dcterms:modified>2023-02-16 14:55:47.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="24b7bc59-3f10-4a0b-b9c1-92ae10feb007">
    <skos:broader rdf:resource="9f8a6a52-df35-487d-9a74-74b76943e0c0"/>
    <skos:prefLabel xml:lang="en">MUSEUM EXHIBITS</skos:prefLabel>
    <gcmd:reference gcmd:text="NASA GCMD" xml:lang="en"/>
    <skos:definition xml:lang="en">Museum Exhibits are defined as Education / Outreach Services that provide a sensory (visual, auditory, tactile, etc.) presentation of items or concepts related to the Earth Sciences and/or Global Environmental Change at a Museum.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="7a33a978-8ef6-4313-b489-c06cfc6d9cec">
    <skos:broader rdf:resource="233a4d81-44f8-4b0e-8ad3-695f641729f8"/>
    <skos:prefLabel xml:lang="en">NUTRIENT CYCLING</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J.and Richard T. Wright. Environmental Science-the Way the World Works. 1998. Prentice-Hall, Inc. Upper Saddle River, New Jersey." xml:lang="en"/>
    <skos:definition xml:lang="en">Nutrient cycling is the repeated pathway of particular nutrients orelements from the environment through one or more organisms back to theenvironment.  Nutrient cycles include the carbon cycle, the nitrogencycle, the phosphorus cycle, and so on.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
