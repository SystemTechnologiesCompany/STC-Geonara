User Note=Rename Concept
System Note=update PrefLabel
Old Value=Vulnerable Populations
New Value=VULNERABLE POPULATIONS</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from the IPCC AR5 WGII Glossary (https://www.ipcc.ch/site/assets/uploads/2018/02/WGIIAR5-AnnexII_FINAL.pdf) and the World Health Organization (https://www.who.int/environmental_health_emergencies/vulnerable_groups/en/)" xml:lang="en"/>
    <skos:definition xml:lang="en">Groups of people with a propensity or predisposition to be adverselyaffected. Vulnerable populations may be less able to anticipate, copewith, resist, and recover from the impacts of a disaster, be it natural orman-made.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <gcmd:altLabel gcmd:text="Population Vulnerability" xml:lang="en"/>
  </skos:Concept>
