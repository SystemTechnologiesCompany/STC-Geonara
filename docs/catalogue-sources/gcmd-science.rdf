    <skos:broader rdf:resource="97675827-9b0a-4d13-a795-d4a3e78c476a"/>
    <skos:prefLabel xml:lang="en">BACKGROUND INFORMATION</skos:prefLabel>
    <gcmd:reference gcmd:text="NASA GCMD" xml:lang="en"/>
    <skos:definition xml:lang="en">Background Information Services are defined as Education/Outreach Services that are designed to provide supplemental or background information on a particular subject in Earth Science and/or Global Environmental Change.</skos:definition>
