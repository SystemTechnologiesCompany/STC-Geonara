  <skos:Concept rdf:about="6aa7422c-ad66-40b6-90cd-750f9158daee">
    <skos:broader rdf:resource="e1dff4d5-2e5b-46e7-9804-9de29fdb36d9"/>
    <dcterms:created>2013-02-14</dcterms:created>
    <skos:prefLabel xml:lang="en">CUMULUS HUMILIS</skos:prefLabel>
    <skos:changeNote>Date=2013-02-14 User Id=mpmorahan Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=CUMULUS HUMILIS [6aa7422c-ad66-40b6-90cd-750f9158daee,82217] - CUMULUS [e1dff4d5-2e5b-46e7-9804-9de29fdb36d9,82215]</skos:changeNote>
    <skos:changeNote>Date=2013-02-14 User Id=mpmorahan Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=CUMULUS HUMILIS [6aa7422c-ad66-40b6-90cd-750f9158daee,82217] - FAIR WEATHER CUMULUS [ef4de9ce-01ee-4bf0-8814-abefd1bad4b9,82219]</skos:changeNote>
    <skos:changeNote>Date=2013-03-21 User Id=mpmorahan Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: (Also called fair-weather cumulus.) A species of cumulus characterized by small vertical development, uniform flat bases and a general similarity among clouds.

Its vertical growth is usually restricted by the existence of a temperature inversion in the atmosphere; this in turn explains the unusually uniform height of the cloud tops of this cumulus species. A single cloud element that is able to penetrate the inversion may develop into cumulus congestus or even further to become cumulonimbus. As in all species of cumulus, wind shear with height may give rise to a hard appearance upshear, where cloud erosion in dry environment air is taking place, and a fuzzy appearance downshear . This species is unique to the genus cumulus.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="American Meteorological Society (http://glossary.ametsoc.org/wiki/Main_Page)" xml:lang="en"/>
    <skos:narrower rdf:resource="ef4de9ce-01ee-4bf0-8814-abefd1bad4b9"/>
    <skos:definition xml:lang="en">(Also called fair-weather cumulus.) A species of cumulus characterized by small vertical development, uniform flat bases and a general similarity among clouds.Its vertical growth is usually restricted by the existence of a temperature inversion in the atmosphere; this in turn explains the unusually uniform height of the cloud tops of this cumulus species. A single cloud element that is able to penetrate the inversion may develop into cumulus congestus or even further to become cumulonimbus. As in all species of cumulus, wind shear with height may give rise to a hard appearance upshear, where cloud erosion in dry environment air is taking place, and a fuzzy appearance downshear . This species is unique to the genus cumulus.</skos:definition>
    <dcterms:modified>2013-03-21 10:23:52.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
