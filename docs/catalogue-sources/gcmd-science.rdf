    <skos:prefLabel xml:lang="en">BIOMASS</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J and Wright, Richard T. Environmental Science. 1998.  Prentice Hall." xml:lang="en"/>
    <skos:definition xml:lang="en">Mass of biological material. Usually the total mass of a particular groupor category; for example, the biomass of producer organisms.</skos:definition>
