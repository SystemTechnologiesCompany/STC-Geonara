    <skos:narrower rdf:resource="68c2baba-b9b9-41d4-89bf-07488728bc4f"/>
    <skos:narrower rdf:resource="69f475b6-42af-4822-ae57-6c8fd8ebad4a"/>
    <skos:narrower rdf:resource="73629546-592e-41ed-bfde-feb4c94415fb"/>
    <skos:narrower rdf:resource="ff985037-2f20-4b08-bb22-3ed701ed2f4d"/>
