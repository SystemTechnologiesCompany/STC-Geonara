    <skos:prefLabel xml:lang="en">ICE NUCLEI</skos:prefLabel>
    <skos:changeNote>Date=2022-08-02 User Id=sritz Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Any particle that serves as a nucleus leading to the formation of ice crystals without regard to the particular physical processes involved in the nucleation.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2022-08-02 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=ICE NUCLEI [60bb6ddf-29b1-4dad-9c9f-27f040a43bba,1011359] - CLOUD MICROPHYSICS [0cfcbaa7-727b-4199-8cca-93824b427e9b,1009858]</skos:changeNote>
    <gcmd:reference gcmd:text="American Meteorological Society, Glossary of Meteorology, https://glossary.ametsoc.org/wiki/Ice_nucleus" xml:lang="en"/>
    <skos:definition xml:lang="en">Any particle that serves as a nucleus leading to the formation of ice crystals without regard to the particular physical processes involved in the nucleation.</skos:definition>
