    <skos:narrower rdf:resource="2343baae-1c4a-4096-8cac-fea8ed7a984f"/>
    <skos:narrower rdf:resource="82191e97-53ba-413d-9a08-acd8b848e0b0"/>
    <skos:narrower rdf:resource="dacbf270-1734-4503-bab8-a32cdaff3012"/>
    <skos:definition xml:lang="en">A measure of height, especially of great height, as a mountain top oraircraft flight level. In meteorology, altitude is used almost exclusivelywith respect to the height of an airborne object above the earth&apos;ssurface, above a constant pressure surface, or above mean sea level.</skos:definition>
    <dcterms:modified>2012-06-28 15:13:45.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="13aeaea0-ab45-4148-abcf-c6becf7a8934">
    <skos:broader rdf:resource="346cade5-801a-4afc-9652-48d02905bc4f"/>
    <skos:prefLabel xml:lang="en">TURBULENCE</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society, 1998." xml:lang="en"/>
    <skos:definition xml:lang="en">A state of fluid (wind) flow in which the instantaneous (wind)velocities exhibit irregular and apparently random fluctuations so that inpractice only statistical properties can be recognized and subjected toanalysis.  &lt;/U&gt;&lt;/B&gt;</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
