    <skos:prefLabel xml:lang="en">FOREST FIRE DANGER INDEX</skos:prefLabel>
    <skos:changeNote>Date=2012-06-26 User Id=gee-cee Entity=BroaderRelation Operation=DELETE 
User Note=Move Concepts
System Note=delete broader relation
