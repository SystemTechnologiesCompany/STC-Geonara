    <skos:prefLabel xml:lang="en">CHLOROPHYLL</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J.and Richard T. Wright. Environmental Science-the Way the World Works. 1998. Prentice-Hall, Inc. Upper Saddle River, New Jersey." xml:lang="en"/>
    <skos:definition xml:lang="en">Chlorophyll is the green pigment in plants responsible for absorbing thelight energy required for photosynthesis.</skos:definition>
