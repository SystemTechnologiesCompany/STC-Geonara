  <skos:Concept rdf:about="21389c4a-0d32-484a-95b9-db319a18f6ca">
    <skos:broader rdf:resource="b887d3e5-4280-43d2-a34e-0f63ac086b6a"/>
    <skos:prefLabel xml:lang="en">EQUATORIAL PACIFIC MERIDIONAL WIND ANOMALY INDEX</skos:prefLabel>
    <skos:changeNote>Date=2012-07-09 User Id=mpmorahan Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: An ENSO meridional wind anomaly index is calculated for the region 12-2N, 160E-80W from the International Comprehensive Ocean-Atmosphere Data Set (COADS). This region was chosen from a map of meridional wind regressed onto an index of eastern equatorial Pacific SST for the period 1950-79.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="The University of Washington Joint Institute for the Study of the Atmosphere  and Ocean (JISAO): http://www.jisao.washington.edu/data/eqpacmeridwindts/" xml:lang="en"/>
    <skos:definition xml:lang="en">An ENSO meridional wind anomaly index is calculated for the region 12-2N, 160E-80W from the International Comprehensive Ocean-Atmosphere Data Set (COADS). This region was chosen from a map of meridional wind regressed onto an index of eastern equatorial Pacific SST for the period 1950-79.</skos:definition>
    <dcterms:modified>2012-07-09 10:15:59.0</dcterms:modified>
