    <skos:prefLabel xml:lang="en">GLACIER FACIES</skos:prefLabel>
    <skos:changeNote>Date=2024-10-02 User Id=tstevens Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
Old Value=Rice University Glacier Glossary, 
http://www.glacier.rice.edu/misc/glossary.html
