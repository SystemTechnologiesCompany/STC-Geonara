  <skos:Concept rdf:about="68f1ff0e-2e23-4025-ba71-7f6177352311">
    <skos:broader rdf:resource="a82d885e-34cd-496a-b34d-17a23ad04126"/>
    <skos:prefLabel xml:lang="en">PARTICLE SPEED</skos:prefLabel>
    <gcmd:reference gcmd:text="Jursa, A.S., ed. 1985. Handbook of Geophysics and the Space Enviornment, Air Force Geophysics Laboratory, USAF. (Available from NTIS, Springfield, VA)." xml:lang="en"/>
    <skos:definition xml:lang="en">The distance per unit time of particles propagating through the Earth&apos;satmosphere or through the interplanetary magnetic fields as a result of solarevents. For example, the solar wind has a &apos;fast&apos; component or high speed streamwith a speed of about 10*5 M/sec. and a &apos;slow&apos; component of about 5x10*4 m/sec.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
