    <skos:prefLabel xml:lang="en">ISOSTATIC ADJUSTMENTS</skos:prefLabel>
    <skos:changeNote>Date=2013-03-11 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The rise of land masses that were depressed by the huge weight of ice sheets during the last glacial period, through a process known as isostasy.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-02-18 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=ISOSTATIC ADJUSTMENTS [5dee7d0e-e13e-4974-9750-79d5cd886c7a,82377] - CRUSTAL MOTION [122f7d15-7e5c-4249-992c-c753c80cf05b,62963]</skos:changeNote>
    <gcmd:reference gcmd:text="Journal of Geophysical Research" xml:lang="en"/>
    <skos:definition xml:lang="en">The rise of land masses that were depressed by the huge weight of ice sheets during the last glacial period, through a process known as isostasy.</skos:definition>
    <dcterms:modified>2013-03-11 15:45:13.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
