    <skos:changeNote>Date=2013-04-01 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A rock formation created by the passing of a glacier. When a glacier erodes down to bedrock, it can form tear-drop shaped hills that taper in the up-ice direction.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">A rock formation created by the passing of a glacier. When a glacier erodes down to bedrock, it can form tear-drop shaped hills that taper in the up-ice direction.</skos:definition>
    <dcterms:modified>2013-04-01 10:35:54.0</dcterms:modified>
