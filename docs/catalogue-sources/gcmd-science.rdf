  <skos:Concept rdf:about="38dadd6d-6adb-44e2-b28a-fd18d797d052">
    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">STABLE ISOTOPES</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Webster&apos;s College Dictionary. 1991. Random House." xml:lang="en"/>
    <skos:definition xml:lang="en">Any non-radioactive form of a chemical element, having the same atomicweight as that element (i.e. same number of protons), but a differentnumber of neutrons.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="3643618f-3af3-4c69-8beb-2ad14141a176">
    <skos:broader rdf:resource="dba19648-3f52-48ba-b00b-8527d44c4d74"/>
    <skos:prefLabel xml:lang="en">ICE CORE AIR BUBBLES</skos:prefLabel>
    <gcmd:reference gcmd:text="Raynaud, D., Jouzel, J., Barnola, J. M., Chappellaz, J., Delmas, R. J. &amp; Lorius, C. (1993) Science 259, 926-933. 20. Battle, M., Bender, M., Sowers, T., Tans, P. P., Butler, J. H., Elkins, J. W., Ellis, J. T., Conway, T., Zhang, N., Lang, P. &amp; Clarke, A. D. (1996) Nature (London) 383, 231-23. Referenced in Alley, Richard B. Ice-core evidence of abrupt climate changes, Proceedings of the National Academy of Sciences of the United States of America (http://www.pnas.org/cgi/content/full/97/4/1331?ijkey=JifxlJJnHUR2Q)" xml:lang="en"/>
    <skos:definition xml:lang="en">Trapped gases in ice-core bubbles are highly reliable records of atmosphericcomposition in reconstructing past climates.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
