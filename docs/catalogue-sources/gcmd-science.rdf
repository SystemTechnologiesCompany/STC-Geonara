  <skos:Concept rdf:about="36bab763-b5d7-450a-8328-1c1f935184f4">
    <skos:broader rdf:resource="a82d885e-34cd-496a-b34d-17a23ad04126"/>
    <skos:prefLabel xml:lang="en">ENERGY DEPOSITION</skos:prefLabel>
    <gcmd:reference gcmd:text="Jursa, A.S., ed. 1985. Handbook of Geophysics and the Space Enviornment, Air Force Geophysics Laboratory, USAF. (Available from NTIS, Springfield, VA)." xml:lang="en"/>
    <skos:definition xml:lang="en">The energy deposited into the atmosphere from ionization of atmospheric
gases, as well as excitation of photometric and x-ray emissions.  The
ionospheric effects resulting from the energy deposition by incident particle
fluxes include:
- production of secondary electrons (ionization)
- enhanced steady-state electron density
- photometric emissions 
- bremsstrahlung x-rays
- conductivity changes
- E-region horizontal currents 
- plasma heating(collisional, Joule heating)
- magnetic field perturbations</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
