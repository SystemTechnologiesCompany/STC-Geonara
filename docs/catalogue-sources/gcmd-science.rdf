  <skos:Concept rdf:about="2d00d3c4-2ef3-49f6-9261-6184f6517b4f">
    <skos:broader rdf:resource="ba4a9964-8323-45df-a372-b4e2f3eef9e5"/>
    <dcterms:created>2013-02-14</dcterms:created>
    <skos:prefLabel xml:lang="en">KARMAN VORTEX STREET</skos:prefLabel>
    <skos:changeNote>Date=2013-03-21 User Id=mpmorahan Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: (Also called Kármán vortex street, vortex trail, vortex train.) Two parallel rows of alternately placed vortices along the wake of an obstacle in a fluid of moderate Reynolds number.

Fluid drag can be calculated from the motion of these vortices, which are stable only for a certain ratio of the width of the street to the distance between vortices along the street.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-02-14 User Id=mpmorahan Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=KARMAN VORTEX STREET [2d00d3c4-2ef3-49f6-9261-6184f6517b4f,82299] - VORTEX STREET [ba4a9964-8323-45df-a372-b4e2f3eef9e5,82295]</skos:changeNote>
    <gcmd:reference gcmd:text="American Meteorological Society (http://glossary.ametsoc.org/wiki/Main_Page)" xml:lang="en"/>
    <skos:definition xml:lang="en">(Also called Kármán vortex street, vortex trail, vortex train.) Two parallel rows of alternately placed vortices along the wake of an obstacle in a fluid of moderate Reynolds number.Fluid drag can be calculated from the motion of these vortices, which are stable only for a certain ratio of the width of the street to the distance between vortices along the street.</skos:definition>
    <dcterms:modified>2013-03-21 14:18:52.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="2ef42281-1e38-4391-b578-ba6a6158f0c2">
    <skos:broader rdf:resource="63bc0693-52eb-4ebd-a39e-e77e96409072"/>
    <skos:prefLabel xml:lang="en">CONDUCTION</skos:prefLabel>
    <gcmd:reference gcmd:text="Huschke, R.E. 1959. Glossary of Meteorology. American Meteorological Association, Boston, MA. See also: Pickard, G.L. and W.J. Emery. 1990. Descriptive Physical Oceanography: An Introduction. Pergamon Press, NY" xml:lang="en"/>
    <skos:definition xml:lang="en">Conduction is the transfer of energy within and through a conductor.In oceanography, the rate of heat gain or loss through the sea surfaceby conduction can be measured.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="31a14270-6275-4155-961f-b78b60ee05f7">
    <skos:broader rdf:resource="4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
    <skos:prefLabel xml:lang="en">ANISOTROPY</skos:prefLabel>
    <gcmd:reference gcmd:text="CEOS Glossary of Remote Sensing Terms &apos;http://ceos.cnes.fr:8100/cdrom-00b2/ceos1/science/glossary/gloss.htm&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">Anisotropy is the characteristic of a surface for which a physical
property, such as reflectivity, varies in value with the direction in or
along which the measurement is made.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="768cfa32-003d-47bd-ab3a-3e27e4ec2699">
    <skos:broader rdf:resource="2e5a401b-1507-4f57-82b8-36557c13b154"/>
    <skos:prefLabel xml:lang="en">NITRATE PARTICLES</skos:prefLabel>
    <skos:definition xml:lang="en">Atmospheric aerosol particles derived from biogenic or anthropogenicnitrate emissions; comprised of nitrate compounds (e.g., ammonia,NOx).</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="2e62a5dd-5ea5-4cd6-8051-b5e162ef4e01">
    <skos:broader rdf:resource="b895f4b5-5273-49ef-883f-b67d9f199505"/>
    <dcterms:created>2013-08-06</dcterms:created>
    <skos:prefLabel xml:lang="en">OUTWASH FANS/PLAINS</skos:prefLabel>
    <skos:changeNote>Date=2013-08-06 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=OUTWASH FANS/PLAINS [2e62a5dd-5ea5-4cd6-8051-b5e162ef4e01,105631] - GLACIAL LANDFORMS [b895f4b5-5273-49ef-883f-b67d9f199505,105287]</skos:changeNote>
    <skos:changeNote>Date=2013-08-26 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: An outwash fan is a fan-shaped body of sediments deposited by braided streams from a melting glacier. Sediment locked within the ice of the glacier, gets transported by the streams of meltwater, and deposits on the outwash plain, at the terminus of the glacier.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">An outwash fan is a fan-shaped body of sediments deposited by braided streams from a melting glacier. Sediment locked within the ice of the glacier, gets transported by the streams of meltwater, and deposits on the outwash plain, at the terminus of the glacier.</skos:definition>
    <dcterms:modified>2013-08-26 08:48:37.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="7b52f7f5-4102-4829-8ea3-c0dcdd36bdca">
    <skos:broader rdf:resource="2e83362e-d8f8-4bca-83fd-bae360ebe94b"/>
    <skos:prefLabel xml:lang="en">SOLAR PROMINENCES/SOLAR FILAMENTS</skos:prefLabel>
    <gcmd:reference gcmd:text="On-Line Glossary of Solar-Terrestrial Terms from the NOAA Space Environment Laboratory. &apos;http://www.ngdc.noaa.gov/stp/GLOSSARY/glossary.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">A term identifying cloud-like features in the solar atmosphere. The
features appear as bright structures in the corona above the solar limb
and as dark filaments when seen projected against the solar disk. 
Solar filaments are also known as prominences, can appear as arcs andproperties can vary with the solar cycle.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
