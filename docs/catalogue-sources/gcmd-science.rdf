  <skos:Concept rdf:about="72b3df24-a061-4624-ad62-f3794798136c">
    <skos:broader rdf:resource="431eca76-9d34-4f86-b1d3-a0b40221e905"/>
    <skos:prefLabel xml:lang="en">COVERAGE PORTRAYAL SERVICE</skos:prefLabel>
    <gcmd:reference gcmd:text="Open Geospatial Consortium (OGC)" xml:lang="en"/>
    <skos:definition xml:lang="en">Dynamically produces client-specified pictorial renderings in an image or graphics format of a coverage subset dynamically retrieved from a Web Coverage Service (WCS).</skos:definition>
