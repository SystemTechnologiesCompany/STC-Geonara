    <gcmd:reference gcmd:text="Adapted from Geomorphology from Space, Chapter 8 EOLIAN LANDFORMS by Alta S. Walker  &lt;a href=http://disc.gsfc.nasa.gov/geomorphology/GEO_8/GEO_CHAPTER_8.HTML&gt; http://disc.gsfc.nasa.gov/geomorphology/GEO_8/GEO_CHAPTER_8.HTML &lt;/a&gt;" xml:lang="en"/>
