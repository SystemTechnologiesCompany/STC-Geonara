    <gcmd:reference gcmd:text="https://glossary.ametsoc.org/wiki/Aerosol_size_distribution" xml:lang="en"/>
    <skos:definition xml:lang="en">The amounts of different size particles of solids or liquids that are suspended in air as an aerosol.</skos:definition>
