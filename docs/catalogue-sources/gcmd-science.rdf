  <skos:Concept rdf:about="3ad043a9-2ec8-401d-a727-5589a303ea4a">
    <skos:broader rdf:resource="da2c70fd-d92b-45be-b159-b2c10cb387c6"/>
    <dcterms:created>2019-07-15</dcterms:created>
    <skos:prefLabel xml:lang="en">MENTAL HEALTH IMPACTS</skos:prefLabel>
    <skos:changeNote>Date=2019-07-15 User Id=mmorahan Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=MENTAL HEALTH IMPACTS [3ad043a9-2ec8-401d-a727-5589a303ea4a,368955] - PUBLIC HEALTH [da2c70fd-d92b-45be-b159-b2c10cb387c6,83869]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from (1) the CDC (https://www.cdc.gov/mentalhealth/learn/index.htm), (2) Finding 8.1 (https://health2016.globalchange.gov/mental-health-and-well-being#finding-59), and (3) and Finding 8.2 (https://health2016.globalchange.gov/mental-health-and-well-being#finding-60) of The Impacts of Climate Change on Human Health in the United States: A Scientific Assessment" xml:lang="en"/>
    <skos:definition xml:lang="en">Mental health refers to the emotional, psychological, and socialwell-being of one or more people. 1 Mental health can be be impactedby exposure to climate related or weather-related disasters. 2 Specificgroups of people are at higher risk for distress and other adversemental health consequences including but not limited to children, theelderly, and people with preexisting mental illness. 3</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <gcmd:altLabel gcmd:text="PSYCHOLOGICAL HEALTH IMPACTS" xml:lang="en"/>
  </skos:Concept>
