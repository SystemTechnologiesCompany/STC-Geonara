    <gcmd:reference gcmd:text="Glossary of Meteorology, https://glossary.ametsoc.org/wiki/Snow" xml:lang="en"/>
    <skos:definition xml:lang="en">Precipitation composed of white or translucent ice crystals, chiefly in complex branch hexagonal form and often agglomerated into snowflakes.</skos:definition>
