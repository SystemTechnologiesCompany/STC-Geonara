    <skos:prefLabel xml:lang="en">ANTICYCLONES/CYCLONES</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Weather and Climate, American Meteorological Society, 1996." xml:lang="en"/>
    <skos:definition xml:lang="en">An anticyclone is a dome of air that exerts relatively highatmospheric pressure compared with the surrounding air at a given level. Acyclone is a weather system characterised by relatively low surface airpressure at a given level and a closed cyclonic wind circulation.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
