  <skos:Concept rdf:about="6ee1f87a-dc7a-48f7-9b0f-9c529a5645a5">
    <skos:broader rdf:resource="39f5a91f-c5b6-4aa9-a0c6-05530306f17b"/>
    <skos:prefLabel xml:lang="en">TSUNAMIS</skos:prefLabel>
    <gcmd:reference gcmd:text="&lt;i&gt;AP Dictionary of Science and Technology&lt;/i&gt;:&lt;br&gt;  &apos;http://www.academicpress.com/inscight/12201999/tsunami1.htm&apos;&lt;br&gt; &apos;http://www.pmel.noaa.gov/~bernard/problem.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">A long-period (usually 15-60 minutes) wave caused by a large-scale movement of
the sea floor, from a volcanic eruption, submarine earthquake, or landslide
although usually barely noticeable at sea, its velocity may be as high as 400
knots, so that it travels great distances and in shoal water may reach heights
of around 15 meters.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="792cf9f0-6d24-4de8-902c-b74e42c74fd3">
    <skos:broader rdf:resource="3a942e8a-d2f2-42bf-9e83-b7b3793b100e"/>
    <skos:prefLabel xml:lang="en">AURORAE</skos:prefLabel>
    <gcmd:reference gcmd:text="NOAA/NGDC Solar-Terrestrial Gloassary http://www.ngdc.noaa.gov/stp/GLOSSARY/glossary.html" xml:lang="en"/>
    <skos:definition xml:lang="en">A faint visual phenomenon associated with geomagnetic activity,
which occurs mainly in the high-latitude night sky.  Typical
auroras are 100 to 250 km above the ground.   The phenomenon
caused by collisions between charged particles, atoms, and ions
in the Earth&apos;s ionosphere and upper atmosphere.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
