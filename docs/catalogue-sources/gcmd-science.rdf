    <skos:prefLabel xml:lang="en">MARINE OBSTRUCTIONS</skos:prefLabel>
    <skos:definition xml:lang="en">The act of watching,keeping track of or checking the ocean(pelagic orbottom conditions) for a special purpose.</skos:definition>
