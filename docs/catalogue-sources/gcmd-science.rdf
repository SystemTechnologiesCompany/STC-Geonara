  <skos:Concept rdf:about="02290e22-24ae-40f6-96f1-0c6c76a145af">
    <skos:broader rdf:resource="910013d7-1e6a-4d1a-9921-be32d792a290"/>
    <skos:prefLabel xml:lang="en">GEOMAGNETIC FORECASTS</skos:prefLabel>
    <skos:changeNote>Date=2013-03-11 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=text 
System Note=update Definition
Old Value=Pertaining to the data and methods used to forecast variations and storms
in the Earth&apos;s magnetic field.
New Value=Forecasts of the likelihood (from 1% to 99%) that the daily geomagnetic activity level will reach a particular activity category. The four categories are Quiet to Unsettled, Active, Minor Storm, and Major to Severe Storm. The geomagnetic category assigned to a day is determined by the highest observed k-index for the day. Quiet to Unsettled = k 0 to k 3, Active = k 4, Minor Storm = k 5, and Major to Severe Storm = k 6 to k 9. Middle-latitude forecasts are verified against Fredericksburg, VA observations and High-latitude forecasts are verified against College, AK observations. Forecast lead times range from one to three days.</skos:changeNote>
    <skos:changeNote>Date=2013-02-18 User Id=tbs1979 Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=GEOMAGNETIC FORECASTS [02290e22-24ae-40f6-96f1-0c6c76a145af,63913] - GEOMAGNETIC ACTIVITY [2d3d9a57-44e8-43c0-98b4-b4891c994862,82399]</skos:changeNote>
    <skos:changeNote>Date=2013-02-18 User Id=tbs1979 Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=GEOMAGNETIC FORECASTS [02290e22-24ae-40f6-96f1-0c6c76a145af,63913] - TOTAL INTENSITY [9a46a62c-952d-4253-8249-7375c14068a2,82397]</skos:changeNote>
    <skos:changeNote>Date=2013-02-18 User Id=tbs1979 Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=GEOMAGNETIC FORECASTS [02290e22-24ae-40f6-96f1-0c6c76a145af,63913] - GEOMAGNETIC STORM CATEGORY [4b7decec-e378-4824-aecf-9fe509392efd,82401]</skos:changeNote>
    <skos:changeNote>Date=2013-03-11 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
New Value=NOAA Space Weather Prediction Center</skos:changeNote>
    <gcmd:reference gcmd:text="NOAA Space Weather Prediction Center" xml:lang="en"/>
    <skos:narrower rdf:resource="4b7decec-e378-4824-aecf-9fe509392efd"/>
    <skos:narrower rdf:resource="2d3d9a57-44e8-43c0-98b4-b4891c994862"/>
    <skos:narrower rdf:resource="9a46a62c-952d-4253-8249-7375c14068a2"/>
    <skos:definition xml:lang="en">Forecasts of the likelihood (from 1% to 99%) that the daily geomagnetic activity level will reach a particular activity category. The four categories are Quiet to Unsettled, Active, Minor Storm, and Major to Severe Storm. The geomagnetic category assigned to a day is determined by the highest observed k-index for the day. Quiet to Unsettled = k 0 to k 3, Active = k 4, Minor Storm = k 5, and Major to Severe Storm = k 6 to k 9. Middle-latitude forecasts are verified against Fredericksburg, VA observations and High-latitude forecasts are verified against College, AK observations. Forecast lead times range from one to three days.</skos:definition>
    <dcterms:modified>2013-03-11 14:26:32.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
