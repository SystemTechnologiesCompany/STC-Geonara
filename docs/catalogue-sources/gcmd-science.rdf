    <skos:prefLabel xml:lang="en">NITRATE</skos:prefLabel>
    <skos:definition xml:lang="en">A charged molecule composed of one atom of nitrogen and three atoms ofoxygen, NO3-, available to plants and phytoplankton as a nutrient.</skos:definition>
