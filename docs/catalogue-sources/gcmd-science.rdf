    <skos:prefLabel xml:lang="en">HYDROGEN PEROXIDE</skos:prefLabel>
    <skos:changeNote>Date=2022-03-03 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=HYDROGEN PEROXIDE [75662ed3-35c5-41ee-abba-51ce435d1b31,836052] - OXYGEN COMPOUNDS [4cc9b4fa-5097-447f-914c-eb90820938c6,832532]</skos:changeNote>
    <gcmd:reference gcmd:text="https://en.wikipedia.org/wiki/Hydrogen_peroxide" xml:lang="en"/>
    <skos:definition xml:lang="en">Hydrogen peroxide is a chemical compound with the formula H2O 2. In its pure form, it is a very pale blue[5] liquid, slightly more viscous than water.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
