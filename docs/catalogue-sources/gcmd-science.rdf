  <skos:Concept rdf:about="29a64468-46a8-4dbc-955d-80b7b4cf9aaf">
    <skos:broader rdf:resource="233a4d81-44f8-4b0e-8ad3-695f641729f8"/>
    <skos:prefLabel xml:lang="en">RESPIRATION RATE</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J.and Richard T. Wright. Environmental Science-the Way the World Works. 1998. Prentice-Hall, Inc. Upper Saddle River, New Jersey." xml:lang="en"/>
    <skos:definition xml:lang="en">The chemical process that occurs in all living cells wherein organiccompounds are broken down to release energy required for lifeprocesses.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="7ee9d286-0742-4844-b7eb-b7550d3f782b">
    <skos:broader rdf:resource="22ec2f9b-1f1a-469b-bc09-851d58637ff4"/>
    <skos:prefLabel xml:lang="en">FOREST CONSERVATION</skos:prefLabel>
    <gcmd:reference gcmd:text="From the Glossary of Forestry Terms, Ministry of Forests, Government of British Columbia, Canada. &apos;http://www.for.gov.bc.ca/hfd/library/documents/glossary/&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">Management of the human use of the biosphere so that it may yield the greatest
sustainable benefit to present generations while maintaining its potential to
meet the needs and aspirations of future generations. It includes the
preservation, maintenance, sustainable utilisation, restoration and enhancementof the environment.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
