    <skos:changeNote>Date=2012-06-26 User Id=gee-cee Entity=BroaderRelation Operation=INSERT 
User Note=Move Concepts
System Note=add broader relation
New Value=FOREST FIRE DANGER INDEX [16329a9b-72ea-4b46-b507-2ce389c63f50,22803] - LAND SURFACE/AGRICULTURE INDICATORS [112e71ec-c0a1-49a8-82d7-bcb317b45860,39835]</skos:changeNote>
    <gcmd:reference gcmd:text="See the American Meteorological Society Glossary of Meteorology Online:  &apos;http://amsglossary.allenpress.com/glossary&apos;.  For other fire weather terms, see:&apos;http://www.fs.fed.us/r2/fire/fbgloss.htm&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">A forest fire danger index (FDI) or burning index (BI) is a relative number
related to the contribution that fire behavior makes to the amount of effort
needed to contain a fire of a specified fuel type. The index may be calculated
differently by different agencies around the world.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
