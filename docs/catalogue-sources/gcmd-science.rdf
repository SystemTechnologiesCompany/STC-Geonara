    <gcmd:reference gcmd:text="https://w1.weather.gov/glossary/index.php?letter=l" xml:lang="en"/>
    <skos:definition xml:lang="en">The infrared energy emitted from the earth at wavelengths between about 5 and 25 micrometers.</skos:definition>
