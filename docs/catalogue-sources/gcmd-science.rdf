    <skos:broader rdf:resource="02d92216-70c6-437c-8c15-2b76f2132921"/>
    <skos:prefLabel xml:lang="en">DATA INTEROPERABILITY</skos:prefLabel>
    <gcmd:reference gcmd:text="IEEE Standard Computer Dictionary" xml:lang="en"/>
    <skos:narrower rdf:resource="dad75074-b2f7-4cb7-ae02-02d054f18251"/>
    <skos:definition xml:lang="en">Interoperability is the ability of two or more systems or components to exchange information and to use the information that has been exchanged.</skos:definition>
