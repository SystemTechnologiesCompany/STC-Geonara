    <skos:changeNote>Date=2012-06-26 User Id=gee-cee Entity=BroaderRelation Operation=INSERT 
User Note=Move Concepts
System Note=add broader relation
New Value=FIRE WEATHER INDEX [7c1977bc-dfe7-4761-9b30-f42ec986d360,22931] - LAND SURFACE/AGRICULTURE INDICATORS [112e71ec-c0a1-49a8-82d7-bcb317b45860,39835]</skos:changeNote>
    <gcmd:reference gcmd:text="American Meteorological Society. 2000. Glossary of Meteorology, Second Edition. Boston, MA: American Meteorological Society." xml:lang="en"/>
    <skos:definition xml:lang="en">A fire weather index relates wind, temperature, relative humidity, andprecipitation, to indicate conditions that influence fire starts, firebehavior, or fire suppression.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
