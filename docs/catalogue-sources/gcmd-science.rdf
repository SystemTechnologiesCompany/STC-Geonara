  <skos:Concept rdf:about="17ce714a-bd7e-41a2-ab3d-4865832f1f0a">
    <skos:broader rdf:resource="72304037-ce59-451a-beeb-4258f3db296a"/>
    <dcterms:created>2013-09-04</dcterms:created>
    <skos:prefLabel xml:lang="en">DRY ADIABATIC LAPSE RATE</skos:prefLabel>
    <skos:changeNote>Date=2014-04-14 User Id=128.183.164.42 Entity=Definition Operation=INSERT 
User Note=added definition
System Note=insert Definition
New Value=id: null
text: The rate at which the temperature of a parcel of dry air decreases as the parcel is lifted in the atmosphere. The dry adiabatic lapse rate (abbreviated DALR) is 5.5Â°F per 1000 ft or 9.8Â°C per km.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-09-04 User Id=epneff Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=DRY ADIABATIC LAPSE RATE [17ce714a-bd7e-41a2-ab3d-4865832f1f0a,105807] - VERTICAL PROFILES [72304037-ce59-451a-beeb-4258f3db296a,86067]</skos:changeNote>
    <gcmd:reference gcmd:text="National Weather Service Glossary, NOAA, 2009" xml:lang="en"/>
    <skos:definition xml:lang="en">The rate at which the temperature of a parcel of dry air decreases as the parcel is lifted in the atmosphere. The dry adiabatic lapse rate (abbreviated DALR) is 5.5Â°F per 1000 ft or 9.8Â°C per km.</skos:definition>
    <dcterms:modified>2014-04-14 15:22:44.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="2ddd003d-c19f-4336-9837-316cce5efe0b">
    <skos:broader rdf:resource="50b8fe04-9149-4b7f-a8b2-b33b1e3aa192"/>
    <skos:prefLabel xml:lang="en">ALBEDO</skos:prefLabel>
    <gcmd:reference gcmd:text="Maunder, W.J. 1994. Dictionary of Global Climate Change, 2nd ed. Chapman and Hall, NY. WMO, 1966. International Meteorological Vocabulary, WMO/OMM/BMO - No. 182 TP. 91, Switzerland." xml:lang="en"/>
    <skos:definition xml:lang="en">Albedo is the ratio of the radiation (radiant energy or luminousenergy) reflected by a surface to that incident on it. Snow and cloudsurfaces have a high albedo, because most of the energy of the visiblesolar spectrum is reflected. Vegetation and ocean surfaces have lowalbedo, because they absorb a large fraction of the energy. Clouds are thechief cause of variations in the Earth&apos;s albedo.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="72c180e6-b3f3-4f9a-8d04-23f0b10735af">
    <skos:broader rdf:resource="1488b98d-6497-48b9-88db-6ee82a2e3ed3"/>
    <dcterms:created>2017-04-20</dcterms:created>
    <skos:prefLabel xml:lang="en">DUST DEVILS</skos:prefLabel>
    <skos:changeNote>Date=2017-04-21 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A well-developed dust whirl; a small but vigorous whirlwind, usually of short duration, rendered visible by dust, sand, and debris picked up from the ground.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2017-04-20 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=DUST DEVILS [72c180e6-b3f3-4f9a-8d04-23f0b10735af,278895] - LOCAL WINDS [1488b98d-6497-48b9-88db-6ee82a2e3ed3,278859]</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society" xml:lang="en"/>
    <skos:definition xml:lang="en">A well-developed dust whirl; a small but vigorous whirlwind, usually of short duration, rendered visible by dust, sand, and debris picked up from the ground.</skos:definition>
    <dcterms:modified>2017-04-21 11:41:50.0</dcterms:modified>
