    <gcmd:reference gcmd:text="Dictionary of Geological Terms, American Geological Institute, 1984." xml:lang="en"/>
    <skos:definition xml:lang="en">The application of the principles of mechanics and hydraulics toengineering problems dealing with the behavior and nature of soils,sediments, and other unconsolidated accumulations.</skos:definition>
