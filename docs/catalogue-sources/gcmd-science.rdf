    <skos:broader rdf:resource="dba19648-3f52-48ba-b00b-8527d44c4d74"/>
    <skos:prefLabel xml:lang="en">PARTICULATE MATTER</skos:prefLabel>
    <gcmd:reference gcmd:text="National Ice Core Laboratory:  http://www.nicl-smo.sr.unh.edu/documents/1988/solubleInsoluble.html" xml:lang="en"/>
    <skos:definition xml:lang="en">Particulate matter in ice cores (continental dust, volcanic ash, diatoms, andpollen)can provide information on past climate conditions and climatevariability.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="64d17528-29b4-4e2e-843a-7f7035bb5717">
    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">AMMONIA</skos:prefLabel>
    <skos:definition xml:lang="en">A gaseous compound of one nitrogen atom and three hydrogen atoms, NH3, thatis highly water-soluble. A dissolved form, ammonium, NH4+, is a nutrientand is listed as a detailed variable under ammonia.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="640d703f-9312-4f11-8367-30a8bd8fc508">
    <skos:broader rdf:resource="e1f20631-b5b9-438c-b5c2-b1fa0fce100a"/>
    <skos:prefLabel xml:lang="en">CARBON CYCLE/CARBON BUDGET MODELS</skos:prefLabel>
    <skos:definition xml:lang="en">Models relating to carbon cycle modeling that simulates, over a given period oftime, carbon interactions on the ecosphere.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="68e2c729-f729-4936-af2e-0ecf7ee7d231">
    <skos:broader rdf:resource="ce4b2c6e-3d69-4cf1-8416-c36e5f9b1b2c"/>
    <skos:prefLabel xml:lang="en">TURBIDITY</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: The Open University. 1989. Seawater: its Compostion, Properties and Behaviour. Pergamon Press. p. 66." xml:lang="en"/>
    <skos:definition xml:lang="en">Measurement of the degree of scattering of light in water, related tothe amount of suspended material in the water.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="67239b1c-db58-4f67-a47a-c6f3ba95a16b">
    <skos:broader rdf:resource="727a79dd-bef9-40c3-bf85-e152947b8e49"/>
    <dcterms:created>2020-05-21</dcterms:created>
    <skos:prefLabel xml:lang="en">RESAMPLING</skos:prefLabel>
    <skos:changeNote>Date=2020-05-21 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=RESAMPLING [67239b1c-db58-4f67-a47a-c6f3ba95a16b,560217] - DATA CUSTOMIZATION [727a79dd-bef9-40c3-bf85-e152947b8e49,560209]</skos:changeNote>
    <gcmd:reference gcmd:text="Good, P.I. (2012) Practitioner&apos;s Guide to Resampling Methods." xml:lang="en"/>
    <skos:definition xml:lang="en">The method that consists of drawing repeated samples from the original data samples. The method of Resampling is a nonparametric method of statistical inference. In other words, the method of resampling does not involve the utilization of the generic distribution tables (for example, normal distribution tables) in order to compute approximate p probability values.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="6621ba11-af39-4634-b07c-811585e91a77">
    <skos:broader rdf:resource="b37c3094-6ec8-4429-a80b-b332a7b4947d"/>
    <skos:prefLabel xml:lang="en">ASK-A OCEANOGRAPHER</skos:prefLabel>
    <skos:definition xml:lang="en">Digital reference services that use the Internet to connect people with peoplewho can answer questions about the marine and oceanographic sciences.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="7b8ad020-7eff-4639-b8c1-8b22e1535c00">
    <skos:broader rdf:resource="68eed887-8008-4352-b420-949457ab59ab"/>
    <dcterms:created>2023-04-03</dcterms:created>
    <skos:prefLabel xml:lang="en">GLACIER ACCUMULATION</skos:prefLabel>
    <skos:changeNote>Date=2023-04-03 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Mass gained by a glacier from all processes.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2023-04-03 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=GLACIER ACCUMULATION [7b8ad020-7eff-4639-b8c1-8b22e1535c00,1276527] - GLACIERS [68eed887-8008-4352-b420-949457ab59ab,1273524]</skos:changeNote>
    <gcmd:reference gcmd:text="NSIDC" xml:lang="en"/>
    <skos:definition xml:lang="en">Mass gained by a glacier from all processes.</skos:definition>
    <dcterms:modified>2023-04-03 18:16:37.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="68f7ba1b-a2f9-41b6-9bc1-fd187942fbed">
    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">CARBONATE</skos:prefLabel>
    <skos:definition xml:lang="en">A dissolved ion of carbonic acid, with the chemical formula CO3(-2), formedby dissolution of carbon dioxide in water. Other forms of carbonate, suchas bicarbonate, HCO3-, are included with this variable as detailedvariables.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="676248f0-75cd-466d-93f1-351440027c82">
    <skos:broader rdf:resource="d46a5046-e1c6-4a09-a2f1-db6a21eda611"/>
    <skos:prefLabel xml:lang="en">METHYL CHLORIDE</skos:prefLabel>
    <gcmd:reference gcmd:text="Graedel, T. E. and Paul Crutzen. Atmospheric Change: An Earth System Prospective. W.H. Freeman and Company:   New York, 1993: 143." xml:lang="en"/>
    <skos:definition xml:lang="en">CH3Cl, this compound supplies chlorine to the stratosphere by occasional volcanic eruptions and by tropospheric to stratospheric transport. Methyl chloride is also produced by seaweed. The natural chlorine content of the stratosphere as a consequence of these sources is about 0.6 ppbv.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="67773da0-f5f1-4047-871a-1fb5a5c1621a">
    <skos:broader rdf:resource="cad91f82-7e2a-43b7-b272-2dc77e2791f4"/>
    <skos:prefLabel xml:lang="en">HEAVY NUCLEI FLUX</skos:prefLabel>
    <gcmd:reference gcmd:text="Jursa, A.S., ed. 1985. Handbook of Geophysics and the Space Enviornment, Air Force Geophysics Laboratory, USAF. (Available from NTIS, Springfield, VA)" xml:lang="en"/>
    <skos:definition xml:lang="en">Solar energetic particles consisting of nuclei of elements heavier than protonsand electrons.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="64baed75-e3c0-4495-9bc9-c5b9373670f6">
    <skos:broader rdf:resource="9246fc12-17e7-4473-b9c0-c23e4bfc4eda"/>
    <dcterms:created>2012-06-26</dcterms:created>
    <skos:prefLabel xml:lang="en">RIVER/LAKE ICE BREAKUP</skos:prefLabel>
    <skos:changeNote>Date=2012-06-26 User Id=gee-cee Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=RIVER/LAKE ICE BREAKUP [64baed75-e3c0-4495-9bc9-c5b9373670f6,39873] - TERRESTRIAL HYDROSPHERE INDICATORS [9246fc12-17e7-4473-b9c0-c23e4bfc4eda,39869]</skos:changeNote>
    <skos:changeNote>Date=2024-10-08 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The process by which ice melts and breaks apart in lakes and rivers. Ice breakup in lakes and rivers has been watched carefully by people living in cold climates, allowing us to observe progressive earlier breakup associated with climate warming. Ice breakup is important to people because it indicates that waterways blocked by ice will soon be navigable, allowing transport of goods, hunting, recreation, and other activities of economic and social importance.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/topics/earth-and-planetary-sciences/ice-breakup" xml:lang="en"/>
    <skos:definition xml:lang="en">The process by which ice melts and breaks apart in lakes and rivers. Ice breakup in lakes and rivers has been watched carefully by people living in cold climates, allowing us to observe progressive earlier breakup associated with climate warming. Ice breakup is important to people because it indicates that waterways blocked by ice will soon be navigable, allowing transport of goods, hunting, recreation, and other activities of economic and social importance.</skos:definition>
    <dcterms:modified>2024-10-08 13:38:42.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
