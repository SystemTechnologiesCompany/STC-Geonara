    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">NITRIC ACID</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Webster&apos;s College Dictionary. 1991. Random House." xml:lang="en"/>
    <skos:definition xml:lang="en">A strong acid, nitric acid (HNO3) is a colorless or yellowish,fuming, suffocating, caustic liquid. It is highly water-soluble.</skos:definition>
