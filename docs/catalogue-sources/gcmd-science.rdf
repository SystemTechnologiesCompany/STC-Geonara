  <skos:Concept rdf:about="449ad1fb-8010-43c7-b994-178a049d4cff">
    <skos:broader rdf:resource="5a7bb095-4d12-4232-bc75-b8e82197cb92"/>
    <skos:prefLabel xml:lang="en">TEMPERATURE TENDENCY</skos:prefLabel>
    <skos:changeNote>Date=2013-10-16 User Id=saritz Entity=Definition Operation=UPDATE Field=text 
User Note=updated definition
System Note=update Definition
Old Value=Temperature is defined, in general, as the degree of hotness or coldness
as measured on some definite temperature scale by means of any of various
types of thermometers. Tendency is defined as the local rate of
change of a vector or scalar quantity with time at a given point in space.
Because of the difficulty of measuring instantaneous variations in the
atmosphere, variations are usually obtained from the differences in
magnitudes over a finite period of time; and the definition of tendency is
frequently broadened to include the local time variations so
obtained.
New Value=Temperature is defined, in general, as the degree of hotness or coldness measured on some definite temperature scale by means of any of various types of thermometers.  Tendency is defined as the local rate of
change of a vector or scalar quantity with time at a given point in space.  Because of the difficulty of measuring instantaneous variations in the atmosphere, variations are usually obtained from the differences in magnitudes over a finite period of time; and the definition of tendency is frequently broadened to include the local time variations so obtained.</skos:changeNote>
    <skos:changeNote>Date=2013-09-04 User Id=epneff Entity=BroaderRelation Operation=INSERT 
User Note=Move Concepts
System Note=add broader relation
New Value=TEMPERATURE TENDENCY [449ad1fb-8010-43c7-b994-178a049d4cff,85741] - SURFACE TEMPERATURE [5a7bb095-4d12-4232-bc75-b8e82197cb92,86389]</skos:changeNote>
    <skos:changeNote>Date=2013-09-04 User Id=epneff Entity=BroaderRelation Operation=DELETE 
User Note=Move Concepts
System Note=delete broader relation
Old Value=TEMPERATURE TENDENCY [449ad1fb-8010-43c7-b994-178a049d4cff,85741] - ATMOSPHERIC TEMPERATURE [35e1f93b-99b3-4430-b477-0ecafa80d67a,83865]</skos:changeNote>
    <skos:changeNote>Date=2013-10-16 User Id=saritz Entity=Definition Operation=UPDATE Field=reference 
User Note=updated definition
System Note=update Definition
Old Value=Glossary of Meteorology, American Meteorological Society, 1998.
New Value=Glossary of Meteorology, American Meteorological Society, 1998.</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society, 1998." xml:lang="en"/>
    <skos:definition xml:lang="en">Temperature is defined, in general, as the degree of hotness or coldness measured on some definite temperature scale by means of any of various types of thermometers.  Tendency is defined as the local rate ofchange of a vector or scalar quantity with time at a given point in space.  Because of the difficulty of measuring instantaneous variations in the atmosphere, variations are usually obtained from the differences in magnitudes over a finite period of time; and the definition of tendency is frequently broadened to include the local time variations so obtained.</skos:definition>
    <dcterms:modified>2013-10-16 18:58:21.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="78fb5691-136d-40f8-a834-6e6f4cd768ff">
    <skos:broader rdf:resource="42c6d91b-afef-4638-95c5-0d130828b2e7"/>
    <dcterms:created>2018-03-07</dcterms:created>
    <skos:prefLabel xml:lang="en">COPPER</skos:prefLabel>
    <skos:changeNote>Date=2018-03-07 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A chemical element that is a soft, malleable, and ductile metal with very high thermal and electrical conductivity. A freshly exposed surface of pure copper has a reddish-orange color. Copper is used as a conductor of heat and electricity, as a building material, and as a constituent of various metal alloys, such as sterling silver used in jewelry, cupronickel used to make marine hardware and coins, and constantly used in strain gauges and thermocouples for temperature measurement.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2018-03-07 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=COPPER [78fb5691-136d-40f8-a834-6e6f4cd768ff,310657] - CONTAMINANTS [42c6d91b-afef-4638-95c5-0d130828b2e7,84623]</skos:changeNote>
    <gcmd:reference gcmd:text="CRC Handbook of Chemistry and Physics" xml:lang="en"/>
    <skos:definition xml:lang="en">A chemical element that is a soft, malleable, and ductile metal with very high thermal and electrical conductivity. A freshly exposed surface of pure copper has a reddish-orange color. Copper is used as a conductor of heat and electricity, as a building material, and as a constituent of various metal alloys, such as sterling silver used in jewelry, cupronickel used to make marine hardware and coins, and constantly used in strain gauges and thermocouples for temperature measurement.</skos:definition>
    <dcterms:modified>2018-03-07 09:23:58.0</dcterms:modified>
