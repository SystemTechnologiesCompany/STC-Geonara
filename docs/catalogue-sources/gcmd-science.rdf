  <skos:Concept rdf:about="46a3c823-727d-4c3c-b09d-e3e3fcaa43a5">
    <skos:broader rdf:resource="4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
    <skos:prefLabel xml:lang="en">HEAT FLUX</skos:prefLabel>
    <gcmd:reference gcmd:text="CDIAC. 1990. Glossary, Carbon Dioxide and Climate. Carbon Dioxide Information Analysis Center/Department of Energy, Oak Ridge, TN. &apos;http://cdiac.esd.ornl.gov/glossary.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">Heat flux is the amount of heat that is transferred across a surface of
unit area in a unit of time. Also refers to latent and sensible heat
fluxes in the atmosphere and between the Earth&apos;s surface and
atmosphere.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="49c8770a-2eb7-40f1-aab0-9c12d3aed031">
    <skos:broader rdf:resource="4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
    <skos:prefLabel xml:lang="en">EMISSIVITY</skos:prefLabel>
    <gcmd:reference gcmd:text="Huschke, R.E. ed. 1959. Glossary of Meteorology, American Meterological Society, Boston, MA." xml:lang="en"/>
    <skos:definition xml:lang="en">The ratio of the emittance of a given surface at a specified wavelengthand emitting temperature to the emittance of an ideal black body at thesame wavelength and temperature. Emissivity has a value between 0 (least)and one (greatest).</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="47f4e7ac-b4ca-4ef9-824b-a36ea5510526">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">PHOSPHORUS</skos:prefLabel>
    <gcmd:reference gcmd:text="Starr, C. and R.Taggart. 1998. Biology: the unity and diversity of life. Wadsworth Publishing Company. Belmont, California." xml:lang="en"/>
    <skos:definition xml:lang="en">Phosphorus is a plant element which is a component of nucleicacids, phospholipids and ATP.	  Plants lacking phosphorus havepurplish veins, stunted growth, fewer seeds, and fruits.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="4809f1e1-1b36-46a7-a7ae-ce55523424e6">
    <skos:broader rdf:resource="cda9b483-8711-42b8-82f9-e7d22ce9c62c"/>
    <skos:prefLabel xml:lang="en">ORBITAL CHARACTERISTICS</skos:prefLabel>
    <gcmd:reference gcmd:text="Mission to Planet Earth, Glossary of Terms, 1994." xml:lang="en"/>
    <skos:definition xml:lang="en">Those properties which describe a satellite in its  periodic revolution.These consist of the satellite&apos;s altitude, orbital  inclination (anglewith respect to the equator, thus a polar orbit is  near 90 degrees, whilean equatorial orbit is near 0 degrees), orbital period, etc.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="44dd98d0-a0d0-46b2-bb98-ed887ce7fa60">
    <skos:broader rdf:resource="f0bd7eeb-9004-4e40-a649-f6010d8a4303"/>
    <dcterms:created>2013-02-18</dcterms:created>
    <skos:prefLabel xml:lang="en">SUBDUCTION</skos:prefLabel>
    <skos:changeNote>Date=2013-04-02 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The process that takes place at convergent boundaries by which one tectonic plate moves under another tectonic plate, sinking into the Earth&apos;s mantle, as the plates converge. A subduction zone is an area on Earth where two tectonic plates move towards one another and subduction occurs.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-02-18 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SUBDUCTION [44dd98d0-a0d0-46b2-bb98-ed887ce7fa60,82551] - TECTONIC PROCESSES [f0bd7eeb-9004-4e40-a649-f6010d8a4303,82507]</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">The process that takes place at convergent boundaries by which one tectonic plate moves under another tectonic plate, sinking into the Earth&apos;s mantle, as the plates converge. A subduction zone is an area on Earth where two tectonic plates move towards one another and subduction occurs.</skos:definition>
    <dcterms:modified>2013-04-02 08:53:28.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="46ecf46f-a710-4589-82b2-34aebf35c3c0">
    <skos:broader rdf:resource="76589134-8d93-4e45-8476-f04497181d14"/>
    <dcterms:created>2016-06-13</dcterms:created>
    <skos:prefLabel xml:lang="en">ARCTIC TUNDRA</skos:prefLabel>
    <skos:changeNote>Date=2016-06-13 User Id=gee-cee Entity=BroaderRelation Operation=INSERT 
