  <skos:Concept rdf:about="072721be-eb8b-4ac4-9354-251dbf74ade0">
    <skos:broader rdf:resource="42c6d91b-afef-4638-95c5-0d130828b2e7"/>
    <dcterms:created>2018-03-07</dcterms:created>
    <skos:prefLabel xml:lang="en">POTASSIUM</skos:prefLabel>
    <skos:changeNote>Date=2018-03-07 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: A chemical element which, in nature,  occurs only in ionic salts. Elemental potassium is a soft silvery-white alkali metal that oxidizes rapidly in air and reacts vigorously with water, generating sufficient heat to ignite hydrogen emitted in the reaction and burning with a lilac-colored flame. It is found dissolved in sea water and is part of many minerals.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2018-03-07 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=POTASSIUM [072721be-eb8b-4ac4-9354-251dbf74ade0,310663] - CONTAMINANTS [42c6d91b-afef-4638-95c5-0d130828b2e7,84623]</skos:changeNote>
    <gcmd:reference gcmd:text="The Journal of Experimental Biology" xml:lang="en"/>
    <skos:definition xml:lang="en">A chemical element which, in nature,  occurs only in ionic salts. Elemental potassium is a soft silvery-white alkali metal that oxidizes rapidly in air and reacts vigorously with water, generating sufficient heat to ignite hydrogen emitted in the reaction and burning with a lilac-colored flame. It is found dissolved in sea water and is part of many minerals.</skos:definition>
    <dcterms:modified>2018-03-07 09:34:46.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="07291e32-fd39-45e8-a603-7443cb780976">
    <skos:broader rdf:resource="02d92216-70c6-437c-8c15-2b76f2132921"/>
    <skos:prefLabel xml:lang="en">DATA MINING</skos:prefLabel>
    <gcmd:reference gcmd:text="Data &amp; Analysis Center for Software (DACS)" xml:lang="en"/>
    <skos:definition xml:lang="en">Data mining is a variety of techniques used to identify nuggets of information or decision-making knowledge in bodies of data, and extracting these in such a way that they can be put to use in areas such as decision support, prediction, forecasting, and estimation. The data is often voluminous but, as it stands, of low value as no direct use can be made of it; it is the hidden information in the data that is useful.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
