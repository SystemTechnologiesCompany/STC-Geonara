  <skos:Concept rdf:about="68c2baba-b9b9-41d4-89bf-07488728bc4f">
    <skos:broader rdf:resource="7a73c724-b532-45eb-a9a5-c77330b61bab"/>
    <skos:prefLabel xml:lang="en">THERMAL INFRARED</skos:prefLabel>
    <gcmd:reference gcmd:text="AILSA ALLABY and MICHAEL ALLABY. &apos;thermal infrared.&apos; A Dictionary of Earth Sciences. 1999. Encyclopedia.com. 4 Aug. 2009 &lt;http://www.encyclopedia.com&gt;." xml:lang="en"/>
    <skos:definition xml:lang="en">Thermal infrared Infrared radiation which has a wavelength between 3.0 μm and 100 μm. At normal environmental temperatures objects emit infrared between these wavelengths; hotter objects, such as fires, emit infrared at wavelengths shorter than thermal infrared. Compare REFLECTED INFRARED.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
