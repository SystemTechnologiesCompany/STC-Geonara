  </skos:Concept>
  <skos:Concept rdf:about="095a05c0-6220-4abd-9c1b-c4504a092d7d">
    <skos:broader rdf:resource="b887d3e5-4280-43d2-a34e-0f63ac086b6a"/>
    <skos:prefLabel xml:lang="en">EL NINO SOUTHERN OSCILLATION (ENSO)</skos:prefLabel>
    <skos:changeNote>Date=2012-06-25 User Id=mpmorahan Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=EL NINO SOUTHERN OSCILLATION [095a05c0-6220-4abd-9c1b-c4504a092d7d,22987] - ENSO [54330626-f9b4-4c34-949a-9be427fdf51b,39707]</skos:changeNote>
