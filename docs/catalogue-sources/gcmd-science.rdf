    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">A specific type of particle transport by fluids such as wind, or the denser fluid water. It occurs when loose material is removed from a bed and carried by the fluid, before being transported back to the surface.</skos:definition>
