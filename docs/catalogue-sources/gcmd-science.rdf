    <skos:prefLabel xml:lang="en">PERCH-LIKE FISHES</skos:prefLabel>
    <skos:changeNote>Date=2013-12-31 User Id=epneff Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=PERCH-LIKE FISHES [85b2ba83-b81c-45a6-98d1-07b36040fe45,84373] - TUNAS AND ALLIES [1369d226-2b9b-4f69-a197-6e24523b21e7,106083]</skos:changeNote>
    <gcmd:reference gcmd:text="Encyclopedia of Life" xml:lang="en"/>
    <skos:narrower rdf:resource="1369d226-2b9b-4f69-a197-6e24523b21e7"/>
    <skos:definition xml:lang="en">Perciforms, or perch-like fish, form the largest order of fish, the largest order of vertebrates and comprise at least a third of all fish species. They are distinguished by  pectoral fins on the sides; spines on the dorsal and anal fins; pelvic fins on the abdomen with one spine and up to five soft rays; dorsal and anal fins that are detached from the caudal (tail) fin, and jaw that can be thrust outward to suck food into the mouth.</skos:definition>
    <dcterms:modified>2013-12-31 10:25:43.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
