    <skos:prefLabel xml:lang="en">HAIL PATH</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from HAIL PATH [4ec71dc5-66bf-453b-883a-ad6d31b3edde] to HAIL STORMS [a2ea1792-c011-4c7c-95c7-3bd648b1b57b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nssl.noaa.gov/education/svrwx101/hail/" xml:lang="en"/>
    <skos:definition xml:lang="en">The route/localized area of a hailstorm, occurring as hail falls while the storm path is moving. Sometimes also referred to as the hail swath.</skos:definition>
    <dcterms:modified>2025-08-12T17:49:37.780Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="3a1aa79b-2897-4ede-8682-3bd66be93a91">
    <skos:broader rdf:resource="2e5a401b-1507-4f57-82b8-36557c13b154"/>
    <skos:prefLabel xml:lang="en">AEROSOL VERTICAL DISTRIBUTION</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from AEROSOL VERTICAL DISTRIBUTION [3a1aa79b-2897-4ede-8682-3bd66be93a91] to AEROSOLS [2e5a401b-1507-4f57-82b8-36557c13b154]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/science/article/pii/S0048969723052075" xml:lang="en"/>
    <skos:definition xml:lang="en">The distribution of aerosols throughout a vertical column of the atmosphere.</skos:definition>
    <dcterms:modified>2025-08-12T18:27:30.461Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="890297e4-b53b-4ceb-aeef-02f41e747311">
    <skos:broader rdf:resource="19ab681c-bdd7-4793-bbdb-1ec498575314"/>
    <skos:prefLabel xml:lang="en">GLYOXAL</skos:prefLabel>
    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from GLYOXAL [890297e4-b53b-4ceb-aeef-02f41e747311] to CARBON AND HYDROCARBON COMPOUNDS [19ab681c-bdd7-4793-bbdb-1ec498575314]</skos:changeNote>
    <gcmd:reference gcmd:text="https://pubchem.ncbi.nlm.nih.gov/compound/Glyoxal https://acp.copernicus.org/articles/23/1369/2023/" xml:lang="en"/>
    <skos:definition xml:lang="en">Glyoxal is the dialdehyde that is the smallest possible and which consists of ethane having oxo groups on both carbons. It has a role as a pesticide, an agrochemical, an allergen and a plant growth regulator. In the atmosphere, it has a significant role as a intermediary in the oxidation of hydrocarbons.</skos:definition>
    <dcterms:modified>2025-08-12T19:11:43.603Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="7acd7fd4-a9ed-4af9-a0e6-1f6bccb17a3c">
    <skos:broader rdf:resource="61c3b720-abc8-4430-866c-f1da35d2cd0b"/>
    <skos:prefLabel xml:lang="en">UV AEROSOL OPTICAL DEPTH</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from UV AEROSOL OPTICAL DEPTH [7acd7fd4-a9ed-4af9-a0e6-1f6bccb17a3c] to AEROSOL OPTICAL DEPTH/THICKNESS [61c3b720-abc8-4430-866c-f1da35d2cd0b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.earthdata.nasa.gov/topics/atmosphere/uv-aerosol-index" xml:lang="en"/>
    <skos:definition xml:lang="en">The degree to which aerosols prevent ultraviolet radiation from passing through due to scattering or absorption.</skos:definition>
    <dcterms:modified>2025-08-13T13:21:40.635Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="86c75a9c-d6ff-4a33-aad2-5c42fbe87daf">
    <skos:broader rdf:resource="2e5a401b-1507-4f57-82b8-36557c13b154"/>
    <skos:prefLabel xml:lang="en">AEROSOL SINGLE SCATTERING ALBEDO</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from AEROSOL SINGLE SCATTERING ALBEDO [86c75a9c-d6ff-4a33-aad2-5c42fbe87daf] to AEROSOLS [2e5a401b-1507-4f57-82b8-36557c13b154]</skos:changeNote>
    <gcmd:reference gcmd:text="https://gml.noaa.gov/grad/about/aero_term.html" xml:lang="en"/>
    <skos:definition xml:lang="en">Ratio of scattering aerosol optical thickness to total aerosol optical thickness, this describes the relative contributions of scattering and absorption to the total light extinction.</skos:definition>
    <dcterms:modified>2025-08-13T13:23:48.375Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="1aa94028-9c0a-47be-8408-f7537c071530">
    <skos:broader rdf:resource="7f94b0e5-edc6-4724-bd84-404896e09afe"/>
    <skos:prefLabel xml:lang="en">BOUNDARY LAYER TEMPERATURE PROFILES</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from BOUNDARY LAYER TEMPERATURE PROFILES [1aa94028-9c0a-47be-8408-f7537c071530] to BOUNDARY LAYER TEMPERATURE [7f94b0e5-edc6-4724-bd84-404896e09afe]</skos:changeNote>
    <gcmd:reference gcmd:text="https://link.springer.com/article/10.1007/s10462-024-10962-5" xml:lang="en"/>
    <skos:definition xml:lang="en">Distribution of temperature as a function of altitude in the atmospheric boundary layer, the bottom layer of the troposphere that is in contact with the surface of the earth.</skos:definition>
    <dcterms:modified>2025-08-13T13:54:47.026Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="4f982a1f-63f0-4160-a19b-76e2c48cea4c">
    <skos:broader rdf:resource="acc824e7-8eea-4e7d-aa3d-757cda7e6ec9"/>
    <skos:prefLabel xml:lang="en">BOUNDARY LAYER WATER VAPOR PROFILES</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from BOUNDARY LAYER WATER VAPOR PROFILES [4f982a1f-63f0-4160-a19b-76e2c48cea4c] to WATER VAPOR PROFILES [acc824e7-8eea-4e7d-aa3d-757cda7e6ec9]</skos:changeNote>
    <gcmd:reference gcmd:text="https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2022JD036708" xml:lang="en"/>
    <skos:definition xml:lang="en">Distribution of water vapor as a function of altitude in the atmospheric boundary layer, the bottom layer of the troposphere that is in contact with the surface of the earth.</skos:definition>
    <dcterms:modified>2025-08-13T14:03:20.241Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="50c9b6e3-4012-47c3-b0af-a140e4ba7b50">
    <skos:broader rdf:resource="d4313915-2d24-424c-a171-30ee9a6f4bb5"/>
    <skos:prefLabel xml:lang="en">OFFSHORE PLATFORMS</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from OFFSHORE PLATFORMS [50c9b6e3-4012-47c3-b0af-a140e4ba7b50] to INFRASTRUCTURE [d4313915-2d24-424c-a171-30ee9a6f4bb5]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.ncei.noaa.gov/maps/gulf-data-atlas/atlas.htm?plate=Offshore%20Structures https://academic.oup.com/jwelb/article/17/1/35/7590330" xml:lang="en"/>
    <skos:definition xml:lang="en">Offshore structures used to extract oil and gas or capture wind energy, encompassing both wind turbines, drilling rigs used to drill wells, and structures that serve as production platforms.</skos:definition>
    <dcterms:modified>2025-08-13T14:22:17.005Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="4f4db335-d418-43d2-9e72-b8312cba310c">
    <skos:broader rdf:resource="2e5a401b-1507-4f57-82b8-36557c13b154"/>
    <skos:prefLabel xml:lang="en">TOXIC AEROSOLS</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from TOXIC AEROSOLS [4f4db335-d418-43d2-9e72-b8312cba310c] to AEROSOLS [2e5a401b-1507-4f57-82b8-36557c13b154]</skos:changeNote>
    <gcmd:reference gcmd:text="https://science.nasa.gov/science-research/earth-science/climate-science/aerosols-small-particles-with-big-climate-effects/" xml:lang="en"/>
    <skos:definition xml:lang="en">The presence of toxic aerosols damaging to human health and the environment, arising from natural sources, such as volcanic gases, and human activities, such as from fossil fuel combustion.</skos:definition>
    <dcterms:modified>2025-08-13T14:47:30.359Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="0c18c5bf-1a5b-4633-8e1c-b93be226be77">
    <skos:broader rdf:resource="55b1e1e3-f6c1-439d-864c-f32a9ca8852c"/>
    <skos:prefLabel xml:lang="en">SURFACE MOISTURE FLUX</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from SURFACE MOISTURE FLUX [0c18c5bf-1a5b-4633-8e1c-b93be226be77] to ATMOSPHERE/SURFACE INTERACTIONS [55b1e1e3-f6c1-439d-864c-f32a9ca8852c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.pmel.noaa.gov/ocs/air-sea-fluxes" xml:lang="en"/>
    <skos:definition xml:lang="en">Transfer of moisture across the interface between the atmosphere and the ocean or land surface due to precipitation and evaporation, including interactions with soil water content and surface water.</skos:definition>
    <dcterms:modified>2025-08-13T15:51:04.127Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="79688737-55d1-4e38-970b-5ad150b74b34">
    <skos:broader rdf:resource="b3406120-9faa-4c00-874e-ce8878ae129f"/>
    <skos:prefLabel xml:lang="en">INDUCED EARTHQUAKES</skos:prefLabel>
    <skos:changeNote>Date=2025-08-13 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-13 User Id=system System Note=Added broader relation from INDUCED EARTHQUAKES [79688737-55d1-4e38-970b-5ad150b74b34] to EARTHQUAKES [b3406120-9faa-4c00-874e-ce8878ae129f]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.usgs.gov/faqs/can-we-cause-earthquakes-there-any-way-prevent-earthquakes" xml:lang="en"/>
    <skos:definition xml:lang="en">Earthquakes induced by a wide range of manmade causes, including impoundment of reservoirs, surface and underground mining, withdrawal of fluids and gas from the subsurface, and injection of fluids into underground formations.</skos:definition>
    <dcterms:modified>2025-08-13T15:59:31.995Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="53ea3f44-904c-42ad-8ac2-334d14b648c6">
    <skos:broader rdf:resource="62c6d256-e6d4-4204-b7a8-e084dd52d30a"/>
    <skos:prefLabel xml:lang="en">WILDLAND FUELS</skos:prefLabel>
    <skos:changeNote>Date=2025-08-14 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-14 User Id=system System Note=Added broader relation from WILDLAND FUELS [53ea3f44-904c-42ad-8ac2-334d14b648c6] to FIRE ECOLOGY [62c6d256-e6d4-4204-b7a8-e084dd52d30a]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.doi.gov/wildlandfire/fuels" xml:lang="en"/>
    <skos:definition xml:lang="en">Wildland fuels may include small trees, brush, dead branches, and limbs (called ladder fuels) that increase the flammability of environments and contribute to the intensity and spread of wild fires. </skos:definition>
    <dcterms:modified>2025-08-14T12:29:57.178Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="16db3055-847d-4f06-a3aa-9e27e02170a5">
    <skos:broader rdf:resource="c47f6052-634e-40ef-a5ac-13f69f6f4c2a"/>
    <skos:prefLabel xml:lang="en">PLANETARY BOUNDARY LAYER</skos:prefLabel>
    <skos:changeNote>Date=2025-08-15 User Id=tstevens User Note=added new keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-15 User Id=system System Note=Added broader relation from PLANETARY BOUNDARY LAYER [16db3055-847d-4f06-a3aa-9e27e02170a5] to ATMOSPHERE [c47f6052-634e-40ef-a5ac-13f69f6f4c2a]</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added narrower relation from PLANETARY BOUNDARY LAYER [16db3055-847d-4f06-a3aa-9e27e02170a5] to PLANETARY BOUNDARY LAYER TURBULENCE [7f79c084-1e73-4b65-be5e-12e4bdf05f43]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.weather.gov/source/zhu/ZHU_Training_Page/clouds/planetary_boundary_layer/PBL.html#:~:text=The%20planetary%20boundary%20layer%20is,to%20have%20a%20higher%20thickness." xml:lang="en"/>
    <skos:narrower rdf:resource="7f79c084-1e73-4b65-be5e-12e4bdf05f43"/>
    <skos:definition xml:lang="en">The lowest layer of the troposphere that is in contact with the surface of the earth, where wind is influenced by friction.</skos:definition>
    <dcterms:modified>2025-08-15T13:37:16.159Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="32d72476-ba7b-43fa-b054-84804278aa84">
    <skos:broader rdf:resource="c47f6052-634e-40ef-a5ac-13f69f6f4c2a"/>
    <skos:prefLabel xml:lang="en">RADIO OCCULTATION PROFILES</skos:prefLabel>
    <skos:changeNote>Date=2025-08-28 User Id=system System Note=Added broader relation from RADIO OCCULTATION PROFILES [32d72476-ba7b-43fa-b054-84804278aa84] to ATMOSPHERE [c47f6052-634e-40ef-a5ac-13f69f6f4c2a]</skos:changeNote>
    <skos:changeNote>Date=2025-08-28 User Id=system System Note=Added narrower relation from RADIO OCCULTATION PROFILES [32d72476-ba7b-43fa-b054-84804278aa84] to EXCESS PHASE [547dd45b-91a6-4511-bdef-157be65d9b6a]</skos:changeNote>
    <skos:changeNote>Date=2025-08-28 User Id=system System Note=Added narrower relation from RADIO OCCULTATION PROFILES [32d72476-ba7b-43fa-b054-84804278aa84] to BENDING ANGLE [8fd7f9f6-9b95-4ba4-9df1-7b876b779a86]</skos:changeNote>
    <skos:changeNote>Date=2025-08-28 User Id=system System Note=Added narrower relation from RADIO OCCULTATION PROFILES [32d72476-ba7b-43fa-b054-84804278aa84] to REFRACTIVITY [f4ec49af-b1c5-431c-968c-56890da96020]</skos:changeNote>
    <gcmd:reference gcmd:text="https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2020RS007205" xml:lang="en"/>
    <skos:narrower rdf:resource="547dd45b-91a6-4511-bdef-157be65d9b6a"/>
    <skos:narrower rdf:resource="8fd7f9f6-9b95-4ba4-9df1-7b876b779a86"/>
    <skos:narrower rdf:resource="f4ec49af-b1c5-431c-968c-56890da96020"/>
    <skos:definition xml:lang="en">Radio occultation (RO) is a remote sensing technique used for measuring the physical properties of a planetary atmosphere or ring system. </skos:definition>
    <dcterms:modified>2025-08-28T19:42:51.457Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="547dd45b-91a6-4511-bdef-157be65d9b6a">
    <skos:broader rdf:resource="32d72476-ba7b-43fa-b054-84804278aa84"/>
    <skos:prefLabel xml:lang="en">EXCESS PHASE</skos:prefLabel>
    <skos:changeNote>Date=2025-08-28 User Id=system System Note=Added broader relation from EXCESS PHASE [547dd45b-91a6-4511-bdef-157be65d9b6a] to RADIO OCCULTATION PROFILES [32d72476-ba7b-43fa-b054-84804278aa84]</skos:changeNote>
    <gcmd:reference gcmd:text="https://descanso.jpl.nasa.gov/monograph/series6/Chapter_1.pdf http://tao.cgu.org.tw/index.php/articles/archive/space-science/item/350" xml:lang="en"/>
    <skos:definition xml:lang="en">Excess phase quantifies the optical path of a temporally coherent signal as it transects the Earth’s limb less the optical path that would have been obtained by a straight-line vacuum path. Excess phase is induced by refraction of a GNSS signal by the Earth’s atmosphere and ionosphere in GNSS radio occultation. It has the dimension of distance, specifically the temporal refractive delay of a signal multiplied by the speed of light in a vacuum. Its associated independent coordinate is the time of signal reception by a low-Earth orbiting GNSS receiver.</skos:definition>
    <dcterms:modified>2025-08-28T19:43:32.417Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="1da194ab-ba56-4dec-8931-7c85d706c7da">
    <skos:broader rdf:resource="aa35a52f-e3d9-41bd-abd2-ec7e1a8101d1"/>
    <skos:prefLabel xml:lang="en">WETNESS</skos:prefLabel>
    <skos:changeNote>Date=2025-10-08 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-10-08 User Id=system System Note=Added broader relation from WETNESS [1da194ab-ba56-4dec-8931-7c85d706c7da] to SNOW/ICE [aa35a52f-e3d9-41bd-abd2-ec7e1a8101d1]</skos:changeNote>
    <gcmd:reference gcmd:text="A. Sihvola and M. Tiuri, &quot;Snow Fork for Field Determination of the Density and Wetness Profiles of a Snow Pack,&quot; in IEEE Transactions on Geoscience and Remote Sensing, vol. GE-24, no. 5, pp. 717-721, Sept. 1986, doi: 10.1109/TGRS.1986.289619.  Vuyovich, C., Stuefer, S., Durand, M., Marshall, H. P., Osmanoglu, B., Elder, K., Vas, D., Gelvin, A., Larsen, C., Pedersen, S., Hodkinson, D., Deeb, E., Mason, M., &amp; Youcha, E. (2023). NASA SnowEx 2023 Experiment Plan. https://snow.nasa.gov/sites/default/files/users/user354/SNEXCampaigns/2023/NASA_SnowEx_Experiment_Plan_2023_draft_20June2024.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">The amount of liquid water in a unit of snow, often described as a spectrum between “dry” and “wet.” Snow wetness can be calculated quantitatively by measuring the dielectric properties of snow, or estimated qualitatively using manual manipulation of the snow pack.</skos:definition>
    <dcterms:modified>2025-10-08T16:55:59.002Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="0f4d4367-c034-4a11-9d70-218d93ddebdb">
    <skos:broader rdf:resource="50b8fe04-9149-4b7f-a8b2-b33b1e3aa192"/>
    <skos:prefLabel xml:lang="en">WETNESS</skos:prefLabel>
    <skos:changeNote>Date=2025-10-08 User Id=tstevens User Note=Added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-10-08 User Id=system System Note=Added broader relation from WETNESS [0f4d4367-c034-4a11-9d70-218d93ddebdb] to SNOW/ICE [50b8fe04-9149-4b7f-a8b2-b33b1e3aa192]</skos:changeNote>
    <gcmd:reference gcmd:text="Sihvola and M. Tiuri, &quot;Snow Fork for Field Determination of the Density and Wetness Profiles of a Snow Pack,&quot; in IEEE Transactions on Geoscience and Remote Sensing, vol. GE-24, no. 5, pp. 717-721, Sept. 1986, doi: 10.1109/TGRS.1986.289619.  Vuyovich, C., Stuefer, S., Durand, M., Marshall, H. P., Osmanoglu, B., Elder, K., Vas, D., Gelvin, A., Larsen, C., Pedersen, S., Hodkinson, D., Deeb, E., Mason, M., &amp; Youcha, E. (2023). NASA SnowEx 2023 Experiment Plan. https://snow.nasa.gov/sites/default/files/users/user354/SNEXCampaigns/2023/NASA_SnowEx_Experiment_Plan_2023_draft_20June2024.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">The amount of liquid water in a unit of snow, often described as a spectrum between “dry” and “wet.” Snow wetness can be calculated quantitatively by measuring the dielectric properties of snow, or estimated qualitatively using manual manipulation of the snow pack.</skos:definition>
    <dcterms:modified>2025-10-08T16:58:28.679Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="6d299271-0a89-4e32-a4a3-6b88ae87b484">
    <skos:broader rdf:resource="50b8fe04-9149-4b7f-a8b2-b33b1e3aa192"/>
    <skos:prefLabel xml:lang="en">SNOW/ICE MASS</skos:prefLabel>
    <skos:changeNote>Date=2025-10-09 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-10-09 User Id=system System Note=Added broader relation from SNOW/ICE MASS [6d299271-0a89-4e32-a4a3-6b88ae87b484] to SNOW/ICE [50b8fe04-9149-4b7f-a8b2-b33b1e3aa192]</skos:changeNote>
    <gcmd:reference gcmd:text="https://science.nasa.gov/universe/glossary" xml:lang="en"/>
    <skos:definition xml:lang="en">Total mass of a representative physical sample of snow or ice.</skos:definition>
    <dcterms:modified>2025-10-09T15:35:42.271Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="451894e1-7ad3-4205-9ebe-94bc89f8756a">
    <skos:broader rdf:resource="a46016d7-e571-403a-ab37-7223fd74e68e"/>
    <skos:prefLabel xml:lang="en">SPICE</skos:prefLabel>
    <skos:changeNote>Date=2025-11-14 User Id=system System Note=Added broader relation from SPICE [451894e1-7ad3-4205-9ebe-94bc89f8756a] to SALINITY/DENSITY [a46016d7-e571-403a-ab37-7223fd74e68e]</skos:changeNote>
    <gcmd:reference gcmd:text="https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2019JC015936" xml:lang="en"/>
    <skos:definition xml:lang="en">&quot;Spice&quot; in oceanography is a term for variations in temperature and salinity that cancel each other out, resulting in no change in density. Essentially, &quot;spicy&quot; water is warmer and saltier, while &quot;minty&quot; water is cooler and less salty; both have the same density</skos:definition>
    <dcterms:modified>2025-11-14T13:48:21.287Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="28c0f62a-1579-4781-af4e-6cbd7f2c6c4c">
    <skos:broader rdf:resource="637ac172-e624-4ae0-aac4-0d1adcc889a2"/>
    <skos:prefLabel xml:lang="en">THUNDER HOUR</skos:prefLabel>
    <skos:changeNote>Date=2025-12-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-12-18 User Id=system System Note=Added broader relation from THUNDER HOUR [28c0f62a-1579-4781-af4e-6cbd7f2c6c4c] to LIGHTNING [637ac172-e624-4ae0-aac4-0d1adcc889a2]</skos:changeNote>
    <gcmd:reference gcmd:text="DiGangi et al. (2022) " xml:lang="en"/>
    <skos:definition xml:lang="en">Thunder hours represent a historical measure of lightning occurrence and a metric of thunderstorm frequency that is comparatively less sensitive to geographic variations in the detection capabilities of a lightning location system. Thunder hours can be calculated for the entire globe using ground-based detection networks (DiGangi et al. 2022) or satellite-based systems (Cecil et al. 2015). These datasets offer a way to observe long-term trends of lightning across the diurnal cycle. Thunder hours can be developed from multiple lightning observation systems where at the temporal and spatial scale used, the various differences in observational techniques are mitigated. Thunder hour datasets are being produced for the World Meteorological Organization to provide an easy to produce, long-term, global lightning observations.

The DiGangi et al. (2022) abstract states that thunder hours are an intuitive measure of thunderstorm frequency where the 1-h interval corresponds to the life-span of most thunderstorms, and the hourly temporal resolution of the data also represents long-lived systems well. Flash-density-observing systems are incredibly useful, but they have some drawbacks that limit how they can be used to quantify global thunderstorm activity on a climatological scale: flash density distributions derived from satellite observations must sacrifice a great deal of their spatial resolution in order to capture the diurnal convective cycle, and the detection efficiencies of ground-based lightning detection systems are not uniform in space or constant in time. Examining convective patterns in the context of thunder hours lends insight into thunderstorm activity without being heavily influenced by network performance, making thunder hours particularly useful for studying thunderstorm climatology.</skos:definition>
    <dcterms:modified>2025-12-18T15:43:59.979Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="030b4439-8a69-408a-b365-ccdf148d0854">
    <skos:broader rdf:resource="8799f524-e313-4d2d-9428-8d672d123513"/>
    <skos:prefLabel xml:lang="en">IMPULSE RESPONSE</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from IMPULSE RESPONSE [030b4439-8a69-408a-b365-ccdf148d0854] to SENSOR CHARACTERISTICS [8799f524-e313-4d2d-9428-8d672d123513]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/topics/computer-science/impulse-response" xml:lang="en"/>
    <skos:definition xml:lang="en">Impulse response is defined as the output of a linear time-invariant system when the input signal is a discrete impulse, represented mathematically as the coefficients of a finite impulse response filter.</skos:definition>
    <dcterms:modified>2026-01-07T12:06:20.416Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="067a4ce7-c7d1-499c-bc86-4a9f747f89ca">
    <skos:broader rdf:resource="b7812c71-4b9e-4016-b4ba-dfcdb7e62365"/>
    <skos:prefLabel xml:lang="en">ENHANCED VEGETATION INDEX (EVI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from ENHANCED VEGETATION INDEX [067a4ce7-c7d1-499c-bc86-4a9f747f89ca] to VEGETATION INDEX [b7812c71-4b9e-4016-b4ba-dfcdb7e62365]</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://science.nasa.gov/earth/earth-observatory/global-enhanced-vegetation-index-1863/ https://pro.arcgis.com/en/pro-app/latest/arcpy/spatial-analyst/evi.htm" xml:lang="en"/>
    <skos:definition xml:lang="en">The Enhanced Vegetation Index (EVI) method is an optimized vegetation index that accounts for atmospheric influences and vegetation background signal. It&apos;s similar to NDVI but is less sensitive to background and atmospheric noise, and it does not become as saturated as NDVI when viewing areas with very dense green vegetation.</skos:definition>
    <dcterms:modified>2026-01-08T13:11:56.895Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="35a5c352-5ce0-429b-852b-397afe4ee102">
    <skos:broader rdf:resource="b7812c71-4b9e-4016-b4ba-dfcdb7e62365"/>
    <skos:prefLabel xml:lang="en">CHLOROPHYLL INDEX RED EDGE (CIRE)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from CHLOROPHYLL INDEX RED EDGE [35a5c352-5ce0-429b-852b-397afe4ee102] to VEGETATION INDEX [b7812c71-4b9e-4016-b4ba-dfcdb7e62365]</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://pro.arcgis.com/en/pro-app/latest/arcpy/spatial-analyst/cire.htm https://agriculture.africageoportal.com/content/7bfa9b2e530641c09e4e3ea3c9c0b872/about" xml:lang="en"/>
    <skos:definition xml:lang="en">The Chlorophyll Index - Red-Edge (CIre) method is a vegetation index for estimating the chlorophyll content in leaves using the ratio of reflectivity in the NIR and red-edge bands.</skos:definition>
    <dcterms:modified>2026-01-08T13:12:18.379Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="6dffdd7b-4c0b-4773-a783-3379b361d962">
    <skos:broader rdf:resource="b7812c71-4b9e-4016-b4ba-dfcdb7e62365"/>
    <skos:prefLabel xml:lang="en">PHOTOCHEMICAL REFLECTANCE INDEX (PRI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from PHOTOCHEMICAL REFLECTANCE INDEX [6dffdd7b-4c0b-4773-a783-3379b361d962] to VEGETATION INDEX [b7812c71-4b9e-4016-b4ba-dfcdb7e62365]</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.mdpi.com/2072-4292/11/7/810  https://nph.onlinelibrary.wiley.com/doi/10.1111/j.1469-8137.2011.03791.x https://metergroup.com/education-guides/ndvi-and-pri-the-researchers-complete-guide/?srsltid=AfmBOoqvWhEjOMh0GOrJDEk0tcCeSpIavQbThSrI7BgxQ3MIT6p8H-Xf https://pubmed.ncbi.nlm.nih.gov/41025719/" xml:lang="en"/>
    <skos:definition xml:lang="en">The photochemical reflectance index (PRI) is a widely used spectral index which can show stress-induced changes in photosynthesis. It is useful for getting at functional properties of plant canopies such as light use efficiency and for measuring foliar pigments.</skos:definition>
    <dcterms:modified>2026-01-08T13:12:38.102Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="43183696-ba4e-4e8e-9553-adc36e3708d1">
    <skos:broader rdf:resource="b7812c71-4b9e-4016-b4ba-dfcdb7e62365"/>
    <skos:prefLabel xml:lang="en">CAROTENOID CONTENT INDEX (CAR)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from CAROTENOID CONTENT INDEX [43183696-ba4e-4e8e-9553-adc36e3708d1] to VEGETATION INDEX [b7812c71-4b9e-4016-b4ba-dfcdb7e62365]</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.arcgis.com/home/item.html?id=20811a82245246178d95321bdebe76f0" xml:lang="en"/>
    <skos:definition xml:lang="en">Carotenoid Content Index describes the canopy content of carotenoids in terrestrial vegetation.</skos:definition>
    <dcterms:modified>2026-01-08T13:23:19.069Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="34dfa28b-c457-4c13-9f18-b0d331190588">
    <skos:broader rdf:resource="b7812c71-4b9e-4016-b4ba-dfcdb7e62365"/>
    <skos:prefLabel xml:lang="en">MODIFIED ANTHOCYANIN REFLECTANCE INDEX (MARI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from MODIFIED ANTHOCYANIN REFLECTANCE INDEX [34dfa28b-c457-4c13-9f18-b0d331190588] to VEGETATION INDEX [b7812c71-4b9e-4016-b4ba-dfcdb7e62365]</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://pmc.ncbi.nlm.nih.gov/articles/PMC10109386/  https://docs.geopera.com/en/docs/spectral-indices/bj3n/ari2" xml:lang="en"/>
    <skos:definition xml:lang="en">The Modified Anthocyanin Reflectance Index (mARI or ARI2) is an enhanced version of ARI that corrects for leaf density and thickness by incorporating a near-infrared band. This modification improves the accuracy of anthocyanin estimation by accounting for leaf scattering properties.</skos:definition>
    <dcterms:modified>2026-01-08T13:25:24.404Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="37d8ff62-a8c7-4fc5-93e7-263d8c33a5d4">
    <skos:broader rdf:resource="b7812c71-4b9e-4016-b4ba-dfcdb7e62365"/>
    <skos:prefLabel xml:lang="en">NORMALIZED DIFFERENCE INFRARED INDEX (NDII)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from NORMALIZED DIFFERENCE INFRARED INDEX [37d8ff62-a8c7-4fc5-93e7-263d8c33a5d4] to VEGETATION INDEX [b7812c71-4b9e-4016-b4ba-dfcdb7e62365]</skos:changeNote>
    <gcmd:reference gcmd:text="https://hess.copernicus.org/articles/27/2149/2023/ https://www.sciencedirect.com/science/article/pii/S0034425707004798" xml:lang="en"/>
    <skos:definition xml:lang="en">The normalized difference infrared index (NDII) is an index that detects canopy water content.</skos:definition>
    <dcterms:modified>2026-01-08T13:25:52.468Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="2426eba5-3817-466a-9be1-879be097227b">
    <skos:broader rdf:resource="b7812c71-4b9e-4016-b4ba-dfcdb7e62365"/>
    <skos:prefLabel xml:lang="en">NORMALIZED DIFFERENCE WATER INDEX (NDWI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from NORMALIZED DIFFERENCE WATER INDEX [2426eba5-3817-466a-9be1-879be097227b] to VEGETATION INDEX [b7812c71-4b9e-4016-b4ba-dfcdb7e62365]</skos:changeNote>
    <gcmd:reference gcmd:text="https://pubs.usgs.gov/publication/70035636  https://pro.arcgis.com/en/pro-app/latest/arcpy/spatial-analyst/ndwi.htm https://www.sciencedirect.com/science/article/pii/S0034425796000673" xml:lang="en"/>
    <skos:definition xml:lang="en">The Normalized Difference Water Index (NDWI) is a remote sensing index used to monitor changes in water content in both vegetation and water bodies. It is calculated using specific wavelengths of light, typically involving green and near-infrared bands for water bodies, and near-infrared and short-wave infrared bands for vegetation.</skos:definition>
    <dcterms:modified>2026-01-08T13:26:51.835Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="84698f17-b070-46fb-ab5f-38ce6db53f40">
    <skos:broader rdf:resource="e63844c1-015c-4776-b01c-e3e7d5dd3d0c"/>
    <skos:prefLabel xml:lang="en">ENHANCED VEGETATION INDEX (EVI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from ENHANCED VEGETATION INDEX [84698f17-b070-46fb-ab5f-38ce6db53f40] to VEGETATION INDEX [e63844c1-015c-4776-b01c-e3e7d5dd3d0c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://pro.arcgis.com/en/pro-app/latest/arcpy/spatial-analyst/evi.htm https://science.nasa.gov/earth/earth-observatory/global-enhanced-vegetation-index-1863/" xml:lang="en"/>
    <skos:definition xml:lang="en">The Enhanced Vegetation Index (EVI) method is an optimized vegetation index that accounts for atmospheric influences and vegetation background signal. It&apos;s similar to NDVI but is less sensitive to background and atmospheric noise, and it does not become as saturated as NDVI when viewing areas with very dense green vegetation.</skos:definition>
    <dcterms:modified>2026-01-08T13:46:05.315Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="6fc0b0cb-6c6b-46dc-ae5e-5ca57394c66c">
    <skos:broader rdf:resource="e63844c1-015c-4776-b01c-e3e7d5dd3d0c"/>
    <skos:prefLabel xml:lang="en">PHOTOCHEMICAL REFLECTANCE INDEX (PRI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from PHOTOCHEMICAL REFLECTANCE INDEX [6fc0b0cb-6c6b-46dc-ae5e-5ca57394c66c] to VEGETATION INDEX [e63844c1-015c-4776-b01c-e3e7d5dd3d0c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.mdpi.com/2072-4292/11/7/810   https://nph.onlinelibrary.wiley.com/doi/10.1111/j.1469-8137.2011.03791.x  https://metergroup.com/education-guides/ndvi-and-pri-the-researchers-complete-guide/?srsltid=AfmBOoqvWhEjOMh0GOrJDEk0tcCeSpIavQbThSrI7BgxQ3MIT6p8H-Xf https://pubmed.ncbi.nlm.nih.gov/41025719/" xml:lang="en"/>
    <skos:definition xml:lang="en">The photochemical reflectance index (PRI) is a widely used spectral index which can show stress-induced changes in photosynthesis. It is useful for getting at functional properties of plant canopies such as light use efficiency and for measuring foliar pigments.</skos:definition>
    <dcterms:modified>2026-01-08T13:48:49.688Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="40c1cd31-df37-4932-a0d8-7c23d1f163b6">
    <skos:broader rdf:resource="e63844c1-015c-4776-b01c-e3e7d5dd3d0c"/>
    <skos:prefLabel xml:lang="en">MODIFIED ANTHOCYANIN REFLECTANCE INDEX (MARI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from MODIFIED ANTHOCYANIN REFLECTANCE INDEX [40c1cd31-df37-4932-a0d8-7c23d1f163b6] to VEGETATION INDEX [e63844c1-015c-4776-b01c-e3e7d5dd3d0c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://docs.geopera.com/en/docs/spectral-indices/bj3n/ari2 https://pmc.ncbi.nlm.nih.gov/articles/PMC10109386/" xml:lang="en"/>
    <skos:definition xml:lang="en">The Modified Anthocyanin Reflectance Index (mARI or ARI2) is an enhanced version of ARI that corrects for leaf density and thickness by incorporating a near-infrared band. This modification improves the accuracy of anthocyanin estimation by accounting for leaf scattering properties.</skos:definition>
    <dcterms:modified>2026-01-08T13:49:54.526Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="5b9a0cef-f536-428c-9b78-772427f316f6">
    <skos:broader rdf:resource="e63844c1-015c-4776-b01c-e3e7d5dd3d0c"/>
    <skos:prefLabel xml:lang="en">NORMALIZED DIFFERENCE WATER INDEX (NDWI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from NORMALIZED DIFFERENCE WATER INDEX [5b9a0cef-f536-428c-9b78-772427f316f6] to VEGETATION INDEX [e63844c1-015c-4776-b01c-e3e7d5dd3d0c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/science/article/pii/S0034425796000673   https://pro.arcgis.com/en/pro-app/latest/arcpy/spatial-analyst/ndwi.htm https://pubs.usgs.gov/publication/70035636" xml:lang="en"/>
    <skos:definition xml:lang="en">The Normalized Difference Water Index (NDWI) is a remote sensing index used to monitor changes in water content in both vegetation and water bodies. It is calculated using specific wavelengths of light, typically involving green and near-infrared bands for water bodies, and near-infrared and short-wave infrared bands for vegetation.</skos:definition>
    <dcterms:modified>2026-01-08T13:50:42.532Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="5b7b1456-6471-4797-b7fd-7b904f869168">
    <skos:broader rdf:resource="e63844c1-015c-4776-b01c-e3e7d5dd3d0c"/>
    <skos:prefLabel xml:lang="en">NORMALIZED DIFFERENCE SNOW INDEX (NDSI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from NORMALIZED DIFFERENCE SNOW INDEX [5b7b1456-6471-4797-b7fd-7b904f869168] to VEGETATION INDEX [e63844c1-015c-4776-b01c-e3e7d5dd3d0c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://link.springer.com/rwe/10.1007/978-90-481-2642-2_376 https://ntrs.nasa.gov/api/citations/20100031195/downloads/20100031195.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">The Normalized Difference Snow Index (NDSI) is a measure used to identify snow cover by comparing the reflectance of visible light and shortwave infrared light. It helps distinguish snow from clouds, as snow reflects visible light well but absorbs infrared light, making it appear darker than clouds in satellite images.</skos:definition>
    <dcterms:modified>2026-01-08T13:51:01.440Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="13354468-9b4c-4a42-9d21-447b34723283">
    <skos:broader rdf:resource="b7812c71-4b9e-4016-b4ba-dfcdb7e62365"/>
    <skos:prefLabel xml:lang="en">NORMALIZED DIFFERENCE SNOW INDEX (NDSI)</skos:prefLabel>
    <skos:changeNote>Date=2026-01-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-01-07 User Id=system System Note=Added broader relation from NORMALIZED DIFFERENCE SNOW INDEX [13354468-9b4c-4a42-9d21-447b34723283] to VEGETATION INDEX [b7812c71-4b9e-4016-b4ba-dfcdb7e62365]</skos:changeNote>
    <gcmd:reference gcmd:text="https://link.springer.com/rwe/10.1007/978-90-481-2642-2_376 https://ntrs.nasa.gov/api/citations/20100031195/downloads/20100031195.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">The Normalized Difference Snow Index (NDSI) is a measure used to identify snow cover by comparing the reflectance of visible light and shortwave infrared light. It helps distinguish snow from clouds, as snow reflects visible light well but absorbs infrared light, making it appear darker than clouds in satellite images.</skos:definition>
    <dcterms:modified>2026-01-08T13:27:27.789Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="02b3a632-15af-4d18-9611-e2423428ec59">
    <skos:broader rdf:resource="25be3b9a-9d4c-4b5b-8d24-b1f519913d90"/>
    <skos:prefLabel xml:lang="en">CROP AREA</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CROP AREA [02b3a632-15af-4d18-9611-e2423428ec59] to AGRICULTURAL PLANT SCIENCE [25be3b9a-9d4c-4b5b-8d24-b1f519913d90]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.usgs.gov/apps/croplands/static/imgs/croplands-docs/Croplands-definitions-1d.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">Refers to actual cropland area whether the cropland is cropped or left fallow. It does not account for cropping intensity. However, it does include permanent crops (e.g., plantations).</skos:definition>
    <dcterms:modified>2026-02-18T12:46:02.757Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="39e47a75-12f1-483c-b239-111329f74384">
    <skos:broader rdf:resource="25be3b9a-9d4c-4b5b-8d24-b1f519913d90"/>
    <skos:prefLabel xml:lang="en">CROP HEALTH</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CROP HEALTH [39e47a75-12f1-483c-b239-111329f74384] to AGRICULTURAL PLANT SCIENCE [25be3b9a-9d4c-4b5b-8d24-b1f519913d90]</skos:changeNote>
    <gcmd:reference gcmd:text="https://bsppjournals.onlinelibrary.wiley.com/doi/10.1111/ppa.12659" xml:lang="en"/>
    <skos:definition xml:lang="en">Crop health encompasses the effects of plant pathogens, animal pests, and abiotic environmental factors on plant physiology, growth, or reproduction. </skos:definition>
    <dcterms:modified>2026-02-18T12:47:36.250Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="257633ec-8f9f-4482-be86-3570426410a0">
    <skos:broader rdf:resource="25be3b9a-9d4c-4b5b-8d24-b1f519913d90"/>
    <skos:prefLabel xml:lang="en">CROP STRESS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CROP STRESS [257633ec-8f9f-4482-be86-3570426410a0] to AGRICULTURAL PLANT SCIENCE [25be3b9a-9d4c-4b5b-8d24-b1f519913d90]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.frontiersin.org/journals/plant-science/articles/10.3389/fpls.2025.1638675/full" xml:lang="en"/>
    <skos:definition xml:lang="en">Crop/Plant stress is defined as any external condition that may adversely affect a plant’s growth and productivity. These stressors are generally divided into two main types: abiotic, resulting from environmental or physical causes, and biotic, resulting from living organisms.</skos:definition>
    <dcterms:modified>2026-02-18T12:48:37.500Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="3b4b4ffa-895f-4e79-a45d-cccaf2479da8">
    <skos:broader rdf:resource="199e3af8-4cf3-48ba-8b28-b9b54756b3db"/>
    <skos:prefLabel xml:lang="en">CROP RESIDUE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CROP RESIDUE [3b4b4ffa-895f-4e79-a45d-cccaf2479da8] to SOILS [199e3af8-4cf3-48ba-8b28-b9b54756b3db]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nrcs.usda.gov/sites/default/files/2024-10/HarvestingCropResidueOctober2016.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">The plant residue left in the field after harvest.</skos:definition>
    <dcterms:modified>2026-02-18T12:52:08.145Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="64ea30b2-cc82-42f0-822e-db355858b189">
    <skos:broader rdf:resource="199e3af8-4cf3-48ba-8b28-b9b54756b3db"/>
    <skos:prefLabel xml:lang="en">SOIL SLOPE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from SOIL SLOPE [64ea30b2-cc82-42f0-822e-db355858b189] to SOILS [199e3af8-4cf3-48ba-8b28-b9b54756b3db]</skos:changeNote>
    <gcmd:reference gcmd:text="https://agsite.missouri.edu/slope-and-landscape-features/#:~:text=Slope%3A%20Slope%20refers%20to%20the,occurs%20between%20two%20different%20points." xml:lang="en"/>
    <skos:definition xml:lang="en">Slope refers to the extent that a soil surface has an incline relative to the horizontal. In percentage terms, slope represents the elevation that occurs between two different points.</skos:definition>
    <dcterms:modified>2026-02-18T12:53:23.592Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="1596f1cd-bbd2-4c95-9206-6b64acbbb15a">
    <skos:broader rdf:resource="55b1e1e3-f6c1-439d-864c-f32a9ca8852c"/>
    <skos:prefLabel xml:lang="en">GREENHOUSE GAS FLUX</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from GREENHOUSE GAS FLUX [1596f1cd-bbd2-4c95-9206-6b64acbbb15a] to ATMOSPHERE/SURFACE INTERACTIONS [55b1e1e3-f6c1-439d-864c-f32a9ca8852c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nist.gov/spo/greenhouse-gas-measurements-program/observations-and-analysis/greenhouse-gas-ghg-flux" xml:lang="en"/>
    <skos:definition xml:lang="en">The emissions or uptake (i.e., flux) of green house gases from a given region. GHG fluxes (sources and sinks) are typically classified into two categories, often termed “bottom-up” and “top-down.” Top-down methods use atmospheric measurements to estimate fluxes, while bottom-up methods focus on using process-level understanding.</skos:definition>
    <dcterms:modified>2026-02-18T12:55:35.105Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="87c7332d-cc84-468f-9d68-4d5dcc108b4d">
    <skos:broader rdf:resource="1532e590-a62d-46e3-8d03-2351bc48166a"/>
    <skos:prefLabel xml:lang="en">PRECIPITATION PHASE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from PRECIPITATION PHASE [87c7332d-cc84-468f-9d68-4d5dcc108b4d] to PRECIPITATION [1532e590-a62d-46e3-8d03-2351bc48166a]</skos:changeNote>
    <gcmd:reference gcmd:text="https://repository.lib.fsu.edu/islandora/object/fsu:954624" xml:lang="en"/>
    <skos:definition xml:lang="en">The phase of precipitation, i.e., solid (e.g., snow, sleet) or liquid (rain), is a crucial property in weather forecasts, satellite precipitation retrievals, and modeling. The shift of precipitation phase from solid to liquid will alter surface energy balance, affect water resource management, and increase risks of natural hazards.</skos:definition>
    <dcterms:modified>2026-02-18T13:10:58.825Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="630cb447-ab0a-4d19-b47c-5511d667e7c1">
    <skos:broader rdf:resource="f5161094-3593-4bc1-85ea-c8c2ecab1d9a"/>
    <skos:prefLabel xml:lang="en">HORSES</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from HORSES [630cb447-ab0a-4d19-b47c-5511d667e7c1] to MAMMALS [f5161094-3593-4bc1-85ea-c8c2ecab1d9a]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.merriam-webster.com/dictionary/horse" xml:lang="en"/>
    <skos:definition xml:lang="en">A large solid-hoofed herbivorous ungulate mammal (Equus caballus, family Equidae, the horse family) domesticated since prehistoric times and used as a beast of burden, a draft animal, or for riding.</skos:definition>
    <dcterms:modified>2026-02-18T13:15:33.361Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="43b1401c-afeb-4ece-9f75-92b98b3da438">
    <skos:broader rdf:resource="62c6d256-e6d4-4204-b7a8-e084dd52d30a"/>
    <skos:prefLabel xml:lang="en">FIRE REGIME</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from FIRE REGIME [43b1401c-afeb-4ece-9f75-92b98b3da438] to FIRE ECOLOGY [62c6d256-e6d4-4204-b7a8-e084dd52d30a]</skos:changeNote>
    <gcmd:reference gcmd:text="https://research.fs.usda.gov/psw/fire/behavior#:~:text=Fire%2Dadapted%20ecosystems%20are%20characterized,the%20amount%20of%20vegetation%20killed" xml:lang="en"/>
    <skos:definition xml:lang="en">Fire-adapted ecosystems are characterized by a &quot;fire regime&quot; which describes the frequency at which fires in a given forest type typically burn, the season(s) in which they burn, and the amount of vegetation killed.</skos:definition>
    <dcterms:modified>2026-02-18T13:17:10.517Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="20872a46-9d27-4e54-a0fb-1e7e384d22bd">
    <skos:broader rdf:resource="235996b1-b1a8-4c20-bb1f-711fb1a0c952"/>
    <skos:prefLabel xml:lang="en">PHYTOPLANKTON ABSORPTION</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from PHYTOPLANKTON ABSORPTION [20872a46-9d27-4e54-a0fb-1e7e384d22bd] to PHYTOPLANKTON [235996b1-b1a8-4c20-bb1f-711fb1a0c952]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.oceanopticsbook.info/view/optical-constituents-of-the-ocean/phytoplankton  https://www.researchgate.net/profile/Oscar-Schofield-2/publication/39731293_Optical_Discrimination_of_a_Phytoplankton_Species_in_Natural_Mixed_Populations/links/5d49e3a7a6fdcc370a80daca/Optical-Discrimination-of-a-Phytoplankton-Species-in-Natural-Mixed-Populations.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">Phytoplankton absorb sunlight and use this energy to produce energy-rich organic material (photosynthesis). Chlorophylls, present in all phytoplankton cells, cause 2 dominant peaks in absorption spectra: a primary peak in the blue (440 nm) and a secondary peak in red part of the spectra (675 nm). Presence of other pigments (depending on species and taxa) will cause the broadening of the blue peak and the appearance of additional absorption maxima. Spectra of phytoplankton absorption vary in magnitude and shape due to diﬀerent cellular pigment compositions and pigment packaging. </skos:definition>
    <dcterms:modified>2026-02-18T13:18:48.735Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="269637ee-c836-48f8-9602-2d6556152c31">
    <skos:broader rdf:resource="abbba948-9b77-4e19-a855-49a7fbc17696"/>
    <skos:prefLabel xml:lang="en">BULK DENSITY</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from BULK DENSITY [269637ee-c836-48f8-9602-2d6556152c31] to CANOPY CHARACTERISTICS [abbba948-9b77-4e19-a855-49a7fbc17696]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.landfire.gov/fuel/cbd" xml:lang="en"/>
    <skos:definition xml:lang="en">Density of available canopy fuel in a stand, defined as the mass of available canopy fuel per canopy volume unit and used to predict crown fire spread.</skos:definition>
    <dcterms:modified>2026-02-18T13:20:18.153Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="4362045d-9af7-4913-928e-e7b96a3cf6f9">
    <skos:broader rdf:resource="0408bac9-c247-4b00-80de-f4665b813658"/>
    <skos:prefLabel xml:lang="en">PLANT STRUCTURE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from PLANT STRUCTURE [4362045d-9af7-4913-928e-e7b96a3cf6f9] to PLANT CHARACTERISTICS [0408bac9-c247-4b00-80de-f4665b813658]</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added narrower relation from PLANT STRUCTURE [4362045d-9af7-4913-928e-e7b96a3cf6f9] to CELLULOSE [008d2821-5f5b-4461-a0a2-8f435405df47]</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added narrower relation from PLANT STRUCTURE [4362045d-9af7-4913-928e-e7b96a3cf6f9] to LIGNIN [041cb632-46d5-4cf9-b2c9-d1a0f706e885]</skos:changeNote>
    <skos:narrower rdf:resource="008d2821-5f5b-4461-a0a2-8f435405df47"/>
    <skos:narrower rdf:resource="041cb632-46d5-4cf9-b2c9-d1a0f706e885"/>
    <skos:definition xml:lang="en"/>
    <dcterms:modified>2026-02-18T13:46:35.455Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="008d2821-5f5b-4461-a0a2-8f435405df47">
    <skos:broader rdf:resource="4362045d-9af7-4913-928e-e7b96a3cf6f9"/>
    <skos:prefLabel xml:lang="en">CELLULOSE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CELLULOSE [008d2821-5f5b-4461-a0a2-8f435405df47] to PLANT STRUCTURE [4362045d-9af7-4913-928e-e7b96a3cf6f9]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.merriam-webster.com/dictionary/cellulose" xml:lang="en"/>
    <skos:definition xml:lang="en">A polysaccharide (C6H10O5)x of glucose units that constitutes the chief part of the cell walls of plants, occurs naturally in such fibrous products as cotton and kapok, and is the raw material of many manufactured goods (such as paper, rayon, and cellophane).</skos:definition>
    <dcterms:modified>2026-02-18T13:47:24.721Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="041cb632-46d5-4cf9-b2c9-d1a0f706e885">
    <skos:broader rdf:resource="4362045d-9af7-4913-928e-e7b96a3cf6f9"/>
    <skos:prefLabel xml:lang="en">LIGNIN</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from LIGNIN [041cb632-46d5-4cf9-b2c9-d1a0f706e885] to PLANT STRUCTURE [4362045d-9af7-4913-928e-e7b96a3cf6f9]</skos:changeNote>
    <gcmd:reference gcmd:text="https://pubchem.ncbi.nlm.nih.gov/compound/Lignin" xml:lang="en"/>
    <skos:definition xml:lang="en">The most abundant natural aromatic organic polymer found in all vascular plants. Lignin together with cellulose and hemicellulose are the major cell wall components of the fibers of all wood and grass species. Lignin is composed of coniferyl, p-coumaryl, and sinapyl alcohols in varying ratios in different plant species.</skos:definition>
    <dcterms:modified>2026-02-18T13:48:47.412Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="1b94f333-5878-4c5c-b537-2148ee8cefbe">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">VEGETATION PRODUCTIVITY</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from VEGETATION PRODUCTIVITY [1b94f333-5878-4c5c-b537-2148ee8cefbe] to VEGETATION [c7b5c02c-724d-4a19-b824-98180f3900c9]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.eea.europa.eu/en/analysis/maps-and-charts/vegetation-productivity-and-land-use-dashboards#:~:text=Vegetation%20productivity%20indicates%20the%20spatial,key%20characteristic%20of%20ecosystem%20condition" xml:lang="en"/>
    <skos:definition xml:lang="en">Vegetation productivity indicates the spatial distribution and change of the vegetation cover - a key characteristic of ecosystem condition.</skos:definition>
    <dcterms:modified>2026-02-18T13:50:20.829Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="3e9503f1-372b-414f-bbdf-58e70513b934">
    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">WOODY BIOMASS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from WOODY BIOMASS [3e9503f1-372b-414f-bbdf-58e70513b934] to VEGETATION [c7b5c02c-724d-4a19-b824-98180f3900c9]</skos:changeNote>
    <gcmd:reference gcmd:text="https://extension.psu.edu/a-primer-on-woody-biomass-energy-for-forest-landowners" xml:lang="en"/>
    <skos:definition xml:lang="en">Woody biomass is any woody material from trees or shrubs, including woody debris or residues that cannot be used for timber. </skos:definition>
    <dcterms:modified>2026-02-18T13:54:29.404Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="47783a44-bd96-429e-8c74-02776e763689">
    <skos:broader rdf:resource="d4313915-2d24-424c-a171-30ee9a6f4bb5"/>
    <skos:prefLabel xml:lang="en">RENEWABLE ENERGY INFRASTRUCTURE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from RENEWABLE ENERGY INFRASTRUCTURE [47783a44-bd96-429e-8c74-02776e763689] to INFRASTRUCTURE [d4313915-2d24-424c-a171-30ee9a6f4bb5]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.energy.gov/eere/energy-reliability-and-resilience  https://www.pnnl.gov/explainer-articles/renewable-integration" xml:lang="en"/>
    <skos:definition xml:lang="en">Facilities or equipment used to generate, deliver, process, or produce renewable energy.</skos:definition>
    <dcterms:modified>2026-02-18T14:01:46.915Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="09a663d9-2b11-40d4-887b-7d5e9313f350">
    <skos:broader rdf:resource="d4313915-2d24-424c-a171-30ee9a6f4bb5"/>
    <skos:prefLabel xml:lang="en">STRUCTURAL DETERIORATION</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from STRUCTURAL DETERIORATION [09a663d9-2b11-40d4-887b-7d5e9313f350] to INFRASTRUCTURE [d4313915-2d24-424c-a171-30ee9a6f4bb5]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.1016/j.engstruct.2018.06.082" xml:lang="en"/>
    <skos:definition xml:lang="en">Any localized destruction or weakness of a building&apos;s structural system that can trigger broader instability or collapse. </skos:definition>
    <dcterms:modified>2026-02-18T14:04:12.558Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="648e6116-5f0c-4314-86a8-ede6dda6bbc1">
    <skos:broader rdf:resource="37a6c8e2-f2ac-48a4-a4fa-d80f700f68db"/>
    <skos:prefLabel xml:lang="en">ROADS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from ROADS [648e6116-5f0c-4314-86a8-ede6dda6bbc1] to TRANSPORTATION [37a6c8e2-f2ac-48a4-a4fa-d80f700f68db]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.merriam-webster.com/dictionary/road" xml:lang="en"/>
    <skos:definition xml:lang="en">An open way for vehicles, persons, and animals.</skos:definition>
    <dcterms:modified>2026-02-18T14:20:17.772Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="6035c55a-7b7a-49de-9887-a440230781d0">
    <skos:broader rdf:resource="6a426480-c58f-4b6b-8e35-0975b7f6edb5"/>
    <skos:prefLabel xml:lang="en">LAND SURFACE COLOR</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from LAND SURFACE COLOR [6035c55a-7b7a-49de-9887-a440230781d0] to LAND SURFACE [6a426480-c58f-4b6b-8e35-0975b7f6edb5]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.earthobservatory.nasa.gov/features/ColorImage" xml:lang="en"/>
    <skos:definition xml:lang="en">The visible shade or hue of the Earth&apos;s exposed ground as seen from above. Dependent on what materials are present and how they reflect light.</skos:definition>
    <dcterms:modified>2026-02-18T14:22:58.443Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="363ad5e8-9516-4fb8-968a-815a7e787e7c">
    <skos:broader rdf:resource="75c312bc-79f9-4d74-a7c0-3c67c019196c"/>
    <skos:prefLabel xml:lang="en">MINERAL LANDS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from MINERAL LANDS [363ad5e8-9516-4fb8-968a-815a7e787e7c] to LAND USE/LAND COVER CLASSIFICATION [75c312bc-79f9-4d74-a7c0-3c67c019196c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.merriam-webster.com/dictionary/mineral%20lands" xml:lang="en"/>
    <skos:definition xml:lang="en">Lands usually held by a federal government as public lands and valuable for deposits of metals and other minerals.</skos:definition>
    <dcterms:modified>2026-02-18T14:25:16.157Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="090aa2ed-698b-4947-ac00-ab05d390c77b">
    <skos:broader rdf:resource="c16bda61-353b-4668-af2f-bbb98785b6fa"/>
    <skos:prefLabel xml:lang="en">SEAFLOOR DEFORMATION</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from SEAFLOOR DEFORMATION [090aa2ed-698b-4947-ac00-ab05d390c77b] to BATHYMETRY/SEAFLOOR TOPOGRAPHY [c16bda61-353b-4668-af2f-bbb98785b6fa]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nature.com/articles/sdata2018182  https://www.annualreviews.org/content/journals/10.1146/annurev-earth-060313-054953" xml:lang="en"/>
    <skos:definition xml:lang="en">The movement or displacement of the ocean floor caused by geological forces including active tectonic plate boundaries, volcanic systems, submarine landsliding, hydrocarbon extraction, and CO2 injection into submarine reservoirs.</skos:definition>
    <dcterms:modified>2026-02-18T14:35:26.009Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="415ca86b-358e-44ab-82c2-abdf3fde3a25">
    <skos:broader rdf:resource="b6fd22ab-dca7-4dfa-8812-913453b5695b"/>
    <skos:prefLabel xml:lang="en">BOTTOM REFLECTANCE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from BOTTOM REFLECTANCE [415ca86b-358e-44ab-82c2-abdf3fde3a25] to COASTAL PROCESSES [b6fd22ab-dca7-4dfa-8812-913453b5695b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.1016/j.jag.2025.104483" xml:lang="en"/>
    <skos:definition xml:lang="en">The proportion of incident light that is reflected upward from the seafloor or lakebed through the overlying water column back toward a sensor. </skos:definition>
    <dcterms:modified>2026-02-18T14:37:08.739Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="5b40f099-b0a1-4d73-8896-6ecf4fcc4d73">
    <skos:broader rdf:resource="ce4b2c6e-3d69-4cf1-8416-c36e5f9b1b2c"/>
    <skos:prefLabel xml:lang="en">PARTICLE DISTRIBUTION</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from PARTICLE DISTRIBUTION [5b40f099-b0a1-4d73-8896-6ecf4fcc4d73] to MARINE SEDIMENTS [ce4b2c6e-3d69-4cf1-8416-c36e5f9b1b2c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.1016/j.csr.2021.104548" xml:lang="en"/>
    <skos:definition xml:lang="en">How sediment particles on the seafloor are spread out by size, number, and concentration.</skos:definition>
    <dcterms:modified>2026-02-18T14:39:03.856Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="0afaa99b-c7e0-40ef-ba91-2af1be0bea52">
    <skos:broader rdf:resource="ed925b43-db83-4cbb-8347-3dc0081bb8f4"/>
    <skos:prefLabel xml:lang="en">PHYTOPLANKTON</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from PHYTOPLANKTON [0afaa99b-c7e0-40ef-ba91-2af1be0bea52] to PIGMENTS [ed925b43-db83-4cbb-8347-3dc0081bb8f4]</skos:changeNote>
    <gcmd:reference gcmd:text="https://oceanservice.noaa.gov/facts/phyto.html" xml:lang="en"/>
    <skos:definition xml:lang="en">Microscopic marine algae that live in the upper sunlit layer of the ocean or other water bodies. </skos:definition>
    <dcterms:modified>2026-02-18T14:44:17.536Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="84ab9e02-29d1-4e58-97c9-d9e14d97131a">
    <skos:broader rdf:resource="6c320188-da7b-4d52-8e99-57d7ac401841"/>
    <skos:prefLabel xml:lang="en">TRACE METALS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from TRACE METALS [84ab9e02-29d1-4e58-97c9-d9e14d97131a] to TRACE ELEMENTS [6c320188-da7b-4d52-8e99-57d7ac401841]</skos:changeNote>
    <gcmd:reference gcmd:text="https://repository.library.noaa.gov/view/noaa/35666/noaa_35666_DS1.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">Metals present in relatively small proportions in oceans and other water bodies that can be both essential for all life and harmful when introduced by humans to the natural aquatic environment in unnatural amounts.</skos:definition>
    <dcterms:modified>2026-02-18T14:46:02.303Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="54aa2648-70cf-434b-832e-8bbd8460efdf">
    <skos:broader rdf:resource="457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
    <skos:prefLabel xml:lang="en">BACKSCATTER</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from BACKSCATTER [54aa2648-70cf-434b-832e-8bbd8460efdf] to OCEAN OPTICS [457883c4-b30c-4d26-bed8-6c2887ebbc90]</skos:changeNote>
    <gcmd:reference gcmd:text="https://oceanservice.noaa.gov/facts/backscatter.html" xml:lang="en"/>
    <skos:definition xml:lang="en">The reflection of a signal, such as sound waves or light, back in the direction from where it originated. Often used from soundwaves to help understand sea floor characteristics.</skos:definition>
    <dcterms:modified>2026-02-18T14:52:48.946Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="5e5852e2-c562-4021-9c28-69fad4b6afa8">
    <skos:broader rdf:resource="15cc550b-068c-49f4-b082-bc2a43675606"/>
    <skos:prefLabel xml:lang="en">CHLOROPHYLL-A</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CHLOROPHYLL-A [5e5852e2-c562-4021-9c28-69fad4b6afa8] to CHLOROPHYLL [15cc550b-068c-49f4-b082-bc2a43675606]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.epa.gov/national-aquatic-resource-surveys/indicators-chlorophyll" xml:lang="en"/>
    <skos:definition xml:lang="en">The predominant type of chlorophyll used by algae and cyanobacteria, it can be used to measure the quantity of these organisms in a lake or on a hard substrate as well as to classify trophic state.</skos:definition>
    <dcterms:modified>2026-02-18T14:53:59.425Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="092956f8-767b-4c43-94d3-72d5f8dba898">
    <skos:broader rdf:resource="a60ae1b6-abfc-4905-8c09-772da7bb1a10"/>
    <skos:prefLabel xml:lang="en">MACROALGAE FLUORESCENCE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from MACROALGAE FLUORESCENCE [092956f8-767b-4c43-94d3-72d5f8dba898] to FLUORESCENCE [a60ae1b6-abfc-4905-8c09-772da7bb1a10]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.1016/j.ecss.2015.11.010" xml:lang="en"/>
    <skos:definition xml:lang="en">Light re-emitted by seaweeds after absorbing energy from sunlight or another light source. This faint glow can be measured to provide information on the pigments, photosynthetic activity, and overall health of the algae, and how the algae respond to environmental change.</skos:definition>
    <dcterms:modified>2026-02-18T14:55:29.229Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="503dbc7c-c969-4a24-8ff8-c3c19a69ca18">
    <skos:broader rdf:resource="1faaede0-2cd6-4447-b28b-0a28d9e2d067"/>
    <skos:prefLabel xml:lang="en">VOLCANIC DEGASSING</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from VOLCANIC DEGASSING [503dbc7c-c969-4a24-8ff8-c3c19a69ca18] to VOLCANIC ACTIVITY [1faaede0-2cd6-4447-b28b-0a28d9e2d067]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.1029/2007RG000244" xml:lang="en"/>
    <skos:definition xml:lang="en">The release of gases from magma as it rises, cools, or solidifies. This release can occur suddenly during volcanic eruptions or continuously through volcanic features like vents and fumeroles. </skos:definition>
    <dcterms:modified>2026-02-18T15:08:56.772Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="201c461b-6e01-49b0-abdb-003215884f26">
    <skos:broader rdf:resource="d7ef7608-01f5-4e95-9fd9-7dc2aa36113d"/>
    <skos:prefLabel xml:lang="en">GNSS-RO BENDING ANGLES</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from GNSS-RO BENDING ANGLES [201c461b-6e01-49b0-abdb-003215884f26] to RADIO WAVE [d7ef7608-01f5-4e95-9fd9-7dc2aa36113d]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nature.com/articles/s41612-022-00229-7 https://www.eoportal.org/other-space-activities/gnss-ro https://repository.library.noaa.gov/view/noaa/41918" xml:lang="en"/>
    <skos:definition xml:lang="en">The angle by which a radio signal from a Global Navigation Satellite System (GNSS) is refracted, or bent, as it passes through the Earth&apos;s atmosphere during a radio occultation event. This bending results from changes in the air&apos;s refractive index with altitude and is used to derive vertical profiles of atmospheric properties such as temperature, pressure, and humidity.</skos:definition>
    <dcterms:modified>2026-02-18T15:11:05.730Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="2bd42602-0d41-4a80-9fb9-c00b521cf7e6">
    <skos:broader rdf:resource="6e4b29b7-a0c9-4e8e-b778-23b50cf8efb8"/>
    <skos:prefLabel xml:lang="en">VOLUME</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from VOLUME [2bd42602-0d41-4a80-9fb9-c00b521cf7e6] to GROUND WATER PROCESSES/MEASUREMENTS [6e4b29b7-a0c9-4e8e-b778-23b50cf8efb8]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.epa.gov/report-environment/ground-water" xml:lang="en"/>
    <skos:definition xml:lang="en">The amount of ground water available in an aquifer.</skos:definition>
    <dcterms:modified>2026-02-18T15:15:43.297Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="41795836-95f8-465f-9d26-9588059d0724">
    <skos:broader rdf:resource="9d86cd70-062a-4c39-b3f3-226abebc07f7"/>
    <skos:prefLabel xml:lang="en">WATER SURFACE HEIGHT</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from WATER SURFACE HEIGHT [41795836-95f8-465f-9d26-9588059d0724] to SURFACE WATER PROCESSES/MEASUREMENTS [9d86cd70-062a-4c39-b3f3-226abebc07f7]</skos:changeNote>
    <gcmd:reference gcmd:text="https://geo.gcoos.org/ssh/data1/ https://coastwatch.noaa.gov/cwn/product-families/sea-surface-height.html https://science.nasa.gov/kids/earth/how-do-we-measure-sea-level/" xml:lang="en"/>
    <skos:definition xml:lang="en">The elevation of a free surface of a water body such as an ocean, lake, or river measured relative to a reference point.</skos:definition>
    <dcterms:modified>2026-02-18T15:19:13.386Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="8152b2c9-fe5c-4b4d-a296-af7feeb61581">
    <skos:broader rdf:resource="2e5a401b-1507-4f57-82b8-36557c13b154"/>
    <skos:prefLabel xml:lang="en">AEROSOL DEPOLARIZATION</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from AEROSOL DEPOLARIZATION [8152b2c9-fe5c-4b4d-a296-af7feeb61581] to AEROSOLS [2e5a401b-1507-4f57-82b8-36557c13b154]</skos:changeNote>
    <gcmd:reference gcmd:text="https://airbornescience.nasa.gov/category/meas/Aerosol_Depolarization_Ratio https://acp.copernicus.org/articles/21/5807/2021/" xml:lang="en"/>
    <skos:definition xml:lang="en">The change in polarization of light that occurs when light is scattered by atmospheric aerosol particles, compared to the polarization of emitted light. Aerosol depolarization can be used to distinguish aerosol particle shape.</skos:definition>
    <dcterms:modified>2026-02-18T17:32:53.461Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="6453b25b-df0b-4643-8fa4-ddc5976b87c9">
    <skos:broader rdf:resource="06d230f1-08f8-48cc-9bbd-5f2358a84d13"/>
    <skos:prefLabel xml:lang="en">MONOTERPENES</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keywords</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from MONOTERPENES [6453b25b-df0b-4643-8fa4-ddc5976b87c9] to NON-METHANE HYDROCARBONS/VOLATILE ORGANIC COMPOUNDS [06d230f1-08f8-48cc-9bbd-5f2358a84d13]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.merriam-webster.com/dictionary/monoterpene" xml:lang="en"/>
    <skos:definition xml:lang="en">Any class of terpenes that contains two isoprene units per model and have the molecular formula C₁₀H₁₆.</skos:definition>
    <dcterms:modified>2026-02-18T17:36:38.865Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="5a9ddd92-6db6-4dc4-87d5-1748705a3efa">
    <skos:broader rdf:resource="c9e429cb-eff0-4dd3-9eca-527e0081f65c"/>
    <skos:prefLabel xml:lang="en">CLOUD BOUNDARIES</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CLOUD BOUNDARIES [5a9ddd92-6db6-4dc4-87d5-1748705a3efa] to CLOUD PROPERTIES [c9e429cb-eff0-4dd3-9eca-527e0081f65c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.e-education.psu.edu/meteo300/node/711#:~:" xml:lang="en"/>
    <skos:definition xml:lang="en">Transition zones between clouds and the surrounding air, primarily marked by sharp changes in moisture, temperature, and turbulence.</skos:definition>
    <dcterms:modified>2026-02-18T17:42:23.898Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="482200cc-e335-4dd8-8d5b-21d246045085">
    <skos:broader rdf:resource="0cfcbaa7-727b-4199-8cca-93824b427e9b"/>
    <skos:prefLabel xml:lang="en">CLOUD DROPLET EFFECTIVE RADIUS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CLOUD DROPLET EFFECTIVE RADIUS [482200cc-e335-4dd8-8d5b-21d246045085] to CLOUD MICROPHYSICS [0cfcbaa7-727b-4199-8cca-93824b427e9b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://web.archive.org/web/20090724155507/http://disc.sci.gsfc.nasa.gov/PIP/shtml/cloud_effective_radius.shtml" xml:lang="en"/>
    <skos:definition xml:lang="en">An area weighted mean radius of cloud droplets. </skos:definition>
    <dcterms:modified>2026-02-18T17:45:20.173Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="7f79c084-1e73-4b65-be5e-12e4bdf05f43">
    <skos:broader rdf:resource="16db3055-847d-4f06-a3aa-9e27e02170a5"/>
    <skos:prefLabel xml:lang="en">PLANETARY BOUNDARY LAYER TURBULENCE</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from PLANETARY BOUNDARY LAYER TURBULENCE [7f79c084-1e73-4b65-be5e-12e4bdf05f43] to PLANETARY BOUNDARY LAYER [16db3055-847d-4f06-a3aa-9e27e02170a5]</skos:changeNote>
    <gcmd:reference gcmd:text="https://people.atmos.ucla.edu/jcm/turbulence_course_notes/planetary_boundary_layers.pdf" xml:lang="en"/>
    <skos:definition xml:lang="en">The turbulent mixing that occurs in the lowest part of the atmosphere where the flow is directly influenced by the Earth&apos;s surface. It is generated mainly by surface friction (shear) and surface heating or cooling (buoyancy), and rapidly mixes momentum, heat, moisture, and pollutants, throughout the boundary layer.</skos:definition>
    <dcterms:modified>2026-02-18T17:48:03.164Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="11c7e92c-ef67-4462-8ed8-3af98d37f6d9">
    <skos:broader rdf:resource="233a4d81-44f8-4b0e-8ad3-695f641729f8"/>
    <skos:prefLabel xml:lang="en">PLANT FUNCTIONAL DIVERSITY</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from PLANT FUNCTIONAL DIVERSITY [11c7e92c-ef67-4462-8ed8-3af98d37f6d9] to ECOSYSTEM FUNCTIONS [233a4d81-44f8-4b0e-8ad3-695f641729f8]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.pnas.org/doi/10.1073/pnas.0704716104 " xml:lang="en"/>
    <skos:definition xml:lang="en">The value, range, distribution, and relative abundance of plant functional traits present in a given ecosystem.</skos:definition>
    <dcterms:modified>2026-02-18T17:51:12.556Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="4c2e1112-ad66-4fc2-a819-6d14c6fd1ba7">
    <skos:broader rdf:resource="46e4aaa4-349c-4049-a910-035391360010"/>
    <skos:prefLabel xml:lang="en">TROPICAL FOREST</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from TROPICAL FOREST [4c2e1112-ad66-4fc2-a819-6d14c6fd1ba7] to FORESTS [46e4aaa4-349c-4049-a910-035391360010]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/topics/agricultural-and-biological-sciences/tropical-forest" xml:lang="en"/>
    <skos:definition xml:lang="en">Complex forest ecosystems with diverse species and species interactions, located between the Tropics of Cancer and Capricorn. The two major types are tropical seasonal forests and tropical rainforests. </skos:definition>
    <dcterms:modified>2026-02-18T17:57:55.105Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="65f9c2e1-922b-41d7-b97b-2bbd33be2117">
    <skos:broader rdf:resource="abbba948-9b77-4e19-a855-49a7fbc17696"/>
    <skos:prefLabel xml:lang="en">CANOPY SPACING</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from CANOPY SPACING [65f9c2e1-922b-41d7-b97b-2bbd33be2117] to CANOPY CHARACTERISTICS [abbba948-9b77-4e19-a855-49a7fbc17696]</skos:changeNote>
    <gcmd:reference gcmd:text="https://doi.org/10.2307/2425452 https://doi.org/10.2307/2388326" xml:lang="en"/>
    <skos:definition xml:lang="en">The leafless regions between adjacent tree crowns of similar height, leading to the presence of channel-like gaps in the canopy.</skos:definition>
    <dcterms:modified>2026-02-18T18:51:59.574Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="10d0bdd7-b51c-4550-b11c-89b6fae51134">
    <skos:broader rdf:resource="d7742082-5461-4610-9ced-e0ec3bb64697"/>
    <skos:prefLabel xml:lang="en">SCHOOLS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-18 User Id=system System Note=Added broader relation from SCHOOLS [10d0bdd7-b51c-4550-b11c-89b6fae51134] to BUILDINGS [d7742082-5461-4610-9ced-e0ec3bb64697]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.merriam-webster.com/dictionary/school" xml:lang="en"/>
    <skos:definition xml:lang="en">An institution, building, or environment for teaching or learning.</skos:definition>
    <dcterms:modified>2026-02-18T19:22:49.145Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="76613ea6-02c6-4b4f-9ad7-fee52077c0ad">
    <skos:broader rdf:resource="d559b900-eca6-42a4-9311-0297b2ef98ab"/>
    <skos:prefLabel xml:lang="en">THERMAL ANOMALIES</skos:prefLabel>
    <skos:changeNote>Date=2026-02-19 User Id=system System Note=Added broader relation from THERMAL ANOMALIES [76613ea6-02c6-4b4f-9ad7-fee52077c0ad] to LAND SURFACE TEMPERATURE [d559b900-eca6-42a4-9311-0297b2ef98ab]</skos:changeNote>
    <skos:changeNote>Date=2026-02-19 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://science.nasa.gov/earth/earth-observatory/global-maps/land-surface-temperature-anomaly/" xml:lang="en"/>
    <skos:definition xml:lang="en">Land surface temperature is how hot the “surface” of the Earth would feel to the touch in a particular location; an anomaly is when the conditions depart from average conditions for a particular place at a given time of year.</skos:definition>
    <dcterms:modified>2026-02-19T13:53:02.513Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="7a1e322a-0025-4c35-b8f2-73acc0eae9ea">
    <skos:broader rdf:resource="0db0e1c8-6ba3-40c4-97c2-d78c9812692b"/>
    <skos:prefLabel xml:lang="en">VOLCANIC DEPOSITS</skos:prefLabel>
    <skos:changeNote>Date=2026-02-19 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-19 User Id=system System Note=Added broader relation from VOLCANIC DEPOSITS [7a1e322a-0025-4c35-b8f2-73acc0eae9ea] to ERUPTION DYNAMICS [0db0e1c8-6ba3-40c4-97c2-d78c9812692b]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.nps.gov/subjects/volcanoes/lava-flows-and-other-volcanic-deposits.htm" xml:lang="en"/>
    <skos:definition xml:lang="en">Depending on whether an eruption is effusive or explosive, they may produce lava flows or pyroclastic deposits respectively. Other types of volcanic deposits include volcanic domes, and those left by lahars and landslides.</skos:definition>
    <dcterms:modified>2026-02-19T14:18:56.562Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="4f45247d-69e5-47fe-9dd4-2a28d42462cd">
    <skos:broader rdf:resource="83150c54-5da8-4ee8-9579-19b95a8dc10c"/>
    <skos:prefLabel xml:lang="en">HYPERSPECTRAL IMAGERY</skos:prefLabel>
    <skos:changeNote>Date=2026-02-19 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-02-19 User Id=system System Note=Added broader relation from HYPERSPECTRAL IMAGERY [4f45247d-69e5-47fe-9dd4-2a28d42462cd] to SPECTRAL/ENGINEERING [83150c54-5da8-4ee8-9579-19b95a8dc10c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.eoportal.org/other-space-activities/hyperspectral-imaging" xml:lang="en"/>
    <skos:definition xml:lang="en">High spectral resolution imagery by dividing light into many narrow, contiguous spectral bands across the electromagnetic (EM) spectrum, typically between visible and infrared wavelengths.</skos:definition>
    <dcterms:modified>2026-02-19T14:22:03.389Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="61a0b64f-f0c7-44e3-a5c9-7cb75b23e54e">
    <skos:broader rdf:resource="66700628-2b62-4466-999e-faeb15ca4da5"/>
    <skos:prefLabel xml:lang="en">INCIDENCE ANGLE</skos:prefLabel>
    <skos:changeNote>Date=2026-04-07 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-04-07 User Id=system System Note=Added broader relation from INCIDENCE ANGLE [61a0b64f-f0c7-44e3-a5c9-7cb75b23e54e] to MICROWAVE [66700628-2b62-4466-999e-faeb15ca4da5]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.earthdata.nasa.gov/learn/earth-observation-data-basics/sar" xml:lang="en"/>
    <skos:definition xml:lang="en">The angle between the radar beam center and the normal to the local topography.</skos:definition>
    <dcterms:modified>2026-04-07T12:16:53.635Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="562ff317-9db1-43ae-b6ff-e64430e76e26">
    <skos:broader rdf:resource="b7d562cf-9b9b-4461-900b-50423a8c4d29"/>
    <skos:prefLabel xml:lang="en">POLAR VORTEX</skos:prefLabel>
    <skos:changeNote>Date=2026-04-20 User Id=system System Note=Added broader relation from POLAR VORTEX [562ff317-9db1-43ae-b6ff-e64430e76e26] to WEATHER EVENTS [b7d562cf-9b9b-4461-900b-50423a8c4d29]</skos:changeNote>
    <skos:changeNote>Date=2026-04-20 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://ozonewatch.gsfc.nasa.gov/facts/vortex_NH.html" xml:lang="en"/>
    <skos:definition xml:lang="en">The stratospheric polar vortex is a large-scale region of air that is contained by a strong west-to-east jet stream that circles the polar region. This jet stream is usually referred to as the polar night jet. The polar vortex extends from the tropopause (the dividing line between the stratosphere and troposphere) through the stratosphere and into the mesosphere (above 50 km). Low values of ozone and cold temperatures are associated with the air inside the vortex.</skos:definition>
    <dcterms:modified>2026-04-21T12:53:37.123Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="66b79b97-37d5-4b78-8c20-76de97db3146">
    <skos:broader rdf:resource="83150c54-5da8-4ee8-9579-19b95a8dc10c"/>
    <skos:prefLabel xml:lang="en">POLARIZATION</skos:prefLabel>
    <skos:changeNote>Date=2026-04-20 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-04-20 User Id=system System Note=Added broader relation from POLARIZATION [66b79b97-37d5-4b78-8c20-76de97db3146] to SPECTRAL/ENGINEERING [83150c54-5da8-4ee8-9579-19b95a8dc10c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.mit.edu/~ashrstnv/polarization.html" xml:lang="en"/>
    <skos:definition xml:lang="en">The polarization of an electromagnetic wave is the direction of the wave’s oscillating electric field. Light is considered polarized if the component electromagnetic waves all share the same polarization, i.e., if the electric fields all oscillate in the same direction.</skos:definition>
    <dcterms:modified>2026-04-20T13:56:25.130Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="027bed43-6d60-47d6-b43c-f95d2003d996">
    <skos:broader rdf:resource="83150c54-5da8-4ee8-9579-19b95a8dc10c"/>
    <skos:prefLabel xml:lang="en">DIFFRACTION GRATING</skos:prefLabel>
    <skos:changeNote>Date=2026-04-20 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2026-04-20 User Id=system System Note=Added broader relation from DIFFRACTION GRATING [027bed43-6d60-47d6-b43c-f95d2003d996] to SPECTRAL/ENGINEERING [83150c54-5da8-4ee8-9579-19b95a8dc10c]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.thorlabs.com/diffraction-gratings-tutorial?tabName=Gratings%20Tutorial" xml:lang="en"/>
    <skos:definition xml:lang="en">Surface with parallel grooves or slits that enable diffraction of incoming light into optical spectra.</skos:definition>
    <dcterms:modified>2026-04-20T14:28:25.364Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="0817a26c-da58-4ede-8e68-52ed7e19e270">
    <skos:broader rdf:resource="e1f20631-b5b9-438c-b5c2-b1fa0fce100a"/>
    <skos:prefLabel xml:lang="en">STATISTICAL DOWNSCALING MODELS</skos:prefLabel>
    <skos:changeNote>Date=2026-08-05 User Id=tstevens User Note=added new service keyword</skos:changeNote>
    <skos:changeNote>Date=2026-08-05 User Id=system System Note=Added broader relation from STATISTICAL DOWNSCALING MODELS [0817a26c-da58-4ede-8e68-52ed7e19e270] to MODELS [e1f20631-b5b9-438c-b5c2-b1fa0fce100a]</skos:changeNote>
    <gcmd:reference gcmd:text="IPCC, 2021: Annex VII: Glossary" xml:lang="en"/>
    <skos:definition xml:lang="en">Models and methods that increase the effective resolution of climate model output by applying empirical relationships between large-scale predictors and local-scale climate variables, derived from observations. Statistical downscaling infers fine-scale climate information without explicitly simulating physical processes.</skos:definition>
    <dcterms:modified>2026-08-05T18:29:59.596Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="6febb758-364f-4ead-8ab9-2473ab17e838">
    <skos:broader rdf:resource="e1f20631-b5b9-438c-b5c2-b1fa0fce100a"/>
    <skos:prefLabel xml:lang="en">REGIONAL CLIMATE MODELS</skos:prefLabel>
    <skos:changeNote>Date=2026-08-06 User Id=tstevens User Note=added new service keyword</skos:changeNote>
    <skos:changeNote>Date=2026-08-06 User Id=system System Note=Added broader relation from REGIONAL CLIMATE MODELS [6febb758-364f-4ead-8ab9-2473ab17e838] to MODELS [e1f20631-b5b9-438c-b5c2-b1fa0fce100a]</skos:changeNote>
    <gcmd:reference gcmd:text="IPCC, 2021: Annex VII: Glossary" xml:lang="en"/>
    <skos:definition xml:lang="en">Numerical models that represent atmospheric and surface climate processes over a limited area of the Earth at high spatial resolution, using boundary conditions supplied by a global climate model or reanalysis to resolve regional and local features not captured by coarser global models.</skos:definition>
    <dcterms:modified>2026-08-06T11:46:39.352Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="836f5d72-df17-4e38-bd45-35339a651838">
    <skos:broader rdf:resource="4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
    <skos:prefLabel xml:lang="en">SPECTRAL RADIANCE</skos:prefLabel>
    <skos:changeNote>Date=2026-09-18 User Id=system System Note=Added broader relation from Spectral Radiance [836f5d72-df17-4e38-bd45-35339a651838] to ATMOSPHERIC RADIATION [4ad0c52d-6449-48ff-8678-adc6b2cebcb7]</skos:changeNote>
    <skos:changeNote>Date=2026-09-18 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <gcmd:reference gcmd:text="https://glossary.ametsoc.org/wiki/spectral-radiance/" xml:lang="en"/>
    <skos:definition xml:lang="en">The radiance per unit wavelength or wavenumber interval.</skos:definition>
    <dcterms:modified>2026-09-18T16:04:50.359Z</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
</rdf:RDF>
