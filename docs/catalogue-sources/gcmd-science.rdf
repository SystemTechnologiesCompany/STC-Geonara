  <skos:Concept rdf:about="5d3725b6-743b-4dda-bb54-b64f201ec4d1">
    <skos:broader rdf:resource="14802b53-b702-438f-8c8a-f51506807ce6"/>
    <skos:prefLabel xml:lang="en">REPTILES</skos:prefLabel>
    <gcmd:reference gcmd:text="Burn, David M.  Animal World.  1980.  Octopus Books Ltd.  London." xml:lang="en"/>
    <skos:narrower rdf:resource="2037d286-6285-49df-aeb4-6e429b18d595"/>
    <skos:narrower rdf:resource="3f1803fa-3ada-4762-96e4-28966dfdcc83"/>
    <skos:narrower rdf:resource="7dce336b-8596-45f0-bc76-f82b26e1405f"/>
    <skos:definition xml:lang="en">Reptiles are cold-blooded tetrapod craniates which breathe using lungs, havea dry, scaly skin and lay large, shelled eggs.  They live in all typesof terrestrial habitats, the majority in tropical regions; manysecondarily freshwater and marine species.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
