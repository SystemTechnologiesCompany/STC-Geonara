  <skos:Concept rdf:about="70892c25-4206-4673-9504-2876927d19a3">
    <skos:broader rdf:resource="abc6f016-d1f0-4725-b847-639de054d13f"/>
    <skos:prefLabel xml:lang="en">ECHINODERMS</skos:prefLabel>
    <gcmd:reference gcmd:text="Burn, David M. Animal World.  1980.  Octopus Books Ltd.  London." xml:lang="en"/>
    <skos:narrower rdf:resource="4c653917-a5d8-4572-a509-572e9fd2c63d"/>
    <skos:narrower rdf:resource="6972b6bd-2f7e-460d-b12a-914b7d1e029c"/>
    <skos:narrower rdf:resource="ec994afa-ecd4-4d25-9e8b-335cd982755c"/>
    <skos:definition xml:lang="en">The phylum Echinoderms is a wholly marine group whose members includethe familiar starfish and sea urchins often found on the shore. Some oftheir particular features are their five-sided adult symmetry, theirendoskeleton which consists of many small crystals of calcium carbonateand tube feet, which are outward manifestations of their water vascularsystem.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
