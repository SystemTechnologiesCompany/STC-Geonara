  <skos:Concept rdf:about="625da982-3648-43fc-a640-1b230509944e">
    <skos:broader rdf:resource="d3b7c3c0-e644-4f01-94da-dfebe854c0d1"/>
    <skos:prefLabel xml:lang="en">RADAR BACKSCATTER</skos:prefLabel>
    <skos:changeNote>Date=2020-09-29 User Id=tstevens Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=RADAR BACKSCATTER [625da982-3648-43fc-a640-1b230509944e,86025] - COMMON MIDPOINT GATHER [d8b34f6e-0713-45ae-b0c7-23329b0b8f0b,560729]</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Radar Terminology" xml:lang="en"/>
    <skos:narrower rdf:resource="d8b34f6e-0713-45ae-b0c7-23329b0b8f0b"/>
    <skos:definition xml:lang="en">The (microwave) signal reflected by elements of  an illuminated scene back
in the direction of the radar. It is so named to make clear the difference
between energy scattered in arbitrary  directions, and that which returns
to the radar and thus may be received  and recorded by the sensor.</skos:definition>
    <dcterms:modified>2020-09-29 13:28:38.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="62013604-1f53-45ab-8612-b3f3fb001db0">
    <skos:broader rdf:resource="b1de8d2f-cfe6-4358-a4cd-5b7e19d0e585"/>
