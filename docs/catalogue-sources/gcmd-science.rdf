    <skos:prefLabel xml:lang="en">OPTICAL DEPTH/THICKNESS</skos:prefLabel>
    <gcmd:reference gcmd:text="WMO. 1966. International Meteorological Vocabulary. WMO/OMM/BMO, No. 182. TP. 91., Switzerland." xml:lang="en"/>
    <skos:definition xml:lang="en">In radiative transfer, optical thickness or optical depth is the mass ofa given absorbing or emitting material in a vertical column ofunit cross-sectional area and extending between two specifiedlevels.</skos:definition>
