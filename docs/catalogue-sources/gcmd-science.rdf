  <skos:Concept rdf:about="26afa886-4866-4536-be3a-6f9db9aacd97">
    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">CARBON DIOXIDE</skos:prefLabel>
    <skos:changeNote>Date=2021-10-19 User Id=tstevens Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=CARBON DIOXIDE [26afa886-4866-4536-be3a-6f9db9aacd97,776170] - CARBON DIOXIDE PARTIAL PRESSURE [6bf8c40d-6bc0-410b-92a5-349bd88dc021,778204]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from: Webster&apos;s College Dictionary. 1991. Random House." xml:lang="en"/>
    <skos:narrower rdf:resource="6bf8c40d-6bc0-410b-92a5-349bd88dc021"/>
    <skos:definition xml:lang="en">A gaseous compound of one carbon atom and two oxygen atoms, CO2. Itis colorless, odorless, incombustible, and is soluble in water. Itsdissolution in seawater is important to understanding the global carboncycle.</skos:definition>
    <dcterms:modified>2021-10-19 12:41:36.0</dcterms:modified>
