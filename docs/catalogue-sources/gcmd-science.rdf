  </skos:Concept>
  <skos:Concept rdf:about="011bed30-f5b6-4b46-a7ce-797851f24f24">
    <skos:broader rdf:resource="08fd82a1-4370-46a2-82ea-94c0f91498a7"/>
    <skos:prefLabel xml:lang="en">PRESSURE ANOMALIES</skos:prefLabel>
    <gcmd:reference gcmd:text="Glossary of Weather and Climate, American Meteorological Society, 1996." xml:lang="en"/>
    <skos:definition xml:lang="en">The deviation of atmospheric pressure in a given region over a specifiedperiod from the long-term average value for the same region.</skos:definition>
