    <skos:narrower rdf:resource="c3447c90-7490-4f04-89c1-c5274ba8f8f6"/>
    <skos:narrower rdf:resource="5d703cfe-2f7c-4736-acbc-ec4e4f4f8eef"/>
    <skos:narrower rdf:resource="765e92a7-8c14-47dc-bdd8-d85d132a11ee"/>
