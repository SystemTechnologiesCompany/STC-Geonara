    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:narrower rdf:resource="cb6b9191-21ab-4a56-b43f-27e86f90f6d9"/>
    <skos:narrower rdf:resource="c63be844-efa7-49f6-8089-c60111bbdffb"/>
    <skos:narrower rdf:resource="b5ee3496-6910-4971-8539-5aa084bfa9e1"/>
    <skos:narrower rdf:resource="f51acce1-eaf6-4de7-b279-5b58c3034aeb"/>
    <skos:narrower rdf:resource="dc9dea65-e574-4bbb-9945-cd6d1cdbf6c1"/>
    <skos:definition xml:lang="en">A hill of sand built by aeolian processes. Dunes occur in different forms and sizes, formed by interaction with the wind. Most kinds of dunes are longer on the windward side where the sand is pushed up the dune and have a shorter &apos;slip face&apos; in the lee of the wind.</skos:definition>
    <dcterms:modified>2024-10-10 10:23:42.0</dcterms:modified>
