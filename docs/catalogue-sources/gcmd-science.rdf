    <skos:changeNote>Date=2025-08-12 User Id=tstevens User Note=added new science keyword</skos:changeNote>
    <skos:changeNote>Date=2025-08-12 User Id=system System Note=Added broader relation from LAND USE/LAND COVER CHANGE [2f72ebfd-bbbd-4cda-bfc1-0d650272b51d] to LAND USE/LAND COVER [e5815f58-8232-4c7f-b50d-ea71d73891a9]</skos:changeNote>
    <gcmd:reference gcmd:text="https://oceanservice.noaa.gov/facts/lclu.html  https://www.usgs.gov/special-topics/land-use-land-cover-modeling " xml:lang="en"/>
    <skos:definition xml:lang="en">Changes to land surfaces from both natural and anthropogenic means, including deforestation, land slides, agriculture, mining, building constructions, pavement, etc.</skos:definition>
