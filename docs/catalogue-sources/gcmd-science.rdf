    <skos:prefLabel xml:lang="en">AIR QUALITY</skos:prefLabel>
    <gcmd:reference gcmd:text="&lt;i&gt;Glossary of Weather and Climate&lt;/i&gt;, American Meteorological Society, 1996" xml:lang="en"/>
    <skos:definition xml:lang="en">Reports providing information on the cleanliness of air described in terms oflevels of contaminants in air especially with regard to their potential effectson human health.</skos:definition>
