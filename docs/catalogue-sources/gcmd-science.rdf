    <skos:broader rdf:resource="83150c54-5da8-4ee8-9579-19b95a8dc10c"/>
    <skos:prefLabel xml:lang="en">MICROWAVE</skos:prefLabel>
    <skos:changeNote>Date=2026-04-07 User Id=system System Note=Added narrower relation from MICROWAVE [66700628-2b62-4466-999e-faeb15ca4da5] to INCIDENCE ANGLE [61a0b64f-f0c7-44e3-a5c9-7cb75b23e54e]</skos:changeNote>
