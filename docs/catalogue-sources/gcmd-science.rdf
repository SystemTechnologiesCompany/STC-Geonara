    <gcmd:reference gcmd:text="https://glossary.ametsoc.org/wiki/Melt_pond" xml:lang="en"/>
    <skos:definition xml:lang="en">A pond of water on the surface of sea ice, commonly occurring in the Arctic in spring.</skos:definition>
