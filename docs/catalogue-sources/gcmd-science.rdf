    <gcmd:reference gcmd:text="Jefferson et al., 2008, Marine Mammals of the World, Academic Press" xml:lang="en"/>
    <skos:definition xml:lang="en">Small to medium-sized odontocetes that live in marine habitats, have conical teeth and a falcate dorsal fin set near the middle to the back.</skos:definition>
