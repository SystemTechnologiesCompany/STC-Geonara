  </skos:Concept>
  <skos:Concept rdf:about="5557a4f3-8392-4df5-81a9-206c2a86da89">
    <skos:broader rdf:resource="7b0bc104-eed1-4bc1-b12b-3cf9add700da"/>
    <skos:prefLabel xml:lang="en">DEER/MOOSE</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: Phylum Chordata. Class Mammalia. Order Atiodactyla. Deer are ruminant, four legged animals with long powerful legs, a small tail, long ears. Deer distinguished by their antlers, which are temporary and can be regrown. Male deer possess antlers while generally females lack antlers.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="encyclopedia of life" xml:lang="en"/>
    <skos:definition xml:lang="en">Phylum Chordata. Class Mammalia. Order Atiodactyla. Deer are ruminant, four legged animals with long powerful legs, a small tail, long ears. Deer distinguished by their antlers, which are temporary and can be regrown. Male deer possess antlers while generally females lack antlers.</skos:definition>
    <dcterms:modified>2017-03-15 09:05:17.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="52f4dfb0-4583-4d82-8cb7-813ffaadd783">
