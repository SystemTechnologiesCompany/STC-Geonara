  <skos:Concept rdf:about="1151dc7e-7441-4a21-95b6-1d03a1053f60">
    <skos:broader rdf:resource="d73e969a-4b66-4713-8d63-fa3cbb1e25e3"/>
    <skos:prefLabel xml:lang="en">ICEBERGS</skos:prefLabel>
    <gcmd:reference gcmd:text="NSIDC Glossary http://nsidc.org" xml:lang="en"/>
    <skos:definition xml:lang="en">A piece of ice that has broken off from the end of a glacier that terminates inwater. Only about 10 percent of its mass is above the surface of the water.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="11aca777-8a01-42ce-b076-b3059c3d8cae">
    <skos:broader rdf:resource="a04804d5-1064-48fd-a7a7-8da8e10399e1"/>
    <skos:prefLabel xml:lang="en">SEA STATE</skos:prefLabel>
    <gcmd:reference gcmd:text="Neshyba, S. 1987. Oceanography, Perspectives on a Fluid Earth. John Wiley and Sons, Inc. p. 488." xml:lang="en"/>
    <skos:definition xml:lang="en">A measure of the roughness of the sea surface; a scale of surfacewave conditions related to the speed of wind.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="0fc68280-1361-43e1-bc5a-40c49e9679b7">
    <skos:broader rdf:resource="a04804d5-1064-48fd-a7a7-8da8e10399e1"/>
    <skos:prefLabel xml:lang="en">WAVE HEIGHT</skos:prefLabel>
    <gcmd:reference gcmd:text="Garrison, T. 1993. Oceanography, an Invitation to Marine Science. Wadsworth Publishing Co. p. 529." xml:lang="en"/>
    <skos:definition xml:lang="en">Vertical distance between a wave crest and the adjacent wave troughs.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
