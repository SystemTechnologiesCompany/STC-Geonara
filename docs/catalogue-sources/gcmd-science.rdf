  <skos:Concept rdf:about="6641ff15-36c8-4dbc-bf9c-176a08688173">
    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">RADIOCARBON</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Webster&apos;s College Dictionary. 1991. Random House." xml:lang="en"/>
    <skos:definition xml:lang="en">A radioactive isotope of carbon (carbon-14) with a half-life of about5730 years, widely used in the dating of organic materials.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="2111d240-315c-411b-8114-7ef9e89317e5">
    <skos:broader rdf:resource="8c4e2397-aed6-4ce4-9ead-08323e2f90ae"/>
    <dcterms:created>2012-06-25</dcterms:created>
    <skos:prefLabel xml:lang="en">INCREASED/DECREASED CLOUD FRACTION</skos:prefLabel>
    <skos:changeNote>Date=2012-06-25 User Id=mpmorahan Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=INCREASED/DECREASED CLOUD FRACTION [2111d240-315c-411b-8114-7ef9e89317e5,39649] - CLOUD INDICATORS [8c4e2397-aed6-4ce4-9ead-08323e2f90ae,39647]</skos:changeNote>
    <skos:changeNote>Date=2024-09-23 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Refers to amount (increased or decreased) of cloud fraction, which is the measurement used to determine how much of the Earth is covered by clouds. The measurement is important because clouds play a large role in regulating the amount of energy that reaches the Earth from the sun as well as the amount of energy that the Earth reflects and emits back into space.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="https://pace.oceansciences.org/gallery_more.htm?id=147" xml:lang="en"/>
    <skos:definition xml:lang="en">Refers to amount (increased or decreased) of cloud fraction, which is the measurement used to determine how much of the Earth is covered by clouds. The measurement is important because clouds play a large role in regulating the amount of energy that reaches the Earth from the sun as well as the amount of energy that the Earth reflects and emits back into space.</skos:definition>
    <dcterms:modified>2024-09-23 10:27:59.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="223e1204-e305-43d2-80d0-8baed8c828c0">
    <skos:broader rdf:resource="f69374fe-eda2-4223-b130-096220251235"/>
    <dcterms:created>2019-09-11</dcterms:created>
    <skos:prefLabel xml:lang="en">CLIMATE ADAPTATION</skos:prefLabel>
    <skos:changeNote>Date=2019-09-11 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=CLIMATE ADAPTATION [223e1204-e305-43d2-80d0-8baed8c828c0,369143] - GLOBAL CHANGE RESPONSES [f69374fe-eda2-4223-b130-096220251235,369139]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from the USGCRP Glossary (https://www.globalchange.gov/climate-change/glossary)" xml:lang="en"/>
    <skos:definition xml:lang="en">Adjustment in natural or human systems to a new or changing environment that exploits beneficial opportunities or moderates negative effects of a changing climate.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <gcmd:altLabel gcmd:text="Climate Change Adaptation" xml:lang="en"/>
  </skos:Concept>
