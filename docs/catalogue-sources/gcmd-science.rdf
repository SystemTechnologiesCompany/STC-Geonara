    <skos:prefLabel xml:lang="en">BIODIVERSITY FUNCTIONS</skos:prefLabel>
    <gcmd:reference gcmd:text="Australian Government, Department of the Environment." xml:lang="en"/>
    <skos:definition xml:lang="en">Biodiversity is the variety of life: the different plants, animals andmicro-organisms, their genes and the ecosystems of which they are a part.</skos:definition>
