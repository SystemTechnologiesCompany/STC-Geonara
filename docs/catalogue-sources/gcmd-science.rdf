    <gcmd:reference gcmd:text="USGS/Cascades Volcano Observatory Glossary of Selected Glacier and Related Terminology, http://vulcan.wr.usgs.gov/Glossary/Glaciers/glacier_terminology.html" xml:lang="en"/>
    <skos:definition xml:lang="en">Mass balance describes the net gain or loss of snow and ice through a given year. It is usually expressed in terms of water gain or loss.</skos:definition>
    <dcterms:modified>2024-10-02 10:14:45.0</dcterms:modified>
