    <gcmd:reference gcmd:text="Global Hydrology Resource Center/Marshall Space Flight Center" xml:lang="en"/>
    <skos:definition xml:lang="en">Wind velocity in the viewing area of the instrument.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
