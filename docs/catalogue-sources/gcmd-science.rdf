    <gcmd:reference gcmd:text="Glossary of Weather and Climate, American Meteorological Society, 1996." xml:lang="en"/>
    <skos:definition xml:lang="en">An extended interval of abnormally dry weather sufficiently prolonged for the lack of water to cause a serious hydrological imbalance (i.e., crop damage, water supply shortage, etc.) in the affected area.</skos:definition>
    <dcterms:modified>2012-07-12 14:26:33.0</dcterms:modified>
