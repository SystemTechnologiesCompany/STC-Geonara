  <skos:Concept rdf:about="4433600b-f323-458a-b295-352f939aab6b">
    <skos:broader rdf:resource="6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
    <skos:prefLabel xml:lang="en">PH</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Porteous, A. 1996. Dictionary of Environmental Science and Technology, Second Edition. John Wiley and Sons. p. 413." xml:lang="en"/>
    <skos:definition xml:lang="en">A measure of the alkaline or acid strength of a substance.  pH is definedas the logarithm of the reciprocal of the hydrogen ion concentration ofa solution.</skos:definition>
