  <skos:Concept rdf:about="4d95ccc8-3ef9-40df-85e7-db36cb815499">
    <skos:broader rdf:resource="8603db51-3484-4439-8b3b-a06f48e8c686"/>
    <skos:prefLabel xml:lang="en">ICEBERGS</skos:prefLabel>
    <gcmd:reference gcmd:text="Canadian Ice Service - Environment Canada &apos;http://www.cis.ec.gc.ca/manice/chp1_eng.htm&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">A massive piece of ice of greatly varying shape, protruding 5 m or more
above sea- level, which has broken away from a glacier and which may be
afloat or aground. They may be described as tabular, domed, pinnacled,
wedged, drydocked or blocky. Sizes of icebergs are classed as small,
medium, large and very large.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
