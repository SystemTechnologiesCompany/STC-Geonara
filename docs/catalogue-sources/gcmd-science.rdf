    <skos:prefLabel xml:lang="en">FIRN AIR CONTENT</skos:prefLabel>
    <skos:changeNote>Date=2019-10-30 User Id=sritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=FIRN AIR CONTENT [0229714c-7960-4179-b671-30ceb9bf68bb,370067] - FIRN [6159b9d9-4aa5-4dec-8146-0e47751449ff,84419]</skos:changeNote>
    <gcmd:reference gcmd:text="NSIDC, https://nsidc.org/" xml:lang="en"/>
    <skos:definition xml:lang="en">Firn Air Content is a parameter within that data set and is defined as the volume of air trapped within the firn layer. This parameter is subtracted from the ice surface elevation to obtain ice thickness in actual ice equivalent.</skos:definition>
