  <skos:Concept rdf:about="6ee8d84e-c829-44e2-8768-3e5342b79707">
    <skos:broader rdf:resource="80a8ca6d-8471-4d49-a99c-fa5954d93a55"/>
    <skos:prefLabel xml:lang="en">BIBLIOGRAPHIC DATABASES</skos:prefLabel>
    <gcmd:reference gcmd:text="From ODLIS: Online Dictionary of Library and Information Science (&lt;A HREF=&apos;http://www.wcsu.edu/library/odlis.html&apos; target=&apos;_blank&apos;&gt; http://www.wcsu.edu/library/odlis  &lt;/BODY&gt; &lt;/HTML&gt;" xml:lang="en"/>
    <skos:definition xml:lang="en">A computerized file consisting of electronic entries or records, each ofwhich represents a document or bibliographic item retrievable by author,title, subject heading (descriptor), or keywords. Although somebibliographic databases are general in scope and coverage, most areindexes and abstracting services which provide access to the literature ofa specific field or discipline.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
