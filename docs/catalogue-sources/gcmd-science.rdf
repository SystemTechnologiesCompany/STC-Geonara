    <skos:prefLabel xml:lang="en">SOLAR INDUCED FLUORESCENCE</skos:prefLabel>
    <skos:changeNote>Date=2020-07-16 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SOLAR INDUCED FLUORESCENCE [0a13efd5-d712-4b5d-abd4-9caf5914cfb6,560529] - VEGETATION [c7b5c02c-724d-4a19-b824-98180f3900c9,83709]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.jpl.nasa.gov/spaceimages/details.php?id=PIA23353" xml:lang="en"/>
    <skos:definition xml:lang="en">Solar-induced fluorescence is the glow plants emit from photosynthesis — the process of plant growth that includes the capture of carbon from the atmosphere. Areas with lower photosynthesis activity are in shown in light green; areas with higher photosynthesis activity are shown in dark green.</skos:definition>
