  <skos:Concept rdf:about="0d43cb88-dd6d-40ac-b241-b628a39ed2af">
    <skos:broader rdf:resource="99b4792a-9ea3-4756-a4dc-b1b30c946b54"/>
    <dcterms:created>2013-08-05</dcterms:created>
    <skos:prefLabel xml:lang="en">SUBDUCTION</skos:prefLabel>
    <skos:changeNote>Date=2013-08-16 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The process that takes place at convergent boundaries by which one tectonic plate moves under another tectonic plate, sinking into the Earth&apos;s mantle, as the plates converge. A subduction zone is an area on Earth where two tectonic plates move towards one another and subduction occurs.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-08-05 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SUBDUCTION [0d43cb88-dd6d-40ac-b241-b628a39ed2af,105419] - TECTONIC PROCESSES [99b4792a-9ea3-4756-a4dc-b1b30c946b54,86001]</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">The process that takes place at convergent boundaries by which one tectonic plate moves under another tectonic plate, sinking into the Earth&apos;s mantle, as the plates converge. A subduction zone is an area on Earth where two tectonic plates move towards one another and subduction occurs.</skos:definition>
    <dcterms:modified>2013-08-16 12:11:11.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
