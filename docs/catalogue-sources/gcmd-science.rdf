    <skos:prefLabel xml:lang="en">REFORESTATION/REVEGETATION</skos:prefLabel>
    <skos:changeNote>Date=2012-07-02 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
Old Value=Chiras, Daniel D. 1998. Environmental Science.	A Systems Approach to
Sustainable Development. Wadsworth Publishing Company. Belmont, California.
