  <skos:Concept rdf:about="5fb90409-f9b5-46bc-8a6a-7c42e250c7c3">
    <skos:broader rdf:resource="233a4d81-44f8-4b0e-8ad3-695f641729f8"/>
    <skos:prefLabel xml:lang="en">OXYGEN DEMAND</skos:prefLabel>
    <gcmd:reference gcmd:text="Nebel, Bernard J. Nebel and Richard T. Wright. Environmental Science-the Way the World Works. 1998. Prentice-Hall, Inc. Upper Saddle River, New Jersey." xml:lang="en"/>
    <skos:definition xml:lang="en">Oxygen demand or biochemical oxygen demand is the amount of oxygen that willbe absorbed or &apos;demanded&apos; as wastes are being digested or oxidized inboth biological and chemical processes.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
