    <skos:prefLabel xml:lang="en">HOGS/PIGS</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: Phylum Chordata. Class Mammalia. Order Artiodactyla. Family Suidae are omnivores, even toed-ungulates with a large head and a long strengthened snout. Hog is a common name for domestic pig weighing more than 120lbs.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="encyclopedia of life" xml:lang="en"/>
    <skos:definition xml:lang="en">Phylum Chordata. Class Mammalia. Order Artiodactyla. Family Suidae are omnivores, even toed-ungulates with a large head and a long strengthened snout. Hog is a common name for domestic pig weighing more than 120lbs.</skos:definition>
