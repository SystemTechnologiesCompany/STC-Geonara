    <skos:narrower rdf:resource="4698858b-bf39-4a2c-9713-e41757739eff"/>
    <skos:narrower rdf:resource="f082ad51-4ce4-4ffe-be50-6753c4f997ae"/>
    <skos:narrower rdf:resource="f4c2557c-e958-4ea4-b7fb-249469f2c0db"/>
    <skos:narrower rdf:resource="997dc5a6-d83f-4d59-8c5a-1d901b069830"/>
    <skos:narrower rdf:resource="51273f3b-9024-46eb-a0dd-4981e1ad268f"/>
    <skos:narrower rdf:resource="4f938731-d686-4d89-b72b-ff60474bb1f0"/>
    <skos:definition xml:lang="en">Describes the process of inspecting, cleansing, transforming, modeling, and visualizing data with the goal of discovering useful information, suggesting conclusions, and supporting decision-making. Visualization helps people understand the significance of data by placing it in a visual context. Patterns, trends and correlations that might go undetected in text-based data can be exposed and recognized easier with data visualization software</skos:definition>
    <dcterms:modified>2020-05-21 11:26:43.0</dcterms:modified>
