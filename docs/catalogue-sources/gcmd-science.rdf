    <skos:prefLabel xml:lang="en">DRAINAGE BASINS</skos:prefLabel>
    <skos:changeNote>Date=2016-04-04 User Id=gee-cee Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=DRAINAGE BASINS [272700c5-d762-452b-8e9f-130e3a51efb5,158827] - SURFACE WATER FEATURES [959f1861-a776-41b1-ba6b-d23c71d4d1eb,158825]</skos:changeNote>
    <skos:changeNote>Date=2016-04-04 User Id=gee-cee Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: An area of land where surface water from rain, melting snow, or ice converges to a single point at a lower elevation, usually the exit of the basin, where the waters join another waterbody, such as a river, lake, reservoir, estuary, wetland, sea, or ocean.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="http://water.usgs.gov/edu/watershed.html" xml:lang="en"/>
    <skos:definition xml:lang="en">An area of land where surface water from rain, melting snow, or ice converges to a single point at a lower elevation, usually the exit of the basin, where the waters join another waterbody, such as a river, lake, reservoir, estuary, wetland, sea, or ocean.</skos:definition>
    <dcterms:modified>2016-04-04 09:06:57.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="2bdfbf06-c583-4e51-a595-dbc6143d95e0">
    <skos:broader rdf:resource="350c9923-fa80-4f83-8724-2886ac559ac0"/>
    <skos:prefLabel xml:lang="en">ATMOSPHERIC CIRCULATION RECONSTRUCTION</skos:prefLabel>
    <gcmd:reference gcmd:text="WDC for Paleoclimatology http://www.ncdc.noaa.gov/paleo/recons.html" xml:lang="en"/>
    <skos:definition xml:lang="en">Reconstruction of past atmospheric circulation conditions based on paleoclimateproxy records.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="27d63fe6-9970-46fd-9b22-a58e52efc57b">
    <skos:broader rdf:resource="d46a5046-e1c6-4a09-a2f1-db6a21eda611"/>
    <skos:prefLabel xml:lang="en">HYPOCHLOROUS ACID</skos:prefLabel>
    <gcmd:reference gcmd:text="American Meteorological Society Glossary of Meteorology Online: &apos;http://amsglossary.allenpress.com/glossary&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">Hypochlorous acid (HOCL) is a weak, unstable acid.
Hypochlorous acid is also a minor component of the gas-phase inorganic chlorinebudget in the stratosphere. It is formed there largely from reaction of
hydroperoxyl radicals (HO2) with chlorine monoxide (ClO) radicals, and from thehydrolysis of chlorine nitrate on stratospheric aerosols. It is subject to
quite rapid photolysis in the sunlit atmosphere.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="2a2db13c-c86d-40ea-9fa8-6d2d5bdac08e">
