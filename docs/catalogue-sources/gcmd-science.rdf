    <skos:prefLabel xml:lang="en">BERYLLIUM-10 ANALYSIS</skos:prefLabel>
    <skos:changeNote>Date=2012-07-18 User Id=mpmorahan Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
Old Value=Anthony Watts, David Archibald, Beryllium 10 as climate proxy: http://www.sott.net/articles/show/179718-Beryllium-10-as-climate-proxy
