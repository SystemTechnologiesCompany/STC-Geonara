  </skos:Concept>
  <skos:Concept rdf:about="7ea836c5-e959-4dba-93bb-b1d4e511bfad">
    <skos:broader rdf:resource="50b8fe04-9149-4b7f-a8b2-b33b1e3aa192"/>
    <dcterms:created>2024-03-11</dcterms:created>
    <skos:prefLabel xml:lang="en">RELATIVE PERMITTIVITY</skos:prefLabel>
    <skos:changeNote>Date=2024-03-12 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The Relative permittivity (or dielectric constant, ε) is a measure of the ease with which a material is polarized by an electric field relative to vacuum. It is defined by the magnitude of the dielectric polarization (dipole moment per unit volume) induced by a unit field. Dielectric constants have no units - they are coefficients that multiply the capacitance with free space (or vacuum) as dielectric.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2024-03-11 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=RELATIVE PERMITTIVITY [7ea836c5-e959-4dba-93bb-b1d4e511bfad,1618396] - SNOW/ICE [50b8fe04-9149-4b7f-a8b2-b33b1e3aa192,1615061]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.sciencedirect.com/topics/earth-and-planetary-sciences/permittivity" xml:lang="en"/>
    <skos:definition xml:lang="en">The Relative permittivity (or dielectric constant, ε) is a measure of the ease with which a material is polarized by an electric field relative to vacuum. It is defined by the magnitude of the dielectric polarization (dipole moment per unit volume) induced by a unit field. Dielectric constants have no units - they are coefficients that multiply the capacitance with free space (or vacuum) as dielectric.</skos:definition>
    <dcterms:modified>2024-03-12 13:07:03.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
