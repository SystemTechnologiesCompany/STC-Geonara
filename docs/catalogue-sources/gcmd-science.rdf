  <skos:Concept rdf:about="83cf8358-4fae-4f17-ba02-b8280f2b7209">
    <skos:broader rdf:resource="0db0e1c8-6ba3-40c4-97c2-d78c9812692b"/>
    <dcterms:created>2013-03-07</dcterms:created>
    <skos:prefLabel xml:lang="en">PYROCLASTIC PARTICAL SIZE DISTRIBUTION</skos:prefLabel>
    <skos:changeNote>Date=2013-03-07 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=PYROCLASTIC PARTICAL SIZE DISTRIBUTION [83cf8358-4fae-4f17-ba02-b8280f2b7209,83151] - ERUPTION DYNAMICS [0db0e1c8-6ba3-40c4-97c2-d78c9812692b,61651]</skos:changeNote>
    <gcmd:reference gcmd:text="Taddeucci, J. &amp; Palladino, D.M. Bull Volcanol (2002) 64: 273. doi:10.1007/s00445-002-0205-6" xml:lang="en"/>
    <skos:definition xml:lang="en">Refers to the distribution and size of the pyroclastic elements when they are erupted from a volcano. In moving pyroclastic systems, particles are sorted as a function of their sizes, densities and shapes. The analysis of the distribution of these characteristics in particle populations of pyroclastic deposits is a major tool in evaluating properties and regimes of parent transport systems.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="262e3568-c57b-4e28-a142-ad5e7b51dfb7">
    <skos:broader rdf:resource="d81b77be-0177-4e26-942c-aa911239482d"/>
    <dcterms:created>2019-03-13</dcterms:created>
    <skos:prefLabel xml:lang="en">GEOENGINEERING</skos:prefLabel>
    <skos:changeNote>Date=2019-03-13 User Id=tstevens Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=GEOENGINEERING [262e3568-c57b-4e28-a142-ad5e7b51dfb7,368563] - SOLAR RADIATION MANAGEMENT [0f583845-c39e-471d-a590-8212a4358e1e,368567]</skos:changeNote>
    <skos:changeNote>Date=2019-03-13 User Id=tstevens Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=GEOENGINEERING [262e3568-c57b-4e28-a142-ad5e7b51dfb7,368563] - CARBON DIOXIDE REMOVAL [1595c0a9-63a8-433c-8515-044a977d73a7,368571]</skos:changeNote>
    <skos:changeNote>Date=2019-03-13 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=GEOENGINEERING [262e3568-c57b-4e28-a142-ad5e7b51dfb7,368563] - ENVIRONMENTAL GOVERNANCE/MANAGEMENT [d81b77be-0177-4e26-942c-aa911239482d,87343]</skos:changeNote>
    <gcmd:reference gcmd:text="http://www.ipcc-wg2.org/meetings/EMs/EM_GeoE_Meeting_Report_final.pdf" xml:lang="en"/>
    <skos:narrower rdf:resource="0f583845-c39e-471d-a590-8212a4358e1e"/>
    <skos:narrower rdf:resource="1595c0a9-63a8-433c-8515-044a977d73a7"/>
    <skos:definition xml:lang="en">Geoengineering refers to a broad set of methods and technologies that aim to deliberately alter the climate system in order to alleviate the impacts of climate change. Most, but not all, methods seek to either (a) reduce the amount of absorbed solar energy in the climate system (Solar Radiation Management) or (b) increase net carbon sinks from the atmosphere at a scale sufficiently large to alter climate (Carbon Dioxide Removal). Scale and intent are of central importance. Two key characteristics of geoengineering methods of particular concern are that they use or affect the climate system (e.g., atmosphere, land, or ocean) globally or regionally and/or could have substantive unintended effects that cross national boundaries. Geoengineering is different from weather modification and ecological engineering, but the boundary can be fuzzy.</skos:definition>
    <dcterms:modified>2019-03-13 07:51:37.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <gcmd:altLabel gcmd:text="Climate Engineering" xml:lang="en"/>
    <gcmd:altLabel gcmd:text="Climate Intervention" xml:lang="en"/>
  </skos:Concept>
