    <skos:narrower rdf:resource="3965bb3f-fa0e-475e-a48c-5703c9ab9fe5"/>
    <skos:narrower rdf:resource="ab3e5ad3-d2c0-4c63-b321-345307bda59d"/>
    <skos:definition xml:lang="en">Atmospheric Carbon Monoxide (CO) is a toxic, odorless, colorless gas produced during fossil fuel or biomass burning. It is one of the longest-lived,naturally occurring atmospheric carbon compounds. The recent change in tropospheric CO content may portend a change in the balance between oxidants and reductants in the atmosphere.</skos:definition>
    <dcterms:modified>2021-02-26 08:59:06.0</dcterms:modified>
