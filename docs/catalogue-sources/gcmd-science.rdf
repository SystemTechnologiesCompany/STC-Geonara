    <skos:prefLabel xml:lang="en">WAVE ENERGY PRODUCTION/USE</skos:prefLabel>
    <skos:changeNote>Date=2012-06-26 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=WAVE ENERGY PRODUCTION/USE [62c1fec5-3512-4136-a060-ec2338a48296,40123] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]</skos:changeNote>
    <skos:changeNote>Date=2012-06-29 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Refers to the production and use of wave energy for human consumption. Wave energy is the transport of energy by ocean surface waves, and the capture of that energy to do useful work.
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="U.S. Department of Energy" xml:lang="en"/>
    <skos:definition xml:lang="en">Refers to the production and use of wave energy for human consumption. Wave energy is the transport of energy by ocean surface waves, and the capture of that energy to do useful work.</skos:definition>
    <dcterms:modified>2012-06-29 13:57:11.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
