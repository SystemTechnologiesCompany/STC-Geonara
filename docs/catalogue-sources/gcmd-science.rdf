    <skos:broader rdf:resource="81655dc5-83d3-4daf-81c8-dc1522e9906e"/>
    <skos:prefLabel xml:lang="en">GREEN ALGAE</skos:prefLabel>
    <skos:changeNote>Date=2017-03-15 User Id=mgenazzi Entity=Definition Operation=INSERT 
User Note=Definition added
System Note=insert Definition
New Value=id: null
text: Green algae are distinguished by chlorophyll a and b proportions, accessory pigments beta-carotene, and xanthophylls in stacked thylakoids. Cell walls are typically cellulose and they store carbohydrates as starch
language code: en</skos:changeNote>
    <gcmd:reference gcmd:text="seaweed.ie" xml:lang="en"/>
    <skos:definition xml:lang="en">Green algae are distinguished by chlorophyll a and b proportions, accessory pigments beta-carotene, and xanthophylls in stacked thylakoids. Cell walls are typically cellulose and they store carbohydrates as starch</skos:definition>
