relationship type: null
relationship value: null
generated by: null</skos:changeNote>
    <skos:changeNote>Date=2012-06-26 User Id=gee-cee Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=SEDIMENT THICKNESS [6fb40553-a2ef-465a-b7d2-3401e3bfceac,40063] - SEDIMENTS [b3764016-0b5d-48fb-be3e-4f1082cf13e7,40061]</skos:changeNote>
    <gcmd:reference gcmd:text="CLCS/11, paragraph 8.1.4. - http://www.continentalshelf.org/" xml:lang="en"/>
    <skos:definition xml:lang="en">The sediment thickness at any location on the continental margin is the vertical distance from the sea floor to the top of the basement at the base of the sediments, regardless of the slope of the sea floor or the slope of the top basement surface.</skos:definition>
