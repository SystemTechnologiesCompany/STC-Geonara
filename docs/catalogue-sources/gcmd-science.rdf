  <skos:Concept rdf:about="44e49605-e860-41d0-8ef8-cb74419f831d">
    <skos:broader rdf:resource="38e40180-1a2a-40a9-a030-04775dabbabb"/>
    <skos:prefLabel xml:lang="en">INSECTS</skos:prefLabel>
    <gcmd:reference gcmd:text="Allaby, M. 1998. A Dictionary of Ecology. Oxford University Press.  Oxford, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">Insects are a class of Arthropoda, members of which have three pairs oflegs and usually two pairs of wings borne on the thorax.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="5d290bd8-049b-4002-86c8-8acba563d0e1">
    <skos:broader rdf:resource="3a942e8a-d2f2-42bf-9e83-b7b3793b100e"/>
    <skos:prefLabel xml:lang="en">SOLAR WIND</skos:prefLabel>
    <gcmd:reference gcmd:text="http://www-istp.gsfc.nasa.gov/Education/gloss.html" xml:lang="en"/>
    <skos:definition xml:lang="en">The solar wind is hot solar plasma spreading from the solar corona in alldirections, at a typical speed of 300-1,000 km/sec. The solar wind isessentially the hot solar corona on expanding in all directions into theinterplanetary space. The solar wind is diverted around the Earth by theEarth&apos;s magnetic field, although some solar particles enter the Earth&apos;s fieldat the poles. The solar wind carries coronal magnetic fields by a process knownas frozen in the flux. If these frozen in fields have the same North-Southorientation as the Earth&apos;s magnetic field, energy can be transferred into theEarth&apos;s magnetosphere, leading to geomagnetic storms.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
