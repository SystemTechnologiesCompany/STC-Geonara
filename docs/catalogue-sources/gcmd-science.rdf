relationship value: null
generated by: null</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.iqair.com/us/newsroom/pm1" xml:lang="en"/>
    <skos:definition xml:lang="en">A type of air pollution that is made up of particles that are less than 1 micron in size. PM1 is particularly dangerous because of its small size, which allows it to penetrate lung tissue and enter the bloodstream.</skos:definition>
