    <skos:broader rdf:resource="c7b5c02c-724d-4a19-b824-98180f3900c9"/>
    <skos:prefLabel xml:lang="en">EVERGREEN VEGETATION</skos:prefLabel>
    <gcmd:reference gcmd:text="Allaby, Michael, ed. 1998. A Dictionary of Plant Sciences, 2nd Edition. New York: Oxford University Press." xml:lang="en"/>
    <skos:definition xml:lang="en">Vegetation that has persistent leaves and whose crown is never totally bare.</skos:definition>
