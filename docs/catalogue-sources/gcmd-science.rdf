    <gcmd:reference gcmd:text="Garrison, T. 1993. Oceanography, an Invitation to Marine Science. Wadsworth Pubishing Co. p. 529." xml:lang="en"/>
    <skos:definition xml:lang="en">A wave formed by transfer of wind energy into water.</skos:definition>
