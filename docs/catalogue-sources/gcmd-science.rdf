    <skos:narrower rdf:resource="cf75769c-2430-4280-b9c2-ba384849a548"/>
    <skos:definition xml:lang="en">High-level clouds that form in the troposphere, the lowest layer of Earth&apos;s atmosphere, and are made up of ice crystals or supercooled water droplets.</skos:definition>
    <dcterms:modified>2024-10-09 09:40:35.0</dcterms:modified>
