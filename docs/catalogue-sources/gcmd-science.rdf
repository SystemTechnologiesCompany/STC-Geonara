  <skos:Concept rdf:about="5f2ec7b9-3e8c-4d12-bba6-0f84c08729e0">
    <skos:broader rdf:resource="457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
    <skos:prefLabel xml:lang="en">EXTINCTION COEFFICIENTS</skos:prefLabel>
    <skos:definition xml:lang="en">Coefficient of underwater light attenuation. Different coefficientsare included as detailed variables (e.g. diffuse attenuation coefficient,etc.).</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="488f4df2-712e-4fac-98d1-46ab134b84ee">
    <skos:broader rdf:resource="b6fd22ab-dca7-4dfa-8812-913453b5695b"/>
    <skos:prefLabel xml:lang="en">ROCKY COASTS</skos:prefLabel>
    <skos:definition xml:lang="en">Pertaining to the environment of rock-dominated shorelines,often characterized by high-energy wave action, and often common alongisostatically rebounding coastlines.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
