  <skos:Concept rdf:about="3d997f01-8987-4fb1-a32e-d88d51f0a2c4">
    <skos:broader rdf:resource="2dcffd8f-2b01-4c68-a4f2-c4940d2709a3"/>
    <dcterms:created>2012-06-25</dcterms:created>
    <skos:prefLabel xml:lang="en">HIGHER MAXIMUM DAYTIME TEMPERATURES</skos:prefLabel>
