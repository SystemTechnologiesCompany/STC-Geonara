    <gcmd:reference gcmd:text="American Meteorological Society, Glossary of Meteorology, http://glossary.ametsoc.org/wiki/Main_Page" xml:lang="en"/>
    <skos:narrower rdf:resource="eddd1f51-a6ae-4c35-bac5-e68131fcb386"/>
    <skos:narrower rdf:resource="2dce1d90-f958-4e96-b8d8-c8b0bc69d16e"/>
    <skos:definition xml:lang="en">A general term referring to the radiation reflected from, or scattered back through, a given surface in response to radiation incident on the surface with the same wavelength or wavelength range.</skos:definition>
    <dcterms:modified>2019-08-26 09:50:55.0</dcterms:modified>
