User Note=Insert Concept
System Note=add broader relation
New Value=SPELEOTHEMS [1cbefa2a-484e-4742-ad3d-d347d27272bd,40089] - PALEOCLIMATE INDICATORS [c9a5b3eb-7556-41a8-a2b8-c015db80e5b2,39947]</skos:changeNote>
    <gcmd:reference gcmd:text="Oxford Dictionary - http://oxforddictionaries.com/definition/english/speleothem" xml:lang="en"/>
    <skos:definition xml:lang="en">a structure formed in a cave by the deposition of minerals from water, e.g. a stalactite or stalagmite.</skos:definition>
