  <skos:Concept rdf:about="2e83362e-d8f8-4bca-83fd-bae360ebe94b">
    <skos:broader rdf:resource="57383ac5-614c-4b84-9202-e137b000422b"/>
    <skos:prefLabel xml:lang="en">SOLAR ACTIVITY</skos:prefLabel>
    <gcmd:reference gcmd:text="Reference: An Extended Glossary of Solar-Terrestrial Terms from the IPS Radio and Space Services: &apos;http://www.ips.oz.au/background/richard/glossary.html&apos;" xml:lang="en"/>
    <skos:narrower rdf:resource="0d32a340-ee64-4795-9254-09dcaf55bf4c"/>
    <skos:narrower rdf:resource="1ef327e1-6139-49ff-87c3-f959ea75a511"/>
    <skos:narrower rdf:resource="25aa0f7b-89a5-46d7-b3d3-622b60032661"/>
    <skos:narrower rdf:resource="33f0ec3e-cd6d-498c-9468-749741fc12e2"/>
    <skos:narrower rdf:resource="e2fc7768-955b-4e76-935e-d33805fcc914"/>
    <skos:narrower rdf:resource="7b52f7f5-4102-4829-8ea3-c0dcdd36bdca"/>
    <skos:narrower rdf:resource="88bd8ce6-334d-4a42-8d51-5ed074ef5a89"/>
    <skos:narrower rdf:resource="6a5a2ccf-3ba6-4519-bc9b-7617ef3b9087"/>
    <skos:narrower rdf:resource="a4390c3d-cffa-43ee-8e91-49c6d49ac371"/>
    <skos:narrower rdf:resource="e06822d8-b640-4d75-ac37-33ab3cc5e765"/>
    <skos:narrower rdf:resource="429d42ef-9b58-4068-b389-0a9e60e55486"/>
    <skos:narrower rdf:resource="a15e514b-4b44-4587-a857-34ab7e2d357e"/>
    <skos:narrower rdf:resource="e4fcb001-f517-4295-89dd-73292e0bf3ee"/>
    <skos:narrower rdf:resource="ace2d2e5-0b9a-472e-b27b-c687b9108076"/>
    <skos:narrower rdf:resource="fa9f54b2-a101-4faf-b1dc-b6dff141c08c"/>
    <skos:narrower rdf:resource="6d486f25-7477-4da9-96ae-0091596ed4d2"/>
    <skos:definition xml:lang="en">Any change in the sun&apos;s appearance or behavior. The sun&apos;s activity
is described as being very low, low, moderate, high or very high.
Solar activity changes over a period of, on average, 11 years. At
solar maximum, the solar activity is high and so too the Extreme
Ultraviolet (EUV) radiation output which affects the ionosphere. At solar 
minimum, the opposite is true.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="4e5cf935-cf17-4947-bd1f-6816a855953a">
