    <skos:prefLabel xml:lang="en">MAGNETIC ANOMALIES</skos:prefLabel>
    <skos:changeNote>Date=2013-02-18 User Id=tbs1979 Entity=BroaderRelation Operation=DELETE 
User Note=Move Concepts
