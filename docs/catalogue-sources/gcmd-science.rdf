    <skos:prefLabel xml:lang="en">SEA LEVEL RISE</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Neshyba, S. 1987. Oceanography, Perspectives on a Fluid Earth. John Wiley &amp; Sons, Inc. p. 488." xml:lang="en"/>
    <skos:definition xml:lang="en">An increase in the average height of the sea surface over a vertical datum.</skos:definition>
