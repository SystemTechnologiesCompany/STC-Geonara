    <skos:prefLabel xml:lang="en">HAZARDS MANAGEMENT</skos:prefLabel>
    <skos:changeNote>Date=2019-07-25 User Id=tstevens Entity=NarrowerRelation Operation=INSERT 
User Note=Insert Concept
System Note=add narrower relation
New Value=HAZARDS MANAGEMENT [464de0a5-2bb9-4172-9fd3-1634cbc4e739,84355] - HAZARD MAPPING [c9a13e09-98de-4ace-8d4c-b01aa04347f4,368979]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.safework.sa.gov.au/uploaded_files/managing_hazards.pdf" xml:lang="en"/>
    <skos:narrower rdf:resource="c9a13e09-98de-4ace-8d4c-b01aa04347f4"/>
    <skos:narrower rdf:resource="d7aa220d-4012-4ab1-98c8-0cc4157a48f3"/>
    <skos:narrower rdf:resource="5c14b001-518f-460b-90fe-139bf192d1f2"/>
    <skos:narrower rdf:resource="a2e9c7b9-96fd-449f-91db-7ab5e2dd679e"/>
    <skos:narrower rdf:resource="6b2fad63-2230-4d54-8f31-fee604d1f977"/>
    <skos:definition xml:lang="en">A problem-solving process aimed at defining problems (identifying hazards), gathering information about them (assessing the risks) and solving them (controlling the risks). Where a control has been used to address an identified hazard, this should be reviewed by checking the effectiveness of the control (evaluation). The whole hazard management process should also be reviewed after a period of time or when something changes.</skos:definition>
    <dcterms:modified>2019-07-25 08:23:30.0</dcterms:modified>
