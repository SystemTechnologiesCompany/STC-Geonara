  <skos:Concept rdf:about="0ef4a2f0-8a29-4f5e-9396-b4f6a71c8bf6">
    <skos:broader rdf:resource="d81b77be-0177-4e26-942c-aa911239482d"/>
    <dcterms:created>2012-06-27</dcterms:created>
    <skos:prefLabel xml:lang="en">FIRE MANAGEMENT</skos:prefLabel>
    <skos:changeNote>Date=2012-06-29 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Involves the management of wildland fires to restore and maintain the health of ecosystems. Fires are managed through a variety of methods that include prevention, suppression, managing wildfire for resource benefits, prescribed fires, and mechanical treatment of hazardous fuels.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2012-06-27 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=FIRE MANAGEMENT [0ef4a2f0-8a29-4f5e-9396-b4f6a71c8bf6,40201] - ENVIRONMENTAL GOVERNANCE/MANAGEMENT [d81b77be-0177-4e26-942c-aa911239482d,40199]</skos:changeNote>
    <gcmd:reference gcmd:text="U.S. Forest Service Fire and Aviation Management Division" xml:lang="en"/>
    <skos:definition xml:lang="en">Involves the management of wildland fires to restore and maintain the health of ecosystems. Fires are managed through a variety of methods that include prevention, suppression, managing wildfire for resource benefits, prescribed fires, and mechanical treatment of hazardous fuels.</skos:definition>
    <dcterms:modified>2012-06-29 14:26:40.0</dcterms:modified>
