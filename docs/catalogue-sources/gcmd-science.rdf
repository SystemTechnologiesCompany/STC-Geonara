    <gcmd:reference gcmd:text="Glossary of Meteorology, https://glossary.ametsoc.org/wiki/Rain" xml:lang="en"/>
    <skos:definition xml:lang="en">Precipitation in the form of liquid water drops that have diameters greater than 0.5 mm, or, if widely scattered, the drops may be smaller.</skos:definition>
