    <skos:prefLabel xml:lang="en">SALINITY</skos:prefLabel>
    <gcmd:reference gcmd:text="NASA/JPL Polar Oceanography Glossary &apos;http://oceans-www.jpl.nasa.gov/polar/Glossary/terms.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">How salty the water is.   Brine has a very high salinity.   Fresh water has a
salinity of zero.</skos:definition>
