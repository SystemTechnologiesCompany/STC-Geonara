    <skos:prefLabel xml:lang="en">LAKE EFFECT SNOW</skos:prefLabel>
    <skos:changeNote>Date=2016-06-28 User Id=saritz Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Snowstorm occurring near or downwind from the shore of a lake resulting from the warming (destabilization) and moistening of relatively cold air during passage over a warm body of water.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2016-06-28 User Id=saritz Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=LAKE EFFECT SNOW [12b7f57f-c295-4adf-97f5-43356f1270bf,217751] - SNOW STORMS [bc9215ae-58ec-481e-ba83-89376a298000,217749]</skos:changeNote>
    <gcmd:reference gcmd:text="Glossary of Meteorology, American Meteorological Society, 2016." xml:lang="en"/>
    <skos:definition xml:lang="en">Snowstorm occurring near or downwind from the shore of a lake resulting from the warming (destabilization) and moistening of relatively cold air during passage over a warm body of water.</skos:definition>
