    <gcmd:reference gcmd:text="Glossary of Weather and Climate, American Meteorological Society, 1996." xml:lang="en"/>
    <skos:definition xml:lang="en">The atmospheric pressure at mean sea level, either directly measured, or,most commonly, empirically determined from the observed station pressure.</skos:definition>
