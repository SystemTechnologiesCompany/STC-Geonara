  <skos:Concept rdf:about="62ee81e7-9f5a-4af5-a086-f4c402c7d19d">
    <skos:broader rdf:resource="42c6d91b-afef-4638-95c5-0d130828b2e7"/>
    <skos:prefLabel xml:lang="en">ACID RAIN</skos:prefLabel>
    <skos:changeNote>Date=2018-03-06 User Id=tstevens Entity=Definition Operation=UPDATE Field=text 
System Note=update Definition
Old Value=Related to the processes of depositing acidic (pH less than 7.0) material into a body of water.
New Value=Acid rain results when sulfur dioxide (SO2) and nitrogen oxides (NOX) are emitted into the atmosphere and transported by wind and air currents.  The SO2 and NOX react with water, oxygen and other chemicals to form sulfuric and nitric acids.  These then mix with water and other materials before falling to the ground.</skos:changeNote>
    <skos:changeNote>Date=2018-03-06 User Id=tstevens Entity=PrefLabel Operation=UPDATE Field=text 
System Note=update PrefLabel
Old Value=ACID DEPOSITION
New Value=ACID RAIN</skos:changeNote>
