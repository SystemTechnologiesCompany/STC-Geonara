  <skos:Concept rdf:about="80e34388-3d24-4ff9-8d23-784fad52c432">
    <skos:broader rdf:resource="02d92216-70c6-437c-8c15-2b76f2132921"/>
    <skos:prefLabel xml:lang="en">DATA NETWORKING/DATA TRANSFER TOOLS</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from Webopedia: http://www.webopedia.com/" xml:lang="en"/>
    <skos:definition xml:lang="en">Data networking tools refer to tools and services that facilitate the ability
 of two or more computers to communicate together and to share data with each
 other.
 Data transfer tools refer to tools and services that manage or facilitate the
 transmission of data from one computer or device to another. For example, grid
 computing is a form of networking that harnesses the processing cycles of all
 computers connected in a network to solve problems that are too large for any
 one computer. In the Earth sciences, these tools facilitate the networking of
 large volumes of satellite data or climate model output data.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
