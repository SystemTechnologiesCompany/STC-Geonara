    <skos:prefLabel xml:lang="en">Urban Heat Island</skos:prefLabel>
    <skos:changeNote>Date=2019-03-12 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=Urban Heat Island [5ce8b673-cdb9-4000-ad00-774d1c67c1b1,368539] - ENVIRONMENTAL HEALTH FACTORS [5a47842e-785d-4cc4-b1c1-2147a9252c19,84159]</skos:changeNote>
    <gcmd:reference gcmd:text="https://www.globalchange.gov/climate-change/glossary" xml:lang="en"/>
    <skos:definition xml:lang="en">The tendency for higher air temperatures to persist in urban areas as aresult of heat absorbed and emitted by buildings and asphalt, tending to make cities warmer than the surrounding countryside.</skos:definition>
