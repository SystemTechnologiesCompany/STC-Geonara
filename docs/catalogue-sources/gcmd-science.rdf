    <gcmd:reference gcmd:text="https://www.metoffice.gov.uk/weather/learn-about/weather/types-of-weather/clouds/low-level-clouds/stratocumulus" xml:lang="en"/>
    <skos:narrower rdf:resource="bec5166e-1822-40f7-8f07-4d5167d8a565"/>
    <skos:narrower rdf:resource="5857260b-1de6-47c2-8f66-5c0dbac42e32"/>
    <skos:narrower rdf:resource="b1d51b72-97d0-484c-b251-220f219965c2"/>
    <skos:definition xml:lang="en">Low-level clumps or patches of cloud varying in color from bright white to dark grey. They are the most common clouds on earth recognized by their well-defined bases, with some parts often darker than others. They usually have gaps between them, but they can also be joined together.</skos:definition>
