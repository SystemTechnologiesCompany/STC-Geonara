  <skos:Concept rdf:about="41f27172-14f6-4940-9b7b-f3d4db69e0c6">
    <skos:broader rdf:resource="0af72e0e-52a5-4695-9eaf-d6fbb7991039"/>
    <skos:prefLabel xml:lang="en">ELECTRIC FIELD</skos:prefLabel>
    <gcmd:reference gcmd:text="International Solar-Terrestrial Physics Science Initiative, NASA Goddard Space Flight Center, &apos;http://www-istp.gsfc.nasa.gov&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">The region in which electric forces can be observed, e.g. near an
electric charge. As a field, it may also be viewed as a region of space
modified by the presence of electric charges.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
