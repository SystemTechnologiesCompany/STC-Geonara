  <skos:Concept rdf:about="12bb9ec2-a706-436d-aa29-253495276052">
    <skos:broader rdf:resource="b409a30b-0e3f-4592-bec9-7d371797b4a9"/>
    <dcterms:created>2013-08-06</dcterms:created>
    <skos:prefLabel xml:lang="en">GLACIAL STRIATION</skos:prefLabel>
    <skos:changeNote>Date=2024-10-30 User Id=tstevens Entity=WeightedRelation Operation=INSERT 
System Note=insert WeightedRelation
New Value=id: null
related concept uuid: 114e9f84-8bc5-4863-abd2-55b80ed2af11
relationship type: null
relationship value: null
generated by: null</skos:changeNote>
    <skos:changeNote>Date=2013-08-26 User Id=tbs1979 Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: Scratches or gouges cut into bedrock by glacial abrasion. Glacial striations are usually multiple, straight, and parallel, representing the movement of the glacier using rock fragments and sand grains, embedded in the base of the glacier, as cutting tools. Large amounts of coarse gravel and boulders carried along underneath the glacier provide the abrasive power to cut trough-like glacial grooves, and finer sediments also in the base of the moving glacier further scour and polish the bedrock surface, forming a glacial pavement.
language code: en</skos:changeNote>
    <skos:changeNote>Date=2013-08-06 User Id=tbs1979 Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=GLACIAL STRIATION [12bb9ec2-a706-436d-aa29-253495276052,105675] - GLACIAL PROCESSES [b409a30b-0e3f-4592-bec9-7d371797b4a9,85295]</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:definition xml:lang="en">Scratches or gouges cut into bedrock by glacial abrasion. Glacial striations are usually multiple, straight, and parallel, representing the movement of the glacier using rock fragments and sand grains, embedded in the base of the glacier, as cutting tools. Large amounts of coarse gravel and boulders carried along underneath the glacier provide the abrasive power to cut trough-like glacial grooves, and finer sediments also in the base of the moving glacier further scour and polish the bedrock surface, forming a glacial pavement.</skos:definition>
    <dcterms:modified>2024-10-30 09:16:30.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <skos:related rdf:resource="114e9f84-8bc5-4863-abd2-55b80ed2af11"/>
  </skos:Concept>
  <skos:Concept rdf:about="1009557b-0d4b-4c13-81a0-fd95c15bf158">
    <skos:broader rdf:resource="860e2af9-ce29-4f3f-b027-ae3747eb3e01"/>
    <skos:prefLabel xml:lang="en">ICE DEFORMATION</skos:prefLabel>
    <gcmd:reference gcmd:text="Canadian Ice Service - Environment Canada &apos;http://www.cis.ec.gc.ca/manice/chp1_eng.htm&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">Ice that has been squeezed together, and in places, forced upwards
and downwards. Some subdivisions of deformed ice are rafted ice, ridged
ice, and hummocked ice.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
