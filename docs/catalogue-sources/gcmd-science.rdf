System Note=add narrower relation
New Value=PETROLEUM [44d0ad8f-fe22-4d17-bc47-c0b728a82baf,61687] - PETROLEUM VERTICAL/GEOGRAPHIC DISTRIBUTION [f9e3595d-29b6-462a-8eb6-a06e5a02b081,82913]</skos:changeNote>
    <skos:changeNote>Date=2013-03-11 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=text 
System Note=update Definition
Old Value=Pertaining to the location, drilling, production, or uses of petroleum
or petroleum products.
New Value=Petroleum is a naturally occurring flammable liquid consisting of a complex mixture of hydrocarbons of various molecular weights and other liquid organic compounds, that are found in geologic formations beneath the Earth&apos;s surface. The name Petroleum covers both naturally occurring unprocessed crude oils and petroleum products that are made up of refined crude oil.</skos:changeNote>
    <skos:changeNote>Date=2013-03-11 User Id=tbs1979 Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
New Value=U.S. Environmental Protection Agency</skos:changeNote>
    <gcmd:reference gcmd:text="U.S. Environmental Protection Agency" xml:lang="en"/>
    <skos:narrower rdf:resource="37f3fdb8-a82f-4bff-bda4-cca12a683d6f"/>
    <skos:narrower rdf:resource="f9e3595d-29b6-462a-8eb6-a06e5a02b081"/>
    <skos:definition xml:lang="en">Petroleum is a naturally occurring flammable liquid consisting of a complex mixture of hydrocarbons of various molecular weights and other liquid organic compounds, that are found in geologic formations beneath the Earth&apos;s surface. The name Petroleum covers both naturally occurring unprocessed crude oils and petroleum products that are made up of refined crude oil.</skos:definition>
    <dcterms:modified>2013-03-11 12:41:33.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
