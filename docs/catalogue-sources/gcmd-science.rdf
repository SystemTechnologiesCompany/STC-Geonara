    <skos:broader rdf:resource="3a942e8a-d2f2-42bf-9e83-b7b3793b100e"/>
    <skos:prefLabel xml:lang="en">PLASMA WAVES</skos:prefLabel>
    <gcmd:reference gcmd:text="http://www-istp.gsfc.nasa.gov/Education/gloss.html" xml:lang="en"/>
    <skos:definition xml:lang="en">A plasma is a gas containing ions, electrons, and a magnetic field, andtherefore capable of
conducting electric currents. A plasma wave is a set of particles under theinfluence of electromagnetic fields, exhibiting wave-like motions withamplitude and periodicity.</skos:definition>
