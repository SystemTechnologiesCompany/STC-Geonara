    <skos:changeNote>Date=2019-05-30 User Id=mmorahan Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=Land-Surface Feedbacks [514c891b-60b8-4a6f-adb3-0366c75588e9,368867] - Climate Feedbacks [de62c07e-96c6-44fb-a3a1-cd2902305691,368851]</skos:changeNote>
    <gcmd:reference gcmd:text="Adapted from the IPCC TAR (https://www.ipcc.ch/site/assets/uploads/2018/03/TAR-07.pdf) and the USGCRP Glossary (https://www.globalchange.gov/climate-change/glossary)" xml:lang="en"/>
    <skos:definition xml:lang="en">Land-surface processes through which climate system is controlled,changed, or modulated. Land-surface feedbacks involve a perturbationin a climate quantity that causes a change in a second quantity, and thechange in the second quantity ultimately leads to an additional changein the first. Land-surface feedbacks often involve land-surface change orchange in terrestrial carbon stocks that in turn affect land-atmosphereinteraction.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="570397b4-3b45-4e12-85c3-ef26779a2c96">
    <skos:broader rdf:resource="66700628-2b62-4466-999e-faeb15ca4da5"/>
    <skos:prefLabel xml:lang="en">ANTENNA TEMPERATURE</skos:prefLabel>
    <gcmd:reference gcmd:text="EOSDIS IMS Definitions. &apos;http://harp.gsfc.nasa.gov/v0ims/definitions/par_alph.html&apos;" xml:lang="en"/>
    <skos:definition xml:lang="en">Absolute radiometric temperature incident upon the instrument antenna with
no corrections for spurious energy received from sources not intended by
the instrument design.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
