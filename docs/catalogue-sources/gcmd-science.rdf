generated by: null</skos:changeNote>
    <gcmd:reference gcmd:text="Allaby, M. 1998. A Dictionary of Ecology. Oxford University Press.  Oxford, New York." xml:lang="en"/>
    <skos:definition xml:lang="en">Tree Rings, also known as annual rings or growth rings, are a sheath ofcells appearing as one of a series of concentric rings in thecross-section of a woody stem.  Each ring is usually the result of asingle yearly growth flush starting in spring and ceasing in late summer.</skos:definition>
    <dcterms:modified>2024-10-24 09:58:12.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
