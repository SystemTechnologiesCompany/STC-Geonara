    <gcmd:reference gcmd:text="Jackson, J.A. (1997) &lt;i&gt;Glossary of Geology.&lt;/i&gt; 4th ed. Alexandria, VA:American Geolog cal Institute. 769 p." xml:lang="en"/>
    <skos:definition xml:lang="en">The sum of exchangeable bases plus total soil acidity at a specific pHvalue, usually 7.0 or 8.0.  When acidity is expressed as salt extractableacidity, the cation exchange capacity (CEC) is called the &lt;i&gt;effective&lt;/i&gt;cation exchange capacity (ECEC) because this is considered to be the CEC of theexchanger at the native pH value.  It is usually expressed in centimoles ofcharge per kilogram of exchanger or millimoles of charge per kilogram ofexchanger</skos:definition>
    <dcterms:modified>2024-09-26 10:18:04.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
    <skos:related rdf:resource="9bad3c7b-daf6-428a-89bd-ce62b074dfcf"/>
  </skos:Concept>
