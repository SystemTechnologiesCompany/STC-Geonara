  <skos:Concept rdf:about="3c1c65c3-e1ef-4163-9695-c39ff7fb48da">
    <skos:broader rdf:resource="b41894fa-2e3e-475b-b8f0-b6ffdd2d6e9c"/>
    <skos:prefLabel xml:lang="en">ANIMAL MANURE AND WASTE</skos:prefLabel>
    <gcmd:reference gcmd:text="Adapted from: Herren, R.V., and R.L. Donahue.  1991.  The Agriculture Dictionary, Delmar Publishers INC.  Albany, New york.  553pp. &lt;B&gt;" xml:lang="en"/>
    <skos:definition xml:lang="en">Any measure related to waste from animals including, but not limitedto: manure, methane gas, by-products, nitrates, waste water, andothers.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="3ef1cc7b-2864-46e3-b399-fcc1fbcf0d9b">
    <skos:broader rdf:resource="8799f524-e313-4d2d-9428-8d672d123513"/>
    <skos:prefLabel xml:lang="en">TOTAL TEMPERATURE</skos:prefLabel>
    <gcmd:reference gcmd:text="Global Hydrology Resource Center/Marshall Space Flight Center" xml:lang="en"/>
    <skos:definition xml:lang="en">Measurement made using a temperature probe (e.g. thermistor) which is thesum of the ambient air temperature plus the heat of friction caused by the highspeed air passing over the probe.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
