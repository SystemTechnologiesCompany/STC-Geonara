    <gcmd:reference gcmd:text="Huschle, R.E., ed. 1959. Glossary of Meteorology, American Meteorological Society, Boston, MA." xml:lang="en"/>
    <skos:definition xml:lang="en">The ratio of the heat absorbed (or released) by a system to the corresponding temperature rise (or fall).</skos:definition>
