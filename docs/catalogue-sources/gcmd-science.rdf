  <skos:Concept rdf:about="1ef327e1-6139-49ff-87c3-f959ea75a511">
    <skos:broader rdf:resource="2e83362e-d8f8-4bca-83fd-bae360ebe94b"/>
    <skos:prefLabel xml:lang="en">CORONA</skos:prefLabel>
    <gcmd:reference gcmd:text="The Cambridge Encyclopedia of the Sun, The Cambridge University Press, Cambridge, CB2, 2RU, UK, 2001." xml:lang="en"/>
    <skos:definition xml:lang="en">The outermost, high temperature region of the solar atmosphere. Above thechromosphere and transition region, consisting of almost fully ionized plasmacontained in closed magnetic field loops, called coronal loops or expanding outalong open magnetic field lines to form the solar wind. The corona is a highlyrarefied, low density gas, with electron densities of less than 10*16electrons/ m*3, heated to temperatures of millions of degrees. The corona isvisible to the unaided eye as a white halo during a total eclipse of the sun.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="1efe6ac1-d375-44c3-b8ec-d0ff2987a881">
    <skos:broader rdf:resource="860e2af9-ce29-4f3f-b027-ae3747eb3e01"/>
    <skos:prefLabel xml:lang="en">ICEBERGS</skos:prefLabel>
    <gcmd:reference gcmd:text="British Antarctic Survey" xml:lang="en"/>
    <skos:definition xml:lang="en">A massive piece of ice of greatly varying shape, protruding more than 5m above
sea-level, which has broken away from a glacier, and which may be afloat or
aground. Icebergs may be described as tabular, dome-shaped, sloping, pinnacled,weathered or glacier bergs.</skos:definition>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
