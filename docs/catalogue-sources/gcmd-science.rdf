User Note=Insert Concept
System Note=add broader relation
New Value=SEDIMENT TRANSPORT [0b5e5a9b-5552-4e41-b1a1-9c01c52dff4b,105445] - AEOLIAN PROCESSES [3ab3aa92-9cca-4660-a0ed-281fff07eede,84207]</skos:changeNote>
    <gcmd:reference gcmd:text="PhysicalGeography.net" xml:lang="en"/>
    <skos:narrower rdf:resource="5ce16b97-c91c-420c-9701-33d19d50b286"/>
    <skos:narrower rdf:resource="abe3a81a-3bac-450b-8006-304bee055289"/>
    <skos:definition xml:lang="en">The movement of solid particles (sediment), typically due to a combination of the force of gravity acting on the sediment, and/or the movement of the fluid in which the sediment is entrained. An understanding of sediment transport is typically used in natural systems, where the particles are clastic rocks (sand, gravel, boulders, etc.), mud, or clay; the fluid is air, water, or ice; and the force of gravity acts to move the particles due to the sloping surface on which they are resting.</skos:definition>
    <dcterms:modified>2013-08-20 10:14:16.0</dcterms:modified>
    <skos:inScheme rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
  </skos:Concept>
  <skos:Concept rdf:about="0c0fa520-f325-4e5b-a003-83e636c63f76">
    <skos:broader rdf:resource="295c1f0b-bb76-4cbc-88cf-a42e6fb83bfb"/>
    <dcterms:created>2021-05-14</dcterms:created>
    <skos:prefLabel xml:lang="en">MASS BALANCE</skos:prefLabel>
    <skos:changeNote>Date=2021-05-14 User Id=tstevens Entity=Definition Operation=INSERT 
System Note=insert Definition
New Value=id: null
text: The definition of how the mass of an area changes over time; i.e. how balanced the mass is (e.g., whether processes that cause an increase mass, such as precipitation, are balanced with processes that cause mass loss, such as runoff and evaporation).
language code: en</skos:changeNote>
    <skos:changeNote>Date=2021-05-14 User Id=tstevens Entity=BroaderRelation Operation=INSERT 
User Note=Insert Concept
System Note=add broader relation
New Value=MASS BALANCE [0c0fa520-f325-4e5b-a003-83e636c63f76,606946] - SURFACE MASS [295c1f0b-bb76-4cbc-88cf-a42e6fb83bfb,606943]</skos:changeNote>
    <skos:changeNote>Date=2021-05-21 User Id=tstevens Entity=Definition Operation=UPDATE Field=reference 
System Note=update Definition
New Value=https://podaac.jpl.nasa.gov/dataset/TELLUS_GRAC_L3_JPL_RL06_LND_v03</skos:changeNote>
    <gcmd:reference gcmd:text="https://podaac.jpl.nasa.gov/dataset/TELLUS_GRAC_L3_JPL_RL06_LND_v03" xml:lang="en"/>
    <skos:definition xml:lang="en">The definition of how the mass of an area changes over time; i.e. how balanced the mass is (e.g., whether processes that cause an increase mass, such as precipitation, are balanced with processes that cause mass loss, such as runoff and evaporation).</skos:definition>
    <dcterms:modified>2021-05-21 08:40:41.0</dcterms:modified>
