# Set these in the server's environment before running npm start.
# Never paste a real key into website files or browser storage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_EMAILS=
# Optional local port; hosting platforms supply PORT.
PORT=
HOST=
# Other Node hosts need a persistent directory in production. Netlify uses Blobs.
STC_DATA_DIR=
STC_PORT=5500

# Supabase mode (publishable / anon key only). Configure Google in Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:5500
# Required stable 64-character hex encryption key in production; keep it private.
SUPABASE_SESSION_KEY=
